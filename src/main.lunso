import std.args
import std.io
import std.mem
import driver

fun main(): i32 {
    var arena: mem.Arena
    if arena.init(65536) < 0 {
        io.eprintln("lunsoc: could not initialize arena")
        return 1
    }
    defer arena.deinit()

    var argv = args.load(&arena) or {
        io.eprintln("lunsoc: could not load arguments")
        return 1
    }

    return driver.run(&arena, argv)
}
