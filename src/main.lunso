import std.args
import std.file
import std.fmt
import std.io
import std.mem
import std.str
import std.vec
import ast { Ast }
import ir { IrModule, lower as ir_lower, write as ir_write }
import lexer { Token, TokenKind, error_message, token_name, tokenize_all }
import parser { ParseError, parse }
import sema { Sema, SemaError, check }

fun print_lexeme(bytes: []u8) {
    for var i: i64 = 0; i < len(bytes); i += 1 {
        var b = bytes[i]
        if b == '\r' {
            io.print("\\r")
        } else if b == '\n' {
            io.print("\\n")
        } else if b == '\t' {
            io.print("\\t")
        } else if b == '\\' {
            io.print("\\\\")
        } else if b < ' ' || b == 127 {
            var hex: [16]u8
            var n = fmt.hex_to_buf(b as u64, &hex[0], 16)
            io.print("\\x")
            if n == 1 {
                io.print("0")
            }
            if n > 0 {
                io.print(hex[0..n])
            }
        } else {
            io.write_bytes(1, bytes[i..(i + 1)])
        }
    }
}

fun has_lexeme(kind: TokenKind): bool {
    match kind {
        TokenKind.Identifier, TokenKind.Integer, TokenKind.Float, TokenKind.String, TokenKind.Char, TokenKind.Comment => return true
        else => return false
    }
}

fun report_error(path: []u8, tok: Token, msg: []u8): i32 {
    io.eprint(path)
    io.eprint(":")
    fmt.print_u64(2, tok.line)
    io.eprint(":")
    fmt.print_u64(2, tok.column)
    io.eprint(": ")
    io.eprintln(msg)
    return 1
}

fun dump_tokens(path: []u8, source: []u8, arena: *mem.Arena): i32 {
    var tokens: vec.Vec[Token]
    if vec.init.[Token](&tokens, arena, 128) < 0 {
        io.eprintln("lunsoc: out of memory")
        return 1
    }

    var err_tok: Token
    if !tokenize_all(source, &tokens, &err_tok) {
        return report_error(path, err_tok, error_message(err_tok.kind))
    }

    var slice = vec.as_slice.[Token](&tokens)
    for var i: i64 = 0; i < len(slice); i += 1 {
        var tok = slice[i]
        fmt.print_u64(1, tok.line)
        io.print(":")
        fmt.print_u64(1, tok.column)
        io.print(" ")
        io.print(token_name(tok.kind))
        if has_lexeme(tok.kind) {
            io.print(" ")
            var start = tok.offset as i64
            var end = (tok.offset + tok.length) as i64
            print_lexeme(source[start..end])
        }
        io.println("")
    }
    return 0
}

fun run_parse(path: []u8, source: []u8, arena: *mem.Arena): i32 {
    var tree: Ast
    var err: ParseError
    if !parse(arena, source, &tree, &err) {
        return report_error(path, err.token, err.message)
    }
    var nodes: u64 = 0
    if tree.nodes.len > 0 {
        nodes = tree.nodes.len - 1
    }
    io.print("Parsed ")
    fmt.print_u64(1, tree.functions.len)
    io.print(" function(s), ")
    fmt.print_u64(1, nodes)
    io.println(" AST node(s)")
    return 0
}

fun report_offset_error(path: []u8, source: []u8, offset: u32, msg: []u8): i32 {
    var line: u64 = 1
    var col: u64 = 1
    var limit = offset as i64
    if limit > len(source) {
        limit = len(source)
    }
    for var i: i64 = 0; i < limit; i += 1 {
        if source[i] == '\n' {
            line += 1
            col = 1
        } else {
            col += 1
        }
    }
    io.eprint(path)
    io.eprint(":")
    fmt.print_u64(2, line)
    io.eprint(":")
    fmt.print_u64(2, col)
    io.eprint(": ")
    io.eprintln(msg)
    return 1
}

fun run_check(path: []u8, source: []u8, arena: *mem.Arena, emit_ir: bool): i32 {
    var tree: Ast
    var perr: ParseError
    if !parse(arena, source, &tree, &perr) {
        return report_error(path, perr.token, perr.message)
    }
    var sem: Sema
    var serr: SemaError
    if !check(arena, &tree, &sem, &serr) {
        return report_offset_error(path, source, serr.offset, serr.message)
    }
    if emit_ir {
        var mod: IrModule
        if !ir_lower(arena, &tree, &sem, &mod) {
            io.eprintln("lunsoc: could not lower to IR")
            return 1
        }
        ir_write(&mod)
        return 0
    }
    io.print("Checked ")
    fmt.print_u64(1, tree.functions.len)
    io.println(" function(s)")
    return 0
}

fun main(): i32 {
    var arena: mem.Arena
    if mem.init(&arena, 65536) < 0 {
        io.eprintln("lunsoc: could not initialize arena")
        return 1
    }

    var argv: [][]u8
    if args.load(&arena, &argv) < 0 {
        io.eprintln("usage: lunsoc [--parse | --check | --emit-ir] <source.lunso>")
        mem.deinit(&arena)
        return 1
    }

    var parse_mode = false
    var check_mode = false
    var ir_mode = false
    var path: []u8 = ""
    for var i: i64 = 1; i < len(argv); i += 1 {
        var arg = argv[i]
        if str.equals(arg, "--parse") {
            parse_mode = true
        } else if str.equals(arg, "--check") {
            check_mode = true
        } else if str.equals(arg, "--emit-ir") {
            ir_mode = true
        } else if len(path) == 0 {
            path = arg
        } else {
            io.eprintln("usage: lunsoc [--parse | --check | --emit-ir] <source.lunso>")
            mem.deinit(&arena)
            return 1
        }
    }
    var mode_count = 0
    if parse_mode { mode_count += 1 }
    if check_mode { mode_count += 1 }
    if ir_mode { mode_count += 1 }
    if len(path) == 0 || mode_count > 1 {
        io.eprintln("usage: lunsoc [--parse | --check | --emit-ir] <source.lunso>")
        mem.deinit(&arena)
        return 1
    }

    var raw: file.Bytes
    if file.read_all(path, &arena, &raw) < 0 {
        io.eprint(path)
        io.eprintln(": could not read source")
        mem.deinit(&arena)
        return 1
    }

    var source = raw.ptr[0..raw.len]
    var rc: i32 = 0
    if check_mode || ir_mode {
        rc = run_check(path, source, &arena, ir_mode)
    } else if parse_mode {
        rc = run_parse(path, source, &arena)
    } else {
        rc = dump_tokens(path, source, &arena)
    }

    mem.deinit(&arena)
    return rc
}
