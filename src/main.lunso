import std.args
import std.io
import std.mem
import driver

fun main(): i32 {
    var arena: mem.Arena
    if mem.init(&arena, 65536) < 0 {
        io.eprintln("lunsoc: could not initialize arena")
        return 1
    }
    defer mem.deinit(&arena)

    var argv: [][]u8
    if args.load(&arena, &argv) < 0 {
        io.eprintln("lunsoc: could not load arguments")
        return 1
    }

    return driver.run(&arena, argv)
}
