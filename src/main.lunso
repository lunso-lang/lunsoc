import std.args
import std.io
import std.mem
import driver { run as driver_run }

fun main(): i32 {
    var arena: mem.Arena
    if mem.init(&arena, 65536) < 0 {
        io.eprintln("lunsoc: could not initialize arena")
        return 1
    }

    var argv: [][]u8
    if args.load(&arena, &argv) < 0 {
        io.eprintln("lunsoc: could not load arguments")
        mem.deinit(&arena)
        return 1
    }

    var rc = driver_run(&arena, argv)
    mem.deinit(&arena)
    return rc
}
