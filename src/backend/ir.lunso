import std.fmt
import std.io
import std.mem
import std.str
import std.collections.Vec
import frontend.ast.*
import frontend.sema.*

pub enum IrOp : u8 {
    Label,
    Number,
    Bool,
    Bytes,
    Immediate,
    Load,
    Store,
    Call,
    FnAddr,
    CallIndirect,
    StorageAlloc,
    StorageInit,
    WidenIndex,
    ElementAddress,
    PointerIndex,
    FieldAddress,
    LocalAddress,
    MemoryLoad,
    MemoryStore,
    Slice,
    PointerSlice,
    ArrayView,
    MakeAny,
    VariadicSlice,
    Len,
    Data,
    Cast,
    FloatExtend,
    Jump,
    Branch,
    Return,
    Negate,
    LogicalNot,
    BitNot,
    Add,
    Subtract,
    Multiply,
    Divide,
    Remainder,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    BitAnd,
    BitOr,
    BitXor,
    ShiftLeft,
    ShiftRight,
}

pub struct IrInstruction {
    op: IrOp
    type_info: SemaType
    result: u32
    a: u32
    b: u32
    c: u32
}

pub struct IrFunction {
    name: Span
    result: SemaType
    first_parameter: u32
    parameter_count: u32
    first_instruction: u32
    instruction_count: u32
    slot_count: u32
    module: u32
    external: bool
    template_only: bool
    specialization: bool
}

pub struct IrModule {
    source: []u8
    module_count: u32
    struct_names: Vec[Span]
    pointees: Vec[SemaType]
    elements: Vec[SemaType]
    func_types: Vec[SemaFuncType]
    functions: Vec[IrFunction]
    parameters: Vec[SemaType]
    instructions: Vec[IrInstruction]
    arguments: Vec[u32]
}

struct IrLoop {
    break_label: u32
    continue_label: u32
    defer_base: u64
}

struct Lowering {
    tree: *Ast
    sem: *Sema
    mod: *IrModule
    next_value: u32
    next_label: u32
    current_fn: u32
    loops: Vec[IrLoop]
    defers: Vec[u32]
    failed: bool
}

fun binary_ir_op(bop: BinaryOp): IrOp {
    match bop {
        BinaryOp.Add, BinaryOp.AssignAdd => return IrOp.Add
        BinaryOp.Subtract, BinaryOp.AssignSubtract => return IrOp.Subtract
        BinaryOp.Multiply, BinaryOp.AssignMultiply => return IrOp.Multiply
        BinaryOp.Divide, BinaryOp.AssignDivide => return IrOp.Divide
        BinaryOp.Remainder, BinaryOp.AssignRemainder => return IrOp.Remainder
        BinaryOp.Equal => return IrOp.Equal
        BinaryOp.NotEqual => return IrOp.NotEqual
        BinaryOp.Less => return IrOp.Less
        BinaryOp.LessEqual => return IrOp.LessEqual
        BinaryOp.Greater => return IrOp.Greater
        BinaryOp.GreaterEqual => return IrOp.GreaterEqual
        BinaryOp.BitAnd, BinaryOp.AssignBitAnd => return IrOp.BitAnd
        BinaryOp.BitOr, BinaryOp.AssignBitOr => return IrOp.BitOr
        BinaryOp.BitXor, BinaryOp.AssignBitXor => return IrOp.BitXor
        BinaryOp.ShiftLeft, BinaryOp.AssignShiftLeft => return IrOp.ShiftLeft
        else => return IrOp.ShiftRight
    }
}

fun emit(l: *Lowering, inst: IrInstruction) {
    if !l.failed && l.mod.instructions.push(&inst) < 0 {
        l.failed = true
    }
}

fun emit_value(l: *Lowering, op: IrOp, t: SemaType, a: u32, b: u32, c: u32): u32 {
    var id: u32 = 0
    if t.kind != TypeKind.Void {
        id = l.next_value
        l.next_value += 1
    }
    emit(l, IrInstruction { op: op, type_info: t, result: id, a: a, b: b, c: c })
    return id
}

fun new_label(l: *Lowering): u32 {
    var id = l.next_label
    l.next_label += 1
    return id
}

fun emit_label(l: *Lowering, target: u32) {
    emit(l, IrInstruction { op: IrOp.Label, type_info: empty_type(), result: 0, a: target, b: 0, c: 0 })
}

fun emit_jump(l: *Lowering, target: u32) {
    emit(l, IrInstruction { op: IrOp.Jump, type_info: empty_type(), result: 0, a: target, b: 0, c: 0 })
}

fun emit_branch(l: *Lowering, cond: u32, yes: u32, no: u32) {
    emit(l, IrInstruction { op: IrOp.Branch, type_info: empty_type(), result: 0, a: cond, b: yes, c: no })
}

fun emit_store(l: *Lowering, t: SemaType, slot: u32, val: u32) {
    emit(l, IrInstruction { op: IrOp.Store, type_info: t, result: 0, a: slot, b: val, c: 0 })
}

fun uses_storage(t: SemaType): bool {
    return t.kind == TypeKind.Array || t.kind == TypeKind.Struct || t.kind == TypeKind.Result || t.kind == TypeKind.TaggedUnion
}

fun make_result_type(l: *Lowering, inner: SemaType): SemaType {
    var al: u32 = 8
    if inner.kind == TypeKind.Struct && (inner.record as u64) < l.sem.records.len {
        var ral = l.sem.records.data[inner.record].alignment
        if ral > al { al = ral }
    }
    var val_off: u32 = 24
    if al > 8 {
        val_off = ((24 + al - 1) / al) * al
    }
    var sz = val_off + storage_size(inner)
    var rem = sz % al
    if rem != 0 {
        sz += al - rem
    }
    var t = simple_type(TypeKind.Result)
    t.length = val_off
    t.record_size = sz
    t.element = inner.kind
    t.element_size = storage_size(inner)
    return t
}

fun lower_node(l: *Lowering, id: u32): SemaNode {
    if l.current_fn < (l.sem.functions.len as u32) {
        var sf = &l.sem.functions.data[l.current_fn]
        if sf.nodes.len > 0 {
            var ast_fns = l.tree.functions.as_slice()
            var first = ast_fns[sf.declaration].nodes.first
            return sf.nodes.data[id - first]
        }
    }
    var sn = l.sem.nodes.as_slice()
    return sn[id]
}

fun lower_const(l: *Lowering, info: SemaNode): u32 {
    var consts = l.sem.constants.as_slice()
    var sc = consts[info.binding]
    if sc.str_node != NODE_NONE {
        var nodes = l.tree.nodes.as_slice()
        var sn_node = nodes[sc.str_node]
        var slen: u32 = 0
        match sn_node.data {
            AstData.String(slen_v) => slen = slen_v
            else => {}
        }
        var st = lower_node(l, sc.str_node).type_info
        var bytes = emit_value(l, IrOp.Bytes, st, sn_node.pos, slen, 0)
        if info.type_info.kind == TypeKind.Slice {
            return emit_value(l, IrOp.ArrayView, st, bytes, 0, 0)
        }
        return bytes
    }
    var op = IrOp.Immediate
    if info.type_info.kind == TypeKind.Bool {
        op = IrOp.Bool
    }
    return emit_value(l, op, info.type_info, sc.bits as u32, (sc.bits >> 32) as u32, 0)
}

fun lower_index(l: *Lowering, id: u32): u32 {
    var idx = lower_expression(l, id)
    var t = lower_node(l, id).type_info
    if t.kind == TypeKind.I64 || t.kind == TypeKind.U64 {
        return idx
    }
    return emit_value(l, IrOp.WidenIndex, t, idx, 0, 0)
}

fun lower_memory_address(l: *Lowering, id: u32): u32 {
    var nodes = l.tree.nodes.as_slice()
    match nodes[id].data {
        AstData.Index(ix) => {
            var base = lower_expression(l, ix.base)
            var idx = lower_index(l, ix.idx)
            var bt = lower_node(l, ix.base).type_info
            if bt.kind == TypeKind.Pointer {
                return emit_value(l, IrOp.PointerIndex, lower_node(l, id).type_info, base, idx, 0)
            }
            return emit_value(l, IrOp.ElementAddress, bt, base, idx, 0)
        }
        AstData.Unary(un) => {
            var base_val = lower_expression(l, un.operand)
            if un.op == UnaryOp.Dereference {
                return base_val
            }
            return base_val
        }
        AstData.Member(m) => {
            var base_val = lower_expression(l, m.base)
            var bt = lower_node(l, m.base).type_info
            if bt.kind == TypeKind.Pointer {
                var pts = l.sem.pointees.as_slice()
                bt = pts[bt.pointee]
            }
            return emit_value(l, IrOp.FieldAddress, bt, base_val, lower_node(l, id).binding, 0)
        }
        else => return 0
    }
}

fun emit_u64_imm(l: *Lowering, v: u64): u32 {
    return emit_value(l, IrOp.Immediate, simple_type(TypeKind.U64), v as u32, (v >> 32) as u32, 0)
}

fun emit_hash_mix(l: *Lowering, h: u32, x: u32): u32 {
    var u64_t = simple_type(TypeKind.U64)
    var xored = emit_value(l, IrOp.BitXor, u64_t, h, x, 0)
    var prime = emit_u64_imm(l, 1099511628211)
    return emit_value(l, IrOp.Multiply, u64_t, xored, prime, 0)
}

fun find_struct_method_ir(l: *Lowering, t: SemaType, name: []u8): u32 {
    if t.kind != TypeKind.Struct { return ~0 as u32 }
    var sr = &l.sem.records.data[t.record]
    var fdecls = l.tree.functions.as_slice()
    var fns = l.sem.functions.as_slice()
    for i, sf in fns {
        var fd = fdecls[sf.declaration]
        if fd.owner_struct != sr.declaration { continue }
        var fn_bytes = l.tree.source[(fd.name.offset as i64)..((fd.name.offset + fd.name.length) as i64)]
        if fn_bytes != name { continue }
        if fd.type_parameters.count == 0 { return i as u32 }
        if sf.arguments.len == sr.arguments.len {
            var ok = true
            for var ai: u64 = 0; ai < sf.arguments.len; ai += 1 {
                if sf.arguments.data[ai].kind != sr.arguments.data[ai].kind ||
                   sf.arguments.data[ai].record != sr.arguments.data[ai].record {
                    ok = false
                    break
                }
            }
            if ok { return i as u32 }
        }
    }
    return ~0 as u32
}

fun emit_call_2(l: *Lowering, ret_t: SemaType, fn_idx: u32, a0: u32, a1: u32): u32 {
    var first = l.mod.arguments.len as u32
    l.mod.arguments.push_value(a0)
    l.mod.arguments.push_value(a1)
    return emit_value(l, IrOp.Call, ret_t, fn_idx, first, 2)
}

fun emit_call_1(l: *Lowering, ret_t: SemaType, fn_idx: u32, a0: u32): u32 {
    var first = l.mod.arguments.len as u32
    l.mod.arguments.push_value(a0)
    return emit_value(l, IrOp.Call, ret_t, fn_idx, first, 1)
}

fun emit_eq_values(l: *Lowering, t: SemaType, lhs: u32, rhs: u32): u32 {
    var bool_t = simple_type(TypeKind.Bool)
    if t.kind == TypeKind.Slice {
        var u64_t = simple_type(TypeKind.U64)
        var u8_t = simple_type(TypeKind.U8)
        var ptr_t = simple_type(TypeKind.Pointer)
        var res_slot = emit_value(l, IrOp.StorageAlloc, bool_t, 0, 0, 0)
        var false_v = emit_value(l, IrOp.Bool, bool_t, 0, 0, 0)
        var true_v = emit_value(l, IrOp.Bool, bool_t, 1, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: res_slot, b: false_v, c: 0 })

        var len_l = emit_value(l, IrOp.Len, t, lhs, 0, 0)
        var len_r = emit_value(l, IrOp.Len, t, rhs, 0, 0)
        var same_len = emit_value(l, IrOp.Equal, u64_t, len_l, len_r, 0)
        var loop_init = new_label(l)
        var done_lbl = new_label(l)
        emit_branch(l, same_len, loop_init, done_lbl)

        emit_label(l, loop_init)
        var idx_slot = emit_value(l, IrOp.StorageAlloc, u64_t, 0, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: idx_slot, b: emit_u64_imm(l, 0), c: 0 })
        var data_l = emit_value(l, IrOp.Data, t, lhs, 0, 0)
        var data_r = emit_value(l, IrOp.Data, t, rhs, 0, 0)
        var loop_hdr = new_label(l)
        var loop_body = new_label(l)
        var set_true = new_label(l)
        emit_jump(l, loop_hdr)

        emit_label(l, loop_hdr)
        var idx = emit_value(l, IrOp.MemoryLoad, u64_t, idx_slot, 0, 0)
        var cond = emit_value(l, IrOp.Less, u64_t, idx, len_l, 0)
        emit_branch(l, cond, loop_body, set_true)

        emit_label(l, loop_body)
        var pl = emit_value(l, IrOp.PointerIndex, u8_t, data_l, idx, 1)
        var pr = emit_value(l, IrOp.PointerIndex, u8_t, data_r, idx, 1)
        var bl = emit_value(l, IrOp.MemoryLoad, u8_t, pl, 0, 0)
        var br = emit_value(l, IrOp.MemoryLoad, u8_t, pr, 0, 0)
        var beq = emit_value(l, IrOp.Equal, u8_t, bl, br, 0)
        var next_lbl = new_label(l)
        emit_branch(l, beq, next_lbl, done_lbl)

        emit_label(l, next_lbl)
        var next_idx = emit_value(l, IrOp.Add, u64_t, idx, emit_u64_imm(l, 1), 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: idx_slot, b: next_idx, c: 0 })
        emit_jump(l, loop_hdr)

        emit_label(l, set_true)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: res_slot, b: true_v, c: 0 })
        emit_jump(l, done_lbl)

        emit_label(l, done_lbl)
        return emit_value(l, IrOp.MemoryLoad, bool_t, res_slot, 0, 0)
    }
    if t.kind == TypeKind.Struct {
        var sr = &l.sem.records.data[t.record]
        if !sr.auto_eq {
            var fi = find_struct_method_ir(l, t, "eq")
            return emit_call_2(l, bool_t, fi, lhs, rhs)
        }
        var res_slot = emit_value(l, IrOp.StorageAlloc, bool_t, 0, 0, 0)
        var false_v = emit_value(l, IrOp.Bool, bool_t, 0, 0, 0)
        var true_v = emit_value(l, IrOp.Bool, bool_t, 1, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: res_slot, b: false_v, c: 0 })
        var done_lbl = new_label(l)
        var ptr_t = simple_type(TypeKind.Pointer)
        var fields = sr.fields.as_slice()
        for f in fields {
            var al = emit_value(l, IrOp.FieldAddress, ptr_t, lhs, f.binding, 0)
            var ar = emit_value(l, IrOp.FieldAddress, ptr_t, rhs, f.binding, 0)
            var vl = al
            var vr = ar
            if !uses_storage(f.type_info) {
                vl = emit_value(l, IrOp.MemoryLoad, f.type_info, al, 0, 0)
                vr = emit_value(l, IrOp.MemoryLoad, f.type_info, ar, 0, 0)
            }
            var feq = emit_eq_values(l, f.type_info, vl, vr)
            var next_f = new_label(l)
            emit_branch(l, feq, next_f, done_lbl)
            emit_label(l, next_f)
        }
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: res_slot, b: true_v, c: 0 })
        emit_jump(l, done_lbl)
        emit_label(l, done_lbl)
        return emit_value(l, IrOp.MemoryLoad, bool_t, res_slot, 0, 0)
    }
    if t.kind == TypeKind.TaggedUnion {
        var u32_t = simple_type(TypeKind.U32)
        var ptr_t = simple_type(TypeKind.Pointer)
        var res_slot = emit_value(l, IrOp.StorageAlloc, bool_t, 0, 0, 0)
        var false_v = emit_value(l, IrOp.Bool, bool_t, 0, 0, 0)
        var true_v = emit_value(l, IrOp.Bool, bool_t, 1, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: res_slot, b: false_v, c: 0 })
        var done_lbl = new_label(l)
        var tl = emit_value(l, IrOp.MemoryLoad, u32_t, lhs, 0, 0)
        var tr = emit_value(l, IrOp.MemoryLoad, u32_t, rhs, 0, 0)
        var tag_eq = emit_value(l, IrOp.Equal, u32_t, tl, tr, 0)
        var chk_vars = new_label(l)
        emit_branch(l, tag_eq, chk_vars, done_lbl)

        emit_label(l, chk_vars)
        var su = &l.sem.unions.data[t.record]
        for var vi: u32 = 0; vi < (su.variants.len as u32); vi += 1 {
            var v_imm = emit_value(l, IrOp.Immediate, u32_t, vi, 0, 0)
            var is_v = emit_value(l, IrOp.Equal, u32_t, tl, v_imm, 0)
            var v_body = new_label(l)
            var v_next = new_label(l)
            emit_branch(l, is_v, v_body, v_next)
            emit_label(l, v_body)
            var fields = su.variants.data[vi].fields.as_slice()
            for f in fields {
                var al = emit_value(l, IrOp.FieldAddress, ptr_t, lhs, f.binding, 0)
                var ar = emit_value(l, IrOp.FieldAddress, ptr_t, rhs, f.binding, 0)
                var vl = al
                var vr = ar
                if !uses_storage(f.type_info) {
                    vl = emit_value(l, IrOp.MemoryLoad, f.type_info, al, 0, 0)
                    vr = emit_value(l, IrOp.MemoryLoad, f.type_info, ar, 0, 0)
                }
                var feq = emit_eq_values(l, f.type_info, vl, vr)
                var next_f = new_label(l)
                emit_branch(l, feq, next_f, done_lbl)
                emit_label(l, next_f)
            }
            emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: res_slot, b: true_v, c: 0 })
            emit_jump(l, done_lbl)
            emit_label(l, v_next)
        }
        emit_jump(l, done_lbl)
        emit_label(l, done_lbl)
        return emit_value(l, IrOp.MemoryLoad, bool_t, res_slot, 0, 0)
    }
    return emit_value(l, IrOp.Equal, t, lhs, rhs, 0)
}

fun emit_hash_value(l: *Lowering, t: SemaType, val: u32): u32 {
    var u64_t = simple_type(TypeKind.U64)
    var fnv_init = emit_u64_imm(l, 14695981039346656037)
    if t.kind == TypeKind.Slice {
        var u8_t = simple_type(TypeKind.U8)
        var ptr_t = simple_type(TypeKind.Pointer)
        var h_slot = emit_value(l, IrOp.StorageAlloc, u64_t, 0, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: h_slot, b: fnv_init, c: 0 })
        var idx_slot = emit_value(l, IrOp.StorageAlloc, u64_t, 0, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: idx_slot, b: emit_u64_imm(l, 0), c: 0 })
        var length = emit_value(l, IrOp.Len, t, val, 0, 0)
        var data_ptr = emit_value(l, IrOp.Data, t, val, 0, 0)
        var loop_hdr = new_label(l)
        var loop_body = new_label(l)
        var done_lbl = new_label(l)
        emit_jump(l, loop_hdr)

        emit_label(l, loop_hdr)
        var idx = emit_value(l, IrOp.MemoryLoad, u64_t, idx_slot, 0, 0)
        var cond = emit_value(l, IrOp.Less, u64_t, idx, length, 0)
        emit_branch(l, cond, loop_body, done_lbl)

        emit_label(l, loop_body)
        var p = emit_value(l, IrOp.PointerIndex, u8_t, data_ptr, idx, 1)
        var b = emit_value(l, IrOp.MemoryLoad, u8_t, p, 0, 0)
        var b64 = emit_value(l, IrOp.Cast, u64_t, b, TypeKind.U8 as u32, 0)
        var h = emit_value(l, IrOp.MemoryLoad, u64_t, h_slot, 0, 0)
        var nh = emit_hash_mix(l, h, b64)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: h_slot, b: nh, c: 0 })
        var next_idx = emit_value(l, IrOp.Add, u64_t, idx, emit_u64_imm(l, 1), 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: idx_slot, b: next_idx, c: 0 })
        emit_jump(l, loop_hdr)

        emit_label(l, done_lbl)
        return emit_value(l, IrOp.MemoryLoad, u64_t, h_slot, 0, 0)
    }
    if t.kind == TypeKind.Struct {
        var sr = &l.sem.records.data[t.record]
        if !sr.auto_hash {
            var fi = find_struct_method_ir(l, t, "hash")
            return emit_call_1(l, u64_t, fi, val)
        }
        var ptr_t = simple_type(TypeKind.Pointer)
        var h = fnv_init
        var fields = sr.fields.as_slice()
        for f in fields {
            var fa = emit_value(l, IrOp.FieldAddress, ptr_t, val, f.binding, 0)
            var fv = fa
            if !uses_storage(f.type_info) {
                fv = emit_value(l, IrOp.MemoryLoad, f.type_info, fa, 0, 0)
            }
            var fh = emit_hash_value(l, f.type_info, fv)
            h = emit_hash_mix(l, h, fh)
        }
        return h
    }
    if t.kind == TypeKind.TaggedUnion {
        var u32_t = simple_type(TypeKind.U32)
        var ptr_t = simple_type(TypeKind.Pointer)
        var tag = emit_value(l, IrOp.MemoryLoad, u32_t, val, 0, 0)
        var tag64 = emit_value(l, IrOp.Cast, u64_t, tag, TypeKind.U32 as u32, 0)
        var h_init = emit_hash_mix(l, fnv_init, tag64)
        var h_slot = emit_value(l, IrOp.StorageAlloc, u64_t, 0, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: h_slot, b: h_init, c: 0 })
        var done_lbl = new_label(l)
        var su = &l.sem.unions.data[t.record]
        for var vi: u32 = 0; vi < (su.variants.len as u32); vi += 1 {
            var v_imm = emit_value(l, IrOp.Immediate, u32_t, vi, 0, 0)
            var is_v = emit_value(l, IrOp.Equal, u32_t, tag, v_imm, 0)
            var v_body = new_label(l)
            var v_next = new_label(l)
            emit_branch(l, is_v, v_body, v_next)
            emit_label(l, v_body)
            var h = emit_value(l, IrOp.MemoryLoad, u64_t, h_slot, 0, 0)
            var fields = su.variants.data[vi].fields.as_slice()
            for f in fields {
                var fa = emit_value(l, IrOp.FieldAddress, ptr_t, val, f.binding, 0)
                var fv = fa
                if !uses_storage(f.type_info) {
                    fv = emit_value(l, IrOp.MemoryLoad, f.type_info, fa, 0, 0)
                }
                var fh = emit_hash_value(l, f.type_info, fv)
                h = emit_hash_mix(l, h, fh)
            }
            emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: u64_t, result: 0, a: h_slot, b: h, c: 0 })
            emit_jump(l, done_lbl)
            emit_label(l, v_next)
        }
        emit_jump(l, done_lbl)
        emit_label(l, done_lbl)
        return emit_value(l, IrOp.MemoryLoad, u64_t, h_slot, 0, 0)
    }
    var v64 = val
    if t.kind != TypeKind.U64 {
        v64 = emit_value(l, IrOp.Cast, u64_t, val, t.kind as u32, 0)
    }
    return emit_hash_mix(l, fnv_init, v64)
}

fun lower_call(l: *Lowering, id: u32): u32 {
    var info = lower_node(l, id)
    var nodes = l.tree.nodes.as_slice()
    var cr = NodeRange { first: 0, count: 0 }
    match nodes[id].data {
        AstData.Call(r) => cr = r
        else => return 0
    }
    var children = l.tree.children.as_slice()
    if info.builtin == SemaBuiltin.SizeOf {
        return emit_value(l, IrOp.Immediate, info.type_info, info.binding, 0, 0)
    }
    if info.builtin == SemaBuiltin.Fail {
        return lower_expression(l, children[cr.first + 1])
    }
    if info.builtin == SemaBuiltin.Hash {
        var recv_id = NODE_NONE
        match nodes[children[cr.first]].data {
            AstData.Member(m) => recv_id = m.base
            else => {}
        }
        var recv_t = lower_node(l, recv_id).type_info
        var recv_val = lower_expression(l, recv_id)
        if recv_t.kind == TypeKind.Pointer {
            var base_t = l.sem.pointees.data[recv_t.pointee]
            if !uses_storage(base_t) {
                recv_val = emit_value(l, IrOp.MemoryLoad, base_t, recv_val, 0, 0)
            }
            return emit_hash_value(l, base_t, recv_val)
        }
        return emit_hash_value(l, recv_t, recv_val)
    }
    if info.builtin == SemaBuiltin.Eq {
        var recv_id = NODE_NONE
        match nodes[children[cr.first]].data {
            AstData.Member(m) => recv_id = m.base
            else => {}
        }
        var arg_id = children[cr.first + 1]
        var recv_t = lower_node(l, recv_id).type_info
        var lhs = lower_expression(l, recv_id)
        var rhs_ptr = lower_expression(l, arg_id)
        var base_t = recv_t
        if recv_t.kind == TypeKind.Pointer {
            base_t = l.sem.pointees.data[recv_t.pointee]
            if !uses_storage(base_t) {
                lhs = emit_value(l, IrOp.MemoryLoad, base_t, lhs, 0, 0)
            }
        }
        var rhs = rhs_ptr
        if !uses_storage(base_t) {
            rhs = emit_value(l, IrOp.MemoryLoad, base_t, rhs_ptr, 0, 0)
        }
        return emit_eq_values(l, base_t, lhs, rhs)
    }
    if info.builtin != SemaBuiltin.None {
        var arg = children[cr.first + 1]
        var val = lower_expression(l, arg)
        var op = IrOp.Data
        if info.builtin == SemaBuiltin.Len {
            op = IrOp.Len
        }
        return emit_value(l, op, lower_node(l, arg).type_info, val, 0, 0)
    }
    if info.is_enum_case && info.type_info.kind == TypeKind.TaggedUnion {
        var count = cr.count - 1
        var temp_vals: [64]u32
        for var i: u32 = 0; i < count && !l.failed; i += 1 {
            var val = lower_expression(l, children[cr.first + 1 + i])
            if i < 64 {
                temp_vals[i] = val
            }
        }
        var addr = emit_value(l, IrOp.StorageAlloc, info.type_info, 0, 0, 0)
        emit(l, IrInstruction { op: IrOp.StorageInit, type_info: info.type_info, result: 0, a: addr, b: 0, c: 0 })
        var tag = emit_value(l, IrOp.Immediate, simple_type(TypeKind.U32), info.binding, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: simple_type(TypeKind.U32), result: 0, a: addr, b: tag, c: 0 })
        var uv = &l.sem.unions.data[info.type_info.record].variants.data[info.binding]
        for var i: u32 = 0; i < count && !l.failed; i += 1 {
            var fsn = uv.fields.data[i]
            var faddr = emit_value(l, IrOp.FieldAddress, simple_type(TypeKind.Pointer), addr, fsn.binding, 0)
            emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: fsn.type_info, result: 0, a: faddr, b: temp_vals[i], c: 0 })
        }
        return addr
    }
    var count = cr.count - 1
    // Lower arguments first so nested calls do not interleave in mod.arguments.
    var temp_vals: [64]u32
    if info.is_indirect_call {
        var callee_val = lower_expression(l, children[cr.first])
        for var i: u32 = 0; i < count && !l.failed; i += 1 {
            var val = lower_expression(l, children[cr.first + 1 + i])
            if i < 64 {
                temp_vals[i] = val
            }
        }
        var first = l.mod.arguments.len as u32
        for var i: u32 = 0; i < count && !l.failed; i += 1 {
            if l.mod.arguments.push_value(temp_vals[i]) < 0 {
                l.failed = true
            }
        }
        var packed_c = (info.binding << 16) | (count & 65535)
        return emit_value(l, IrOp.CallIndirect, info.type_info, callee_val, first, packed_c)
    }
    var arg_offset: u32 = 0
    if info.method_call != 0 {
        var callee_id = children[cr.first]
        match nodes[callee_id].data {
            AstData.GenericCallee(gr) => callee_id = children[gr.first]
            else => {}
        }
        var recv_id = NODE_NONE
        match nodes[callee_id].data {
            AstData.Member(m) => recv_id = m.base
            else => {}
        }
        var recv_val: u32 = 0
        if info.method_call == 2 {
            var target = lower_node(l, recv_id)
            var recv_is_ident = false
            match nodes[recv_id].data {
                AstData.Identifier(_) => recv_is_ident = true
                else => {}
            }
            if uses_storage(target.type_info) || target.is_const {
                recv_val = lower_expression(l, recv_id)
            } else if !recv_is_ident {
                recv_val = lower_memory_address(l, recv_id)
            } else {
                recv_val = emit_value(l, IrOp.LocalAddress, target.type_info, target.binding, 0, 0)
            }
        } else {
            recv_val = lower_expression(l, recv_id)
        }
        temp_vals[0] = recv_val
        arg_offset = 1
    }
    for var i: u32 = 0; i < count && !l.failed; i += 1 {
        var arg_id = children[cr.first + 1 + i]
        var val: u32 = 0
        var spread_inner = NODE_NONE
        var is_sp = false
        match nodes[arg_id].data {
            AstData.Unary(un) => {
                if un.op == UnaryOp.Spread {
                    is_sp = true
                    spread_inner = un.operand
                }
            }
            else => {}
        }
        if is_sp {
            val = lower_expression(l, spread_inner)
        } else {
            val = lower_expression(l, arg_id)
        }
        if (arg_offset + i) < 64 {
            temp_vals[arg_offset + i] = val
        }
    }
    var total_count = count + arg_offset
    var sf = l.sem.functions.data[info.binding]
    var fdecl = l.tree.functions.data[sf.declaration]
    if fdecl.is_variadic && !l.failed {
        var fixed_total = fdecl.parameters.count - 1
        var var_count = total_count - fixed_total
        var is_spread = false
        if var_count == 1 {
            match nodes[children[cr.first + 1 + (fixed_total - arg_offset)]].data {
                AstData.Unary(un) => {
                    if un.op == UnaryOp.Spread { is_spread = true }
                }
                else => {}
            }
        }
        if is_spread {
            total_count = fixed_total + 1
        } else {
            var first_var = l.mod.arguments.len as u32
            for var i: u32 = 0; i < var_count && !l.failed; i += 1 {
                if l.mod.arguments.push_value(temp_vals[fixed_total + i]) < 0 {
                    l.failed = true
                }
            }
            var var_slice_t = sf.param_types.data[sf.param_types.len - 1]
            var var_val = emit_value(l, IrOp.VariadicSlice, var_slice_t, first_var, var_count, 0)
            temp_vals[fixed_total] = var_val
            total_count = fixed_total + 1
        }
    }
    var first = l.mod.arguments.len as u32
    for var i: u32 = 0; i < total_count && !l.failed; i += 1 {
        if l.mod.arguments.push_value(temp_vals[i]) < 0 {
            l.failed = true
        }
    }
    return emit_value(l, IrOp.Call, info.type_info, info.binding, first, total_count)
}

fun lower_logical(l: *Lowering, bop: BinaryOp, a: u32, b: u32, t: SemaType): u32 {
    var lhs = lower_expression(l, a)
    var slot = l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count
    l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count += 1
    var rhs_lbl = new_label(l)
    var short_lbl = new_label(l)
    var end_lbl = new_label(l)
    if bop == BinaryOp.LogicalAnd {
        emit_branch(l, lhs, rhs_lbl, short_lbl)
    } else {
        emit_branch(l, lhs, short_lbl, rhs_lbl)
    }
    emit_label(l, rhs_lbl)
    var rhs = lower_expression(l, b)
    emit_store(l, t, slot, rhs)
    emit_jump(l, end_lbl)
    emit_label(l, short_lbl)
    var sv: u32 = 0
    if bop == BinaryOp.LogicalOr { sv = 1 }
    var short_val = emit_value(l, IrOp.Bool, t, sv, 0, 0)
    emit_store(l, t, slot, short_val)
    emit_jump(l, end_lbl)
    emit_label(l, end_lbl)
    return emit_value(l, IrOp.Load, t, slot, 0, 0)
}

fun lower_unconverted(l: *Lowering, id: u32): u32 {
    if l.failed { return 0 }
    var nodes = l.tree.nodes.as_slice()
    var node = nodes[id]
    var info = lower_node(l, id)
    match node.data {
        AstData.Identifier(_) => {
            if info.is_const {
                return lower_const(l, info)
            }
            if info.is_fn_ref {
                return emit_value(l, IrOp.FnAddr, info.type_info, info.binding, 0, 0)
            }
            var op = IrOp.Load
            if info.is_boolean_literal { op = IrOp.Bool }
            return emit_value(l, op, info.type_info, info.binding, 0, 0)
        }
        AstData.Integer(nlen) => return emit_value(l, IrOp.Number, info.type_info, node.pos, nlen, 0)
        AstData.Float(nlen) => return emit_value(l, IrOp.Number, info.type_info, node.pos, nlen, 0)
        AstData.String(nlen) => return emit_value(l, IrOp.Bytes, info.type_info, node.pos, nlen, 0)
        AstData.Null => return emit_value(l, IrOp.Immediate, info.type_info, 0, 0, 0)
        AstData.ArrayLiteral(ar) => {
            var addr = emit_value(l, IrOp.StorageAlloc, info.type_info, 0, 0, 0)
            var elems = l.sem.elements.as_slice()
            var elem_t = elems[info.type_info.element_type]
            var children = l.tree.children.as_slice()
            for var i: u32 = 0; i < ar.count && !l.failed; i += 1 {
                var idx = emit_value(l, IrOp.Immediate, simple_type(TypeKind.I64), i, 0, 0)
                var dst = emit_value(l, IrOp.ElementAddress, info.type_info, addr, idx, 0)
                var val = lower_expression(l, children[ar.first + i])
                if uses_storage(elem_t) {
                    emit(l, IrInstruction { op: IrOp.StorageInit, type_info: elem_t, result: 0, a: dst, b: val, c: 0 })
                } else {
                    emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: elem_t, result: 0, a: dst, b: val, c: 0 })
                }
            }
            return addr
        }
        AstData.StructLiteral(sl) => {
            var addr = emit_value(l, IrOp.StorageAlloc, info.type_info, 0, 0, 0)
            emit(l, IrInstruction { op: IrOp.StorageInit, type_info: info.type_info, result: 0, a: addr, b: 0, c: 0 })
            var children = l.tree.children.as_slice()
            for var i: u32 = 0; i < sl.fields.count && !l.failed; i += 1 {
                var init_id = children[sl.fields.first + i]
                var init_val = NODE_NONE
                match nodes[init_id].data {
                    AstData.StructFieldInit(fi) => init_val = fi.value
                    else => {}
                }
                var init_info = lower_node(l, init_id)
                var ft = init_info.type_info
                var dst = emit_value(l, IrOp.FieldAddress, ft, addr, init_info.binding, 0)
                var val = lower_expression(l, init_val)
                if uses_storage(ft) {
                    emit(l, IrInstruction { op: IrOp.StorageInit, type_info: ft, result: 0, a: dst, b: val, c: 0 })
                } else {
                    emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: ft, result: 0, a: dst, b: val, c: 0 })
                }
            }
            return addr
        }
        AstData.Call(_) => return lower_call(l, id)
        AstData.Index(_) => {
            if info.is_const { return lower_const(l, info) }
            if info.is_fn_ref { return emit_value(l, IrOp.FnAddr, info.type_info, info.binding, 0, 0) }
            var addr = lower_memory_address(l, id)
            if uses_storage(info.type_info) { return addr }
            return emit_value(l, IrOp.MemoryLoad, info.type_info, addr, 0, 0)
        }
        AstData.Member(m) => {
            if info.is_const { return lower_const(l, info) }
            if info.is_fn_ref { return emit_value(l, IrOp.FnAddr, info.type_info, info.binding, 0, 0) }
            if info.is_enum_case {
                if info.type_info.kind == TypeKind.TaggedUnion {
                    var addr = emit_value(l, IrOp.StorageAlloc, info.type_info, 0, 0, 0)
                    emit(l, IrInstruction { op: IrOp.StorageInit, type_info: info.type_info, result: 0, a: addr, b: 0, c: 0 })
                    var tag = emit_value(l, IrOp.Immediate, simple_type(TypeKind.U32), info.binding, 0, 0)
                    emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: simple_type(TypeKind.U32), result: 0, a: addr, b: tag, c: 0 })
                    return addr
                }
                var evals = l.sem.enum_values.as_slice()
                var bits = evals[info.binding]
                return emit_value(l, IrOp.Immediate, info.type_info, bits as u32, (bits >> 32) as u32, 0)
            }
            if lower_node(l, m.base).type_info.kind == TypeKind.Any {
                var any_val = lower_expression(l, m.base)
                if info.binding == 0 {
                    return emit_value(l, IrOp.Data, info.type_info, any_val, 0, 0)
                }
                return emit_value(l, IrOp.Len, simple_type(TypeKind.Any), any_val, 0, 0)
            }
            var addr = lower_memory_address(l, id)
            if uses_storage(info.type_info) { return addr }
            return emit_value(l, IrOp.MemoryLoad, info.type_info, addr, 0, 0)
        }
        AstData.Slice(sl) => {
            var base = lower_expression(l, sl.base)
            var rstart = NODE_NONE
            var rend = NODE_NONE
            match nodes[sl.range].data {
                AstData.SliceRange(sr) => {
                    rstart = sr.start
                    rend = sr.end
                }
                else => {}
            }
            var start = lower_index(l, rstart)
            var end = lower_index(l, rend)
            var src_t = lower_node(l, sl.base).type_info
            if src_t.kind == TypeKind.Pointer {
                return emit_value(l, IrOp.PointerSlice, info.type_info, base, start, end)
            }
            return emit_value(l, IrOp.Slice, src_t, base, start, end)
        }
        AstData.OrElse(oeh) => {
            var r_addr = lower_expression(l, oeh.expr)
            var res_t = lower_node(l, oeh.expr).type_info
            var inner_t = info.type_info
            var ok_val = emit_value(l, IrOp.MemoryLoad, simple_type(TypeKind.Bool), r_addr, 0, 0)
            var ok_lbl = new_label(l)
            var err_lbl = new_label(l)
            var end_lbl = new_label(l)
            var out_slot: u32 = 0
            if inner_t.kind != TypeKind.Void {
                out_slot = l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count
                l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count += 1
            }
            emit_branch(l, ok_val, ok_lbl, err_lbl)
            emit_label(l, ok_lbl)
            if inner_t.kind != TypeKind.Void {
                var val_addr = emit_value(l, IrOp.FieldAddress, res_t, r_addr, res_t.length, 0)
                var v = val_addr
                if !uses_storage(inner_t) {
                    v = emit_value(l, IrOp.MemoryLoad, inner_t, val_addr, 0, 0)
                }
                emit_store(l, inner_t, out_slot, v)
            }
            emit_jump(l, end_lbl)
            emit_label(l, err_lbl)
            if oeh.is_block {
                if oeh.err_name.length > 0 {
                    var slice_t = simple_type(TypeKind.Slice)
                    var err_src = emit_value(l, IrOp.FieldAddress, res_t, r_addr, 8, 0)
                    var err_val = emit_value(l, IrOp.MemoryLoad, slice_t, err_src, 0, 0)
                    emit_store(l, slice_t, info.binding, err_val)
                }
                lower_statement(l, oeh.handler)
                if lower_node(l, oeh.handler).falls_through {
                    emit_jump(l, end_lbl)
                }
            } else {
                var fb = lower_expression(l, oeh.handler)
                if inner_t.kind != TypeKind.Void {
                    emit_store(l, inner_t, out_slot, fb)
                }
                emit_jump(l, end_lbl)
            }
            emit_label(l, end_lbl)
            if inner_t.kind != TypeKind.Void {
                return emit_value(l, IrOp.Load, inner_t, out_slot, 0, 0)
            }
            return 0
        }
        AstData.Cast(c) => {
            var val = lower_expression(l, c.expr)
            var src_t = lower_node(l, c.expr).type_info
            return emit_value(l, IrOp.Cast, info.type_info, val, src_t.kind as u32, 0)
        }
        AstData.Unary(un) => {
            var uop = un.op
            var op_id = un.operand
            if uop == UnaryOp.Dereference {
                if info.is_const { return lower_const(l, info) }
                if info.is_fn_ref { return emit_value(l, IrOp.FnAddr, info.type_info, info.binding, 0, 0) }
                var addr = lower_memory_address(l, id)
                if uses_storage(info.type_info) { return addr }
                return emit_value(l, IrOp.MemoryLoad, info.type_info, addr, 0, 0)
            }
            if uop == UnaryOp.AddressOf {
                var target = lower_node(l, op_id)
                if uses_storage(target.type_info) || target.is_const {
                    return lower_expression(l, op_id)
                }
                var is_ident = false
                match nodes[op_id].data {
                    AstData.Identifier(_) => is_ident = true
                    else => {}
                }
                if !is_ident {
                    return lower_memory_address(l, op_id)
                }
                return emit_value(l, IrOp.LocalAddress, target.type_info, target.binding, 0, 0)
            }
            if uop == UnaryOp.Try {
                var r_addr = lower_expression(l, op_id)
                var res_t = lower_node(l, op_id).type_info
                var inner_t = info.type_info
                var ok_val = emit_value(l, IrOp.MemoryLoad, simple_type(TypeKind.Bool), r_addr, 0, 0)
                var ok_lbl = new_label(l)
                var err_lbl = new_label(l)
                emit_branch(l, ok_val, ok_lbl, err_lbl)
                emit_label(l, err_lbl)
                var ret_t = l.sem.functions.data[l.current_fn].result
                var ret_slot = emit_value(l, IrOp.StorageAlloc, ret_t, 0, 0, 0)
                var bool_t = simple_type(TypeKind.Bool)
                var slice_t = simple_type(TypeKind.Slice)
                var ok_dst = emit_value(l, IrOp.FieldAddress, ret_t, ret_slot, 0, 0)
                var ok_false = emit_value(l, IrOp.Bool, bool_t, 0, 0, 0)
                emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: ok_dst, b: ok_false, c: 0 })
                var err_src = emit_value(l, IrOp.FieldAddress, res_t, r_addr, 8, 0)
                var err_val = emit_value(l, IrOp.MemoryLoad, slice_t, err_src, 0, 0)
                var err_dst = emit_value(l, IrOp.FieldAddress, ret_t, ret_slot, 8, 0)
                emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: slice_t, result: 0, a: err_dst, b: err_val, c: 0 })
                emit_defers(l, 0)
                emit(l, IrInstruction { op: IrOp.Return, type_info: empty_type(), result: 0, a: ret_slot, b: 0, c: 0 })
                emit_label(l, ok_lbl)
                if inner_t.kind == TypeKind.Void {
                    return 0
                }
                var val_addr = emit_value(l, IrOp.FieldAddress, res_t, r_addr, res_t.length, 0)
                if uses_storage(inner_t) {
                    return val_addr
                }
                return emit_value(l, IrOp.MemoryLoad, inner_t, val_addr, 0, 0)
            }
            if uop == UnaryOp.Positive {
                return lower_expression(l, op_id)
            }
            if uop == UnaryOp.Negate {
                var int_len: u32 = 0
                var is_int = false
                match nodes[op_id].data {
                    AstData.Integer(l) => {
                        is_int = true
                        int_len = l
                    }
                    else => {}
                }
                if is_int {
                    return emit_value(l, IrOp.Number, info.type_info, nodes[op_id].pos, int_len, 1)
                }
                var val = lower_expression(l, op_id)
                return emit_value(l, IrOp.Negate, info.type_info, val, 0, 0)
            }
            if uop == UnaryOp.LogicalNot {
                return emit_value(l, IrOp.LogicalNot, info.type_info, lower_expression(l, op_id), 0, 0)
            }
            if uop == UnaryOp.BitNot {
                return emit_value(l, IrOp.BitNot, info.type_info, lower_expression(l, op_id), 0, 0)
            }
            return 0
        }
        AstData.Binary(bin) => {
            var bop = bin.op
            var lhs_id = bin.left
            var rhs_id = bin.right
            if bop == BinaryOp.LogicalAnd || bop == BinaryOp.LogicalOr {
                return lower_logical(l, bop, lhs_id, rhs_id, info.type_info)
            }
            if (bop as u8) >= (BinaryOp.Assign as u8) && (bop as u8) <= (BinaryOp.AssignShiftRight as u8) {
                var lhs_is_ident = false
                var lhs_is_mem = false
                match nodes[lhs_id].data {
                    AstData.Identifier(_) => lhs_is_ident = true
                    AstData.Index(_) => lhs_is_mem = true
                    AstData.Member(_) => lhs_is_mem = true
                    AstData.Unary(un) => {
                        if un.op == UnaryOp.Dereference { lhs_is_mem = true }
                    }
                    else => {}
                }
                if bop == BinaryOp.Assign && lhs_is_ident && lower_node(l, lhs_id).binding == (~0 as u32) {
                    return lower_expression(l, rhs_id)
                }
                var target = lower_node(l, lhs_id).binding
                if lhs_is_mem {
                    target = lower_memory_address(l, lhs_id)
                }
                if uses_storage(info.type_info) {
                    var addr = target
                    if !lhs_is_mem {
                        addr = emit_value(l, IrOp.Load, info.type_info, target, 0, 0)
                    }
                    var src = lower_expression(l, rhs_id)
                    emit(l, IrInstruction { op: IrOp.StorageInit, type_info: info.type_info, result: 0, a: addr, b: src, c: 0 })
                    return addr
                }
                var cur: u32 = 0
                if bop != BinaryOp.Assign {
                    var load_op = IrOp.Load
                    if lhs_is_mem { load_op = IrOp.MemoryLoad }
                    cur = emit_value(l, load_op, info.type_info, target, 0, 0)
                }
                var val = lower_expression(l, rhs_id)
                if bop != BinaryOp.Assign {
                    val = emit_value(l, binary_ir_op(bop), info.type_info, cur, val, 0)
                }
                if lhs_is_mem {
                    emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: info.type_info, result: 0, a: target, b: val, c: 0 })
                } else {
                    emit_store(l, info.type_info, target, val)
                }
                return val
            }
            var left = lower_expression(l, lhs_id)
            var right = lower_expression(l, rhs_id)
            var linfo = lower_node(l, lhs_id)
            if (bop == BinaryOp.Equal || bop == BinaryOp.NotEqual) && info.method_call != 0 {
                var eq_res: u32 = 0
                if info.method_call == 2 {
                    eq_res = emit_call_2(l, simple_type(TypeKind.Bool), info.binding, left, right)
                } else {
                    var eq_t = linfo.type_info
                    if linfo.borrow_array {
                        eq_t = lower_node(l, rhs_id).type_info
                    }
                    eq_res = emit_eq_values(l, eq_t, left, right)
                }
                if bop == BinaryOp.NotEqual {
                    eq_res = emit_value(l, IrOp.LogicalNot, simple_type(TypeKind.Bool), eq_res, 0, 0)
                }
                return eq_res
            }
            var op_type = linfo.type_info
            if linfo.promotion != TypeKind.Invalid {
                op_type.kind = linfo.promotion
            }
            return emit_value(l, binary_ir_op(bop), op_type, left, right, 0)
        }
        else => return 0
    }
}

fun lower_expression(l: *Lowering, id: u32): u32 {
    var val = lower_unconverted(l, id)
    var info = lower_node(l, id)
    if info.borrow_array {
        val = emit_value(l, IrOp.ArrayView, info.type_info, val, 0, 0)
    }
    if info.promotion != TypeKind.Invalid {
        var dst = simple_type(info.promotion)
        if info.promotion == TypeKind.F64 && info.type_info.kind == TypeKind.F32 {
            val = emit_value(l, IrOp.FloatExtend, dst, val, 0, 0)
        } else {
            val = emit_value(l, IrOp.Cast, dst, val, info.type_info.kind as u32, 0)
        }
    }
    if info.box_any {
        var orig_t = info.type_info
        if info.borrow_array {
            orig_t.kind = TypeKind.Slice
        } else if info.promotion != TypeKind.Invalid {
            orig_t = simple_type(info.promotion)
        }
        var tag: u32 = orig_t.kind as u32
        if orig_t.kind == TypeKind.Slice || orig_t.kind == TypeKind.Array {
            tag |= (orig_t.element as u32) << 8
        } else if orig_t.kind == TypeKind.Pointer {
            tag |= (l.sem.pointees.data[orig_t.pointee].kind as u32) << 8
        }
        val = emit_value(l, IrOp.MakeAny, simple_type(TypeKind.Any), val, tag, 0)
    }
    if info.result_wrap == 1 {
        var inner_t = info.type_info
        if info.borrow_array {
            inner_t.kind = TypeKind.Slice
        } else if info.promotion != TypeKind.Invalid {
            inner_t = simple_type(info.promotion)
        }
        var res_t = make_result_type(l, inner_t)
        var slot_addr = emit_value(l, IrOp.StorageAlloc, res_t, 0, 0, 0)
        var bool_t = simple_type(TypeKind.Bool)
        var ok_addr = emit_value(l, IrOp.FieldAddress, res_t, slot_addr, 0, 0)
        var ok_val = emit_value(l, IrOp.Bool, bool_t, 1, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: ok_addr, b: ok_val, c: 0 })
        var val_addr = emit_value(l, IrOp.FieldAddress, res_t, slot_addr, res_t.length, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: inner_t, result: 0, a: val_addr, b: val, c: 0 })
        val = slot_addr
    } else if info.result_wrap == 2 {
        var res_t = info.type_info
        var slot_addr = emit_value(l, IrOp.StorageAlloc, res_t, 0, 0, 0)
        var bool_t = simple_type(TypeKind.Bool)
        var slice_t = simple_type(TypeKind.Slice)
        var ok_addr = emit_value(l, IrOp.FieldAddress, res_t, slot_addr, 0, 0)
        var ok_val = emit_value(l, IrOp.Bool, bool_t, 0, 0, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: ok_addr, b: ok_val, c: 0 })
        var err_addr = emit_value(l, IrOp.FieldAddress, res_t, slot_addr, 8, 0)
        emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: slice_t, result: 0, a: err_addr, b: val, c: 0 })
        val = slot_addr
    }
    return val
}

fun lower_if(l: *Lowering, id: u32) {
    var nodes = l.tree.nodes.as_slice()
    var arms = AstIf { condition: NODE_NONE, then_branch: NODE_NONE, else_branch: NODE_NONE }
    match nodes[id].data {
        AstData.If(ifn) => arms = ifn
        else => return
    }
    var cond = lower_expression(l, arms.condition)
    var yes = new_label(l)
    var no = new_label(l)
    var falls = lower_node(l, id).falls_through
    var end = no
    if arms.else_branch != NODE_NONE && falls {
        end = new_label(l)
    }
    emit_branch(l, cond, yes, no)
    emit_label(l, yes)
    lower_statement(l, arms.then_branch)
    if lower_node(l, arms.then_branch).falls_through {
        emit_jump(l, end)
    }
    if arms.else_branch != NODE_NONE {
        emit_label(l, no)
        lower_statement(l, arms.else_branch)
        if lower_node(l, arms.else_branch).falls_through {
            emit_jump(l, end)
        }
    }
    if falls {
        emit_label(l, end)
    }
}

fun lower_match(l: *Lowering, id: u32) {
    var nodes = l.tree.nodes.as_slice()
    var children = l.tree.children.as_slice()
    var mr = NodeRange { first: 0, count: 0 }
    match nodes[id].data {
        AstData.Match(r) => mr = r
        else => return
    }
    var scrut_id = children[mr.first]
    var scrut = lower_expression(l, scrut_id)
    var st = lower_node(l, scrut_id).type_info
    var cmp_t = st
    var cmp_val = scrut
    if st.kind == TypeKind.TaggedUnion {
        cmp_t = simple_type(TypeKind.U32)
        cmp_val = emit_value(l, IrOp.MemoryLoad, cmp_t, scrut, 0, 0)
    }
    var end_lbl = new_label(l)
    var arm_count = mr.count - 1
    var mvals = l.sem.match_values.as_slice()

    for var i: u32 = 0; i < arm_count && !l.failed; i += 1 {
        var arm_id = children[mr.first + 1 + i]
        var ar = NodeRange { first: 0, count: 0 }
        match nodes[arm_id].data {
            AstData.MatchArm(r) => ar = r
            else => {}
        }
        var body = children[ar.first + ar.count - 1]
        if ar.count == 1 {
            lower_statement(l, body)
            if lower_node(l, body).falls_through {
                emit_jump(l, end_lbl)
            }
            break
        }
        var arm_body = new_label(l)
        var is_last = i == arm_count - 1
        var next_arm: u32 = 0
        if !is_last { next_arm = new_label(l) }
        if is_last {
            emit_jump(l, arm_body)
        } else {
            for var p: u32 = 0; p < ar.count - 1 && !l.failed; p += 1 {
                var pat = children[ar.first + p]
                var bits = mvals[lower_node(l, pat).binding]
                var op = IrOp.Immediate
                if cmp_t.kind == TypeKind.Bool { op = IrOp.Bool }
                var pval = emit_value(l, op, cmp_t, bits as u32, (bits >> 32) as u32, 0)
                var cmp = emit_value(l, IrOp.Equal, cmp_t, cmp_val, pval, 0)
                var last_pat = p + 1 == ar.count - 1
                var next_pat = next_arm
                if !last_pat { next_pat = new_label(l) }
                emit_branch(l, cmp, arm_body, next_pat)
                if !last_pat {
                    emit_label(l, next_pat)
                }
            }
        }
        emit_label(l, arm_body)
        if st.kind == TypeKind.TaggedUnion && ar.count == 2 {
            var pat = children[ar.first]
            var pcr = NodeRange { first: 0, count: 0 }
            var pat_is_call = false
            match nodes[pat].data {
                AstData.Call(r) => {
                    pat_is_call = true
                    pcr = r
                }
                else => {}
            }
            if pat_is_call {
                var v_idx = mvals[lower_node(l, pat).binding] as u32
                var uv = &l.sem.unions.data[st.record].variants.data[v_idx]
                for var bi: u32 = 0; bi < pcr.count - 1 && !l.failed; bi += 1 {
                    var arg_id = children[pcr.first + 1 + bi]
                    var binfo = lower_node(l, arg_id)
                    if binfo.binding != (~0 as u32) {
                        var fsn = uv.fields.data[bi]
                        var faddr = emit_value(l, IrOp.FieldAddress, simple_type(TypeKind.Pointer), scrut, fsn.binding, 0)
                        if uses_storage(fsn.type_info) {
                            var local_addr = emit_value(l, IrOp.StorageAlloc, fsn.type_info, 0, 0, 0)
                            emit(l, IrInstruction { op: IrOp.StorageInit, type_info: fsn.type_info, result: 0, a: local_addr, b: faddr, c: 0 })
                            emit_store(l, fsn.type_info, binfo.binding, local_addr)
                        } else {
                            var fval = emit_value(l, IrOp.MemoryLoad, fsn.type_info, faddr, 0, 0)
                            emit_store(l, fsn.type_info, binfo.binding, fval)
                        }
                    }
                }
            }
        }
        lower_statement(l, body)
        if lower_node(l, body).falls_through {
            emit_jump(l, end_lbl)
        }
        if !is_last {
            emit_label(l, next_arm)
        }
    }
    if lower_node(l, id).falls_through {
        emit_label(l, end_lbl)
    }
}

fun lower_loop(l: *Lowering, id: u32) {
    var nodes = l.tree.nodes.as_slice()
    var header = AstForHeader { initializer: NODE_NONE, condition: NODE_NONE, step: NODE_NONE, body: NODE_NONE, label: Span { offset: 0, length: 0 } }
    match nodes[id].data {
        AstData.For(h) => header = h
        else => return
    }
    if header.initializer != NODE_NONE {
        lower_statement(l, header.initializer)
    }
    var start = new_label(l)
    emit_jump(l, start)
    emit_label(l, start)
    var end = new_label(l)
    var cont = start
    if header.step != NODE_NONE {
        cont = new_label(l)
    }
    if header.condition != NODE_NONE {
        var cond = lower_expression(l, header.condition)
        var body = new_label(l)
        emit_branch(l, cond, body, end)
        emit_label(l, body)
    }
    var le = IrLoop { break_label: end, continue_label: cont, defer_base: l.defers.len }
    l.loops.push(&le)
    lower_statement(l, header.body)
    l.loops.pop(null)
    if header.step != NODE_NONE {
        emit_label(l, cont)
        lower_expression(l, header.step)
        emit_jump(l, start)
    } else if lower_node(l, header.body).falls_through {
        emit_jump(l, start)
    }
    if header.condition != NODE_NONE || lower_node(l, id).falls_through {
        emit_label(l, end)
    }
}

fun lower_for_in(l: *Lowering, id: u32) {
    var nodes = l.tree.nodes.as_slice()
    var info = lower_node(l, id)
    var item_t = info.type_info
    var item_slot = info.binding
    var h = AstForInHeader { index_name: Span { offset: 0, length: 0 }, item_name: Span { offset: 0, length: 0 }, iterable: NODE_NONE, range_end: NODE_NONE, body: NODE_NONE, label: Span { offset: 0, length: 0 } }
    match nodes[id].data {
        AstData.ForIn(hdr) => h = hdr
        else => return
    }

    var start = new_label(l)
    var body = new_label(l)
    var cont = new_label(l)
    var end = new_label(l)

    var i64_t = simple_type(TypeKind.I64)

    if h.range_end != NODE_NONE {
        var start_val = lower_expression(l, h.iterable)
        var end_val = lower_expression(l, h.range_end)
        emit_store(l, item_t, item_slot, start_val)
        var end_slot = l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count
        l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count += 1
        emit_store(l, item_t, end_slot, end_val)
        if h.index_name.length > 0 {
            var zero = emit_value(l, IrOp.Immediate, i64_t, 0, 0, 0)
            emit_store(l, i64_t, item_slot - 1, zero)
        }
        emit_jump(l, start)
        emit_label(l, start)
        var cur = emit_value(l, IrOp.Load, item_t, item_slot, 0, 0)
        var end_v = emit_value(l, IrOp.Load, item_t, end_slot, 0, 0)
        var cond = emit_value(l, IrOp.Less, item_t, cur, end_v, 0)
        emit_branch(l, cond, body, end)
        emit_label(l, body)
        var le = IrLoop { break_label: end, continue_label: cont, defer_base: l.defers.len }
        l.loops.push(&le)
        lower_statement(l, h.body)
        l.loops.pop(null)
        emit_label(l, cont)
        var cur2 = emit_value(l, IrOp.Load, item_t, item_slot, 0, 0)
        var one = emit_value(l, IrOp.Immediate, item_t, 1, 0, 0)
        var next = emit_value(l, IrOp.Add, item_t, cur2, one, 0)
        emit_store(l, item_t, item_slot, next)
        if h.index_name.length > 0 {
            var cidx = emit_value(l, IrOp.Load, i64_t, item_slot - 1, 0, 0)
            var ione = emit_value(l, IrOp.Immediate, i64_t, 1, 0, 0)
            var nidx = emit_value(l, IrOp.Add, i64_t, cidx, ione, 0)
            emit_store(l, i64_t, item_slot - 1, nidx)
        }
        emit_jump(l, start)
        emit_label(l, end)
        return
    }

    var iter_t = lower_node(l, h.iterable).type_info
    var iter_val = lower_expression(l, h.iterable)
    var base_ptr: u32 = 0
    var len_val: u32 = 0
    if iter_t.kind == TypeKind.Array {
        base_ptr = iter_val
        len_val = emit_value(l, IrOp.Immediate, i64_t, iter_t.length, 0, 0)
    } else {
        base_ptr = emit_value(l, IrOp.Data, iter_t, iter_val, 0, 0)
        len_val = emit_value(l, IrOp.Len, iter_t, iter_val, 0, 0)
    }
    var ptr_t = simple_type(TypeKind.U64)
    var base_slot = l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count
    l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count += 1
    var len_slot = l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count
    l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count += 1
    var idx_slot: u32 = 0
    if h.index_name.length > 0 {
        idx_slot = item_slot - 1
    } else {
        idx_slot = l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count
        l.mod.functions.data[l.mod.functions.len as i64 - 1].slot_count += 1
    }
    emit_store(l, ptr_t, base_slot, base_ptr)
    emit_store(l, i64_t, len_slot, len_val)
    var zero = emit_value(l, IrOp.Immediate, i64_t, 0, 0, 0)
    emit_store(l, i64_t, idx_slot, zero)

    emit_jump(l, start)
    emit_label(l, start)
    var cur_idx = emit_value(l, IrOp.Load, i64_t, idx_slot, 0, 0)
    var max_len = emit_value(l, IrOp.Load, i64_t, len_slot, 0, 0)
    var cond = emit_value(l, IrOp.Less, i64_t, cur_idx, max_len, 0)
    emit_branch(l, cond, body, end)
    emit_label(l, body)
    var bp = emit_value(l, IrOp.Load, ptr_t, base_slot, 0, 0)
    var elem_addr = emit_value(l, IrOp.PointerIndex, item_t, bp, cur_idx, 0)
    if uses_storage(item_t) {
        emit_store(l, item_t, item_slot, elem_addr)
    } else {
        var elem_val = emit_value(l, IrOp.MemoryLoad, item_t, elem_addr, 0, 0)
        emit_store(l, item_t, item_slot, elem_val)
    }
    var le = IrLoop { break_label: end, continue_label: cont, defer_base: l.defers.len }
    l.loops.push(&le)
    lower_statement(l, h.body)
    l.loops.pop(null)
    emit_label(l, cont)
    var cidx = emit_value(l, IrOp.Load, i64_t, idx_slot, 0, 0)
    var ione = emit_value(l, IrOp.Immediate, i64_t, 1, 0, 0)
    var nidx = emit_value(l, IrOp.Add, i64_t, cidx, ione, 0)
    emit_store(l, i64_t, idx_slot, nidx)
    emit_jump(l, start)
    emit_label(l, end)
}

fun emit_defers(l: *Lowering, base: u64) {
    var i = l.defers.len
    for i > base && !l.failed {
        i -= 1
        var top = l.defers.len
        lower_statement(l, l.defers.data[i])
        if l.defers.len > top {
            emit_defers(l, top)
            l.defers.len = top
        }
    }
}

fun emit_ok_void_result(l: *Lowering, ret_t: SemaType): u32 {
    var slot_addr = emit_value(l, IrOp.StorageAlloc, ret_t, 0, 0, 0)
    var bool_t = simple_type(TypeKind.Bool)
    var ok_addr = emit_value(l, IrOp.FieldAddress, ret_t, slot_addr, 0, 0)
    var ok_val = emit_value(l, IrOp.Bool, bool_t, 1, 0, 0)
    emit(l, IrInstruction { op: IrOp.MemoryStore, type_info: bool_t, result: 0, a: ok_addr, b: ok_val, c: 0 })
    return slot_addr
}

fun lower_statement(l: *Lowering, id: u32) {
    if l.failed || id == NODE_NONE { return }
    var nodes = l.tree.nodes.as_slice()
    var node = nodes[id]
    var children = l.tree.children.as_slice()
    match node.data {
        AstData.Block(br) => {
            var defer_base = l.defers.len
            var fell = true
            for var i: u32 = 0; i < br.count && !l.failed; i += 1 {
                var ch = children[br.first + i]
                lower_statement(l, ch)
                if !lower_node(l, ch).falls_through {
                    fell = false
                    break
                }
            }
            if fell {
                emit_defers(l, defer_base)
            }
            l.defers.len = defer_base
        }
        AstData.Defer(stmt_id) => l.defers.push_value(stmt_id)
        AstData.Return(val_id) => {
            var val: u32 = 0
            if val_id != NODE_NONE {
                val = lower_expression(l, val_id)
            } else if l.current_fn < (l.sem.functions.len as u32) {
                var ret_t = l.sem.functions.data[l.current_fn].result
                if ret_t.kind == TypeKind.Result {
                    val = emit_ok_void_result(l, ret_t)
                }
            }
            emit_defers(l, 0)
            emit(l, IrInstruction { op: IrOp.Return, type_info: empty_type(), result: 0, a: val, b: 0, c: 0 })
        }
        AstData.If(_) => lower_if(l, id)
        AstData.MatchType(mr) => {
            var matched_arm = lower_node(l, id).binding
            var arm_id = children[mr.first + matched_arm]
            var ar = NodeRange { first: 0, count: 0 }
            match nodes[arm_id].data {
                AstData.MatchArm(r) => ar = r
                else => {}
            }
            var body = children[ar.first + ar.count - 1]
            lower_statement(l, body)
        }
        AstData.Match(_) => lower_match(l, id)
        AstData.For(_) => lower_loop(l, id)
        AstData.ForIn(_) => lower_for_in(l, id)
        AstData.Break(_) => {
            var loops = l.loops.as_slice()
            var target = loops[lower_node(l, id).binding]
            emit_defers(l, target.defer_base)
            emit_jump(l, target.break_label)
        }
        AstData.Continue(_) => {
            var loops = l.loops.as_slice()
            var target = loops[lower_node(l, id).binding]
            emit_defers(l, target.defer_base)
            emit_jump(l, target.continue_label)
        }
        AstData.Const(_) => return
        AstData.Var(v) => {
            var info = lower_node(l, id)
            var init_id = v.initializer
            if info.binding == (~0 as u32) {
                if init_id != NODE_NONE {
                    lower_expression(l, init_id)
                }
                return
            }
            if uses_storage(info.type_info) {
                var addr = emit_value(l, IrOp.StorageAlloc, info.type_info, 0, 0, 0)
                var src: u32 = 0
                if init_id != NODE_NONE {
                    src = lower_expression(l, init_id)
                }
                emit(l, IrInstruction { op: IrOp.StorageInit, type_info: info.type_info, result: 0, a: addr, b: src, c: 0 })
                emit_store(l, info.type_info, info.binding, addr)
            } else {
                var val: u32 = 0
                if init_id != NODE_NONE {
                    val = lower_expression(l, init_id)
                } else {
                    var op = IrOp.Immediate
                    if info.type_info.kind == TypeKind.Bool { op = IrOp.Bool }
                    val = emit_value(l, op, info.type_info, 0, 0, 0)
                }
                emit_store(l, info.type_info, info.binding, val)
            }
        }
        else => {
            lower_expression(l, id)
        }
    }
}

pub fun lower(arena: *mem.Arena, tree: *Ast, sem: *Sema, out: *IrModule): bool {
    out.source = tree.source
    out.module_count = tree.modules.len as u32
    out.pointees = sem.pointees
    out.elements = sem.elements
    out.func_types = sem.func_types
    if out.struct_names.init(arena, sem.records.len + 1) < 0 { return false }
    if out.functions.init(arena, sem.functions.len + 1) < 0 { return false }
    if out.parameters.init(arena, 32) < 0 { return false }
    if out.instructions.init(arena, 256) < 0 { return false }
    if out.arguments.init(arena, 64) < 0 { return false }

    var structs = tree.structs.as_slice()
    var recs = sem.records.as_slice()
    for rec in recs {
        var sp = structs[rec.declaration].name
        out.struct_names.push(&sp)
    }

    var l: Lowering
    l.tree = tree
    l.sem = sem
    l.mod = out
    l.current_fn = ~0 as u32
    l.failed = false
    l.loops.init(arena, 16)
    l.defers.init(arena, 16)

    var ast_fns = tree.functions.as_slice()
    var sema_fns = sem.functions.as_slice()
    for i, sf in sema_fns {
        if l.failed { break }
        var fdecl = ast_fns[sf.declaration]
        var is_template = fdecl.type_parameters.count > 0 && sf.arguments.len == 0
        var is_spec = fdecl.type_parameters.count > 0 && sf.arguments.len > 0
        var first_param = out.parameters.len as u32
        var ptypes = sf.param_types.as_slice()
        for pt in ptypes {
            var pt_copy = pt
            out.parameters.push(&pt_copy)
        }
        var irf = IrFunction {
            name: fdecl.name,
            result: sf.result,
            first_parameter: first_param,
            parameter_count: sf.param_types.len as u32,
            first_instruction: out.instructions.len as u32,
            instruction_count: 0,
            slot_count: sf.slot_count,
            module: fdecl.module,
            external: fdecl.body == NODE_NONE,
            template_only: is_template,
            specialization: is_spec,
        }
        out.functions.push(&irf)
        if !is_template && fdecl.body != NODE_NONE {
            l.current_fn = i as u32
            l.next_value = 1
            l.next_label = 0
            l.loops.len = 0
            var entry = new_label(&l)
            emit_label(&l, entry)
            lower_statement(&l, fdecl.body)
            if lower_node(&l, fdecl.body).falls_through {
                var val: u32 = 0
                if sf.result.kind == TypeKind.Result {
                    val = emit_ok_void_result(&l, sf.result)
                }
                emit(&l, IrInstruction { op: IrOp.Return, type_info: empty_type(), result: 0, a: val, b: 0, c: 0 })
            }
            var fn_ptr = out.functions.data
            fn_ptr[i].instruction_count = (out.instructions.len as u32) - fn_ptr[i].first_instruction
        }
    }
    return !l.failed
}

fun type_kind_name(k: TypeKind): []u8 {
    match k {
        TypeKind.Void => return "void"
        TypeKind.Bool => return "bool"
        TypeKind.I8 => return "i8"
        TypeKind.I16 => return "i16"
        TypeKind.I32 => return "i32"
        TypeKind.I64 => return "i64"
        TypeKind.U8 => return "u8"
        TypeKind.U16 => return "u16"
        TypeKind.U32 => return "u32"
        TypeKind.U64 => return "u64"
        TypeKind.F32 => return "f32"
        TypeKind.F64 => return "f64"
        TypeKind.Struct => return "struct"
        TypeKind.Array => return "array"
        TypeKind.Slice => return "slice"
        TypeKind.Pointer => return "pointer"
        else => return "invalid"
    }
}

fun write_span(m: *IrModule, s: Span) {
    io.write_bytes(1, m.source[(s.offset as i64)..((s.offset + s.length) as i64)])
}

fun write_type(m: *IrModule, t_in: SemaType) {
    var t = t_in
    var pts = m.pointees.as_slice()
    var elems = m.elements.as_slice()
    for {
        if t.kind == TypeKind.Pointer {
            io.print("*")
            if t.read_only { io.print("const ") }
            t = pts[t.pointee]
        } else if t.kind == TypeKind.Array || t.kind == TypeKind.Slice {
            if t.kind == TypeKind.Array {
                io.print("[")
                fmt.print_u64(1, t.length as u64)
                io.print("]")
            } else {
                io.print("[]")
            }
            t = elems[t.element_type]
        } else {
            break
        }
    }
    if t.kind == TypeKind.Struct {
        var names = m.struct_names.as_slice()
        write_span(m, names[t.record])
    } else {
        io.print(type_kind_name(t.kind))
    }
}

fun op_name(op: IrOp): []u8 {
    match op {
        IrOp.Negate => return "neg"
        IrOp.LogicalNot => return "not"
        IrOp.BitNot => return "bit_not"
        IrOp.Add => return "add"
        IrOp.Subtract => return "sub"
        IrOp.Multiply => return "mul"
        IrOp.Divide => return "div"
        IrOp.Remainder => return "rem"
        IrOp.Equal => return "eq"
        IrOp.NotEqual => return "ne"
        IrOp.Less => return "lt"
        IrOp.LessEqual => return "le"
        IrOp.Greater => return "gt"
        IrOp.GreaterEqual => return "ge"
        IrOp.BitAnd => return "bit_and"
        IrOp.BitOr => return "bit_or"
        IrOp.BitXor => return "bit_xor"
        IrOp.ShiftLeft => return "shl"
        else => return "shr"
    }
}

fun write_val(v: u32) {
    io.print("%")
    fmt.print_u64(1, v as u64)
}

fun write_lbl(l: u32) {
    io.print("b")
    fmt.print_u64(1, l as u64)
}

fun write_inst(m: *IrModule, inst: IrInstruction) {
    if inst.op == IrOp.Label {
        write_lbl(inst.a)
        io.println(":")
        return
    }
    io.print("    ")
    if inst.result != 0 {
        write_val(inst.result)
        io.print(" = ")
    }
    if inst.op == IrOp.Number || inst.op == IrOp.Bool || inst.op == IrOp.Bytes || inst.op == IrOp.Immediate {
        io.print("const.")
        write_type(m, inst.type_info)
        io.print(" ")
        if inst.op == IrOp.Number {
            if inst.c != 0 { io.print("-") }
            write_span(m, Span { offset: inst.a, length: inst.b })
        } else if inst.op == IrOp.Bytes {
            write_span(m, Span { offset: inst.a, length: inst.b })
        } else if inst.type_info.kind == TypeKind.Bool {
            if inst.a != 0 { io.print("true") } else { io.print("false") }
        } else {
            var bits = ((inst.b as u64) << 32) | (inst.a as u64)
            if is_signed(inst.type_info.kind) {
                fmt.print_i64(1, bits as i64)
            } else {
                fmt.print_u64(1, bits)
            }
        }
    } else if inst.op == IrOp.Load || inst.op == IrOp.Store {
        if inst.op == IrOp.Load { io.print("load.") } else { io.print("store.") }
        write_type(m, inst.type_info)
        io.print(" $")
        fmt.print_u64(1, inst.a as u64)
        if inst.op == IrOp.Store {
            io.print(", ")
            write_val(inst.b)
        }
    } else if inst.op == IrOp.LocalAddress {
        io.print("local_address.")
        write_type(m, inst.type_info)
        io.print(" $")
        fmt.print_u64(1, inst.a as u64)
    } else if inst.op == IrOp.StorageAlloc {
        io.print("alloc.")
        write_type(m, inst.type_info)
    } else if inst.op == IrOp.StorageInit {
        io.print("init.")
        write_type(m, inst.type_info)
        io.print(" ")
        write_val(inst.a)
        io.print(", ")
        if inst.b != 0 { write_val(inst.b) } else { io.print("0") }
    } else if inst.op == IrOp.Len || inst.op == IrOp.Data || inst.op == IrOp.WidenIndex || inst.op == IrOp.ArrayView || inst.op == IrOp.MemoryLoad {
        if inst.op == IrOp.Len { io.print("len.") }
        else if inst.op == IrOp.Data { io.print("data.") }
        else if inst.op == IrOp.WidenIndex { io.print("widen_index.") }
        else if inst.op == IrOp.ArrayView { io.print("array_view.") }
        else { io.print("load_memory.") }
        write_type(m, inst.type_info)
        io.print(" ")
        write_val(inst.a)
    } else if inst.op == IrOp.Cast {
        io.print("cast.")
        write_type(m, inst.type_info)
        io.print(" ")
        io.print(type_kind_name(inst.b as TypeKind))
        io.print(" ")
        write_val(inst.a)
    } else if inst.op == IrOp.FloatExtend {
        io.print("extend.f64 ")
        write_val(inst.a)
    } else if inst.op == IrOp.FieldAddress {
        io.print("field_address.")
        write_type(m, inst.type_info)
        io.print(" ")
        write_val(inst.a)
        io.print(", ")
        fmt.print_u64(1, inst.b as u64)
    } else if inst.op == IrOp.ElementAddress || inst.op == IrOp.PointerIndex || inst.op == IrOp.MemoryStore || inst.op == IrOp.Slice || inst.op == IrOp.PointerSlice {
        if inst.op == IrOp.Slice { io.print("slice.") }
        else if inst.op == IrOp.PointerSlice { io.print("pointer_slice.") }
        else if inst.op == IrOp.ElementAddress { io.print("element_address.") }
        else if inst.op == IrOp.PointerIndex { io.print("pointer_index.") }
        else { io.print("store_memory.") }
        write_type(m, inst.type_info)
        io.print(" ")
        write_val(inst.a)
        io.print(", ")
        write_val(inst.b)
        if inst.op == IrOp.Slice || inst.op == IrOp.PointerSlice {
            io.print(", ")
            write_val(inst.c)
        }
    } else if inst.op == IrOp.Call {
        var fns = m.functions.as_slice()
        var args = m.arguments.as_slice()
        io.print("call.")
        write_type(m, inst.type_info)
        io.print(" @")
        write_span(m, fns[inst.a].name)
        io.print("(")
        for var i: u32 = 0; i < inst.c; i += 1 {
            if i > 0 { io.print(", ") }
            write_val(args[inst.b + i])
        }
        io.print(")")
    } else if inst.op == IrOp.Jump {
        io.print("jump ")
        write_lbl(inst.a)
    } else if inst.op == IrOp.Branch {
        io.print("branch ")
        write_val(inst.a)
        io.print(", ")
        write_lbl(inst.b)
        io.print(", ")
        write_lbl(inst.c)
    } else if inst.op == IrOp.Return {
        io.print("return")
        if inst.a != 0 {
            io.print(" ")
            write_val(inst.a)
        }
    } else {
        io.print(op_name(inst.op))
        io.print(".")
        write_type(m, inst.type_info)
        io.print(" ")
        write_val(inst.a)
        if inst.b != 0 {
            io.print(", ")
            write_val(inst.b)
        }
    }
    io.println("")
}

pub fun write(m: *IrModule) {
    var fns = m.functions.as_slice()
    var params = m.parameters.as_slice()
    var insts = m.instructions.as_slice()
    for i, fn in fns {
        if fn.template_only { continue }
        if i > 0 { io.println("") }
        if fn.external { io.print("ext fun @") } else { io.print("fun @") }
        write_span(m, fn.name)
        io.print("(")
        for var p: u32 = 0; p < fn.parameter_count; p += 1 {
            if p > 0 { io.print(", ") }
            if !fn.external {
                io.print("$")
                fmt.print_u64(1, p as u64)
                io.print(": ")
            }
            write_type(m, params[fn.first_parameter + p])
        }
        io.print("): ")
        write_type(m, fn.result)
        if fn.external {
            io.println("")
            continue
        }
        io.print(" [slots ")
        fmt.print_u64(1, fn.slot_count as u64)
        io.println("] {")
        for var j: u32 = 0; j < fn.instruction_count; j += 1 {
            write_inst(m, insts[fn.first_instruction + j])
        }
        io.println("}")
    }
}
