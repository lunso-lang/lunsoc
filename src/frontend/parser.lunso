import std.mem
import std.collections.Vec
import frontend.ast
import frontend.lexer

const PREC_ASSIGNMENT: u32 = 1
const PREC_OR: u32 = 2
const PREC_LOGICAL_OR: u32 = 3
const PREC_LOGICAL_AND: u32 = 4
const PREC_BIT_OR: u32 = 5
const PREC_BIT_XOR: u32 = 6
const PREC_BIT_AND: u32 = 7
const PREC_EQUALITY: u32 = 8
const PREC_COMPARISON: u32 = 9
const PREC_SHIFT: u32 = 10
const PREC_SUM: u32 = 11
const PREC_PRODUCT: u32 = 12
const PREC_CAST: u32 = 13
const PREC_PREFIX: u32 = 14
const MAX_RECURSION_DEPTH: u32 = 256

pub struct ParseError {
    token: lexer.Token
    message: []u8
}

struct Parser {
    lex: lexer.Lexer
    current: lexer.Token
    error: ParseError
    has_error: bool
    tree: *ast.Ast
    pending: Vec[u32]
    source_base: u32
    module: u32
    group_depth: u32
    recursion_depth: u32
    disallow_struct_literal: bool
}

fun fail(p: *Parser, msg: []u8) {
    if !p.has_error {
        p.has_error = true
        var lex_err = lexer.error_message(p.current.kind)
        if len(lex_err) > 0 {
            p.error = ParseError { token: p.current, message: lex_err }
        } else {
            p.error = ParseError { token: p.current, message: msg }
        }
    }
}

fun read_token(l: *lexer.Lexer, in_group: bool): lexer.Token {
    for {
        var tok = lexer.next_token(l)
        if tok.kind == lexer.TokenKind.Comment {
            if !in_group && l.line != tok.line {
                for l.source[tok.offset] != '\r' && l.source[tok.offset] != '\n' {
                    tok.offset += 1
                    tok.column += 1
                }
                tok.kind = lexer.TokenKind.Newline
                if l.source[tok.offset] == '\r' &&
                   tok.offset + 1 < (len(l.source) as u64) &&
                   l.source[tok.offset + 1] == '\n' {
                    tok.length = 2
                } else {
                    tok.length = 1
                }
                return tok
            }
            continue
        }
        if tok.kind != lexer.TokenKind.Newline || !in_group {
            return tok
        }
    }
}

fun advance(p: *Parser) {
    p.current = read_token(&p.lex, p.group_depth != 0)
}

fun match_tok(p: *Parser, kind: lexer.TokenKind): bool {
    if p.has_error || p.current.kind != kind {
        return false
    }
    advance(p)
    return true
}

fun expect_tok(p: *Parser, kind: lexer.TokenKind, msg: []u8): lexer.Token {
    var tok = p.current
    if !match_tok(p, kind) {
        fail(p, msg)
    }
    return tok
}

fun enter(p: *Parser): bool {
    if p.has_error {
        return false
    }
    if p.recursion_depth >= MAX_RECURSION_DEPTH {
        fail(p, "syntax nesting limit exceeded")
        return false
    }
    p.recursion_depth += 1
    return true
}

fun add_node(p: *Parser, kind: ast.AstKind, tok: lexer.Token, a: u32, b: u32): u32 {
    if p.has_error {
        return ast.NODE_NONE
    }
    var id = ast.add_node(p.tree, kind, p.source_base + (tok.offset as u32), a, b)
    if id == ast.NODE_NONE {
        fail(p, "could not allocate AST storage")
    }
    return id
}

fun push_child(p: *Parser, child: u32) {
    if !p.has_error {
        if p.pending.push_value(child) < 0 {
            fail(p, "could not allocate AST storage")
        }
    }
}

fun finish_children(p: *Parser, mark: u64): ast.NodeRange {
    if p.has_error {
        p.pending.len = mark
        return ast.NodeRange { first: 0, count: 0 }
    }
    var before = p.pending.len
    var range = ast.finish_children(p.tree, &p.pending, mark)
    if before > mark && range.count == 0 {
        fail(p, "could not allocate AST storage")
    }
    return range
}

fun is_separator(kind: lexer.TokenKind): bool {
    return kind == lexer.TokenKind.Newline || kind == lexer.TokenKind.Semicolon
}

fun finish_item(p: *Parser, end_kind: lexer.TokenKind, msg: []u8) {
    if len(msg) > 0 && !p.has_error && p.current.kind != end_kind && !is_separator(p.current.kind) {
        fail(p, msg)
    }
    for !p.has_error && is_separator(p.current.kind) {
        advance(p)
    }
}

fun open_group(p: *Parser) {
    p.group_depth += 1
    advance(p)
}

fun close_group(p: *Parser, kind: lexer.TokenKind, msg: []u8) {
    p.group_depth -= 1
    expect_tok(p, kind, msg)
}

fun source_span(p: *Parser, tok: lexer.Token): ast.Span {
    return ast.Span { offset: p.source_base + (tok.offset as u32), length: tok.length as u32 }
}

fun infix_prec(kind: lexer.TokenKind): u32 {
    match kind {
        lexer.TokenKind.Equal, lexer.TokenKind.PlusEqual, lexer.TokenKind.MinusEqual, lexer.TokenKind.StarEqual, lexer.TokenKind.SlashEqual, lexer.TokenKind.PercentEqual, lexer.TokenKind.AmpersandEqual, lexer.TokenKind.PipeEqual, lexer.TokenKind.CaretEqual, lexer.TokenKind.ShiftLeftEqual, lexer.TokenKind.ShiftRightEqual => return PREC_ASSIGNMENT
        lexer.TokenKind.PipePipe => return PREC_LOGICAL_OR
        lexer.TokenKind.AmpersandAmpersand => return PREC_LOGICAL_AND
        lexer.TokenKind.Pipe => return PREC_BIT_OR
        lexer.TokenKind.Caret => return PREC_BIT_XOR
        lexer.TokenKind.Ampersand => return PREC_BIT_AND
        lexer.TokenKind.EqualEqual, lexer.TokenKind.BangEqual => return PREC_EQUALITY
        lexer.TokenKind.Less, lexer.TokenKind.LessEqual, lexer.TokenKind.Greater, lexer.TokenKind.GreaterEqual => return PREC_COMPARISON
        lexer.TokenKind.ShiftLeft, lexer.TokenKind.ShiftRight => return PREC_SHIFT
        lexer.TokenKind.Plus, lexer.TokenKind.Minus => return PREC_SUM
        lexer.TokenKind.Star, lexer.TokenKind.Slash, lexer.TokenKind.Percent => return PREC_PRODUCT
        else => return 0
    }
}

fun infix_kind(kind: lexer.TokenKind): ast.AstKind {
    match kind {
        lexer.TokenKind.Equal => return ast.AstKind.Assign
        lexer.TokenKind.PlusEqual => return ast.AstKind.AssignAdd
        lexer.TokenKind.MinusEqual => return ast.AstKind.AssignSubtract
        lexer.TokenKind.StarEqual => return ast.AstKind.AssignMultiply
        lexer.TokenKind.SlashEqual => return ast.AstKind.AssignDivide
        lexer.TokenKind.PercentEqual => return ast.AstKind.AssignRemainder
        lexer.TokenKind.AmpersandEqual => return ast.AstKind.AssignBitAnd
        lexer.TokenKind.PipeEqual => return ast.AstKind.AssignBitOr
        lexer.TokenKind.CaretEqual => return ast.AstKind.AssignBitXor
        lexer.TokenKind.ShiftLeftEqual => return ast.AstKind.AssignShiftLeft
        lexer.TokenKind.ShiftRightEqual => return ast.AstKind.AssignShiftRight
        lexer.TokenKind.PipePipe => return ast.AstKind.LogicalOr
        lexer.TokenKind.AmpersandAmpersand => return ast.AstKind.LogicalAnd
        lexer.TokenKind.Pipe => return ast.AstKind.BitOr
        lexer.TokenKind.Caret => return ast.AstKind.BitXor
        lexer.TokenKind.Ampersand => return ast.AstKind.BitAnd
        lexer.TokenKind.EqualEqual => return ast.AstKind.Equal
        lexer.TokenKind.BangEqual => return ast.AstKind.NotEqual
        lexer.TokenKind.Less => return ast.AstKind.Less
        lexer.TokenKind.LessEqual => return ast.AstKind.LessEqual
        lexer.TokenKind.Greater => return ast.AstKind.Greater
        lexer.TokenKind.GreaterEqual => return ast.AstKind.GreaterEqual
        lexer.TokenKind.ShiftLeft => return ast.AstKind.ShiftLeft
        lexer.TokenKind.ShiftRight => return ast.AstKind.ShiftRight
        lexer.TokenKind.Plus => return ast.AstKind.Add
        lexer.TokenKind.Minus => return ast.AstKind.Subtract
        lexer.TokenKind.Star => return ast.AstKind.Multiply
        lexer.TokenKind.Slash => return ast.AstKind.Divide
        else => return ast.AstKind.Remainder
    }
}

fun parse_type_application(p: *Parser, kind: ast.AstKind, base: u32): u32 {
    var opening = p.current
    var mark = p.pending.len
    push_child(p, base)
    open_group(p)
    for {
        push_child(p, parse_type(p))
        if !match_tok(p, lexer.TokenKind.Comma) || p.current.kind == lexer.TokenKind.RightBracket {
            break
        }
    }
    close_group(p, lexer.TokenKind.RightBracket, "expected ']' after type arguments")
    var items = finish_children(p, mark)
    return add_node(p, kind, opening, items.first, items.count)
}

fun bracket_before_initializer(p: *Parser): bool {
    var look = p.lex
    var depth: u32 = 1
    for depth > 0 {
        var k = read_token(&look, true).kind
        if k == lexer.TokenKind.Eof {
            return false
        }
        if k == lexer.TokenKind.LeftBracket {
            depth += 1
        } else if k == lexer.TokenKind.RightBracket {
            depth -= 1
        }
    }
    return read_token(&look, p.group_depth != 0).kind == lexer.TokenKind.LeftBrace
}

fun parse_call(p: *Parser, callee: u32): u32 {
    var opening = p.current
    var mark = p.pending.len
    push_child(p, callee)
    open_group(p)
    var saved = p.disallow_struct_literal
    p.disallow_struct_literal = false
    for !p.has_error && p.current.kind != lexer.TokenKind.RightParen && p.current.kind != lexer.TokenKind.Eof {
        if p.current.kind == lexer.TokenKind.DotDotDot {
            var sp_tok = p.current
            advance(p)
            var expr = parse_expression(p, PREC_ASSIGNMENT)
            push_child(p, add_node(p, ast.AstKind.Spread, sp_tok, expr, 0))
        } else {
            push_child(p, parse_expression(p, PREC_ASSIGNMENT))
        }
        if p.current.kind == lexer.TokenKind.RightParen || p.current.kind == lexer.TokenKind.Eof {
            break
        }
        expect_tok(p, lexer.TokenKind.Comma, "expected ',' or ')' after argument")
    }
    p.disallow_struct_literal = saved
    close_group(p, lexer.TokenKind.RightParen, "expected ')' after arguments")
    var items = finish_children(p, mark)
    return add_node(p, ast.AstKind.Call, opening, items.first, items.count)
}

fun parse_struct_literal(p: *Parser, type_expr: u32): u32 {
    var opening = p.current
    var mark = p.pending.len
    push_child(p, type_expr)
    open_group(p)
    var saved = p.disallow_struct_literal
    p.disallow_struct_literal = false
    for !p.has_error && p.current.kind != lexer.TokenKind.RightBrace && p.current.kind != lexer.TokenKind.Eof {
        var field = expect_tok(p, lexer.TokenKind.Identifier, "expected field name in struct initializer")
        expect_tok(p, lexer.TokenKind.Colon, "expected ':' after field name")
        var val = parse_expression(p, PREC_ASSIGNMENT)
        push_child(p, add_node(p, ast.AstKind.StructFieldInit, field, field.length as u32, val))
        if !match_tok(p, lexer.TokenKind.Comma) {
            break
        }
    }
    p.disallow_struct_literal = saved
    close_group(p, lexer.TokenKind.RightBrace, "expected '}' after struct initializer")
    var items = finish_children(p, mark)
    return add_node(p, ast.AstKind.StructLiteral, opening, items.first, items.count)
}

fun parse_array_literal(p: *Parser): u32 {
    var opening = p.current
    var mark = p.pending.len
    open_group(p)
    var saved = p.disallow_struct_literal
    p.disallow_struct_literal = false
    for !p.has_error && p.current.kind != lexer.TokenKind.RightBracket && p.current.kind != lexer.TokenKind.Eof {
        push_child(p, parse_expression(p, PREC_ASSIGNMENT))
        if !match_tok(p, lexer.TokenKind.Comma) {
            break
        }
    }
    p.disallow_struct_literal = saved
    close_group(p, lexer.TokenKind.RightBracket, "expected ']' after array initializer")
    var items = finish_children(p, mark)
    if !p.has_error && items.count == 0 {
        fail(p, "array initializer cannot be empty")
    }
    return add_node(p, ast.AstKind.ArrayLiteral, opening, items.first, items.count)
}

fun parse_postfix(p: *Parser, base_in: u32): u32 {
    var base = base_in
    var nodes = p.tree.nodes.as_slice()
    for !p.has_error {
        var tok = p.current
        if tok.kind == lexer.TokenKind.LeftParen {
            base = parse_call(p, base)
            nodes = p.tree.nodes.as_slice()
        } else if tok.kind == lexer.TokenKind.LeftBrace {
            var base_kind = ast.AstKind.Invalid
            if base != ast.NODE_NONE {
                base_kind = nodes[base].kind
            }
            if p.disallow_struct_literal ||
               (base_kind != ast.AstKind.Identifier && base_kind != ast.AstKind.Member && base_kind != ast.AstKind.GenericType) {
                return base
            }
            base = parse_struct_literal(p, base)
            nodes = p.tree.nodes.as_slice()
        } else if tok.kind == lexer.TokenKind.LeftBracket {
            var base_kind = nodes[base].kind
            if !p.disallow_struct_literal &&
               (base_kind == ast.AstKind.Identifier || base_kind == ast.AstKind.Member) &&
               bracket_before_initializer(p) {
                base = parse_type_application(p, ast.AstKind.GenericType, base)
                nodes = p.tree.nodes.as_slice()
                continue
            }
            open_group(p)
            var idx = parse_expression(p, PREC_ASSIGNMENT)
            if p.current.kind == lexer.TokenKind.DotDot && !p.has_error {
                var range_tok = p.current
                advance(p)
                var end_expr = parse_expression(p, PREC_ASSIGNMENT)
                close_group(p, lexer.TokenKind.RightBracket, "expected ']' after slice range")
                var bounds = add_node(p, ast.AstKind.SliceRange, range_tok, idx, end_expr)
                base = add_node(p, ast.AstKind.Slice, tok, base, bounds)
            } else {
                close_group(p, lexer.TokenKind.RightBracket, "expected ']' after index")
                base = add_node(p, ast.AstKind.Index, tok, base, idx)
            }
            nodes = p.tree.nodes.as_slice()
        } else if tok.kind == lexer.TokenKind.Dot {
            advance(p)
            if p.current.kind == lexer.TokenKind.LeftBracket {
                base = parse_type_application(p, ast.AstKind.GenericCallee, base)
                if !p.has_error && p.current.kind != lexer.TokenKind.LeftParen {
                    fail(p, "expected '(' after generic function type arguments")
                }
                if !p.has_error {
                    base = parse_call(p, base)
                }
            } else {
                var member = expect_tok(p, lexer.TokenKind.Identifier, "expected member name after '.'")
                base = add_node(p, ast.AstKind.Member, member, base, member.length as u32)
            }
            nodes = p.tree.nodes.as_slice()
        } else if match_tok(p, lexer.TokenKind.Question) {
            base = add_node(p, ast.AstKind.Try, tok, base, 0)
            nodes = p.tree.nodes.as_slice()
        } else {
            return base
        }
    }
    return ast.NODE_NONE
}

fun parse_operand(p: *Parser): u32 {
    var tok = p.current
    var kind = ast.AstKind.Invalid
    if tok.kind == lexer.TokenKind.Plus {
        kind = ast.AstKind.Positive
    } else if tok.kind == lexer.TokenKind.Minus {
        kind = ast.AstKind.Negate
    } else if tok.kind == lexer.TokenKind.Bang {
        kind = ast.AstKind.LogicalNot
    } else if tok.kind == lexer.TokenKind.Tilde {
        kind = ast.AstKind.BitNot
    } else if tok.kind == lexer.TokenKind.Ampersand {
        kind = ast.AstKind.AddressOf
    } else if tok.kind == lexer.TokenKind.Star {
        kind = ast.AstKind.Dereference
    } else if tok.kind == lexer.TokenKind.LeftParen {
        open_group(p)
        var saved = p.disallow_struct_literal
        p.disallow_struct_literal = false
        var val = parse_expression(p, PREC_ASSIGNMENT)
        p.disallow_struct_literal = saved
        close_group(p, lexer.TokenKind.RightParen, "expected ')' after expression")
        return parse_postfix(p, val)
    } else if tok.kind == lexer.TokenKind.LeftBracket {
        return parse_postfix(p, parse_array_literal(p))
    } else if tok.kind == lexer.TokenKind.Identifier {
        advance(p)
        return parse_postfix(p, add_node(p, ast.AstKind.Identifier, tok, tok.length as u32, 0))
    } else if tok.kind == lexer.TokenKind.Integer || tok.kind == lexer.TokenKind.Char {
        advance(p)
        return parse_postfix(p, add_node(p, ast.AstKind.Integer, tok, tok.length as u32, 0))
    } else if tok.kind == lexer.TokenKind.Float {
        advance(p)
        return parse_postfix(p, add_node(p, ast.AstKind.Float, tok, tok.length as u32, 0))
    } else if tok.kind == lexer.TokenKind.String {
        advance(p)
        return parse_postfix(p, add_node(p, ast.AstKind.String, tok, tok.length as u32, 0))
    } else if tok.kind == lexer.TokenKind.Null {
        advance(p)
        return parse_postfix(p, add_node(p, ast.AstKind.Null, tok, 0, 0))
    } else {
        fail(p, "expected an expression")
        return ast.NODE_NONE
    }

    advance(p)
    var operand = parse_expression(p, PREC_PREFIX)
    return add_node(p, kind, tok, operand, 0)
}

fun parse_expression(p: *Parser, minimum: u32): u32 {
    if !enter(p) {
        return ast.NODE_NONE
    }
    var left = parse_operand(p)
    for !p.has_error {
        var tok = p.current
        if tok.kind == lexer.TokenKind.As && minimum <= PREC_CAST {
            advance(p)
            var t = parse_type(p)
            left = add_node(p, ast.AstKind.Cast, tok, left, t)
            continue
        }
        if tok.kind == lexer.TokenKind.Or && minimum <= PREC_OR {
            advance(p)
            var err_name = ast.Span { offset: 0, length: 0 }
            var handler = ast.NODE_NONE
            var is_block = false
            if p.current.kind == lexer.TokenKind.LeftBrace {
                is_block = true
                handler = parse_block(p)
            } else if p.current.kind == lexer.TokenKind.Identifier {
                var saved_lex = p.lex
                var saved_cur = p.current
                var id_tok = p.current
                advance(p)
                if p.current.kind == lexer.TokenKind.LeftBrace {
                    is_block = true
                    err_name = source_span(p, id_tok)
                    handler = parse_block(p)
                } else {
                    p.lex = saved_lex
                    p.current = saved_cur
                    handler = parse_expression(p, PREC_OR + 1)
                }
            } else {
                handler = parse_expression(p, PREC_OR + 1)
            }
            var oe = ast.AstOrElse {
                expr: left,
                err_name: err_name,
                handler: handler,
                is_block: is_block,
            }
            var idx = p.tree.or_elses.len as u32
            if !p.has_error && p.tree.or_elses.push(&oe) < 0 {
                fail(p, "could not allocate AST storage")
            }
            left = add_node(p, ast.AstKind.OrElse, tok, idx, 0)
            continue
        }
        var prec = infix_prec(tok.kind)
        if prec < minimum {
            break
        }
        var op_kind = infix_kind(tok.kind)
        advance(p)
        for p.current.kind == lexer.TokenKind.Newline {
            advance(p)
        }
        var next_min = prec
        if prec != PREC_ASSIGNMENT {
            next_min += 1
        }
        var right = parse_expression(p, next_min)
        left = add_node(p, op_kind, tok, left, right)
    }
    p.recursion_depth -= 1
    return left
}

fun parse_type_name(p: *Parser): u32 {
    var t = expect_tok(p, lexer.TokenKind.Identifier, "expected a type name")
    if !match_tok(p, lexer.TokenKind.Dot) {
        return add_node(p, ast.AstKind.TypeName, t, t.length as u32, 0)
    }
    var mark = p.pending.len
    push_child(p, add_node(p, ast.AstKind.Identifier, t, t.length as u32, 0))
    for {
        var part = expect_tok(p, lexer.TokenKind.Identifier, "expected a type path component")
        push_child(p, add_node(p, ast.AstKind.Identifier, part, part.length as u32, 0))
        if !match_tok(p, lexer.TokenKind.Dot) {
            break
        }
    }
    var path = finish_children(p, mark)
    return add_node(p, ast.AstKind.QualifiedType, t, path.first, path.count)
}

fun parse_type(p: *Parser): u32 {
    if !enter(p) {
        return ast.NODE_NONE
    }
    var opening = p.current
    var res = ast.NODE_NONE
    if match_tok(p, lexer.TokenKind.Bang) {
        var inner = parse_type(p)
        res = add_node(p, ast.AstKind.ResultType, opening, inner, 0)
    } else if match_tok(p, lexer.TokenKind.Fun) {
        if p.current.kind != lexer.TokenKind.LeftParen {
            fail(p, "expected '(' after 'fun'")
        } else {
            open_group(p)
            var mark = p.pending.len
            if p.current.kind != lexer.TokenKind.RightParen {
                for !p.has_error {
                    push_child(p, parse_type(p))
                    if !match_tok(p, lexer.TokenKind.Comma) || p.current.kind == lexer.TokenKind.RightParen {
                        break
                    }
                }
            }
            close_group(p, lexer.TokenKind.RightParen, "expected ')' after function type parameters")
            var ret = ast.NODE_NONE
            if match_tok(p, lexer.TokenKind.Colon) {
                ret = parse_type(p)
            }
            var ft = ast.AstFuncType { params: finish_children(p, mark), return_type: ret }
            var idx = p.tree.func_types.len as u32
            if !p.has_error && p.tree.func_types.push(&ft) < 0 {
                fail(p, "could not allocate AST storage")
            }
            res = add_node(p, ast.AstKind.FuncType, opening, idx, 0)
        }
    } else if match_tok(p, lexer.TokenKind.Star) {
        var read_only: u32 = 0
        if match_tok(p, lexer.TokenKind.Const) {
            read_only = 1
        }
        var pointee = parse_type(p)
        res = add_node(p, ast.AstKind.PointerType, opening, pointee, read_only)
    } else if opening.kind != lexer.TokenKind.LeftBracket {
        var base = parse_type_name(p)
        if !p.has_error && p.current.kind == lexer.TokenKind.LeftBracket {
            res = parse_type_application(p, ast.AstKind.GenericType, base)
        } else {
            res = base
        }
    } else {
        open_group(p)
        var count = ast.NODE_NONE
        if p.current.kind != lexer.TokenKind.RightBracket {
            var len_tok = p.current
            if len_tok.kind == lexer.TokenKind.Identifier {
                advance(p)
                count = add_node(p, ast.AstKind.Identifier, len_tok, len_tok.length as u32, 0)
            } else {
                len_tok = expect_tok(p, lexer.TokenKind.Integer, "expected an integer array length or ']'")
                count = add_node(p, ast.AstKind.Integer, len_tok, len_tok.length as u32, 0)
            }
        }
        close_group(p, lexer.TokenKind.RightBracket, "expected ']' after array length")
        var is_const = match_tok(p, lexer.TokenKind.Const)
        var elem = parse_type(p)
        if is_const {
            elem = add_node(p, ast.AstKind.ConstType, opening, elem, 0)
        }
        res = add_node(p, ast.AstKind.ArrayType, opening, elem, count)
    }
    p.recursion_depth -= 1
    return res
}

fun match_else(p: *Parser): bool {
    if match_tok(p, lexer.TokenKind.Else) {
        return true
    }
    if p.has_error || p.current.kind != lexer.TokenKind.Newline {
        return false
    }
    var look = p.lex
    var tok = read_token(&look, false)
    for tok.kind == lexer.TokenKind.Newline {
        tok = read_token(&look, false)
    }
    if tok.kind != lexer.TokenKind.Else {
        return false
    }
    p.lex = look
    advance(p)
    return true
}

fun parse_if(p: *Parser): u32 {
    if !enter(p) {
        return ast.NODE_NONE
    }
    var kw = expect_tok(p, lexer.TokenKind.If, "expected 'if'")
    var saved = p.disallow_struct_literal
    p.disallow_struct_literal = true
    var cond = parse_expression(p, PREC_ASSIGNMENT)
    p.disallow_struct_literal = saved
    var branches = ast.AstIfBranches { then_branch: parse_block(p), else_branch: ast.NODE_NONE }
    if match_else(p) {
        if p.current.kind == lexer.TokenKind.If {
            branches.else_branch = parse_if(p)
        } else {
            branches.else_branch = parse_block(p)
        }
    }
    var idx = p.tree.if_branches.len as u32
    if !p.has_error && p.tree.if_branches.push(&branches) < 0 {
        fail(p, "could not allocate AST storage")
    }
    p.recursion_depth -= 1
    return add_node(p, ast.AstKind.If, kw, cond, idx)
}

fun is_match_type_kw(p: *Parser): bool {
    if p.current.kind != lexer.TokenKind.Identifier || p.current.length != 4 {
        return false
    }
    var off = p.current.offset as i64
    var src = p.lex.source
    if src[off] != 't' || src[off + 1] != 'y' || src[off + 2] != 'p' || src[off + 3] != 'e' {
        return false
    }
    var look = p.lex
    return read_token(&look, true).kind != lexer.TokenKind.LeftBrace
}

fun parse_match(p: *Parser): u32 {
    if !enter(p) {
        return ast.NODE_NONE
    }
    var kw = expect_tok(p, lexer.TokenKind.Match, "expected 'match'")
    var is_type_match = is_match_type_kw(p)
    var scrutinee = ast.NODE_NONE
    if is_type_match {
        advance(p)
        scrutinee = parse_type(p)
        expect_tok(p, lexer.TokenKind.LeftBrace, "expected '{' after match type")
    } else {
        var saved = p.disallow_struct_literal
        p.disallow_struct_literal = true
        scrutinee = parse_expression(p, PREC_ASSIGNMENT)
        p.disallow_struct_literal = saved
        expect_tok(p, lexer.TokenKind.LeftBrace, "expected '{' after match expression")
    }
    var mark = p.pending.len
    push_child(p, scrutinee)
    for !p.has_error && is_separator(p.current.kind) {
        advance(p)
    }
    for !p.has_error && p.current.kind != lexer.TokenKind.RightBrace && p.current.kind != lexer.TokenKind.Eof {
        var arm_tok = p.current
        var arm_mark = p.pending.len
        if !match_tok(p, lexer.TokenKind.Else) {
            for {
                if is_type_match {
                    push_child(p, parse_type(p))
                } else {
                    push_child(p, parse_expression(p, PREC_ASSIGNMENT))
                }
                if !match_tok(p, lexer.TokenKind.Comma) {
                    break
                }
            }
        }
        expect_tok(p, lexer.TokenKind.FatArrow, "expected '=>' after match pattern")
        var body = ast.NODE_NONE
        if p.current.kind == lexer.TokenKind.LeftBrace {
            body = parse_block(p)
        } else {
            body = parse_statement(p)
        }
        push_child(p, body)
        var arm_items = finish_children(p, arm_mark)
        push_child(p, add_node(p, ast.AstKind.MatchArm, arm_tok, arm_items.first, arm_items.count))
        if p.current.kind == lexer.TokenKind.Eof {
            break
        }
        finish_item(p, lexer.TokenKind.RightBrace, "expected a newline, ';', or '}' after match arm")
    }
    expect_tok(p, lexer.TokenKind.RightBrace, "expected '}' after match")
    var items = finish_children(p, mark)
    p.recursion_depth -= 1
    if is_type_match {
        return add_node(p, ast.AstKind.MatchType, kw, items.first, items.count)
    }
    return add_node(p, ast.AstKind.Match, kw, items.first, items.count)
}

fun parse_variable(p: *Parser): u32 {
    advance(p)
    var name = expect_tok(p, lexer.TokenKind.Identifier, "expected a variable name after 'var'")
    var v = ast.AstVariable { name_length: name.length as u32, type_node: ast.NODE_NONE, initializer: ast.NODE_NONE }
    if match_tok(p, lexer.TokenKind.Colon) {
        v.type_node = parse_type(p)
    }
    if match_tok(p, lexer.TokenKind.Equal) {
        v.initializer = parse_expression(p, PREC_ASSIGNMENT)
    } else if v.type_node == ast.NODE_NONE {
        fail(p, "expected ':' or '=' after variable name")
    }
    var idx = p.tree.variables.len as u32
    if !p.has_error && p.tree.variables.push(&v) < 0 {
        fail(p, "could not allocate AST storage")
    }
    return add_node(p, ast.AstKind.Var, name, idx, 0)
}

fun parse_for_with_label(p: *Parser, label: ast.Span): u32 {
    var kw = expect_tok(p, lexer.TokenKind.For, "expected 'for' after loop label")
    if p.has_error {
        return ast.NODE_NONE
    }
    if p.current.kind == lexer.TokenKind.LeftBrace {
        var body = parse_block(p)
        if label.length == 0 {
            return add_node(p, ast.AstKind.For, kw, ast.NODE_NONE, body)
        }
        var header = ast.AstForHeader { initializer: ast.NODE_NONE, condition: ast.NODE_NONE, step: ast.NODE_NONE, label: label }
        var idx = p.tree.for_headers.len as u32
        if !p.has_error && p.tree.for_headers.push(&header) < 0 {
            fail(p, "could not allocate AST storage")
        }
        return add_node(p, ast.AstKind.ForCStyle, kw, idx, body)
    }

    if p.current.kind == lexer.TokenKind.Identifier {
        var saved_lex = p.lex
        var saved_cur = p.current
        var first_ident = p.current
        advance(p)
        var is_for_in = false
        var idx_sp = ast.Span { offset: 0, length: 0 }
        var item_sp = source_span(p, first_ident)
        if match_tok(p, lexer.TokenKind.Comma) {
            if p.current.kind == lexer.TokenKind.Identifier {
                var second_ident = p.current
                advance(p)
                if p.current.kind == lexer.TokenKind.Identifier && p.current.length == 2 &&
                   p.lex.source[p.current.offset] == 'i' && p.lex.source[p.current.offset + 1] == 'n' {
                    is_for_in = true
                    idx_sp = item_sp
                    item_sp = source_span(p, second_ident)
                    advance(p)
                }
            }
        } else if p.current.kind == lexer.TokenKind.Identifier && p.current.length == 2 &&
                  p.lex.source[p.current.offset] == 'i' && p.lex.source[p.current.offset + 1] == 'n' {
            is_for_in = true
            advance(p)
        }
        if is_for_in {
            var saved = p.disallow_struct_literal
            p.disallow_struct_literal = true
            var iterable = parse_expression(p, PREC_ASSIGNMENT)
            var range_end = ast.NODE_NONE
            if match_tok(p, lexer.TokenKind.DotDot) {
                range_end = parse_expression(p, PREC_ASSIGNMENT)
            }
            p.disallow_struct_literal = saved
            var body = parse_block(p)
            var hdr = ast.AstForInHeader {
                index_name: idx_sp,
                item_name: item_sp,
                iterable: iterable,
                range_end: range_end,
                label: label,
            }
            var idx = p.tree.for_in_headers.len as u32
            if !p.has_error && p.tree.for_in_headers.push(&hdr) < 0 {
                fail(p, "could not allocate AST storage")
            }
            return add_node(p, ast.AstKind.ForIn, kw, idx, body)
        }
        p.lex = saved_lex
        p.current = saved_cur
    }

    var declares_var = p.current.kind == lexer.TokenKind.Var
    var saved = p.disallow_struct_literal
    p.disallow_struct_literal = true
    var first = ast.NODE_NONE
    if declares_var {
        first = parse_variable(p)
    } else if p.current.kind != lexer.TokenKind.Semicolon {
        first = parse_expression(p, PREC_ASSIGNMENT)
    }

    if !match_tok(p, lexer.TokenKind.Semicolon) {
        p.disallow_struct_literal = saved
        if declares_var {
            fail(p, "expected ';' after for initializer")
        }
        var body = parse_block(p)
        if label.length == 0 {
            return add_node(p, ast.AstKind.For, kw, first, body)
        }
        var header = ast.AstForHeader { initializer: ast.NODE_NONE, condition: first, step: ast.NODE_NONE, label: label }
        var idx = p.tree.for_headers.len as u32
        if !p.has_error && p.tree.for_headers.push(&header) < 0 {
            fail(p, "could not allocate AST storage")
        }
        return add_node(p, ast.AstKind.ForCStyle, kw, idx, body)
    }

    var header = ast.AstForHeader { initializer: first, condition: ast.NODE_NONE, step: ast.NODE_NONE, label: label }
    if p.current.kind != lexer.TokenKind.Semicolon {
        header.condition = parse_expression(p, PREC_ASSIGNMENT)
    }
    expect_tok(p, lexer.TokenKind.Semicolon, "expected ';' after for condition")
    if p.current.kind != lexer.TokenKind.LeftBrace {
        header.step = parse_expression(p, PREC_ASSIGNMENT)
    }
    p.disallow_struct_literal = saved
    var body = parse_block(p)
    var idx = p.tree.for_headers.len as u32
    if !p.has_error && p.tree.for_headers.push(&header) < 0 {
        fail(p, "could not allocate AST storage")
    }
    return add_node(p, ast.AstKind.ForCStyle, kw, idx, body)
}

fun parse_const(p: *Parser, public: bool, local: bool): u32 {
    var kw = expect_tok(p, lexer.TokenKind.Const, "expected 'const'")
    var name = expect_tok(p, lexer.TokenKind.Identifier, "expected a constant name")
    var t = ast.NODE_NONE
    if match_tok(p, lexer.TokenKind.Colon) {
        t = parse_type(p)
    }
    expect_tok(p, lexer.TokenKind.Equal, "expected '=' in constant declaration")
    var val = parse_expression(p, PREC_ASSIGNMENT)
    var c = ast.AstConst {
        name: source_span(p, name),
        type_node: t,
        value: val,
        module: p.module,
        public: public,
        local: local,
    }
    var idx = p.tree.consts.len as u32
    if !p.has_error && p.tree.consts.push(&c) < 0 {
        fail(p, "could not allocate AST storage")
    }
    return add_node(p, ast.AstKind.Const, kw, idx, 0)
}

fun parse_statement(p: *Parser): u32 {
    var tok = p.current
    if tok.kind == lexer.TokenKind.Identifier {
        var saved_lex = p.lex
        var next = read_token(&saved_lex, p.group_depth > 0)
        if next.kind == lexer.TokenKind.Colon {
            advance(p)
            advance(p)
            return parse_for_with_label(p, source_span(p, tok))
        }
    }
    if tok.kind == lexer.TokenKind.If { return parse_if(p) }
    if tok.kind == lexer.TokenKind.Match { return parse_match(p) }
    if tok.kind == lexer.TokenKind.For { return parse_for_with_label(p, ast.Span { offset: 0, length: 0 }) }
    if tok.kind == lexer.TokenKind.Break || tok.kind == lexer.TokenKind.Continue {
        advance(p)
        var lbl = ast.NODE_NONE
        if p.current.kind == lexer.TokenKind.Identifier {
            var target = p.current
            advance(p)
            lbl = add_node(p, ast.AstKind.Identifier, target, target.length as u32, 0)
        }
        if tok.kind == lexer.TokenKind.Break {
            return add_node(p, ast.AstKind.Break, tok, lbl, 0)
        }
        return add_node(p, ast.AstKind.Continue, tok, lbl, 0)
    }
    if tok.kind == lexer.TokenKind.Defer {
        advance(p)
        var body: u32 = ast.NODE_NONE
        if p.current.kind == lexer.TokenKind.LeftBrace {
            body = parse_block(p)
        } else {
            body = parse_statement(p)
        }
        return add_node(p, ast.AstKind.Defer, tok, body, 0)
    }
    if tok.kind == lexer.TokenKind.Var { return parse_variable(p) }
    if tok.kind == lexer.TokenKind.Const { return parse_const(p, false, true) }
    if tok.kind == lexer.TokenKind.Return {
        advance(p)
        var nk = p.current.kind
        var val = ast.NODE_NONE
        if !is_separator(nk) && nk != lexer.TokenKind.RightBrace && nk != lexer.TokenKind.Eof {
            val = parse_expression(p, PREC_ASSIGNMENT)
        }
        return add_node(p, ast.AstKind.Return, tok, val, 0)
    }
    return parse_expression(p, PREC_ASSIGNMENT)
}

fun parse_block(p: *Parser): u32 {
    if !enter(p) {
        return ast.NODE_NONE
    }
    var opening = expect_tok(p, lexer.TokenKind.LeftBrace, "expected '{' to start block")
    var mark = p.pending.len
    for !p.has_error && is_separator(p.current.kind) {
        advance(p)
    }
    for !p.has_error && p.current.kind != lexer.TokenKind.RightBrace && p.current.kind != lexer.TokenKind.Eof {
        push_child(p, parse_statement(p))
        if p.current.kind == lexer.TokenKind.Eof {
            break
        }
        finish_item(p, lexer.TokenKind.RightBrace, "expected a newline, ';', or '}' after statement")
    }
    expect_tok(p, lexer.TokenKind.RightBrace, "expected '}' to end block")
    var stmts = finish_children(p, mark)
    p.recursion_depth -= 1
    return add_node(p, ast.AstKind.Block, opening, stmts.first, stmts.count)
}

fun parse_type_parameters(p: *Parser): ast.NodeRange {
    if p.current.kind != lexer.TokenKind.LeftBracket {
        return ast.NodeRange { first: 0, count: 0 }
    }
    var mark = p.pending.len
    open_group(p)
    for {
        var name = expect_tok(p, lexer.TokenKind.Identifier, "expected a type parameter name")
        push_child(p, add_node(p, ast.AstKind.Identifier, name, name.length as u32, 0))
        if !match_tok(p, lexer.TokenKind.Comma) || p.current.kind == lexer.TokenKind.RightBracket {
            break
        }
    }
    close_group(p, lexer.TokenKind.RightBracket, "expected ']' after type parameters")
    return finish_children(p, mark)
}

fun parse_parameters(p: *Parser, out_variadic: *bool): ast.NodeRange {
    *out_variadic = false
    var mark = p.pending.len
    if p.has_error {
        return ast.NodeRange { first: 0, count: 0 }
    }
    if p.current.kind != lexer.TokenKind.LeftParen {
        fail(p, "expected '(' before parameters")
        return ast.NodeRange { first: 0, count: 0 }
    }
    open_group(p)
    if p.current.kind != lexer.TokenKind.RightParen {
        for {
            var name = expect_tok(p, lexer.TokenKind.Identifier, "expected a parameter name")
            expect_tok(p, lexer.TokenKind.Colon, "expected ':' after parameter name")
            var variadic = match_tok(p, lexer.TokenKind.DotDotDot)
            var t = parse_type(p)
            push_child(p, add_node(p, ast.AstKind.Parameter, name, name.length as u32, t))
            if variadic {
                *out_variadic = true
                if p.current.kind == lexer.TokenKind.Comma {
                    fail(p, "variadic parameter must be the last parameter")
                }
                break
            }
            if !match_tok(p, lexer.TokenKind.Comma) || p.current.kind == lexer.TokenKind.RightParen {
                break
            }
        }
    }
    close_group(p, lexer.TokenKind.RightParen, "expected ')' after parameters")
    return finish_children(p, mark)
}

fun parse_function(p: *Parser, public: bool): u32 {
    var start = p.current
    var external = match_tok(p, lexer.TokenKind.Ext)
    if external {
        expect_tok(p, lexer.TokenKind.Fun, "expected 'fun' after 'ext'")
    } else {
        expect_tok(p, lexer.TokenKind.Fun, "expected a function declaration")
    }
    var name = expect_tok(p, lexer.TokenKind.Identifier, "expected a function name")
    var first_node = p.tree.nodes.len as u32
    var type_params = parse_type_parameters(p)
    var is_variadic = false
    var params = parse_parameters(p, &is_variadic)
    var ret_type = ast.NODE_NONE
    if match_tok(p, lexer.TokenKind.Colon) {
        ret_type = parse_type(p)
    }
    var body = ast.NODE_NONE
    if !external {
        body = parse_block(p)
    } else if p.current.kind == lexer.TokenKind.LeftBrace {
        fail(p, "an external function declaration cannot have a body")
    }
    var fn = ast.AstFunction {
        name: source_span(p, name),
        parameters: params,
        type_parameters: type_params,
        nodes: ast.NodeRange { first: first_node, count: (p.tree.nodes.len as u32) - first_node },
        return_type: ret_type,
        body: body,
        module: p.module,
        owner_struct: ~0 as u32,
        public: public,
        is_variadic: is_variadic,
    }
    var idx = p.tree.functions.len as u32
    if !p.has_error && p.tree.functions.push(&fn) < 0 {
        fail(p, "could not allocate AST storage")
    }
    return add_node(p, ast.AstKind.Function, start, idx, 0)
}

fun parse_struct(p: *Parser, public: bool): u32 {
    var kw = expect_tok(p, lexer.TokenKind.Struct, "expected 'struct'")
    var name = expect_tok(p, lexer.TokenKind.Identifier, "expected a struct name")
    var type_params = parse_type_parameters(p)
    expect_tok(p, lexer.TokenKind.LeftBrace, "expected '{' after struct name")
    var struct_idx = p.tree.structs.len as u32
    var mark = p.pending.len
    for !p.has_error && is_separator(p.current.kind) {
        advance(p)
    }
    for !p.has_error && p.current.kind != lexer.TokenKind.RightBrace && p.current.kind != lexer.TokenKind.Eof {
        if p.current.kind == lexer.TokenKind.Pub || p.current.kind == lexer.TokenKind.Fun {
            var m_pub = match_tok(p, lexer.TokenKind.Pub)
            var fn_node = parse_function(p, m_pub)
            if !p.has_error {
                var fn_idx = p.tree.nodes.data[fn_node].a
                p.tree.functions.data[fn_idx].owner_struct = struct_idx
                if type_params.count > 0 {
                    var own_tp = p.tree.functions.data[fn_idx].type_parameters
                    if own_tp.count == 0 {
                        p.tree.functions.data[fn_idx].type_parameters = type_params
                    } else {
                        var first_tp = p.tree.children.len as u32
                        for var ti: u32 = 0; ti < type_params.count; ti += 1 {
                            var cid = p.tree.children.data[type_params.first + ti]
                            p.tree.children.push(&cid)
                        }
                        for var ti: u32 = 0; ti < own_tp.count; ti += 1 {
                            var cid = p.tree.children.data[own_tp.first + ti]
                            p.tree.children.push(&cid)
                        }
                        p.tree.functions.data[fn_idx].type_parameters = ast.NodeRange {
                            first: first_tp,
                            count: type_params.count + own_tp.count,
                        }
                    }
                }
            }
            for !p.has_error && is_separator(p.current.kind) {
                advance(p)
            }
            continue
        }
        var field = expect_tok(p, lexer.TokenKind.Identifier, "expected a field name")
        expect_tok(p, lexer.TokenKind.Colon, "expected ':' after field name")
        var t = parse_type(p)
        push_child(p, add_node(p, ast.AstKind.Field, field, field.length as u32, t))
        if p.current.kind == lexer.TokenKind.Eof {
            break
        }
        finish_item(p, lexer.TokenKind.RightBrace, "expected a newline, ';', or '}' after field")
    }
    expect_tok(p, lexer.TokenKind.RightBrace, "expected '}' to end struct")
    var rec = ast.AstStruct {
        name: source_span(p, name),
        fields: finish_children(p, mark),
        type_parameters: type_params,
        module: p.module,
        public: public,
    }
    var idx = p.tree.structs.len as u32
    if !p.has_error && p.tree.structs.push(&rec) < 0 {
        fail(p, "could not allocate AST storage")
    }
    return add_node(p, ast.AstKind.Struct, kw, idx, 0)
}

fun parse_enum(p: *Parser, public: bool): u32 {
    var kw = expect_tok(p, lexer.TokenKind.Enum, "expected 'enum'")
    var name = expect_tok(p, lexer.TokenKind.Identifier, "expected an enum name")
    var type_params = parse_type_parameters(p)
    var backing = ast.NODE_NONE
    if match_tok(p, lexer.TokenKind.Colon) {
        var t = expect_tok(p, lexer.TokenKind.Identifier, "expected an integer backing type")
        backing = add_node(p, ast.AstKind.TypeName, t, t.length as u32, 0)
    }
    expect_tok(p, lexer.TokenKind.LeftBrace, "expected '{' after enum header")

    var has_any_payload = false
    var mark = p.pending.len
    for !p.has_error && is_separator(p.current.kind) {
        advance(p)
    }
    for !p.has_error && p.current.kind != lexer.TokenKind.RightBrace && p.current.kind != lexer.TokenKind.Eof {
        var member = expect_tok(p, lexer.TokenKind.Identifier, "expected an enum member name")
        var val = ast.NODE_NONE
        var has_case_payload = false
        var case_fields = ast.NodeRange { first: 0, count: 0 }
        if match_tok(p, lexer.TokenKind.LeftParen) {
            has_case_payload = true
            has_any_payload = true
            open_group(p)
            var fmark = p.pending.len
            for !p.has_error && p.current.kind != lexer.TokenKind.RightParen && p.current.kind != lexer.TokenKind.Eof {
                push_child(p, parse_type(p))
                if !match_tok(p, lexer.TokenKind.Comma) || p.current.kind == lexer.TokenKind.RightParen {
                    break
                }
            }
            close_group(p, lexer.TokenKind.RightParen, "expected ')' after enum variant payload")
            case_fields = finish_children(p, fmark)
        } else if match_tok(p, lexer.TokenKind.Equal) {
            var sign = p.current
            var neg = match_tok(p, lexer.TokenKind.Minus)
            var lit = p.current
            if lit.kind == lexer.TokenKind.Char {
                advance(p)
            } else {
                lit = expect_tok(p, lexer.TokenKind.Integer, "expected an integer enum value")
            }
            val = add_node(p, ast.AstKind.Integer, lit, lit.length as u32, 0)
            if neg {
                val = add_node(p, ast.AstKind.Negate, sign, val, 0)
            }
        }
        var ec = ast.AstEnumCase {
            fields: case_fields,
            value: val,
            has_payload: has_case_payload,
        }
        var ec_idx = p.tree.enum_cases.len as u32
        if !p.has_error && p.tree.enum_cases.push(&ec) < 0 {
            fail(p, "could not allocate AST storage")
        }
        push_child(p, add_node(p, ast.AstKind.EnumCase, member, member.length as u32, ec_idx))
        if match_tok(p, lexer.TokenKind.Comma) {
            finish_item(p, lexer.TokenKind.RightBrace, "")
        } else {
            finish_item(p, lexer.TokenKind.RightBrace, "expected ',', a newline, ';', or '}' after enum member")
        }
    }
    expect_tok(p, lexer.TokenKind.RightBrace, "expected '}' after enum")
    var en = ast.AstEnum {
        name: source_span(p, name),
        cases: finish_children(p, mark),
        type_parameters: type_params,
        backing: backing,
        module: p.module,
        public: public,
        has_payload: has_any_payload,
    }
    var idx = p.tree.enums.len as u32
    if !p.has_error && p.tree.enums.push(&en) < 0 {
        fail(p, "could not allocate AST storage")
    }
    return add_node(p, ast.AstKind.Enum, kw, idx, 0)
}

fun parse_import(p: *Parser): u32 {
    var kw = expect_tok(p, lexer.TokenKind.Import, "expected 'import'")
    var item = ast.AstImport {
        path: ast.NodeRange { first: 0, count: 0 },
        items: ast.NodeRange { first: 0, count: 0 },
        alias: ast.Span { offset: 0, length: 0 },
        kind: ast.ImportKind.Module,
    }
    var mark = p.pending.len
    for {
        if p.pending.len != mark && match_tok(p, lexer.TokenKind.Star) {
            item.kind = ast.ImportKind.All
            break
        }
        var part = expect_tok(p, lexer.TokenKind.Identifier, "expected a module path component")
        push_child(p, add_node(p, ast.AstKind.Identifier, part, part.length as u32, 0))
        if !match_tok(p, lexer.TokenKind.Dot) {
            break
        }
    }
    item.path = finish_children(p, mark)

    if item.kind == ast.ImportKind.Module && match_tok(p, lexer.TokenKind.As) {
        item.alias = source_span(p, expect_tok(p, lexer.TokenKind.Identifier, "expected an import alias"))
    } else if item.kind == ast.ImportKind.Module && p.current.kind == lexer.TokenKind.LeftBrace {
        item.kind = ast.ImportKind.Selected
        open_group(p)
        for {
            var name = expect_tok(p, lexer.TokenKind.Identifier, "expected an imported name")
            var alias_node = ast.NODE_NONE
            if match_tok(p, lexer.TokenKind.As) {
                var tok = expect_tok(p, lexer.TokenKind.Identifier, "expected an import alias")
                alias_node = add_node(p, ast.AstKind.Identifier, tok, tok.length as u32, 0)
            }
            push_child(p, add_node(p, ast.AstKind.ImportItem, name, name.length as u32, alias_node))
            if !match_tok(p, lexer.TokenKind.Comma) || p.current.kind == lexer.TokenKind.RightBrace {
                break
            }
        }
        close_group(p, lexer.TokenKind.RightBrace, "expected '}' after imported names")
        item.items = finish_children(p, mark)
    }

    var idx = p.tree.imports.len as u32
    if !p.has_error && p.tree.imports.push(&item) < 0 {
        fail(p, "could not allocate AST storage")
    }
    return add_node(p, ast.AstKind.Import, kw, idx, 0)
}

pub fun parse_append(arena: *mem.Arena, tree: *ast.Ast, slice: []u8, source_base: u32, module: u32,
                     out_decls: *ast.NodeRange, err: *ParseError): bool {
    var p: Parser
    p.lex = lexer.init(slice)
    p.has_error = false
    p.tree = tree
    p.source_base = source_base
    p.module = module
    p.group_depth = 0
    p.recursion_depth = 0
    p.disallow_struct_literal = false
    if p.pending.init(arena, 64) < 0 {
        *err = ParseError { token: lexer.Token { kind: lexer.TokenKind.Eof, offset: 0, length: 0, line: 1, column: 1 }, message: "could not allocate parser stack" }
        return false
    }

    var mark = p.pending.len
    advance(&p)
    for is_separator(p.current.kind) {
        advance(&p)
    }
    for !p.has_error && p.current.kind != lexer.TokenKind.Eof {
        var msg: []u8 = ""
        var decl = ast.NODE_NONE
        if p.current.kind == lexer.TokenKind.Import {
            decl = parse_import(&p)
            msg = "expected a newline or ';' after import"
        } else {
            var public = match_tok(&p, lexer.TokenKind.Pub)
            if !public {
                match_tok(&p, lexer.TokenKind.Priv)
            }
            if p.current.kind == lexer.TokenKind.Struct {
                decl = parse_struct(&p, public)
            } else if p.current.kind == lexer.TokenKind.Enum {
                decl = parse_enum(&p, public)
            } else if p.current.kind == lexer.TokenKind.Const {
                decl = parse_const(&p, public, false)
                msg = "expected a newline or ';' after constant"
            } else {
                decl = parse_function(&p, public)
                msg = "expected a newline or ';' after function"
            }
        }
        push_child(&p, decl)
        finish_item(&p, lexer.TokenKind.Eof, msg)
    }
    *out_decls = finish_children(&p, mark)
    *err = p.error
    return !p.has_error
}

pub fun parse(arena: *mem.Arena, source: []u8, out: *ast.Ast, err: *ParseError): bool {
    if !ast.init(arena, source, out) {
        *err = ParseError { token: lexer.Token { kind: lexer.TokenKind.Eof, offset: 0, length: 0, line: 1, column: 1 }, message: "could not allocate AST storage" }
        return false
    }
    return parse_append(arena, out, source, 0, 0, &out.declarations, err)
}
