import std.mem
import std.collections.Vec
import frontend.ast.*

pub enum TypeKind : u8 {
    Invalid,
    Void,
    Bool,
    I8,
    I16,
    I32,
    I64,
    U8,
    U16,
    U32,
    U64,
    F32,
    F64,
    Struct,
    Array,
    Slice,
    Pointer,
    Any,
    Result,
    Error,
    Func,
    Null,
    TaggedUnion,
}

pub struct SemaType {
    kind: TypeKind
    length: u32
    element: TypeKind
    element_type: u32
    element_size: u32
    record: u32
    record_size: u32
    pointee: u32
    read_only: bool
}

pub enum SemaBuiltin : u8 {
    None,
    Len,
    Data,
    SizeOf,
    Fail,
    Eq,
    Hash,
}

pub struct SemaNode {
    type_info: SemaType
    binding: u32
    builtin: SemaBuiltin
    promotion: TypeKind
    method_call: u8
    result_wrap: u8
    box_any: bool
    is_fn_ref: bool
    is_indirect_call: bool
    is_boolean_literal: bool
    borrow_array: bool
    falls_through: bool
    is_enum_case: bool
    is_const: bool
}

pub struct SemaFunction {
    result: SemaType
    slot_count: u32
    declaration: u32
    instantiated_at: u32
    param_types: Vec[SemaType]
    arguments: Vec[SemaType]
    nodes: Vec[SemaNode]
}

pub struct SemaConstant {
    type_info: SemaType
    bits: u64
    str_node: u32
    state: u8
}

pub struct SemaRecord {
    declaration: u32
    size: u32
    alignment: u32
    state: u8
    auto_eq: bool
    auto_hash: bool
    fields: Vec[SemaNode]
    arguments: Vec[SemaType]
}

pub struct SemaUnionVariant {
    fields: Vec[SemaNode]
}

pub struct SemaUnion {
    declaration: u32
    size: u32
    alignment: u32
    state: u8
    auto_eq: bool
    auto_hash: bool
    variants: Vec[SemaUnionVariant]
    arguments: Vec[SemaType]
}

pub struct SemaFuncType {
    params: Vec[SemaType]
    result: SemaType
}

pub struct Sema {
    nodes: Vec[SemaNode]
    functions: Vec[SemaFunction]
    records: Vec[SemaRecord]
    unions: Vec[SemaUnion]
    constants: Vec[SemaConstant]
    pointees: Vec[SemaType]
    elements: Vec[SemaType]
    func_types: Vec[SemaFuncType]
    enum_values: Vec[u64]
    match_values: Vec[u64]
}

pub struct SemaError {
    offset: u32
    message: []u8
    note_offset: u32
    note_message: []u8
}

struct LocalVar {
    name: Span
    slot: u32
    type_info: SemaType
    is_const: bool
    const_idx: u32
    depth: u32
}

struct LoopEntry {
    label: Span
    has_break: bool
}

struct Checker {
    arena: *mem.Arena
    tree: *Ast
    sema: *Sema
    err: SemaError
    has_error: bool
    locals: Vec[LocalVar]
    loops: Vec[LoopEntry]
    scope_depth: u32
    slot_count: u32
    current_return: SemaType
    current_fn_idx: u32
    recursion_depth: u32
    module: u32
    owner_struct: u32
    type_parameters: NodeRange
    type_arguments: []SemaType
    instantiation_depth: u32
    in_defer: bool
    defer_loop_base: u64
}

struct TypeScope {
    parameters: NodeRange
    arguments: []SemaType
    module: u32
    owner_struct: u32
    instantiation_depth: u32
}

fun enter_type_scope(c: *Checker, module: u32, params: NodeRange, args: []SemaType, depth: u32): TypeScope {
    var saved = TypeScope {
        parameters: c.type_parameters,
        arguments: c.type_arguments,
        module: c.module,
        owner_struct: c.owner_struct,
        instantiation_depth: c.instantiation_depth,
    }
    c.type_parameters = params
    c.type_arguments = args
    c.module = module
    c.instantiation_depth = depth
    return saved
}

fun leave_type_scope(c: *Checker, saved: TypeScope) {
    c.type_parameters = saved.parameters
    c.type_arguments = saved.arguments
    c.module = saved.module
    c.owner_struct = saved.owner_struct
    c.instantiation_depth = saved.instantiation_depth
}

fun node_info(c: *Checker, id: u32): *SemaNode {
    if c.current_fn_idx < (c.sema.functions.len as u32) {
        var f = &c.sema.functions.data[c.current_fn_idx]
        if f.nodes.len > 0 {
            var fdecls = c.tree.functions.as_slice()
            var first = fdecls[f.declaration].nodes.first
            return &f.nodes.data[id - first]
        }
    }
    return &c.sema.nodes.data[id]
}

pub fun empty_type(): SemaType {
    return SemaType {
        kind: TypeKind.Invalid,
        length: 0,
        element: TypeKind.Invalid,
        element_type: 0,
        element_size: 0,
        record: 0,
        record_size: 0,
        pointee: 0,
        read_only: false,
    }
}

pub fun simple_type(k: TypeKind): SemaType {
    var t = empty_type()
    t.kind = k
    return t
}

pub fun is_signed(k: TypeKind): bool {
    return k == TypeKind.I8 || k == TypeKind.I16 || k == TypeKind.I32 || k == TypeKind.I64
}

pub fun is_unsigned(k: TypeKind): bool {
    return k == TypeKind.U8 || k == TypeKind.U16 || k == TypeKind.U32 || k == TypeKind.U64
}

pub fun is_integer(k: TypeKind): bool {
    return is_signed(k) || is_unsigned(k)
}

pub fun is_float(k: TypeKind): bool {
    return k == TypeKind.F32 || k == TypeKind.F64
}

pub fun is_numeric(k: TypeKind): bool {
    return is_integer(k) || is_float(k)
}

pub fun is_enum(t: SemaType): bool {
    return is_integer(t.kind) && t.record != 0
}

pub fun scalar_size(k: TypeKind): u32 {
    match k {
        TypeKind.Bool, TypeKind.I8, TypeKind.U8 => return 1
        TypeKind.I16, TypeKind.U16 => return 2
        TypeKind.I32, TypeKind.U32, TypeKind.F32 => return 4
        TypeKind.I64, TypeKind.U64, TypeKind.F64, TypeKind.Pointer, TypeKind.Func => return 8
        else => return 0
    }
}

pub fun element_size(t: SemaType): u32 {
    if t.kind == TypeKind.Array || t.kind == TypeKind.Slice {
        return t.element_size
    }
    if t.kind == TypeKind.Struct || t.kind == TypeKind.Result || t.kind == TypeKind.TaggedUnion {
        return t.record_size
    }
    return scalar_size(t.kind)
}

pub fun storage_size(t: SemaType): u32 {
    if t.kind == TypeKind.Array {
        return t.length * t.element_size
    }
    if t.kind == TypeKind.Struct || t.kind == TypeKind.Result || t.kind == TypeKind.TaggedUnion {
        return t.record_size
    }
    if t.kind == TypeKind.Slice || t.kind == TypeKind.Any {
        return 16
    }
    return scalar_size(t.kind)
}

fun type_alignment(c: *Checker, t: SemaType): u32 {
    if t.kind == TypeKind.Array {
        var elems = c.sema.elements.as_slice()
        return type_alignment(c, elems[t.element_type])
    }
    if t.kind == TypeKind.Struct {
        var recs = c.sema.records.data
        return recs[t.record].alignment
    }
    if t.kind == TypeKind.TaggedUnion {
        var uns = c.sema.unions.data
        return uns[t.record].alignment
    }
    if t.kind == TypeKind.Slice || t.kind == TypeKind.Any {
        return 8
    }
    if t.kind == TypeKind.Result {
        var elems = c.sema.elements.as_slice()
        var al = type_alignment(c, elems[t.element_type])
        if al < 8 { al = 8 }
        return al
    }
    var sz = scalar_size(t.kind)
    if sz == 0 {
        return 1
    }
    return sz
}

fun span_bytes(tree: *Ast, s: Span): []u8 {
    if s.length == 0 {
        return ""
    }
    var start = s.offset as i64
    var end = (s.offset + s.length) as i64
    return tree.source[start..end]
}

fun node_span(tree: *Ast, id: u32, length: u32): Span {
    var nodes = tree.nodes.as_slice()
    return Span { offset: nodes[id].pos, length: length }
}

fun node_ident_span(tree: *Ast, id: u32): Span {
    var nodes = tree.nodes.as_slice()
    var l: u32 = 0
    match nodes[id].data {
        AstData.Identifier(n) => l = n
        AstData.TypeParam(tp) => l = tp.name_length
        AstData.TypeName(n) => l = n
        AstData.Field(f) => l = f.name_length
        AstData.Parameter(p) => l = p.name_length
        AstData.EnumCase(ec) => l = ec.name_length
        AstData.StructFieldInit(fi) => l = fi.name_length
        AstData.Integer(n) => l = n
        AstData.Float(n) => l = n
        AstData.String(n) => l = n
        AstData.Break(n) => l = n
        AstData.Continue(n) => l = n
        else => {}
    }
    return Span { offset: nodes[id].pos, length: l }
}

fun same_span(tree: *Ast, a: Span, b: Span): bool {
    return span_bytes(tree, a) == span_bytes(tree, b)
}

fun fail_at(c: *Checker, offset: u32, msg: []u8): SemaType {
    if !c.has_error {
        c.has_error = true
        c.err = SemaError { offset: offset, message: msg }
    }
    return empty_type()
}

fun fail(c: *Checker, id: u32, msg: []u8): SemaType {
    var nodes = c.tree.nodes.as_slice()
    return fail_at(c, nodes[id].pos, msg)
}

fun add_pointee(c: *Checker, t: SemaType): u32 {
    var idx = c.sema.pointees.len as u32
    var copy_t = t
    c.sema.pointees.push(&copy_t)
    return idx
}

fun add_element(c: *Checker, t: SemaType): u32 {
    var idx = c.sema.elements.len as u32
    var copy_t = t
    c.sema.elements.push(&copy_t)
    return idx
}

fun same_type(c: *Checker, a: SemaType, b: SemaType): bool {
    if a.kind != b.kind {
        return false
    }
    if a.kind == TypeKind.Func {
        var fa = &c.sema.func_types.data[a.record]
        var fb = &c.sema.func_types.data[b.record]
        if fa.params.len != fb.params.len || !same_type(c, fa.result, fb.result) {
            return false
        }
        for var i: u64 = 0; i < fa.params.len; i += 1 {
            if !same_type(c, fa.params.data[i], fb.params.data[i]) {
                return false
            }
        }
        return true
    }
    if a.record != b.record {
        return false
    }
    if a.kind == TypeKind.Pointer {
        if a.read_only != b.read_only {
            return false
        }
        var pts = c.sema.pointees.as_slice()
        return same_type(c, pts[a.pointee], pts[b.pointee])
    }
    if a.kind == TypeKind.Array || a.kind == TypeKind.Slice || a.kind == TypeKind.Result {
        if a.kind == TypeKind.Array && a.length != b.length {
            return false
        }
        var elems = c.sema.elements.as_slice()
        return same_type(c, elems[a.element_type], elems[b.element_type])
    }
    return true
}

fun can_widen_num(src: TypeKind, dst: TypeKind): bool {
    if src == dst { return true }
    if is_signed(src) && is_signed(dst) {
        return scalar_size(src) < scalar_size(dst)
    }
    if is_unsigned(src) && is_unsigned(dst) {
        return scalar_size(src) < scalar_size(dst)
    }
    if is_unsigned(src) && is_signed(dst) {
        return scalar_size(src) < scalar_size(dst)
    }
    return src == TypeKind.F32 && dst == TypeKind.F64
}

fun common_numeric_type(a: TypeKind, b: TypeKind): TypeKind {
    if a == b { return a }
    if is_float(a) && is_float(b) { return TypeKind.F64 }
    if is_integer(a) && is_integer(b) {
        if is_signed(a) == is_signed(b) {
            if scalar_size(a) > scalar_size(b) { return a }
            return b
        }
        var u = a
        var s = b
        if is_signed(a) {
            u = b
            s = a
        }
        if scalar_size(s) > scalar_size(u) { return s }
        if scalar_size(u) < 8 {
            if scalar_size(u) == 1 { return TypeKind.I16 }
            if scalar_size(u) == 2 { return TypeKind.I32 }
            return TypeKind.I64
        }
    }
    return TypeKind.Invalid
}

fun find_in_module(c: *Checker, name: Span, kind: AstBindingKind): u32 {
    if (c.module as u64) >= c.tree.modules.len {
        return ~0 as u32
    }
    var bs = (c.tree.modules.data[c.module].bindings).as_slice()
    var target = span_bytes(c.tree, name)
    for b in bs {
        if b.kind == kind && b.name == target {
            return b.index
        }
    }
    return ~0 as u32
}

fun find_struct_idx(c: *Checker, name: Span): u32 {
    var list = c.tree.structs.as_slice()
    for i, item in list {
        if item.module == c.module && same_span(c.tree, item.name, name) {
            return i as u32
        }
    }
    return find_in_module(c, name, AstBindingKind.Struct)
}

fun find_enum_idx(c: *Checker, name: Span): u32 {
    var list = c.tree.enums.as_slice()
    for i, item in list {
        if item.module == c.module && same_span(c.tree, item.name, name) {
            return i as u32
        }
    }
    return find_in_module(c, name, AstBindingKind.Enum)
}

fun find_trait_idx(c: *Checker, name: Span): u32 {
    var list = c.tree.traits.as_slice()
    for i, item in list {
        if item.module == c.module && same_span(c.tree, item.name, name) {
            return i as u32
        }
    }
    return find_in_module(c, name, AstBindingKind.Trait)
}

fun find_const_idx(c: *Checker, name: Span): u32 {
    var list = c.tree.consts.as_slice()
    for i, item in list {
        if !item.local && item.module == c.module && same_span(c.tree, item.name, name) {
            return i as u32
        }
    }
    return find_in_module(c, name, AstBindingKind.Const)
}

fun find_fn_idx(c: *Checker, name: Span): u32 {
    var list = c.tree.functions.as_slice()
    for i, item in list {
        if item.owner_struct == (~0 as u32) && item.module == c.module && same_span(c.tree, item.name, name) {
            return i as u32
        }
    }
    return find_in_module(c, name, AstBindingKind.Function)
}

fun find_method_idx(c: *Checker, struct_decl: u32, name: Span): u32 {
    var list = c.tree.functions.as_slice()
    for i, item in list {
        if item.owner_struct == struct_decl && same_span(c.tree, item.name, name) {
            return i as u32
        }
    }
    return ~0 as u32
}

fun find_local(c: *Checker, name: Span, min_depth: u32): i64 {
    var list = c.locals.as_slice()
    var i = len(list) - 1
    for i >= 0 {
        if list[i].depth < min_depth {
            break
        }
        if same_span(c.tree, list[i].name, name) {
            return i
        }
        i -= 1
    }
    return -1
}

fun is_hex_char(b: u8, out: *u64): bool {
    if b >= '0' && b <= '9' { *out = (b - '0') as u64; return true }
    if b >= 'a' && b <= 'f' { *out = (b - 'a' + 10) as u64; return true }
    if b >= 'A' && b <= 'F' { *out = (b - 'A' + 10) as u64; return true }
    return false
}

fun decoded_string_len(text: []u8): u32 {
    if len(text) < 2 { return 0 }
    var count: u32 = 0
    var i: i64 = 1
    var end = len(text) - 1
    for i < end {
        if text[i] == '\\' && i + 1 < end {
            if text[i + 1] == 'x' && i + 3 < end {
                i += 4
            } else {
                i += 2
            }
        } else {
            i += 1
        }
        count += 1
    }
    return count
}

pub fun parse_int_literal(text: []u8, out: *u64): bool {
    if len(text) == 0 {
        if len(text) == 6 && text[2] == 'x' {
            var h1: u64 = 0
            var h2: u64 = 0
            var c1 = text[3]
            var c2 = text[4]
            if !is_hex_char(c1, &h1) || !is_hex_char(c2, &h2) {
                return false
            }
            *out = h1 * 16 + h2
            return true
        }
        return false
    }
    if text[0] == '\'' {
        if len(text) < 3 || text[len(text) - 1] != '\'' {
            return false
        }
        if text[1] != '\\' {
            if len(text) != 3 { return false }
            *out = text[1] as u64
            return true
        }
        if len(text) == 4 {
            var esc = text[2]
            if esc == '0' { *out = 0; return true }
            if esc == 'n' { *out = 10; return true }
            if esc == 'r' { *out = 13; return true }
            if esc == 't' { *out = 9; return true }
            if esc == '\\' { *out = 92; return true }
            if esc == '"' { *out = 34; return true }
            if esc == '\'' { *out = 39; return true }
        }
        if len(text) == 6 && text[2] == 'x' {
            var h1: u64 = 0
            var h2: u64 = 0
            if !is_hex_char(text[3], &h1) || !is_hex_char(text[4], &h2) {
                return false
            }
            *out = h1 * 16 + h2
            return true
        }
        return false
    }
    var base: u64 = 10
    var start: i64 = 0
    if len(text) >= 2 && text[0] == '0' {
        if text[1] == 'x' || text[1] == 'X' {
            base = 16
            start = 2
        } else if text[1] == 'b' || text[1] == 'B' {
            base = 2
            start = 2
        }
    }
    if start >= len(text) {
        return false
    }
    var val: u64 = 0
    var max: u64 = ~0
    for var i = start; i < len(text); i += 1 {
        var b = text[i]
        var d: u64 = 0
        if b >= '0' && b <= '9' {
            d = (b - '0') as u64
        } else if b >= 'a' && b <= 'f' {
            d = (b - 'a' + 10) as u64
        } else if b >= 'A' && b <= 'F' {
            d = (b - 'A' + 10) as u64
        } else {
            return false
        }
        if d >= base || val > (max - d) / base {
            return false
        }
        val = val * base + d
    }
    *out = val
    return true
}

fun int_fits_type(bits: u64, negative: bool, kind: TypeKind): bool {
    var sz = scalar_size(kind)
    if is_unsigned(kind) {
        if negative { return false }
        if sz == 8 { return true }
        var limit = ((1 as u64) << ((sz * 8) as u64)) - 1
        return bits <= limit
    }
    if is_signed(kind) {
        var shift = (sz * 8 - 1) as u64
        var max_pos = ((1 as u64) << shift) - 1
        if !negative {
            return bits <= max_pos
        }
        return bits <= max_pos + 1
    }
    return false
}

fun resolve_primitive(name: []u8): TypeKind {
    if name == "bool" { return TypeKind.Bool }
    if name == "i8" { return TypeKind.I8 }
    if name == "i16" { return TypeKind.I16 }
    if name == "i32" { return TypeKind.I32 }
    if name == "i64" { return TypeKind.I64 }
    if name == "int" { return TypeKind.I64 }
    if name == "u8" { return TypeKind.U8 }
    if name == "u16" { return TypeKind.U16 }
    if name == "u32" { return TypeKind.U32 }
    if name == "u64" { return TypeKind.U64 }
    if name == "f32" { return TypeKind.F32 }
    if name == "f64" { return TypeKind.F64 }
    if name == "any" { return TypeKind.Any }
    return TypeKind.Invalid
}

fun same_type_args(c: *Checker, a: []SemaType, b: []SemaType): bool {
    if len(a) != len(b) { return false }
    for i, x in a {
        if !same_type(c, x, b[i]) { return false }
    }
    return true
}

fun resolve_type_args(c: *Checker, id: u32, expected_count: u32, out: *Vec[SemaType]): bool {
    var nodes = c.tree.nodes.as_slice()
    var children = c.tree.children.as_slice()
    var r = NodeRange { first: 0, count: 0 }
    match nodes[id].data {
        AstData.GenericType(gr) => r = gr
        AstData.GenericCallee(gr) => r = gr
        else => {}
    }
    if r.count - 1 != expected_count {
        fail(c, id, "wrong number of type arguments")
        return false
    }
    if out.init(c.arena, expected_count as u64) < 0 {
        fail(c, id, "could not allocate type arguments")
        return false
    }
    for var i: u32 = 0; i < expected_count; i += 1 {
        var at = resolve_type_inner(c, children[r.first + 1 + i], false)
        if c.has_error { return false }
        out.push(&at)
    }
    return true
}

fun specialize_record_with_args(c: *Checker, id: u32, decl: u32, args: Vec[SemaType], allow_incomplete: bool): SemaType {
    var arg_slice = args.as_slice()
    if !check_generic_bounds(c, id, c.tree.structs.data[decl].type_parameters, arg_slice) {
        return empty_type()
    }
    var recs = c.sema.records.data
    for var i = c.tree.structs.len as i64; i < (c.sema.records.len as i64); i += 1 {
        if recs[i].declaration == decl && same_type_args(c, (recs[i].arguments).as_slice(), arg_slice) {
            if !allow_incomplete {
                resolve_struct_layout(c, i as u32)
            }
            var t = simple_type(TypeKind.Struct)
            t.record = i as u32
            t.record_size = c.sema.records.data[i].size
            return t
        }
    }
    if c.instantiation_depth >= 64 {
        return fail(c, id, "generic instantiation nesting limit exceeded")
    }
    var rec_idx = c.sema.records.len as u32
    var sr = SemaRecord {
        declaration: decl,
        size: 0,
        alignment: 1,
        state: 0,
        auto_eq: false,
        auto_hash: false,
        fields: Vec[SemaNode] { arena: c.arena },
        arguments: args,
    }
    sr.fields.init(c.arena, 8)
    c.sema.records.push(&sr)
    if !allow_incomplete {
        resolve_struct_layout(c, rec_idx)
    }
    var t = simple_type(TypeKind.Struct)
    t.record = rec_idx
    t.record_size = c.sema.records.data[rec_idx].size
    return t
}

fun resolve_enum_backing(c: *Checker, edecl: AstEnum): SemaType {
    if edecl.backing == NODE_NONE {
        return simple_type(TypeKind.I32)
    }
    return resolve_type_inner(c, edecl.backing, false)
}

fun specialize_union_with_args(c: *Checker, id: u32, decl: u32, args: Vec[SemaType], allow_incomplete: bool): SemaType {
    var arg_slice = args.as_slice()
    if !check_generic_bounds(c, id, c.tree.enums.data[decl].type_parameters, arg_slice) {
        return empty_type()
    }
    var uns = c.sema.unions.data
    for var i = c.tree.enums.len as i64; i < (c.sema.unions.len as i64); i += 1 {
        if uns[i].declaration == decl && same_type_args(c, (uns[i].arguments).as_slice(), arg_slice) {
            if !allow_incomplete {
                resolve_union_layout(c, i as u32)
            }
            var t = simple_type(TypeKind.TaggedUnion)
            t.record = i as u32
            t.record_size = c.sema.unions.data[i].size
            return t
        }
    }
    if c.instantiation_depth >= 64 {
        return fail(c, id, "generic instantiation nesting limit exceeded")
    }
    var u_idx = c.sema.unions.len as u32
    var su = SemaUnion {
        declaration: decl,
        size: 0,
        alignment: 4,
        state: 0,
        auto_eq: false,
        auto_hash: false,
        variants: Vec[SemaUnionVariant] { arena: c.arena },
        arguments: args,
    }
    su.variants.init(c.arena, 8)
    c.sema.unions.push(&su)
    if !allow_incomplete {
        resolve_union_layout(c, u_idx)
    }
    var t = simple_type(TypeKind.TaggedUnion)
    t.record = u_idx
    t.record_size = c.sema.unions.data[u_idx].size
    return t
}

fun specialize_record(c: *Checker, id: u32, allow_incomplete: bool): SemaType {
    var nodes = c.tree.nodes.as_slice()
    var children = c.tree.children.as_slice()
    var base = NODE_NONE
    match nodes[id].data {
        AstData.GenericType(gr) => base = children[gr.first]
        else => return fail(c, id, "expected a generic type")
    }
    var decl: u32 = ~0 as u32
    var enum_decl: u32 = ~0 as u32
    var q: AstQualified
    if find_qualified(c.tree, id, &q) && !q.inaccessible {
        if q.kind == AstBindingKind.Struct { decl = q.index }
        else if q.kind == AstBindingKind.Enum { enum_decl = q.index }
    } else if find_qualified(c.tree, base, &q) && !q.inaccessible {
        if q.kind == AstBindingKind.Struct { decl = q.index }
        else if q.kind == AstBindingKind.Enum { enum_decl = q.index }
    } else {
        match nodes[base].data {
            AstData.Identifier(l) => {
                var bname = node_span(c.tree, base, l)
                decl = find_struct_idx(c, bname)
                if decl == (~0 as u32) { enum_decl = find_enum_idx(c, bname) }
            }
            AstData.TypeName(l) => {
                var bname = node_span(c.tree, base, l)
                decl = find_struct_idx(c, bname)
                if decl == (~0 as u32) { enum_decl = find_enum_idx(c, bname) }
            }
            else => {}
        }
    }
    if enum_decl != (~0 as u32) {
        var edecls = c.tree.enums.as_slice()
        var count = edecls[enum_decl].type_parameters.count
        if count == 0 {
            return fail(c, id, "enum does not take type arguments")
        }
        var args: Vec[SemaType]
        if !resolve_type_args(c, id, count, &args) {
            return empty_type()
        }
        return specialize_union_with_args(c, id, enum_decl, args, allow_incomplete)
    }
    if decl == (~0 as u32) {
        return fail(c, id, "expected a generic struct or enum")
    }
    var sdecls = c.tree.structs.as_slice()
    var count = sdecls[decl].type_parameters.count
    if count == 0 {
        return fail(c, id, "struct does not take type arguments")
    }
    var args: Vec[SemaType]
    if !resolve_type_args(c, id, count, &args) {
        return empty_type()
    }
    return specialize_record_with_args(c, id, decl, args, allow_incomplete)
}

fun resolve_self_type(c: *Checker, id: u32, allow_incomplete: bool): SemaType {
    var sdecl = c.tree.structs.data[c.owner_struct]
    var scount = sdecl.type_parameters.count
    if scount == 0 {
        if !allow_incomplete {
            resolve_struct_layout(c, c.owner_struct)
        }
        var t = simple_type(TypeKind.Struct)
        t.record = c.owner_struct
        t.record_size = c.sema.records.data[c.owner_struct].size
        return t
    }
    var args: Vec[SemaType]
    args.init(c.arena, scount as u64)
    for var i: u32 = 0; i < scount; i += 1 {
        args.push(&c.type_arguments[i])
    }
    return specialize_record_with_args(c, id, c.owner_struct, args, allow_incomplete)
}

fun complete_type(c: *Checker, t: SemaType): SemaType {
    if t.kind == TypeKind.Struct {
        resolve_struct_layout(c, t.record)
        var res = t
        res.record_size = c.sema.records.data[t.record].size
        return res
    }
    if t.kind == TypeKind.TaggedUnion {
        resolve_union_layout(c, t.record)
        var res = t
        res.record_size = c.sema.unions.data[t.record].size
        return res
    }
    return t
}

fun resolve_type_inner(c: *Checker, id: u32, allow_incomplete: bool): SemaType {
    if id == NODE_NONE || c.has_error {
        return simple_type(TypeKind.Void)
    }
    var nodes = c.tree.nodes.as_slice()
    var node = nodes[id]
    match node.data {
        AstData.TypeName(nlen) => {
            var name = node_span(c.tree, id, nlen)
            var text = span_bytes(c.tree, name)
            var children = c.tree.children.as_slice()
            for var i: u32 = 0; i < c.type_parameters.count; i += 1 {
                var tp_id = children[c.type_parameters.first + i]
                if same_span(c.tree, name, node_ident_span(c.tree, tp_id)) {
                    return c.type_arguments[i]
                }
            }
            if text == "Self" && c.owner_struct != (~0 as u32) {
                return resolve_self_type(c, id, allow_incomplete)
            }
            var prim = resolve_primitive(text)
            if prim != TypeKind.Invalid {
                return simple_type(prim)
            }
            var si = find_struct_idx(c, name)
            if si != (~0 as u32) {
                if !allow_incomplete {
                    resolve_struct_layout(c, si)
                }
                var t = simple_type(TypeKind.Struct)
                t.record = si
                var recs = c.sema.records.data
                t.record_size = recs[si].size
                return t
            }
            var ei = find_enum_idx(c, name)
            if ei != (~0 as u32) {
                var enums = c.tree.enums.as_slice()
                var edecl = enums[ei]
                if edecl.type_parameters.count > 0 {
                    return fail(c, id, "generic enum requires type arguments")
                }
                if edecl.has_payload {
                    if !allow_incomplete {
                        resolve_union_layout(c, ei)
                    }
                    var t = simple_type(TypeKind.TaggedUnion)
                    t.record = ei
                    t.record_size = c.sema.unions.data[ei].size
                    return t
                }
                var backing = resolve_enum_backing(c, edecl)
                backing.record = ei + 1
                return backing
            }
            return fail(c, id, "unknown type name")
        }
        AstData.QualifiedType(_) => {
            var q: AstQualified
            if !find_qualified(c.tree, id, &q) {
                return fail(c, id, "unknown qualified type")
            }
            if q.kind == AstBindingKind.Enum {
                var enums = c.tree.enums.as_slice()
                var edecl = enums[q.index]
                if edecl.type_parameters.count > 0 {
                    return fail(c, id, "generic enum requires type arguments")
                }
                if edecl.has_payload {
                    if !allow_incomplete {
                        resolve_union_layout(c, q.index)
                    }
                    var t = simple_type(TypeKind.TaggedUnion)
                    t.record = q.index
                    t.record_size = c.sema.unions.data[q.index].size
                    return t
                }
                var backing = resolve_enum_backing(c, edecl)
                backing.record = q.index + 1
                return backing
            }
            if q.kind == AstBindingKind.Struct {
                if !allow_incomplete {
                    resolve_struct_layout(c, q.index)
                }
                var t = simple_type(TypeKind.Struct)
                t.record = q.index
                t.record_size = c.sema.records.data[q.index].size
                return t
            }
            return fail(c, id, "unknown qualified type")
        }
        AstData.FuncType(aft) => {
            var children = c.tree.children.as_slice()
            var sft = SemaFuncType {
                params: Vec[SemaType] { arena: c.arena },
                result: simple_type(TypeKind.Void),
            }
            sft.params.init(c.arena, aft.params.count as u64)
            for var i: u32 = 0; i < aft.params.count && !c.has_error; i += 1 {
                var pt = resolve_type_inner(c, children[aft.params.first + i], true)
                sft.params.push(&pt)
            }
            if aft.return_type != NODE_NONE && !c.has_error {
                sft.result = resolve_type_inner(c, aft.return_type, true)
            }
            if c.has_error { return empty_type() }
            var idx = c.sema.func_types.len as u32
            c.sema.func_types.push(&sft)
            var t = simple_type(TypeKind.Func)
            t.record = idx
            return t
        }
        AstData.ResultType(inner_id) => {
            var inner = empty_type()
            var is_void = false
            match nodes[inner_id].data {
                AstData.TypeName(nlen) => {
                    if span_bytes(c.tree, node_span(c.tree, inner_id, nlen)) == "void" {
                        is_void = true
                    }
                }
                else => {}
            }
            if is_void {
                inner = simple_type(TypeKind.Void)
            } else {
                inner = resolve_type_inner(c, inner_id, allow_incomplete)
            }
            if c.has_error { return empty_type() }
            var al = type_alignment(c, inner)
            if al < 8 { al = 8 }
            var val_off: u32 = 24
            if al > 8 {
                val_off = ((24 + al - 1) / al) * al
            }
            var total = val_off + storage_size(inner)
            var rem = total % al
            if rem != 0 {
                total += al - rem
            }
            var t = simple_type(TypeKind.Result)
            t.length = val_off
            t.record_size = total
            t.element = inner.kind
            t.element_type = add_element(c, inner)
            t.element_size = storage_size(inner)
            return t
        }
        AstData.GenericType(_) => return specialize_record(c, id, allow_incomplete)
        AstData.ConstType(inner_id) => {
            var t = resolve_type_inner(c, inner_id, allow_incomplete)
            t.read_only = true
            return t
        }
        AstData.PointerType(pt) => {
            var pointee = resolve_type_inner(c, pt.pointee, true)
            if c.has_error { return empty_type() }
            var t = simple_type(TypeKind.Pointer)
            t.pointee = add_pointee(c, pointee)
            t.read_only = pt.read_only
            return t
        }
        AstData.ArrayType(at) => {
            var count_id = at.count
            var is_slice = count_id == NODE_NONE
            var elem = resolve_type_inner(c, at.elem, allow_incomplete || is_slice)
            if c.has_error { return empty_type() }
            if is_slice {
                var t = simple_type(TypeKind.Slice)
                t.element = elem.kind
                t.element_type = add_element(c, elem)
                t.element_size = storage_size(elem)
                t.record = elem.record
                t.record_size = elem.record_size
                t.pointee = elem.pointee
                t.read_only = elem.read_only
                return t
            }
            var arr_len: u64 = 0
            var is_int_len = false
            match nodes[count_id].data {
                AstData.Integer(nlen) => {
                    is_int_len = true
                    var text = span_bytes(c.tree, node_span(c.tree, count_id, nlen))
                    if !parse_int_literal(text, &arr_len) || arr_len > 2147483647 {
                        return fail(c, count_id, "invalid array length")
                    }
                }
                else => {}
            }
            if !is_int_len {
                var cname = node_ident_span(c.tree, count_id)
                var ci = find_const_idx(c, cname)
                if ci == (~0 as u32) {
                    var li = find_local(c, cname, 0)
                    if li >= 0 {
                        var locals = c.locals.as_slice()
                        if locals[li].is_const {
                            ci = locals[li].const_idx
                        }
                    }
                }
                if ci == (~0 as u32) {
                    return fail(c, count_id, "array length must be a constant")
                }
                check_const_decl(c, ci)
                if c.has_error { return empty_type() }
                var consts = c.sema.constants.data
                var sc = consts[ci]
                if !is_integer(sc.type_info.kind) || sc.bits == 0 || sc.bits > 2147483647 {
                    return fail(c, count_id, "invalid constant array length")
                }
                arr_len = sc.bits
            }
            var t = simple_type(TypeKind.Array)
            t.length = arr_len as u32
            t.element = elem.kind
            t.element_type = add_element(c, elem)
            t.element_size = storage_size(elem)
            t.record = elem.record
            t.record_size = elem.record_size
            t.pointee = elem.pointee
            t.read_only = elem.read_only
            return t
        }
        else => return fail(c, id, "unsupported type")
    }
}

fun resolve_type(c: *Checker, id: u32): SemaType {
    return resolve_type_inner(c, id, false)
}

fun resolve_struct_layout(c: *Checker, rec_idx: u32) {
    var recs = c.sema.records.data
    if recs[rec_idx].state == 2 {
        return
    }
    if recs[rec_idx].state == 1 {
        fail_at(c, 0, "recursive struct definition")
        return
    }
    recs[rec_idx].state = 1
    var decl_idx = recs[rec_idx].declaration
    var decls = c.tree.structs.as_slice()
    var decl = decls[decl_idx]
    if decl.fields.count == 0 {
        fail_at(c, decl.name.offset, "struct must have at least one field")
        return
    }

    var saved = enter_type_scope(c, decl.module, decl.type_parameters,
                                 (recs[rec_idx].arguments).as_slice(),
                                 c.instantiation_depth + 1)
    var offset: u32 = 0
    var max_align: u32 = 1
    var children = c.tree.children.as_slice()
    var nodes = c.tree.nodes.as_slice()
    for var i: u32 = 0; i < decl.fields.count && !c.has_error; i += 1 {
        var fid = children[decl.fields.first + i]
        var fname = node_ident_span(c.tree, fid)
        for var prev: u32 = 0; prev < i; prev += 1 {
            var pfid = children[decl.fields.first + prev]
            if same_span(c.tree, fname, node_ident_span(c.tree, pfid)) {
                leave_type_scope(c, saved)
                fail(c, fid, "duplicate struct field")
                return
            }
        }
        var ftype_node = NODE_NONE
        match nodes[fid].data {
            AstData.Field(f) => ftype_node = f.type_node
            else => {}
        }
        var ft = resolve_type(c, ftype_node)
        if c.has_error {
            leave_type_scope(c, saved)
            return
        }
        var align = type_alignment(c, ft)
        var sz = storage_size(ft)
        var rem = offset % align
        if rem != 0 {
            offset += align - rem
        }
        var sn = SemaNode {
            type_info: ft,
            binding: offset,
            builtin: SemaBuiltin.None,
            promotion: TypeKind.Invalid,
            method_call: 0,
            result_wrap: 0,
            box_any: false,
            is_fn_ref: false,
            is_indirect_call: false,
            is_boolean_literal: false,
            borrow_array: false,
            falls_through: false,
            is_enum_case: false,
            is_const: false,
        }
        recs = c.sema.records.data
        (recs[rec_idx].fields).push(&sn)
        offset += sz
        if align > max_align {
            max_align = align
        }
    }
    leave_type_scope(c, saved)
    var tail = offset % max_align
    if tail != 0 {
        offset += max_align - tail
    }
    recs = c.sema.records.data
    recs[rec_idx].size = offset
    recs[rec_idx].alignment = max_align
    recs[rec_idx].state = 2
    check_struct_traits(c, rec_idx)
}

fun resolve_union_layout(c: *Checker, u_idx: u32) {
    var uns = c.sema.unions.data
    if uns[u_idx].state == 2 {
        return
    }
    if uns[u_idx].state == 1 {
        fail_at(c, 0, "recursive enum definition")
        return
    }
    uns[u_idx].state = 1
    var decl_idx = uns[u_idx].declaration
    var decl = c.tree.enums.data[decl_idx]

    var saved = enter_type_scope(c, decl.module, decl.type_parameters,
                                 (uns[u_idx].arguments).as_slice(),
                                 c.instantiation_depth + 1)
    var max_size: u32 = 4
    var max_align: u32 = 4
    var children = c.tree.children.as_slice()
    var nodes = c.tree.nodes.as_slice()
    for var m: u32 = 0; m < decl.cases.count && !c.has_error; m += 1 {
        var cid = children[decl.cases.first + m]
        var ec = AstEnumCase { name_length: 0, fields: NodeRange { first: 0, count: 0 }, value: NODE_NONE, has_payload: false }
        match nodes[cid].data {
            AstData.EnumCase(cdata) => ec = cdata
            else => {}
        }
        var uv = SemaUnionVariant { fields: Vec[SemaNode] { arena: c.arena } }
        uv.fields.init(c.arena, (ec.fields.count + 1) as u64)
        var offset: u32 = 4
        for var fi: u32 = 0; fi < ec.fields.count && !c.has_error; fi += 1 {
            var ft_node = children[ec.fields.first + fi]
            var ft = resolve_type(c, ft_node)
            if c.has_error {
                leave_type_scope(c, saved)
                return
            }
            var align = type_alignment(c, ft)
            var sz = storage_size(ft)
            var rem = offset % align
            if rem != 0 {
                offset += align - rem
            }
            var sn = SemaNode {
                type_info: ft,
                binding: offset,
                builtin: SemaBuiltin.None,
                promotion: TypeKind.Invalid,
                method_call: 0,
                result_wrap: 0,
                box_any: false,
                is_fn_ref: false,
                is_indirect_call: false,
                is_boolean_literal: false,
                borrow_array: false,
                falls_through: false,
                is_enum_case: false,
                is_const: false,
            }
            uv.fields.push(&sn)
            offset += sz
            if align > max_align {
                max_align = align
            }
        }
        if offset > max_size {
            max_size = offset
        }
        uns = c.sema.unions.data
        (uns[u_idx].variants).push(&uv)
    }
    leave_type_scope(c, saved)
    var tail = max_size % max_align
    if tail != 0 {
        max_size += max_align - tail
    }
    var uns2 = c.sema.unions.data
    uns2[u_idx].size = max_size
    uns2[u_idx].alignment = max_align
    uns2[u_idx].state = 2
    check_union_traits(c, u_idx)
}

const BUILTIN_TRAIT_EQ: u32 = 0xFFFFFFFE
const BUILTIN_TRAIT_HASH: u32 = 0xFFFFFFFD

fun resolve_trait_ref(c: *Checker, id: u32): u32 {
    var nodes = c.tree.nodes.as_slice()
    match nodes[id].data {
        AstData.TypeName(nlen) => {
            var name = node_span(c.tree, id, nlen)
            var tidx = find_trait_idx(c, name)
            if tidx != (~0 as u32) {
                return tidx
            }
            var text = span_bytes(c.tree, name)
            if text == "Eq" { return BUILTIN_TRAIT_EQ }
            if text == "Hash" { return BUILTIN_TRAIT_HASH }
            fail(c, id, "unknown trait")
            return ~0 as u32
        }
        AstData.QualifiedType(_) => {
            var q: AstQualified
            if find_qualified(c.tree, id, &q) && q.kind == AstBindingKind.Trait && !q.inaccessible {
                return q.index
            }
            fail(c, id, "unknown qualified trait")
            return ~0 as u32
        }
        else => {
            fail(c, id, "expected trait name")
            return ~0 as u32
        }
    }
}

fun is_eq_trait(c: *Checker, tidx: u32): bool {
    if tidx == BUILTIN_TRAIT_EQ { return true }
    if tidx < (c.tree.traits.len as u32) {
        return span_bytes(c.tree, c.tree.traits.data[tidx].name) == "Eq"
    }
    return false
}

fun is_hash_trait(c: *Checker, tidx: u32): bool {
    if tidx == BUILTIN_TRAIT_HASH { return true }
    if tidx < (c.tree.traits.len as u32) {
        return span_bytes(c.tree, c.tree.traits.data[tidx].name) == "Hash"
    }
    return false
}

fun is_byte_slice(t: SemaType): bool {
    return t.kind == TypeKind.Slice && (t.element == TypeKind.U8 || t.element == TypeKind.I8)
}

fun find_method_idx_by_bytes(c: *Checker, struct_decl: u32, name: []u8): u32 {
    var fns = c.tree.functions.as_slice()
    for i, f in fns {
        if f.owner_struct == struct_decl && span_bytes(c.tree, f.name) == name {
            return i as u32
        }
    }
    return ~0 as u32
}

fun specialize_struct_method(c: *Checker, struct_t: SemaType, fi: u32): u32 {
    var fdecl = c.tree.functions.data[fi]
    if fdecl.type_parameters.count == 0 {
        return fi
    }
    var sr = &c.sema.records.data[struct_t.record]
    if fdecl.type_parameters.count != (sr.arguments.len as u32) {
        return ~0 as u32
    }
    var margs: Vec[SemaType]
    margs.init(c.arena, sr.arguments.len)
    for var ai: u64 = 0; ai < sr.arguments.len; ai += 1 {
        margs.push(&sr.arguments.data[ai])
    }
    return specialize_function_with_args(c, 0, fi, margs)
}

fun find_user_eq_method(c: *Checker, t: SemaType): u32 {
    if t.kind != TypeKind.Struct { return ~0 as u32 }
    var sr = &c.sema.records.data[t.record]
    var fi = find_method_idx_by_bytes(c, sr.declaration, "eq")
    if fi == (~0 as u32) { return ~0 as u32 }
    fi = specialize_struct_method(c, t, fi)
    if fi == (~0 as u32) || c.has_error { return ~0 as u32 }
    var sf = &c.sema.functions.data[fi]
    if sf.param_types.len != 2 || sf.result.kind != TypeKind.Bool { return ~0 as u32 }
    var p0 = sf.param_types.data[0]
    var p1 = sf.param_types.data[1]
    if p0.kind != TypeKind.Pointer || p1.kind != TypeKind.Pointer { return ~0 as u32 }
    if !same_type(c, c.sema.pointees.data[p0.pointee], t) { return ~0 as u32 }
    if !same_type(c, c.sema.pointees.data[p1.pointee], t) { return ~0 as u32 }
    return fi
}

fun find_user_hash_method(c: *Checker, t: SemaType): u32 {
    if t.kind != TypeKind.Struct { return ~0 as u32 }
    var sr = &c.sema.records.data[t.record]
    var fi = find_method_idx_by_bytes(c, sr.declaration, "hash")
    if fi == (~0 as u32) { return ~0 as u32 }
    fi = specialize_struct_method(c, t, fi)
    if fi == (~0 as u32) || c.has_error { return ~0 as u32 }
    var sf = &c.sema.functions.data[fi]
    if sf.param_types.len != 1 || sf.result.kind != TypeKind.U64 { return ~0 as u32 }
    var p0 = sf.param_types.data[0]
    if p0.kind != TypeKind.Pointer { return ~0 as u32 }
    if !same_type(c, c.sema.pointees.data[p0.pointee], t) { return ~0 as u32 }
    return fi
}

fun supports_eq(c: *Checker, t: SemaType): bool {
    if is_integer(t.kind) || is_float(t.kind) || t.kind == TypeKind.Bool || t.kind == TypeKind.Pointer || is_byte_slice(t) {
        return true
    }
    if t.kind == TypeKind.Struct {
        resolve_struct_layout(c, t.record)
        return c.sema.records.data[t.record].auto_eq || find_user_eq_method(c, t) != (~0 as u32)
    }
    if t.kind == TypeKind.TaggedUnion {
        resolve_union_layout(c, t.record)
        return c.sema.unions.data[t.record].auto_eq
    }
    return false
}

fun supports_hash(c: *Checker, t: SemaType): bool {
    if is_integer(t.kind) || t.kind == TypeKind.Bool || is_byte_slice(t) {
        return true
    }
    if t.kind == TypeKind.Struct {
        resolve_struct_layout(c, t.record)
        return c.sema.records.data[t.record].auto_hash || find_user_hash_method(c, t) != (~0 as u32)
    }
    if t.kind == TypeKind.TaggedUnion {
        resolve_union_layout(c, t.record)
        return c.sema.unions.data[t.record].auto_hash
    }
    return false
}

fun type_has_declared_trait(c: *Checker, traits: NodeRange, target: u32): bool {
    var children = c.tree.children.as_slice()
    for var i: u32 = 0; i < traits.count; i += 1 {
        var tidx = resolve_trait_ref(c, children[traits.first + i])
        if tidx == target { return true }
        if is_eq_trait(c, tidx) && is_eq_trait(c, target) { return true }
        if is_hash_trait(c, tidx) && is_hash_trait(c, target) { return true }
    }
    return false
}

fun type_satisfies_trait(c: *Checker, t: SemaType, tidx: u32): bool {
    if is_eq_trait(c, tidx) {
        return supports_eq(c, t)
    }
    if is_hash_trait(c, tidx) {
        return supports_hash(c, t)
    }
    if t.kind == TypeKind.Struct {
        resolve_struct_layout(c, t.record)
        var decl = c.tree.structs.data[c.sema.records.data[t.record].declaration]
        return type_has_declared_trait(c, decl.traits, tidx)
    }
    if t.kind == TypeKind.TaggedUnion {
        resolve_union_layout(c, t.record)
        var decl = c.tree.enums.data[c.sema.unions.data[t.record].declaration]
        return type_has_declared_trait(c, decl.traits, tidx)
    }
    if is_enum(t) {
        var decl = c.tree.enums.data[t.record - 1]
        return type_has_declared_trait(c, decl.traits, tidx)
    }
    return false
}

fun check_generic_bounds(c: *Checker, site_id: u32, tp_range: NodeRange, args: []SemaType): bool {
    var children = c.tree.children.as_slice()
    var nodes = c.tree.nodes.as_slice()
    for var i: u32 = 0; i < tp_range.count; i += 1 {
        var tp_id = children[tp_range.first + i]
        var brange = NodeRange { first: 0, count: 0 }
        match nodes[tp_id].data {
            AstData.TypeParam(tp) => brange = tp.bounds
            else => {}
        }
        for var bi: u32 = 0; bi < brange.count; bi += 1 {
            var tidx = resolve_trait_ref(c, children[brange.first + bi])
            if c.has_error { return false }
            if !type_satisfies_trait(c, args[i], tidx) {
                if !c.has_error {
                    fail(c, site_id, "type argument does not satisfy trait bound")
                }
                return false
            }
        }
    }
    return true
}

fun check_struct_traits(c: *Checker, rec_idx: u32) {
    var sr = &c.sema.records.data[rec_idx]
    var decl = c.tree.structs.data[sr.declaration]
    if decl.traits.count == 0 || c.has_error { return }
    var self_t = simple_type(TypeKind.Struct)
    self_t.record = rec_idx
    self_t.record_size = sr.size
    var children = c.tree.children.as_slice()
    for var i: u32 = 0; i < decl.traits.count && !c.has_error; i += 1 {
        var tnode = children[decl.traits.first + i]
        var tidx = resolve_trait_ref(c, tnode)
        if c.has_error { return }
        if is_eq_trait(c, tidx) {
            if find_user_eq_method(c, self_t) == (~0 as u32) {
                var fields = c.sema.records.data[rec_idx].fields.as_slice()
                for f in fields {
                    if !supports_eq(c, f.type_info) {
                        fail(c, tnode, "struct field does not support Eq")
                        return
                    }
                }
                c.sema.records.data[rec_idx].auto_eq = true
            }
        } else if is_hash_trait(c, tidx) {
            if find_user_hash_method(c, self_t) == (~0 as u32) {
                var fields = c.sema.records.data[rec_idx].fields.as_slice()
                for f in fields {
                    if !supports_hash(c, f.type_info) {
                        fail(c, tnode, "struct field does not support Hash")
                        return
                    }
                }
                c.sema.records.data[rec_idx].auto_hash = true
            }
        } else {
            var tr = c.tree.traits.data[tidx]
            var nodes = c.tree.nodes.as_slice()
            var saved = enter_type_scope(c, decl.module, decl.type_parameters,
                                         (c.sema.records.data[rec_idx].arguments).as_slice(),
                                         c.instantiation_depth + 1)
            var saved_owner = c.owner_struct
            c.owner_struct = sr.declaration
            for var mi: u32 = 0; mi < tr.methods.count && !c.has_error; mi += 1 {
                var mnode_id = children[tr.methods.first + mi]
                var mfn_idx: u32 = 0
                match nodes[mnode_id].data {
                    AstData.Function(fi) => mfn_idx = fi
                    else => {}
                }
                var mfn_decl = c.tree.functions.data[mfn_idx]
                var mname = span_bytes(c.tree, mfn_decl.name)
                var impl_fi = find_method_idx_by_bytes(c, sr.declaration, mname)
                if impl_fi == (~0 as u32) {
                    fail(c, tnode, "struct does not implement required trait method")
                    break
                }
                impl_fi = specialize_struct_method(c, self_t, impl_fi)
                if c.has_error || impl_fi == (~0 as u32) { break }
                var impl_sf = &c.sema.functions.data[impl_fi]
                if impl_sf.param_types.len != (mfn_decl.parameters.count as u64) {
                    fail(c, tnode, "trait method parameter count mismatch")
                    break
                }
                var saved_mod = c.module
                c.module = tr.module
                var exp_ret = resolve_type(c, mfn_decl.return_type)
                if !c.has_error && !same_type(c, impl_sf.result, exp_ret) {
                    fail(c, tnode, "trait method return type mismatch")
                }
                for var pi: u32 = 0; pi < mfn_decl.parameters.count && !c.has_error; pi += 1 {
                    var pt_id = NODE_NONE
                    match nodes[children[mfn_decl.parameters.first + pi]].data {
                        AstData.Parameter(p) => pt_id = p.type_node
                        else => {}
                    }
                    var exp_pt = resolve_type(c, pt_id)
                    if !c.has_error && !same_type(c, impl_sf.param_types.data[pi], exp_pt) {
                        fail(c, tnode, "trait method parameter type mismatch")
                    }
                }
                c.module = saved_mod
            }
            c.owner_struct = saved_owner
            leave_type_scope(c, saved)
        }
    }
}

fun check_union_traits(c: *Checker, u_idx: u32) {
    var su = &c.sema.unions.data[u_idx]
    var decl = c.tree.enums.data[su.declaration]
    if decl.traits.count == 0 || c.has_error { return }
    var children = c.tree.children.as_slice()
    for var i: u32 = 0; i < decl.traits.count && !c.has_error; i += 1 {
        var tnode = children[decl.traits.first + i]
        var tidx = resolve_trait_ref(c, tnode)
        if c.has_error { return }
        if is_eq_trait(c, tidx) {
            var variants = c.sema.unions.data[u_idx].variants.as_slice()
            for v in variants {
                var fields = v.fields.as_slice()
                for f in fields {
                    if !supports_eq(c, f.type_info) {
                        fail(c, tnode, "enum variant field does not support Eq")
                        return
                    }
                }
            }
            c.sema.unions.data[u_idx].auto_eq = true
        } else if is_hash_trait(c, tidx) {
            var variants = c.sema.unions.data[u_idx].variants.as_slice()
            for v in variants {
                var fields = v.fields.as_slice()
                for f in fields {
                    if !supports_hash(c, f.type_info) {
                        fail(c, tnode, "enum variant field does not support Hash")
                        return
                    }
                }
            }
            c.sema.unions.data[u_idx].auto_hash = true
        } else {
            fail(c, tnode, "enum only supports Eq and Hash traits")
            return
        }
    }
}

fun find_enum_for_member(c: *Checker, member_id: u32): u32 {
    var nodes = c.tree.nodes.as_slice()
    var children = c.tree.children.as_slice()
    var base_id = NODE_NONE
    match nodes[member_id].data {
        AstData.Member(m) => base_id = m.base
        else => return ~0 as u32
    }
    var q: AstQualified
    if find_qualified(c.tree, member_id, &q) && q.kind == AstBindingKind.Enum && !q.inaccessible {
        return q.index
    }
    match nodes[base_id].data {
        AstData.Identifier(nlen) => {
            var ename = node_span(c.tree, base_id, nlen)
            if find_local(c, ename, 0) < 0 {
                return find_enum_idx(c, ename)
            }
        }
        AstData.GenericType(gr) => {
            if find_qualified(c.tree, base_id, &q) && q.kind == AstBindingKind.Enum && !q.inaccessible {
                return q.index
            }
            var gbase = children[gr.first]
            if find_qualified(c.tree, gbase, &q) && q.kind == AstBindingKind.Enum && !q.inaccessible {
                return q.index
            }
            match nodes[gbase].data {
                AstData.Identifier(nlen) => return find_enum_idx(c, node_span(c.tree, gbase, nlen))
                AstData.TypeName(nlen) => return find_enum_idx(c, node_span(c.tree, gbase, nlen))
                else => {}
            }
        }
        else => {}
    }
    return ~0 as u32
}

fun resolve_enum_member_type(c: *Checker, id: u32, ei: u32, base_id: u32, mname: Span, expected: SemaType, allow_payload: bool): SemaType {
    var nodes = c.tree.nodes.as_slice()
    var enums = c.tree.enums.as_slice()
    var edecl = enums[ei]
    var children = c.tree.children.as_slice()
    for var i: u32 = 0; i < edecl.cases.count; i += 1 {
        var cid = children[edecl.cases.first + i]
        var ec = AstEnumCase { name_length: 0, fields: NodeRange { first: 0, count: 0 }, value: NODE_NONE, has_payload: false }
        match nodes[cid].data {
            AstData.EnumCase(cdata) => ec = cdata
            else => {}
        }
        if same_span(c.tree, mname, node_span(c.tree, cid, ec.name_length)) {
            if !edecl.has_payload {
                var sn = node_info(c, id)
                sn.is_enum_case = true
                sn.binding = c.sema.nodes.data[cid].binding
                var res = resolve_enum_backing(c, edecl)
                res.record = ei + 1
                return res
            }
            if !allow_payload && ec.has_payload {
                return fail(c, id, "enum variant requires payload arguments")
            }
            var ut: SemaType
            var is_generic_base = false
            match nodes[base_id].data {
                AstData.GenericType(_) => is_generic_base = true
                else => {}
            }
            if edecl.type_parameters.count == 0 {
                resolve_union_layout(c, ei)
                ut = simple_type(TypeKind.TaggedUnion)
                ut.record = ei
                ut.record_size = c.sema.unions.data[ei].size
            } else if is_generic_base {
                ut = specialize_record(c, base_id, false)
            } else if expected.kind == TypeKind.TaggedUnion && c.sema.unions.data[expected.record].declaration == ei {
                ut = expected
            } else {
                return fail(c, base_id, "generic enum requires type arguments")
            }
            if c.has_error { return empty_type() }
            var sn = node_info(c, id)
            sn.is_enum_case = true
            sn.binding = i
            sn.type_info = ut
            return ut
        }
    }
    return fail(c, id, "unknown enum member")
}

fun eval_const_expr(c: *Checker, id: u32, expected: SemaType, out_bits: *u64, out_str: *u32): SemaType {
    var nodes = c.tree.nodes.as_slice()
    var node = nodes[id]
    *out_str = NODE_NONE
    match node.data {
        AstData.Null => {
            if expected.kind == TypeKind.Pointer {
                *out_bits = 0
                return expected
            }
            return fail(c, id, "null requires a pointer type")
        }
        AstData.Integer(nlen) => {
            var text = span_bytes(c.tree, node_span(c.tree, id, nlen))
            var bits: u64 = 0
            if !parse_int_literal(text, &bits) {
                if text[0] == '\'' {
                    return fail(c, id, "invalid character literal")
                }
                return fail(c, id, "invalid integer literal")
            }
            var kind = TypeKind.I32
            if is_integer(expected.kind) {
                kind = expected.kind
            } else if bits > 2147483647 {
                kind = TypeKind.I64
            }
            if !int_fits_type(bits, false, kind) {
                return fail(c, id, "integer literal out of range")
            }
            *out_bits = bits
            return simple_type(kind)
        }
        AstData.Float(nlen) => {
            var k = TypeKind.F64
            if expected.kind == TypeKind.F32 {
                k = TypeKind.F32
            }
            var text = span_bytes(c.tree, node_span(c.tree, id, nlen))
            var val: f64 = 0.0
            var i: i64 = 0
            for i < len(text) && text[i] >= '0' && text[i] <= '9' {
                val = val * 10.0 + ((text[i] - '0') as f64)
                i += 1
            }
            if i < len(text) && text[i] == '.' {
                i += 1
                var frac: f64 = 0.1
                for i < len(text) && text[i] >= '0' && text[i] <= '9' {
                    val = val + ((text[i] - '0') as f64) * frac
                    frac = frac * 0.1
                    i += 1
                }
            }
            if k == TypeKind.F32 {
                var f = val as f32
                var ptr = ((&f) as u64) as *const u32
                *out_bits = (*ptr) as u64
            } else {
                var ptr = ((&val) as u64) as *const u64
                *out_bits = *ptr
            }
            return simple_type(k)
        }
        AstData.Unary(un) => {
            var uop = un.op
            var inner_id = un.operand
            if uop == UnaryOp.Positive || uop == UnaryOp.BitNot || uop == UnaryOp.LogicalNot {
                var b: u64 = 0
                var s: u32 = 0
                var t = eval_const_expr(c, inner_id, expected, &b, &s)
                if uop == UnaryOp.BitNot {
                    *out_bits = ~b
                } else if uop == UnaryOp.LogicalNot {
                    if b == 0 { *out_bits = 1 } else { *out_bits = 0 }
                    return simple_type(TypeKind.Bool)
                } else {
                    *out_bits = b
                }
                return t
            }
            if uop == UnaryOp.Negate {
                var int_len: u32 = 0
                var is_int = false
                match nodes[inner_id].data {
                    AstData.Integer(l) => {
                        is_int = true
                        int_len = l
                    }
                    else => {}
                }
                if is_int {
                    var text = span_bytes(c.tree, node_span(c.tree, inner_id, int_len))
                    var bits: u64 = 0
                    if !parse_int_literal(text, &bits) {
                        return fail(c, inner_id, "invalid integer literal")
                    }
                    var kind = TypeKind.I32
                    if is_integer(expected.kind) {
                        kind = expected.kind
                    } else if bits > 2147483648 {
                        kind = TypeKind.I64
                    }
                    if !int_fits_type(bits, true, kind) {
                        return fail(c, inner_id, "integer literal out of range")
                    }
                    *out_bits = (0 as u64) - bits
                    return simple_type(kind)
                }
                var b: u64 = 0
                var s: u32 = 0
                var t = eval_const_expr(c, inner_id, expected, &b, &s)
                if t.kind == TypeKind.F64 {
                    *out_bits = b ^ ((1 as u64) << 63)
                } else if t.kind == TypeKind.F32 {
                    *out_bits = b ^ ((1 as u64) << 31)
                } else {
                    *out_bits = (0 as u64) - b
                }
                return t
            }
            return fail(c, id, "constant expression required")
        }
        AstData.Identifier(nlen) => {
            var name = node_span(c.tree, id, nlen)
            var text = span_bytes(c.tree, name)
            if text == "true" {
                *out_bits = 1
                return simple_type(TypeKind.Bool)
            }
            if text == "false" {
                *out_bits = 0
                return simple_type(TypeKind.Bool)
            }
            var ci = find_const_idx(c, name)
            if ci == (~0 as u32) {
                var li = find_local(c, name, 0)
                if li >= 0 {
                    var locals = c.locals.as_slice()
                    if locals[li].is_const {
                        ci = locals[li].const_idx
                    }
                }
            }
            if ci != (~0 as u32) {
                check_const_decl(c, ci)
                if c.has_error { return empty_type() }
                var consts = c.sema.constants.data
                *out_bits = consts[ci].bits
                *out_str = consts[ci].str_node
                return consts[ci].type_info
            }
            return fail(c, id, "constant expression required")
        }
        AstData.String(nlen) => {
            *out_str = id
            var arr = simple_type(TypeKind.Array)
            arr.element = TypeKind.U8
            arr.element_size = 1
            var elem = simple_type(TypeKind.U8)
            arr.element_type = add_element(c, elem)
            arr.length = decoded_string_len(span_bytes(c.tree, node_span(c.tree, id, nlen)))
            set_node_type(c, id, arr)
            return arr
        }
        AstData.Member(m) => {
            var base_id = m.base
            var mlen = m.name_length
            var q: AstQualified
            if find_qualified(c.tree, id, &q) {
                if q.kind == AstBindingKind.Const && !q.inaccessible {
                    check_const_decl(c, q.index)
                    if c.has_error { return empty_type() }
                    var consts = c.sema.constants.data
                    *out_bits = consts[q.index].bits
                    *out_str = consts[q.index].str_node
                    return consts[q.index].type_info
                }
                if q.kind == AstBindingKind.Enum && !q.inaccessible {
                    var ei = q.index
                    var mname = node_span(c.tree, id, mlen)
                    var enums = c.tree.enums.as_slice()
                    var edecl = enums[ei]
                    var children = c.tree.children.as_slice()
                    var sn = c.sema.nodes.data
                    var evals = c.sema.enum_values.as_slice()
                    for var i: u32 = 0; i < edecl.cases.count; i += 1 {
                        var cid = children[edecl.cases.first + i]
                        if same_span(c.tree, mname, node_ident_span(c.tree, cid)) {
                            if edecl.has_payload {
                                return fail(c, id, "tagged union is not a constant expression")
                            }
                            *out_bits = evals[sn[cid].binding]
                            var et = resolve_enum_backing(c, edecl)
                            et.record = ei + 1
                            return et
                        }
                    }
                }
            }
            match nodes[base_id].data {
                AstData.Identifier(blen) => {
                    var ename = node_span(c.tree, base_id, blen)
                    var ei = find_enum_idx(c, ename)
                    if ei != (~0 as u32) {
                        var mname = node_span(c.tree, id, mlen)
                        var enums = c.tree.enums.as_slice()
                        var edecl = enums[ei]
                        var children = c.tree.children.as_slice()
                        var sn = c.sema.nodes.data
                        var evals = c.sema.enum_values.as_slice()
                        for var i: u32 = 0; i < edecl.cases.count; i += 1 {
                            var cid = children[edecl.cases.first + i]
                            if same_span(c.tree, mname, node_ident_span(c.tree, cid)) {
                                if edecl.has_payload {
                                    return fail(c, id, "tagged union is not a constant expression")
                                }
                                *out_bits = evals[sn[cid].binding]
                                var et = resolve_enum_backing(c, edecl)
                                et.record = ei + 1
                                return et
                            }
                        }
                    }
                }
                else => {}
            }
            return fail(c, id, "constant expression required")
        }
        AstData.Cast(ca) => {
            var dst = resolve_type(c, ca.target_type)
            if c.has_error { return empty_type() }
            var b: u64 = 0
            var s: u32 = 0
            var src_t = eval_const_expr(c, ca.expr, dst, &b, &s)
            if dst.kind == TypeKind.F64 && is_integer(src_t.kind) {
                var d: f64 = 0.0
                if is_signed(src_t.kind) { d = (b as i64) as f64 } else { d = b as f64 }
                var ptr = ((&d) as u64) as *const u64
                b = *ptr
            } else if dst.kind == TypeKind.F32 && is_integer(src_t.kind) {
                var f: f32 = 0.0
                if is_signed(src_t.kind) { f = (b as i64) as f32 } else { f = b as f32 }
                var ptr = ((&f) as u64) as *const u32
                b = (*ptr) as u64
            } else if is_integer(dst.kind) && src_t.kind == TypeKind.F64 {
                var ptr = ((&b) as u64) as *const f64
                var d = *ptr
                if is_signed(dst.kind) { b = (d as i64) as u64 } else { b = d as u64 }
            } else if is_integer(dst.kind) && src_t.kind == TypeKind.F32 {
                var b32 = b as u32
                var ptr = ((&b32) as u64) as *const f32
                var f = *ptr
                if is_signed(dst.kind) { b = (f as i64) as u64 } else { b = f as u64 }
            } else if dst.kind == TypeKind.F32 && src_t.kind == TypeKind.F64 {
                var ptr = ((&b) as u64) as *const f64
                var f = (*ptr) as f32
                var fptr = ((&f) as u64) as *const u32
                b = (*fptr) as u64
            } else if dst.kind == TypeKind.F64 && src_t.kind == TypeKind.F32 {
                var b32 = b as u32
                var ptr = ((&b32) as u64) as *const f32
                var d = (*ptr) as f64
                var dptr = ((&d) as u64) as *const u64
                b = *dptr
            } else if dst.kind == TypeKind.Bool {
                if src_t.kind == TypeKind.F64 {
                    var ptr = ((&b) as u64) as *const f64
                    if *ptr != 0.0 { b = 1 } else { b = 0 }
                } else if src_t.kind == TypeKind.F32 {
                    var b32 = b as u32
                    var ptr = ((&b32) as u64) as *const f32
                    if *ptr != 0.0 { b = 1 } else { b = 0 }
                } else {
                    if b != 0 { b = 1 } else { b = 0 }
                }
            }
            *out_bits = b
            return dst
        }
        AstData.Binary(bin) => {
            var bop = bin.op
            var lhs_id = bin.left
            var rhs_id = bin.right
            if (bop as u8) >= (BinaryOp.Add as u8) && (bop as u8) <= (BinaryOp.ShiftRight as u8) {
                var lb: u64 = 0
                var rb: u64 = 0
                var ls: u32 = 0
                var rs: u32 = 0
                var lt = eval_const_expr(c, lhs_id, expected, &lb, &ls)
                var rt = eval_const_expr(c, rhs_id, lt, &rb, &rs)
                if c.has_error { return empty_type() }
                if !is_integer(lt.kind) || !is_integer(rt.kind) {
                    return fail(c, id, "constant binary expression requires integers")
                }
                if bop == BinaryOp.Add { *out_bits = lb + rb; return lt }
                if bop == BinaryOp.Subtract { *out_bits = lb - rb; return lt }
                if bop == BinaryOp.Multiply { *out_bits = lb * rb; return lt }
                if bop == BinaryOp.Divide {
                    if rb == 0 { return fail(c, id, "division by zero in constant") }
                    *out_bits = lb / rb
                    return lt
                }
                if bop == BinaryOp.Remainder {
                    if rb == 0 { return fail(c, id, "division by zero in constant") }
                    *out_bits = lb % rb
                    return lt
                }
                if bop == BinaryOp.BitAnd { *out_bits = lb & rb; return lt }
                if bop == BinaryOp.BitOr { *out_bits = lb | rb; return lt }
                if bop == BinaryOp.BitXor { *out_bits = lb ^ rb; return lt }
                if bop == BinaryOp.ShiftLeft { *out_bits = lb << rb; return lt }
                if bop == BinaryOp.ShiftRight { *out_bits = lb >> rb; return lt }
            }
            return fail(c, id, "constant expression required")
        }
        else => return fail(c, id, "constant expression required")
    }
}

fun check_const_decl(c: *Checker, idx: u32) {
    var consts = c.sema.constants.data
    if consts[idx].state == 2 {
        return
    }
    if consts[idx].state == 1 {
        var decls = c.tree.consts.as_slice()
        fail_at(c, decls[idx].name.offset, "cyclic constant definition")
        return
    }
    consts[idx].state = 1
    var decls = c.tree.consts.as_slice()
    var decl = decls[idx]
    var saved = enter_type_scope(c, decl.module, NodeRange { first: 0, count: 0 }, c.type_arguments, 0)
    var expected = empty_type()
    if decl.type_node != NODE_NONE {
        expected = resolve_type(c, decl.type_node)
        if c.has_error { leave_type_scope(c, saved); return }
    }
    var bits: u64 = 0
    var str_node: u32 = 0
    var val_type = eval_const_expr(c, decl.value, expected, &bits, &str_node)
    leave_type_scope(c, saved)
    if c.has_error { return }
    if decl.type_node != NODE_NONE && !same_type(c, val_type, expected) {
        if expected.kind == TypeKind.Slice && val_type.kind == TypeKind.Array {
            var elems = c.sema.elements.as_slice()
            if same_type(c, elems[val_type.element_type], elems[expected.element_type]) {
                val_type = expected
            } else {
                fail_at(c, decl.name.offset, "constant type mismatch")
                return
            }
        } else if is_numeric(val_type.kind) && can_widen_num(val_type.kind, expected.kind) {
            val_type = expected
        } else {
            fail_at(c, decl.name.offset, "constant type mismatch")
            return
        }
    }
    consts = c.sema.constants.data
    consts[idx].type_info = val_type
    consts[idx].bits = bits
    consts[idx].str_node = str_node
    consts[idx].state = 2
}

fun set_node_type(c: *Checker, id: u32, t: SemaType) {
    node_info(c, id).type_info = t
}

fun check_value(c: *Checker, id: u32, expected: SemaType): SemaType {
    var t = check_expr(c, id, expected)
    if c.has_error || expected.kind == TypeKind.Invalid {
        return t
    }
    if same_type(c, t, expected) {
        return t
    }
    if expected.kind == TypeKind.Result {
        if t.kind == TypeKind.Error {
            var sn = node_info(c, id)
            sn.result_wrap = 2
            sn.type_info = expected
            return expected
        }
        var inner_exp = c.sema.elements.data[expected.element_type]
        if inner_exp.kind == TypeKind.Void {
            return fail(c, id, "cannot return a value from !void")
        }
        check_value(c, id, inner_exp)
        if !c.has_error {
            node_info(c, id).result_wrap = 1
        }
        return expected
    }
    if expected.kind == TypeKind.Any {
        if t.kind == TypeKind.Array {
            var sn = node_info(c, id)
            sn.borrow_array = true
            sn.box_any = true
            return expected
        }
        node_info(c, id).box_any = true
        return expected
    }
    if expected.kind == TypeKind.Slice && t.kind == TypeKind.Array {
        var elems = c.sema.elements.as_slice()
        var te = elems[t.element_type]
        var ee = elems[expected.element_type]
        if expected.read_only {
            te.read_only = ee.read_only
        }
        if same_type(c, te, ee) {
            node_info(c, id).borrow_array = true
            return expected
        }
    }
    if expected.kind == TypeKind.Slice && t.kind == TypeKind.Slice && expected.read_only && !t.read_only {
        var elems = c.sema.elements.as_slice()
        var te = elems[t.element_type]
        var ee = elems[expected.element_type]
        te.read_only = ee.read_only
        if same_type(c, te, ee) {
            return expected
        }
    }
    if expected.kind == TypeKind.Pointer && t.kind == TypeKind.Pointer && expected.read_only && !t.read_only {
        var pts = c.sema.pointees.as_slice()
        if same_type(c, pts[t.pointee], pts[expected.pointee]) {
            return expected
        }
    }
    if !is_enum(t) && !is_enum(expected) && can_widen_num(t.kind, expected.kind) {
        node_info(c, id).promotion = expected.kind
        return expected
    }
    return fail(c, id, "type mismatch")
}

fun is_writable_lvalue(c: *Checker, id: u32): bool {
    var nodes = c.tree.nodes.as_slice()
    var cur = id
    for {
        var base = NODE_NONE
        var is_idx = false
        var cont = false
        match nodes[cur].data {
            AstData.Member(m) => {
                base = m.base
                cont = true
            }
            AstData.Index(ix) => {
                base = ix.base
                is_idx = true
                cont = true
            }
            else => {}
        }
        if !cont { break }
        var bt = node_info(c, base).type_info
        if bt.kind == TypeKind.Pointer {
            return !bt.read_only
        }
        if is_idx && bt.kind == TypeKind.Slice {
            return !bt.read_only
        }
        cur = base
    }
    match nodes[cur].data {
        AstData.Unary(un) => {
            if un.op == UnaryOp.Dereference {
                return !node_info(c, un.operand).type_info.read_only
            }
            return false
        }
        AstData.Identifier(_) => {
            var sn = node_info(c, cur)
            return !sn.is_const && !sn.is_boolean_literal
        }
        else => return false
    }
}

fun register_fn_sig(c: *Checker, fn_idx: u32) {
    var fdecls = c.tree.functions.as_slice()
    var children = c.tree.children.as_slice()
    var nodes = c.tree.nodes.as_slice()
    var sf = &c.sema.functions.data[fn_idx]
    var fdecl = fdecls[sf.declaration]
    var saved = enter_type_scope(c, fdecl.module, fdecl.type_parameters,
                                 sf.arguments.as_slice(),
                                 c.instantiation_depth + 1)
    c.owner_struct = fdecl.owner_struct
    var res_t = resolve_type(c, fdecl.return_type)
    c.sema.functions.data[fn_idx].result = res_t
    for var p: u32 = 0; p < fdecl.parameters.count && !c.has_error; p += 1 {
        var pid = children[fdecl.parameters.first + p]
        var pt_id = NODE_NONE
        match nodes[pid].data {
            AstData.Parameter(par) => pt_id = par.type_node
            else => {}
        }
        var pt = resolve_type(c, pt_id)
        if fdecl.is_variadic && p == fdecl.parameters.count - 1 && !c.has_error {
            var st = simple_type(TypeKind.Slice)
            st.element = pt.kind
            st.element_type = add_element(c, pt)
            st.element_size = storage_size(pt)
            st.record = pt.record
            st.record_size = pt.record_size
            st.pointee = pt.pointee
            st.read_only = true
            pt = st
        }
        (c.sema.functions.data[fn_idx].param_types).push(&pt)
    }
    leave_type_scope(c, saved)
}

fun specialize_function_with_args(c: *Checker, site_id: u32, decl_idx: u32, args: Vec[SemaType]): u32 {
    var fdecls = c.tree.functions.as_slice()
    var fdecl = fdecls[decl_idx]
    var arg_slice = args.as_slice()
    if !check_generic_bounds(c, site_id, fdecl.type_parameters, arg_slice) {
        return ~0 as u32
    }
    var fns = c.sema.functions.data
    for var i = c.tree.functions.len as i64; i < (c.sema.functions.len as i64); i += 1 {
        if fns[i].declaration == decl_idx && same_type_args(c, (fns[i].arguments).as_slice(), arg_slice) {
            return i as u32
        }
    }
    if c.instantiation_depth >= 64 {
        fail(c, site_id, "generic instantiation nesting limit exceeded")
        return ~0 as u32
    }
    var fn_idx = c.sema.functions.len as u32
    var sf = SemaFunction {
        result: empty_type(),
        slot_count: 0,
        declaration: decl_idx,
        instantiated_at: site_id,
        param_types: Vec[SemaType] { arena: c.arena },
        arguments: args,
        nodes: Vec[SemaNode] { arena: c.arena },
    }
    sf.param_types.init(c.arena, fdecl.parameters.count as u64)
    sf.nodes.init(c.arena, fdecl.nodes.count as u64)
    var empty_sn = SemaNode {
        type_info: empty_type(),
        binding: 0,
        builtin: SemaBuiltin.None,
        promotion: TypeKind.Invalid,
        method_call: 0,
        result_wrap: 0,
        box_any: false,
        is_fn_ref: false,
        is_indirect_call: false,
        is_boolean_literal: false,
        borrow_array: false,
        falls_through: false,
        is_enum_case: false,
        is_const: false,
    }
    for var i: u32 = 0; i < fdecl.nodes.count; i += 1 {
        sf.nodes.push(&empty_sn)
    }
    c.sema.functions.push(&sf)
    register_fn_sig(c, fn_idx)
    return fn_idx
}

fun specialize_function(c: *Checker, app_id: u32, decl_idx: u32): u32 {
    var fdecls = c.tree.functions.as_slice()
    var count = fdecls[decl_idx].type_parameters.count
    var args: Vec[SemaType]
    if !resolve_type_args(c, app_id, count, &args) {
        return ~0 as u32
    }
    return specialize_function_with_args(c, app_id, decl_idx, args)
}

fun unify_param_ast(c: *Checker, param_ast: u32, actual: SemaType, fdecl: AstFunction, inferred: *Vec[SemaType]) {
    if param_ast == NODE_NONE || actual.kind == TypeKind.Invalid {
        return
    }
    var nodes = c.tree.nodes.as_slice()
    var children = c.tree.children.as_slice()
    match nodes[param_ast].data {
        AstData.TypeName(nlen) => {
            var name = node_span(c.tree, param_ast, nlen)
            for var i: u32 = 0; i < fdecl.type_parameters.count; i += 1 {
                var tp_id = children[fdecl.type_parameters.first + i]
                if same_span(c.tree, name, node_ident_span(c.tree, tp_id)) {
                    if inferred.data[i].kind == TypeKind.Invalid {
                        inferred.data[i] = actual
                    }
                    return
                }
            }
        }
        AstData.Identifier(nlen) => {
            var name = node_span(c.tree, param_ast, nlen)
            for var i: u32 = 0; i < fdecl.type_parameters.count; i += 1 {
                var tp_id = children[fdecl.type_parameters.first + i]
                if same_span(c.tree, name, node_ident_span(c.tree, tp_id)) {
                    if inferred.data[i].kind == TypeKind.Invalid {
                        inferred.data[i] = actual
                    }
                    return
                }
            }
        }
        AstData.ConstType(inner) => unify_param_ast(c, inner, actual, fdecl, inferred)
        AstData.PointerType(pt) => {
            if actual.kind == TypeKind.Pointer {
                var pts = c.sema.pointees.as_slice()
                unify_param_ast(c, pt.pointee, pts[actual.pointee], fdecl, inferred)
            }
        }
        AstData.ArrayType(at) => {
            if at.count == NODE_NONE && actual.kind == TypeKind.Slice {
                var elems = c.sema.elements.as_slice()
                unify_param_ast(c, at.elem, elems[actual.element_type], fdecl, inferred)
            } else if at.count != NODE_NONE && actual.kind == TypeKind.Array {
                var elems = c.sema.elements.as_slice()
                unify_param_ast(c, at.elem, elems[actual.element_type], fdecl, inferred)
            }
        }
        AstData.GenericType(gr) => {
            var base = children[gr.first]
            if actual.kind == TypeKind.TaggedUnion {
                var decl: u32 = ~0 as u32
                var q: AstQualified
                if find_qualified(c.tree, param_ast, &q) && q.kind == AstBindingKind.Enum && !q.inaccessible {
                    decl = q.index
                } else if find_qualified(c.tree, base, &q) && q.kind == AstBindingKind.Enum && !q.inaccessible {
                    decl = q.index
                } else {
                    match nodes[base].data {
                        AstData.Identifier(l) => decl = find_enum_idx(c, node_span(c.tree, base, l))
                        AstData.TypeName(l) => decl = find_enum_idx(c, node_span(c.tree, base, l))
                        else => {}
                    }
                }
                var su = &c.sema.unions.data[actual.record]
                if decl != (~0 as u32) && su.declaration == decl && (gr.count - 1) == (su.arguments.len as u32) {
                    for var i: u32 = 0; i < (su.arguments.len as u32); i += 1 {
                        unify_param_ast(c, children[gr.first + 1 + i], su.arguments.data[i], fdecl, inferred)
                    }
                }
            } else if actual.kind == TypeKind.Struct {
                var decl: u32 = ~0 as u32
                var q: AstQualified
                if find_qualified(c.tree, param_ast, &q) && q.kind == AstBindingKind.Struct && !q.inaccessible {
                    decl = q.index
                } else if find_qualified(c.tree, base, &q) && q.kind == AstBindingKind.Struct && !q.inaccessible {
                    decl = q.index
                } else {
                    match nodes[base].data {
                        AstData.Identifier(l) => decl = find_struct_idx(c, node_span(c.tree, base, l))
                        AstData.TypeName(l) => decl = find_struct_idx(c, node_span(c.tree, base, l))
                        else => {}
                    }
                }
                var sr = &c.sema.records.data[actual.record]
                if decl != (~0 as u32) && sr.declaration == decl && (gr.count - 1) == (sr.arguments.len as u32) {
                    for var i: u32 = 0; i < (sr.arguments.len as u32); i += 1 {
                        unify_param_ast(c, children[gr.first + 1 + i], sr.arguments.data[i], fdecl, inferred)
                    }
                }
            }
        }
        else => {}
    }
}

fun check_variadic_call_args(c: *Checker, args_first: u32, arg_count: u32, ptypes: []SemaType, param_offset: u32) {
    var nodes = c.tree.nodes.as_slice()
    var children = c.tree.children.as_slice()
    var fixed = (len(ptypes) as u32) - 1 - param_offset
    for var i: u32 = 0; i < fixed && !c.has_error; i += 1 {
        check_value(c, children[args_first + i], ptypes[i + param_offset])
    }
    if c.has_error { return }
    var var_slice_t = ptypes[len(ptypes) - 1]
    if arg_count == fixed + 1 {
        var tail_id = children[args_first + fixed]
        match nodes[tail_id].data {
            AstData.Unary(un) => {
                if un.op == UnaryOp.Spread {
                    check_value(c, un.operand, var_slice_t)
                    if !c.has_error {
                        node_info(c, tail_id).type_info = var_slice_t
                    }
                    return
                }
            }
            else => {}
        }
    }
    var var_elem_t = c.sema.elements.data[var_slice_t.element_type]
    for var i: u32 = fixed; i < arg_count && !c.has_error; i += 1 {
        check_value(c, children[args_first + i], var_elem_t)
    }
}

fun infer_method_type_args(c: *Checker, call_id: u32, decl_idx: u32, struct_args: Vec[SemaType], out_args: *Vec[SemaType]): bool {
    var nodes = c.tree.nodes.as_slice()
    var children = c.tree.children.as_slice()
    var cr = NodeRange { first: 0, count: 0 }
    match nodes[call_id].data {
        AstData.Call(r) => cr = r
        else => return false
    }
    var fdecl = c.tree.functions.as_slice()[decl_idx]
    if fdecl.parameters.count == 0 || (cr.count - 1) != (fdecl.parameters.count - 1) {
        return false
    }
    var count = fdecl.type_parameters.count
    out_args.init(c.arena, count as u64)
    var inv = empty_type()
    for var i: u32 = 0; i < count; i += 1 {
        if (i as u64) < struct_args.len {
            out_args.push(&struct_args.data[i])
        } else {
            out_args.push(&inv)
        }
    }
    for var i: u32 = 0; i < fdecl.parameters.count - 1 && !c.has_error; i += 1 {
        var arg_id = children[cr.first + 1 + i]
        var arg_t = check_expr(c, arg_id, empty_type())
        var param_id = children[fdecl.parameters.first + 1 + i]
        var pt_id = NODE_NONE
        match nodes[param_id].data {
            AstData.Parameter(par) => pt_id = par.type_node
            else => {}
        }
        unify_param_ast(c, pt_id, arg_t, fdecl, out_args)
    }
    if c.has_error {
        return false
    }
    for var i: u32 = 0; i < count; i += 1 {
        if out_args.data[i].kind == TypeKind.Invalid {
            return false
        }
    }
    return true
}

fun infer_function_type_args(c: *Checker, call_id: u32, decl_idx: u32, out_args: *Vec[SemaType]): bool {
    var nodes = c.tree.nodes.as_slice()
    var children = c.tree.children.as_slice()
    var cr = NodeRange { first: 0, count: 0 }
    match nodes[call_id].data {
        AstData.Call(r) => cr = r
        else => return false
    }
    var fdecl = c.tree.functions.as_slice()[decl_idx]
    if cr.count - 1 != fdecl.parameters.count {
        return false
    }
    var count = fdecl.type_parameters.count
    out_args.init(c.arena, count as u64)
    var inv = empty_type()
    for var i: u32 = 0; i < count; i += 1 {
        out_args.push(&inv)
    }
    for var i: u32 = 0; i < fdecl.parameters.count && !c.has_error; i += 1 {
        var arg_id = children[cr.first + 1 + i]
        var arg_t = check_expr(c, arg_id, empty_type())
        var param_id = children[fdecl.parameters.first + i]
        var pt_id = NODE_NONE
        match nodes[param_id].data {
            AstData.Parameter(par) => pt_id = par.type_node
            else => {}
        }
        unify_param_ast(c, pt_id, arg_t, fdecl, out_args)
    }
    if c.has_error {
        return false
    }
    for var i: u32 = 0; i < count; i += 1 {
        if out_args.data[i].kind == TypeKind.Invalid {
            return false
        }
    }
    return true
}

fun is_literal_expr(tree: *Ast, id: u32): bool {
    var nodes = tree.nodes.as_slice()
    var cur = id
    for cur != NODE_NONE {
        match nodes[cur].data {
            AstData.Integer(_) => return true
            AstData.Float(_) => return true
            AstData.Null => return true
            AstData.Unary(un) => {
                if un.op == UnaryOp.Positive || un.op == UnaryOp.Negate {
                    cur = un.operand
                } else {
                    return false
                }
            }
            else => return false
        }
    }
    return false
}

fun make_fn_type(c: *Checker, fi: u32): SemaType {
    var sf = &c.sema.functions.data[fi]
    var sft = SemaFuncType {
        params: Vec[SemaType] { arena: c.arena },
        result: sf.result,
    }
    sft.params.init(c.arena, sf.param_types.len)
    for var i: u64 = 0; i < sf.param_types.len; i += 1 {
        sft.params.push(&sf.param_types.data[i])
    }
    var idx = c.sema.func_types.len as u32
    c.sema.func_types.push(&sft)
    var t = simple_type(TypeKind.Func)
    t.record = idx
    return t
}

fun check_indirect_call(c: *Checker, call_id: u32, callee_t: SemaType): SemaType {
    if callee_t.kind != TypeKind.Func {
        return fail(c, call_id, "expression is not callable")
    }
    var cr = NodeRange { first: 0, count: 0 }
    match c.tree.nodes.as_slice()[call_id].data {
        AstData.Call(r) => cr = r
        else => {}
    }
    var children = c.tree.children.as_slice()
    var ft = &c.sema.func_types.data[callee_t.record]
    if cr.count - 1 != (ft.params.len as u32) {
        return fail(c, call_id, "wrong number of function arguments")
    }
    for var i: u32 = 0; i < cr.count - 1 && !c.has_error; i += 1 {
        check_value(c, children[cr.first + 1 + i], ft.params.data[i])
    }
    if !c.has_error {
        var sn = node_info(c, call_id)
        sn.is_indirect_call = true
        sn.binding = callee_t.record
    }
    return ft.result
}

fun check_expr(c: *Checker, id: u32, expected: SemaType): SemaType {
    if id == NODE_NONE || c.has_error {
        return empty_type()
    }
    if c.recursion_depth >= 256 {
        return fail(c, id, "expression nesting limit exceeded")
    }
    c.recursion_depth += 1

    var nodes = c.tree.nodes.as_slice()
    var node = nodes[id]
    var res = empty_type()

    match node.data {
        AstData.Identifier(nlen) => {
            var name = node_span(c.tree, id, nlen)
            var text = span_bytes(c.tree, name)
            if text == "true" || text == "false" {
                var sn = node_info(c, id)
                sn.is_boolean_literal = true
                if text == "true" {
                    sn.binding = 1
                } else {
                    sn.binding = 0
                }
                res = simple_type(TypeKind.Bool)
            } else {
                var li = find_local(c, name, 0)
                if li >= 0 {
                    var locals = c.locals.as_slice()
                    var lv = locals[li]
                    var sn = node_info(c, id)
                    sn.binding = lv.slot
                    sn.is_const = lv.is_const
                    res = lv.type_info
                } else {
                    var ci = find_const_idx(c, name)
                    if ci != (~0 as u32) {
                        check_const_decl(c, ci)
                        if !c.has_error {
                            var consts = c.sema.constants.data
                            var sn = node_info(c, id)
                            sn.binding = ci
                            sn.is_const = true
                            res = consts[ci].type_info
                        }
                    } else {
                        var fi = find_fn_idx(c, name)
                        if fi != (~0 as u32) {
                            var fdecl = c.tree.functions.as_slice()[fi]
                            if fdecl.type_parameters.count > 0 {
                                res = fail(c, id, "generic function cannot be used as a value")
                            } else {
                                var sn = node_info(c, id)
                                sn.is_fn_ref = true
                                sn.binding = fi
                                res = make_fn_type(c, fi)
                            }
                        } else {
                            res = fail(c, id, "unknown variable")
                        }
                    }
                }
            }
        }
        AstData.Integer(nlen) => {
            var text = span_bytes(c.tree, node_span(c.tree, id, nlen))
            var bits: u64 = 0
            if !parse_int_literal(text, &bits) {
                if text[0] == '\'' {
                    res = fail(c, id, "invalid character literal")
                } else {
                    res = fail(c, id, "invalid integer literal")
                }
            } else {
                var k = TypeKind.I32
                if is_integer(expected.kind) && !is_enum(expected) {
                    k = expected.kind
                } else if bits > 2147483647 {
                    k = TypeKind.I64
                }
                if !int_fits_type(bits, false, k) {
                    res = fail(c, id, "integer literal out of range")
                } else {
                    res = simple_type(k)
                }
            }
        }
        AstData.Float(_) => {
            if expected.kind == TypeKind.F32 {
                res = simple_type(TypeKind.F32)
            } else {
                res = simple_type(TypeKind.F64)
            }
        }
        AstData.String(nlen) => {
            res = simple_type(TypeKind.Array)
            res.element = TypeKind.U8
            res.element_size = 1
            res.element_type = add_element(c, simple_type(TypeKind.U8))
            res.length = decoded_string_len(span_bytes(c.tree, node_span(c.tree, id, nlen)))
        }
        AstData.Null => {
            if expected.kind == TypeKind.Pointer {
                res = expected
            } else {
                res = simple_type(TypeKind.Null)
            }
        }
        AstData.ArrayLiteral(ar) => {
            if expected.kind == TypeKind.Array && ar.count != expected.length {
                res = fail(c, id, "array initializer length mismatch")
            } else {
                var children = c.tree.children.as_slice()
                var elem_exp = empty_type()
                if expected.kind == TypeKind.Array || expected.kind == TypeKind.Slice {
                    var elems = c.sema.elements.as_slice()
                    elem_exp = elems[expected.element_type]
                }
                var elem_t = check_value(c, children[ar.first], elem_exp)
                if !c.has_error {
                    for var i: u32 = 1; i < ar.count && !c.has_error; i += 1 {
                        check_value(c, children[ar.first + i], elem_t)
                    }
                    if !c.has_error {
                        res = simple_type(TypeKind.Array)
                        res.length = ar.count
                        res.element = elem_t.kind
                        res.element_type = add_element(c, elem_t)
                        res.element_size = storage_size(elem_t)
                        res.record = elem_t.record
                        res.record_size = elem_t.record_size
                        res.pointee = elem_t.pointee
                        res.read_only = elem_t.read_only
                    }
                }
            }
        }
        AstData.StructLiteral(sl) => {
            var tid = sl.type_node
            var inits = sl.fields
            var children = c.tree.children.as_slice()
            var si: u32 = ~0 as u32
            var is_generic_t = false
            match nodes[tid].data {
                AstData.GenericType(_) => is_generic_t = true
                else => {}
            }
            if is_generic_t {
                var st = specialize_record(c, tid, false)
                if !c.has_error { si = st.record }
            } else {
                var q: AstQualified
                if find_qualified(c.tree, id, &q) && q.kind == AstBindingKind.Struct && !q.inaccessible {
                    si = q.index
                } else if find_qualified(c.tree, tid, &q) && q.kind == AstBindingKind.Struct && !q.inaccessible {
                    si = q.index
                } else {
                    match nodes[tid].data {
                        AstData.Identifier(tlen) => {
                            var tspan = node_span(c.tree, tid, tlen)
                            if span_bytes(c.tree, tspan) == "Self" && c.owner_struct != (~0 as u32) {
                                si = resolve_self_type(c, tid, false).record
                            } else {
                                si = find_struct_idx(c, tspan)
                            }
                        }
                        AstData.TypeName(tlen) => {
                            var tspan = node_span(c.tree, tid, tlen)
                            if span_bytes(c.tree, tspan) == "Self" && c.owner_struct != (~0 as u32) {
                                si = resolve_self_type(c, tid, false).record
                            } else {
                                si = find_struct_idx(c, tspan)
                            }
                        }
                        else => {}
                    }
                }
            }
            if si == (~0 as u32) {
                if !c.has_error { res = fail(c, tid, "unknown struct type") }
            } else {
                resolve_struct_layout(c, si)
                if !c.has_error {
                    var recs = c.sema.records.data
                    var sdecls = c.tree.structs.as_slice()
                    var sdecl = sdecls[recs[si].declaration]
                    for var i: u32 = 0; i < inits.count && !c.has_error; i += 1 {
                        var init_id = children[inits.first + i]
                        var fn_len: u32 = 0
                        var fval_id = NODE_NONE
                        match nodes[init_id].data {
                            AstData.StructFieldInit(fi) => {
                                fn_len = fi.name_length
                                fval_id = fi.value
                            }
                            else => {}
                        }
                        var fname = node_span(c.tree, init_id, fn_len)
                        for var prev: u32 = 0; prev < i; prev += 1 {
                            var pid = children[inits.first + prev]
                            if same_span(c.tree, fname, node_ident_span(c.tree, pid)) {
                                fail(c, init_id, "duplicate struct field")
                                break
                            }
                        }
                        if c.has_error { break }
                        var matched = false
                        for var f: u32 = 0; f < sdecl.fields.count; f += 1 {
                            var fid = children[sdecl.fields.first + f]
                            if same_span(c.tree, fname, node_ident_span(c.tree, fid)) {
                                var fields = (recs[si].fields).as_slice()
                                var sn = node_info(c, init_id)
                                sn.type_info = fields[f].type_info
                                sn.binding = fields[f].binding
                                check_value(c, fval_id, fields[f].type_info)
                                matched = true
                                break
                            }
                        }
                        if !matched && !c.has_error {
                            fail(c, init_id, "unknown struct field")
                        }
                    }
                    if !c.has_error {
                        res = simple_type(TypeKind.Struct)
                        res.record = si
                        res.record_size = recs[si].size
                    }
                }
            }
        }
        AstData.Call(cr) => {
            var children = c.tree.children.as_slice()
            var callee = children[cr.first]
            var app = NODE_NONE
            match nodes[callee].data {
                AstData.GenericCallee(gr) => {
                    app = callee
                    callee = children[gr.first]
                }
                else => {}
            }
            var q: AstQualified
            var has_q = find_qualified(c.tree, id, &q) && q.kind == AstBindingKind.Function
            var c_is_member = false
            var c_mem_base = NODE_NONE
            var c_mem_len: u32 = 0
            var c_is_ident = false
            var c_ident_len: u32 = 0
            match nodes[callee].data {
                AstData.Member(m) => {
                    c_is_member = true
                    c_mem_base = m.base
                    c_mem_len = m.name_length
                }
                AstData.Identifier(il) => {
                    c_is_ident = true
                    c_ident_len = il
                }
                else => {}
            }
            var enum_ei = ~0 as u32
            if !has_q && app == NODE_NONE && c_is_member {
                enum_ei = find_enum_for_member(c, callee)
            }
            if enum_ei != (~0 as u32) {
                var mname = node_span(c.tree, callee, c_mem_len)
                var ut = resolve_enum_member_type(c, callee, enum_ei, c_mem_base, mname, expected, true)
                if !c.has_error {
                    if ut.kind != TypeKind.TaggedUnion {
                        res = fail(c, id, "plain enum case cannot take arguments")
                    } else {
                        var v_idx = node_info(c, callee).binding
                        var uv = &c.sema.unions.data[ut.record].variants.data[v_idx]
                        if uv.fields.len == 0 {
                            res = fail(c, id, "unit enum variant does not take arguments")
                        } else if (cr.count - 1) != (uv.fields.len as u32) {
                            res = fail(c, id, "wrong number of enum variant arguments")
                        } else {
                            for var i: u32 = 0; i < cr.count - 1 && !c.has_error; i += 1 {
                                check_value(c, children[cr.first + 1 + i], uv.fields.data[i].type_info)
                            }
                            if !c.has_error {
                                var sn = node_info(c, id)
                                sn.is_enum_case = true
                                sn.binding = v_idx
                                sn.type_info = ut
                                res = ut
                            }
                        }
                    }
                }
            } else if !has_q && c_is_member {
                var recv_id = c_mem_base
                var recv_t = check_expr(c, recv_id, empty_type())
                if !c.has_error {
                    var base_t = recv_t
                    if recv_t.kind == TypeKind.Pointer {
                        base_t = c.sema.pointees.data[recv_t.pointee]
                    }
                    var mname = node_span(c.tree, callee, c_mem_len)
                    var mbytes = span_bytes(c.tree, mname)
                    if base_t.kind != TypeKind.Struct {
                        if app == NODE_NONE && mbytes == "hash" && cr.count == 1 && supports_hash(c, base_t) {
                            var sn = node_info(c, id)
                            sn.builtin = SemaBuiltin.Hash
                            res = simple_type(TypeKind.U64)
                        } else if app == NODE_NONE && mbytes == "eq" && cr.count == 2 && supports_eq(c, base_t) {
                            var arg_id = children[cr.first + 1]
                            var arg_t = check_expr(c, arg_id, empty_type())
                            if !c.has_error {
                                if arg_t.kind != TypeKind.Pointer || !same_type(c, c.sema.pointees.data[arg_t.pointee], base_t) {
                                    res = fail(c, arg_id, "eq expects pointer to matching type")
                                } else {
                                    var sn = node_info(c, id)
                                    sn.builtin = SemaBuiltin.Eq
                                    res = simple_type(TypeKind.Bool)
                                }
                            }
                        } else {
                            res = fail(c, callee, "method receiver must be a struct or pointer to struct")
                        }
                    } else {
                        var sr = c.sema.records.data[base_t.record]
                        var fi = find_method_idx(c, sr.declaration, mname)
                        if fi == (~0 as u32) {
                            if app == NODE_NONE && mbytes == "hash" && cr.count == 1 && supports_hash(c, base_t) {
                                var sn = node_info(c, id)
                                sn.builtin = SemaBuiltin.Hash
                                res = simple_type(TypeKind.U64)
                            } else if app == NODE_NONE && mbytes == "eq" && cr.count == 2 && supports_eq(c, base_t) {
                                var arg_id = children[cr.first + 1]
                                var arg_t = check_expr(c, arg_id, empty_type())
                                if !c.has_error {
                                    if arg_t.kind != TypeKind.Pointer || !same_type(c, c.sema.pointees.data[arg_t.pointee], base_t) {
                                        res = fail(c, arg_id, "eq expects pointer to matching type")
                                    } else {
                                        var sn = node_info(c, id)
                                        sn.builtin = SemaBuiltin.Eq
                                        res = simple_type(TypeKind.Bool)
                                    }
                                }
                            } else {
                                var ct = check_expr(c, callee, empty_type())
                                if !c.has_error && ct.kind == TypeKind.Func {
                                    res = check_indirect_call(c, id, ct)
                                } else if !c.has_error {
                                    res = fail(c, callee, "unknown method")
                                }
                            }
                        } else {
                            var fdecls = c.tree.functions.as_slice()
                            if !fdecls[fi].public && fdecls[fi].module != c.module {
                                res = fail(c, callee, "method is private")
                            } else {
                                if fdecls[fi].type_parameters.count > 0 {
                                    if app == NODE_NONE {
                                        if fdecls[fi].type_parameters.count == (sr.arguments.len as u32) {
                                            var margs: Vec[SemaType]
                                            margs.init(c.arena, sr.arguments.len)
                                            for var ai: u64 = 0; ai < sr.arguments.len; ai += 1 {
                                                margs.push(&sr.arguments.data[ai])
                                            }
                                            fi = specialize_function_with_args(c, id, fi, margs)
                                        } else {
                                            var inferred_args: Vec[SemaType]
                                            if infer_method_type_args(c, id, fi, sr.arguments, &inferred_args) {
                                                fi = specialize_function_with_args(c, id, fi, inferred_args)
                                            } else if !c.has_error {
                                                res = fail(c, callee, "generic method requires explicit type arguments")
                                            }
                                        }
                                    } else {
                                        fi = specialize_function(c, app, fi)
                                    }
                                } else if app != NODE_NONE {
                                    res = fail(c, app, "method does not take type arguments")
                                }
                                if !c.has_error && fi != (~0 as u32) {
                                    var fns = c.sema.functions.data
                                    var sf = &fns[fi]
                                    var is_var = fdecls[sf.declaration].is_variadic
                                    if sf.param_types.len == 0 {
                                        res = fail(c, callee, "method must declare a receiver parameter")
                                    } else if (!is_var && cr.count != (sf.param_types.len as u32)) || (is_var && cr.count + 1 < (sf.param_types.len as u32)) {
                                        res = fail(c, id, "wrong number of function arguments")
                                    } else {
                                        var ptypes = sf.param_types.as_slice()
                                        var self_t = ptypes[0]
                                        var mcall: u8 = 0
                                        if self_t.kind == TypeKind.Pointer {
                                            var pt = c.sema.pointees.data[self_t.pointee]
                                            if recv_t.kind == TypeKind.Pointer {
                                                if !same_type(c, base_t, pt) {
                                                    res = fail(c, recv_id, "method receiver type mismatch")
                                                } else if !self_t.read_only && recv_t.read_only {
                                                    res = fail(c, recv_id, "cannot call mutating method on const pointer")
                                                } else {
                                                    mcall = 1
                                                }
                                            } else {
                                                if !same_type(c, recv_t, pt) {
                                                    res = fail(c, recv_id, "method receiver type mismatch")
                                                } else if !self_t.read_only && !is_writable_lvalue(c, recv_id) {
                                                    res = fail(c, recv_id, "cannot call mutating method on immutable value")
                                                } else {
                                                    mcall = 2
                                                }
                                            }
                                        } else {
                                            if recv_t.kind == TypeKind.Pointer {
                                                if !same_type(c, base_t, self_t) {
                                                    res = fail(c, recv_id, "method receiver type mismatch")
                                                } else {
                                                    mcall = 1
                                                }
                                            } else if !same_type(c, recv_t, self_t) {
                                                res = fail(c, recv_id, "method receiver type mismatch")
                                            } else {
                                                mcall = 1
                                            }
                                        }
                                        if !c.has_error {
                                            if is_var {
                                                check_variadic_call_args(c, cr.first + 1, cr.count - 1, ptypes, 1)
                                            } else {
                                                for var i: u32 = 0; i < cr.count - 1 && !c.has_error; i += 1 {
                                                    check_value(c, children[cr.first + 1 + i], ptypes[i + 1])
                                                }
                                            }
                                            if !c.has_error {
                                                var sn = node_info(c, id)
                                                sn.binding = fi
                                                sn.method_call = mcall
                                                res = sf.result
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            } else if !has_q && !c_is_ident {
                var ct = check_expr(c, callee, empty_type())
                if !c.has_error {
                    res = check_indirect_call(c, id, ct)
                }
            } else if !has_q && app == NODE_NONE && find_local(c, node_span(c.tree, callee, c_ident_len), 0) >= 0 {
                var ct = check_expr(c, callee, empty_type())
                if !c.has_error {
                    res = check_indirect_call(c, id, ct)
                }
            } else {
                var is_builtin = false
                if !has_q && app == NODE_NONE {
                    var cname = node_span(c.tree, callee, c_ident_len)
                    var text = span_bytes(c.tree, cname)
                    if text == "len" || text == "data" || text == "size_of" || (text == "fail" && find_fn_idx(c, cname) == (~0 as u32)) {
                        is_builtin = true
                        if cr.count != 2 {
                            res = fail(c, id, "builtin expects 1 argument")
                        } else if text == "fail" {
                            var arg = children[cr.first + 1]
                            var msg_t = simple_type(TypeKind.Slice)
                            msg_t.element = TypeKind.U8
                            msg_t.element_type = add_element(c, simple_type(TypeKind.U8))
                            msg_t.element_size = 1
                            msg_t.read_only = true
                            check_value(c, arg, msg_t)
                            if !c.has_error {
                                var sn = node_info(c, id)
                                sn.builtin = SemaBuiltin.Fail
                                res = simple_type(TypeKind.Error)
                            }
                        } else {
                            var arg = children[cr.first + 1]
                            var at = check_expr(c, arg, empty_type())
                            if !c.has_error {
                                var sn = node_info(c, id)
                                if text == "len" {
                                    if at.kind != TypeKind.Array && at.kind != TypeKind.Slice {
                                        res = fail(c, arg, "len requires an array or slice")
                                    } else {
                                        sn.builtin = SemaBuiltin.Len
                                        res = simple_type(TypeKind.I64)
                                    }
                                } else if text == "data" {
                                    if at.kind != TypeKind.Array && at.kind != TypeKind.Slice {
                                        res = fail(c, arg, "data requires an array or slice")
                                    } else {
                                        sn.builtin = SemaBuiltin.Data
                                        var elems = c.sema.elements.as_slice()
                                        res = simple_type(TypeKind.Pointer)
                                        res.pointee = add_pointee(c, elems[at.element_type])
                                        if at.kind == TypeKind.Slice {
                                            res.read_only = at.read_only
                                        } else {
                                            res.read_only = !is_writable_lvalue(c, arg)
                                        }
                                    }
                                } else {
                                    sn.builtin = SemaBuiltin.SizeOf
                                    sn.binding = storage_size(at)
                                    res = simple_type(TypeKind.U64)
                                }
                            }
                        }
                    }
                }
                if !is_builtin {
                    var fi: u32 = ~0 as u32
                    if has_q {
                        fi = q.index
                    } else {
                        fi = find_fn_idx(c, node_span(c.tree, callee, c_ident_len))
                    }
                    if fi == (~0 as u32) {
                        res = fail(c, callee, "unknown function")
                    } else {
                        var fdecls = c.tree.functions.as_slice()
                        if fdecls[fi].type_parameters.count > 0 {
                            if app == NODE_NONE {
                                var inferred_args: Vec[SemaType]
                                if infer_function_type_args(c, id, fi, &inferred_args) {
                                    fi = specialize_function_with_args(c, id, fi, inferred_args)
                                } else if !c.has_error {
                                    res = fail(c, callee, "generic function requires explicit type arguments")
                                }
                            } else {
                                fi = specialize_function(c, app, fi)
                            }
                        } else if app != NODE_NONE {
                            res = fail(c, app, "function does not take type arguments")
                        }
                        if !c.has_error && fi != (~0 as u32) {
                            var fns = c.sema.functions.data
                            var sf = &fns[fi]
                            var is_var = fdecls[sf.declaration].is_variadic
                            if (!is_var && cr.count - 1 != (sf.param_types.len as u32)) || (is_var && cr.count < (sf.param_types.len as u32)) {
                                res = fail(c, id, "wrong number of function arguments")
                            } else {
                                var ptypes = sf.param_types.as_slice()
                                if is_var {
                                    check_variadic_call_args(c, cr.first + 1, cr.count - 1, ptypes, 0)
                                } else {
                                    for var i: u32 = 0; i < cr.count - 1 && !c.has_error; i += 1 {
                                        check_value(c, children[cr.first + 1 + i], ptypes[i])
                                    }
                                }
                                if !c.has_error {
                                    var sn = node_info(c, id)
                                    sn.binding = fi
                                    res = sf.result
                                }
                            }
                        }
                    }
                }
            }
        }
        AstData.Index(ix) => {
            var base_id = ix.base
            var idx_id = ix.idx
            var bt = check_expr(c, base_id, empty_type())
            if !c.has_error {
                var it = check_expr(c, idx_id, empty_type())
                if !c.has_error && !is_integer(it.kind) {
                    res = fail(c, idx_id, "index must be an integer")
                } else if !c.has_error {
                    if bt.kind == TypeKind.Array || bt.kind == TypeKind.Slice {
                        var elems = c.sema.elements.as_slice()
                        res = complete_type(c, elems[bt.element_type])
                    } else if bt.kind == TypeKind.Pointer {
                        var pts = c.sema.pointees.as_slice()
                        res = complete_type(c, pts[bt.pointee])
                    } else {
                        res = fail(c, base_id, "indexing requires an array, slice, or pointer")
                    }
                }
            }
        }
        AstData.Slice(sl) => {
            var base_id = sl.base
            var range_id = sl.range
            var bt = check_expr(c, base_id, empty_type())
            if !c.has_error {
                var rstart = NODE_NONE
                var rend = NODE_NONE
                match nodes[range_id].data {
                    AstData.SliceRange(sr) => {
                        rstart = sr.start
                        rend = sr.end
                    }
                    else => {}
                }
                var st = check_expr(c, rstart, empty_type())
                var et = check_expr(c, rend, empty_type())
                if !c.has_error && (!is_integer(st.kind) || !is_integer(et.kind)) {
                    res = fail(c, range_id, "slice bounds must be integers")
                } else if !c.has_error {
                    var elem = empty_type()
                    if bt.kind == TypeKind.Array || bt.kind == TypeKind.Slice {
                        var elems = c.sema.elements.as_slice()
                        elem = complete_type(c, elems[bt.element_type])
                    } else if bt.kind == TypeKind.Pointer {
                        var pts = c.sema.pointees.as_slice()
                        elem = complete_type(c, pts[bt.pointee])
                    } else {
                        return fail(c, base_id, "slicing requires an array, slice, or pointer")
                    }
                    res = simple_type(TypeKind.Slice)
                    res.element = elem.kind
                    res.element_type = add_element(c, elem)
                    res.element_size = storage_size(elem)
                    res.record = elem.record
                    res.record_size = elem.record_size
                    res.pointee = elem.pointee
                    if bt.kind == TypeKind.Array {
                        res.read_only = !is_writable_lvalue(c, base_id)
                    } else if bt.kind == TypeKind.Slice {
                        res.read_only = bt.read_only
                    } else {
                        res.read_only = elem.read_only || bt.read_only
                    }
                }
            }
        }
        AstData.Member(m) => {
            var base_id = m.base
            var mlen = m.name_length
            var mname = node_span(c.tree, id, mlen)
            var q: AstQualified
            var handled = false
            if find_qualified(c.tree, id, &q) {
                if q.kind == AstBindingKind.Const && !q.inaccessible {
                    check_const_decl(c, q.index)
                    if !c.has_error {
                        var consts = c.sema.constants.data
                        var sn = node_info(c, id)
                        sn.binding = q.index
                        sn.is_const = true
                        res = consts[q.index].type_info
                    }
                    handled = true
                } else if q.kind == AstBindingKind.Enum && !q.inaccessible {
                    handled = true
                    res = resolve_enum_member_type(c, id, q.index, base_id, mname, expected, false)
                }
            }
            if !handled {
                var ei = find_enum_for_member(c, id)
                if ei != (~0 as u32) {
                    handled = true
                    res = resolve_enum_member_type(c, id, ei, base_id, mname, expected, false)
                }
            }
            if !handled {
                var bt = check_expr(c, base_id, empty_type())
                if !c.has_error {
                    if bt.kind == TypeKind.Pointer {
                        var pts = c.sema.pointees.as_slice()
                        bt = pts[bt.pointee]
                    }
                    if bt.kind == TypeKind.Any {
                        var sn = node_info(c, id)
                        if span_bytes(c.tree, mname) == "ptr" {
                            res = simple_type(TypeKind.Pointer)
                            res.pointee = add_pointee(c, simple_type(TypeKind.U8))
                            res.read_only = true
                            sn.binding = 0
                        } else if span_bytes(c.tree, mname) == "tag" {
                            res = simple_type(TypeKind.U64)
                            sn.binding = 8
                        } else {
                            res = fail(c, id, "unknown field on any")
                        }
                    } else if bt.kind != TypeKind.Struct {
                        res = fail(c, id, "member access requires a struct value")
                    } else {
                        resolve_struct_layout(c, bt.record)
                        if !c.has_error {
                            var recs = c.sema.records.data
                            var sdecls = c.tree.structs.as_slice()
                            var sdecl = sdecls[recs[bt.record].declaration]
                            var children = c.tree.children.as_slice()
                            var found = false
                            for var i: u32 = 0; i < sdecl.fields.count; i += 1 {
                                var fid = children[sdecl.fields.first + i]
                                if same_span(c.tree, mname, node_ident_span(c.tree, fid)) {
                                    var fields = (recs[bt.record].fields).as_slice()
                                    var sn = node_info(c, id)
                                    sn.binding = fields[i].binding
                                    res = fields[i].type_info
                                    found = true
                                    break
                                }
                            }
                            if !found {
                                res = fail(c, id, "unknown struct field")
                            }
                        }
                    }
                }
            }
        }
        AstData.OrElse(oeh) => {
            var rt = check_expr(c, oeh.expr, empty_type())
            if !c.has_error {
                if rt.kind != TypeKind.Result {
                    res = fail(c, oeh.expr, "'or' requires a !T result expression")
                } else {
                    var inner_t = c.sema.elements.data[rt.element_type]
                    if !oeh.is_block {
                        check_value(c, oeh.handler, inner_t)
                    } else {
                        var saved_locals = c.locals.len
                        c.scope_depth += 1
                        if oeh.err_name.length > 0 {
                            var eslot = c.slot_count
                            c.slot_count += 1
                            var msg_t = simple_type(TypeKind.Slice)
                            msg_t.element = TypeKind.U8
                            msg_t.element_type = add_element(c, simple_type(TypeKind.U8))
                            msg_t.element_size = 1
                            msg_t.read_only = true
                            var elv = LocalVar {
                                name: oeh.err_name,
                                slot: eslot,
                                type_info: msg_t,
                                is_const: false,
                                const_idx: 0,
                                depth: c.scope_depth,
                            }
                            c.locals.push(&elv)
                            node_info(c, id).binding = eslot
                        }
                        var bf = check_block(c, oeh.handler)
                        c.scope_depth -= 1
                        c.locals.len = saved_locals
                        if !c.has_error && inner_t.kind != TypeKind.Void && bf {
                            fail(c, oeh.handler, "'or' block must return or diverge when expression yields a value")
                        }
                    }
                    if !c.has_error {
                        res = inner_t
                    }
                }
            }
        }
        AstData.Cast(ca) => {
            var expr_id = ca.expr
            var type_id = ca.target_type
            var dst = resolve_type(c, type_id)
            if !c.has_error {
                var hint = empty_type()
                match nodes[expr_id].data {
                    AstData.Integer(_) => hint = simple_type(TypeKind.U64)
                    AstData.Null => {
                        if dst.kind == TypeKind.Pointer { hint = dst }
                    }
                    else => {}
                }
                var src_t = check_expr(c, expr_id, hint)
                if !c.has_error {
                    if src_t.kind == TypeKind.Null && dst.kind != TypeKind.Pointer {
                        res = fail(c, id, "null requires a pointer type")
                    } else {
                        res = dst
                    }
                }
            }
        }
        AstData.Unary(un) => {
            var uop = un.op
            var op_id = un.operand
            if uop == UnaryOp.Try {
                var rt = check_expr(c, op_id, empty_type())
                if !c.has_error {
                    if rt.kind != TypeKind.Result {
                        res = fail(c, op_id, "? requires a !T result expression")
                    } else if c.current_return.kind != TypeKind.Result {
                        res = fail(c, id, "? can only be used in a function returning !T")
                    } else {
                        res = c.sema.elements.data[rt.element_type]
                    }
                }
            } else if uop == UnaryOp.AddressOf {
                var op = check_expr(c, op_id, empty_type())
                if !c.has_error {
                    res = simple_type(TypeKind.Pointer)
                    res.pointee = add_pointee(c, op)
                    res.read_only = !is_writable_lvalue(c, op_id)
                }
            } else if uop == UnaryOp.Dereference {
                var op = check_expr(c, op_id, empty_type())
                if !c.has_error {
                    if op.kind != TypeKind.Pointer {
                        res = fail(c, id, "dereference requires a pointer")
                    } else {
                        var pts = c.sema.pointees.as_slice()
                        res = complete_type(c, pts[op.pointee])
                    }
                }
            } else if uop == UnaryOp.Negate {
                var is_int = false
                var int_len: u32 = 0
                match nodes[op_id].data {
                    AstData.Integer(l) => {
                        is_int = true
                        int_len = l
                    }
                    else => {}
                }
                if is_int {
                    var text = span_bytes(c.tree, node_span(c.tree, op_id, int_len))
                    var bits: u64 = 0
                    if !parse_int_literal(text, &bits) {
                        if text[0] == '\'' {
                            res = fail(c, op_id, "invalid character literal")
                        } else {
                            res = fail(c, op_id, "invalid integer literal")
                        }
                    } else {
                        var k = TypeKind.I32
                        if is_integer(expected.kind) && !is_enum(expected) {
                            k = expected.kind
                        } else if bits > 2147483648 {
                            k = TypeKind.I64
                        }
                        if !int_fits_type(bits, true, k) {
                            res = fail(c, op_id, "integer literal out of range")
                        } else {
                            var nt = simple_type(k)
                            node_info(c, op_id).type_info = nt
                            res = nt
                        }
                    }
                } else {
                    var op = check_expr(c, op_id, expected)
                    if !c.has_error && !is_numeric(op.kind) {
                        res = fail(c, id, "unary sign requires a numeric operand")
                    } else if !c.has_error {
                        res = op
                    }
                }
            } else if uop == UnaryOp.Positive {
                var op = check_expr(c, op_id, expected)
                if !c.has_error && !is_numeric(op.kind) {
                    res = fail(c, id, "unary sign requires a numeric operand")
                } else if !c.has_error {
                    res = op
                }
            } else if uop == UnaryOp.LogicalNot {
                check_value(c, op_id, simple_type(TypeKind.Bool))
                res = simple_type(TypeKind.Bool)
            } else if uop == UnaryOp.BitNot {
                var op = check_expr(c, op_id, expected)
                if !c.has_error && !is_integer(op.kind) {
                    res = fail(c, id, "bitwise not requires an integer operand")
                } else if !c.has_error {
                    res = op
                }
            } else {
                res = fail(c, id, "unsupported unary operator")
            }
        }
        AstData.Binary(bin) => {
            var bop = bin.op
            var lhs_id = bin.left
            var rhs_id = bin.right
            if bop == BinaryOp.LogicalAnd || bop == BinaryOp.LogicalOr {
                check_value(c, lhs_id, simple_type(TypeKind.Bool))
                check_value(c, rhs_id, simple_type(TypeKind.Bool))
                res = simple_type(TypeKind.Bool)
            } else if (bop as u8) >= (BinaryOp.Assign as u8) && (bop as u8) <= (BinaryOp.AssignShiftRight as u8) {
                var is_discard = false
                if bop == BinaryOp.Assign {
                    match nodes[lhs_id].data {
                        AstData.Identifier(l) => {
                            if span_bytes(c.tree, node_span(c.tree, lhs_id, l)) == "_" {
                                is_discard = true
                            }
                        }
                        else => {}
                    }
                }
                if is_discard {
                    var rt = check_expr(c, rhs_id, empty_type())
                    if !c.has_error && rt.kind == TypeKind.Null {
                        res = fail(c, rhs_id, "cannot infer type from null")
                    } else if !c.has_error {
                        node_info(c, lhs_id).binding = ~0 as u32
                        node_info(c, lhs_id).type_info = rt
                        res = rt
                    }
                } else {
                    var lt = check_expr(c, lhs_id, empty_type())
                    if !c.has_error {
                        if !is_writable_lvalue(c, lhs_id) {
                            var is_ro_ptr = false
                            match nodes[lhs_id].data {
                                AstData.Unary(un) => {
                                    if un.op == UnaryOp.Dereference { is_ro_ptr = true }
                                }
                                AstData.Index(ix) => {
                                    if node_info(c, ix.base).type_info.kind == TypeKind.Pointer { is_ro_ptr = true }
                                }
                                else => {}
                            }
                            if is_ro_ptr {
                                res = fail(c, lhs_id, "cannot write through a read-only pointer")
                            } else {
                                res = fail(c, lhs_id, "cannot assign to non-writable target")
                            }
                        } else {
                            check_value(c, rhs_id, lt)
                            res = lt
                        }
                    }
                }
            } else if (bop as u8) >= (BinaryOp.Equal as u8) && (bop as u8) <= (BinaryOp.GreaterEqual as u8) {
                var lt: SemaType
                var rt: SemaType
                if is_literal_expr(c.tree, lhs_id) && !is_literal_expr(c.tree, rhs_id) {
                    rt = check_expr(c, rhs_id, empty_type())
                    lt = check_expr(c, lhs_id, rt)
                } else {
                    lt = check_expr(c, lhs_id, empty_type())
                    rt = check_expr(c, rhs_id, lt)
                }
                if !c.has_error {
                    if is_numeric(lt.kind) && is_numeric(rt.kind) && !is_enum(lt) && !is_enum(rt) {
                        var cm = common_numeric_type(lt.kind, rt.kind)
                        if cm == TypeKind.Invalid {
                            res = fail(c, id, "incompatible comparison operands")
                        } else {
                            if lt.kind != cm { node_info(c, lhs_id).promotion = cm }
                            if rt.kind != cm { node_info(c, rhs_id).promotion = cm }
                            res = simple_type(TypeKind.Bool)
                        }
                    } else if (is_byte_slice(lt) && is_byte_slice(rt)) && (bop == BinaryOp.Equal || bop == BinaryOp.NotEqual) {
                        node_info(c, id).method_call = 1
                        res = simple_type(TypeKind.Bool)
                    } else if is_byte_slice(lt) && rt.kind == TypeKind.Array && rt.element == TypeKind.U8 && (bop == BinaryOp.Equal || bop == BinaryOp.NotEqual) {
                        node_info(c, rhs_id).borrow_array = true
                        node_info(c, id).method_call = 1
                        res = simple_type(TypeKind.Bool)
                    } else if is_byte_slice(rt) && lt.kind == TypeKind.Array && lt.element == TypeKind.U8 && (bop == BinaryOp.Equal || bop == BinaryOp.NotEqual) {
                        node_info(c, lhs_id).borrow_array = true
                        node_info(c, id).method_call = 1
                        res = simple_type(TypeKind.Bool)
                    } else if lt.kind != TypeKind.Null && same_type(c, lt, rt) {
                        if lt.kind == TypeKind.Struct || lt.kind == TypeKind.TaggedUnion {
                            if bop != BinaryOp.Equal && bop != BinaryOp.NotEqual {
                                res = fail(c, id, "ordered comparison not supported for struct or tagged union")
                            } else if !supports_eq(c, lt) {
                                res = fail(c, id, "type does not implement Eq")
                            } else {
                                var eq_fi = find_user_eq_method(c, lt)
                                if eq_fi != (~0 as u32) {
                                    node_info(c, id).method_call = 2
                                    node_info(c, id).binding = eq_fi
                                } else {
                                    node_info(c, id).method_call = 1
                                }
                                res = simple_type(TypeKind.Bool)
                            }
                        } else {
                            res = simple_type(TypeKind.Bool)
                        }
                    } else {
                        res = fail(c, id, "incompatible comparison operands")
                    }
                }
            } else if bop == BinaryOp.ShiftLeft || bop == BinaryOp.ShiftRight {
                var lt = check_expr(c, lhs_id, expected)
                var r_hint = empty_type()
                if is_literal_expr(c.tree, rhs_id) { r_hint = lt }
                var rt = check_expr(c, rhs_id, r_hint)
                if !c.has_error && (!is_integer(lt.kind) || !is_integer(rt.kind)) {
                    res = fail(c, id, "shift requires integer operands")
                } else if !c.has_error {
                    res = lt
                }
            } else {
                var lt: SemaType
                var rt: SemaType
                if is_literal_expr(c.tree, lhs_id) && !is_literal_expr(c.tree, rhs_id) {
                    rt = check_expr(c, rhs_id, expected)
                    lt = check_expr(c, lhs_id, rt)
                } else {
                    lt = check_expr(c, lhs_id, expected)
                    rt = check_expr(c, rhs_id, lt)
                }
                if !c.has_error {
                    if !is_numeric(lt.kind) || !is_numeric(rt.kind) || is_enum(lt) || is_enum(rt) {
                        res = fail(c, id, "incompatible binary operands")
                    } else {
                        var cm = common_numeric_type(lt.kind, rt.kind)
                        if cm == TypeKind.Invalid {
                            res = fail(c, id, "incompatible binary operands")
                        } else {
                            if lt.kind != cm { node_info(c, lhs_id).promotion = cm }
                            if rt.kind != cm { node_info(c, rhs_id).promotion = cm }
                            res = simple_type(cm)
                        }
                    }
                }
            }
        }
        else => res = fail(c, id, "unsupported expression")
    }

    c.recursion_depth -= 1
    if !c.has_error {
        set_node_type(c, id, res)
    }
    return res
}

fun check_statement(c: *Checker, id: u32): bool {
    if id == NODE_NONE || c.has_error {
        return true
    }
    var nodes = c.tree.nodes.as_slice()
    var node = nodes[id]
    var falls = true
    match node.data {
        AstData.Block(_) => falls = check_block(c, id)
        AstData.Defer(stmt_id) => {
            var saved_in_defer = c.in_defer
            var saved_loop_base = c.defer_loop_base
            c.in_defer = true
            c.defer_loop_base = c.loops.len
            check_statement(c, stmt_id)
            c.in_defer = saved_in_defer
            c.defer_loop_base = saved_loop_base
            falls = true
        }
        AstData.Return(val_id) => {
            if c.in_defer {
                fail(c, id, "cannot return from defer")
            }
            if val_id == NODE_NONE {
                if c.current_return.kind == TypeKind.Result {
                    var inner = c.sema.elements.data[c.current_return.element_type]
                    if inner.kind != TypeKind.Void {
                        fail(c, id, "non-void function must return a value")
                    }
                } else if c.current_return.kind != TypeKind.Void {
                    fail(c, id, "non-void function must return a value")
                }
            } else {
                if c.current_return.kind == TypeKind.Void {
                    fail(c, id, "void function cannot return a value")
                } else {
                    check_value(c, val_id, c.current_return)
                }
            }
            falls = false
        }
        AstData.Break(lbl_id) => {
            if c.loops.len == 0 {
                fail(c, id, "break must be inside a loop")
            } else {
                var target = (c.loops.len - 1) as i64
                if lbl_id != NODE_NONE {
                    var lbl = node_ident_span(c.tree, lbl_id)
                    var loops = c.loops.as_slice()
                    target = -1
                    var k = len(loops) - 1
                    for k >= 0 {
                        if loops[k].label.length > 0 && same_span(c.tree, loops[k].label, lbl) {
                            target = k
                            break
                        }
                        k -= 1
                    }
                    if target < 0 {
                        fail(c, lbl_id, "unknown loop label")
                        target = 0
                    }
                }
                if c.in_defer && (target as u64) < c.defer_loop_base {
                    fail(c, id, "cannot break or continue out of defer")
                }
                node_info(c, id).binding = target as u32
                var lptr = c.loops.data
                lptr[target].has_break = true
            }
            falls = false
        }
        AstData.Continue(lbl_id) => {
            if c.loops.len == 0 {
                fail(c, id, "continue must be inside a loop")
            } else {
                var target = (c.loops.len - 1) as i64
                if lbl_id != NODE_NONE {
                    var lbl = node_ident_span(c.tree, lbl_id)
                    var loops = c.loops.as_slice()
                    target = -1
                    var k = len(loops) - 1
                    for k >= 0 {
                        if loops[k].label.length > 0 && same_span(c.tree, loops[k].label, lbl) {
                            target = k
                            break
                        }
                        k -= 1
                    }
                    if target < 0 {
                        fail(c, lbl_id, "unknown loop label")
                        target = 0
                    }
                }
                if c.in_defer && (target as u64) < c.defer_loop_base {
                    fail(c, id, "cannot break or continue out of defer")
                }
                node_info(c, id).binding = target as u32
            }
            falls = false
        }
        AstData.Var(v) => {
            var name = node_span(c.tree, id, v.name_length)
            if find_local(c, name, c.scope_depth) >= 0 {
                fail(c, id, "duplicate local variable")
                return true
            }
            var vt = empty_type()
            if v.type_node != NODE_NONE {
                vt = resolve_type(c, v.type_node)
                if c.has_error { return true }
                if v.initializer != NODE_NONE {
                    check_value(c, v.initializer, vt)
                }
            } else {
                vt = check_expr(c, v.initializer, empty_type())
                if !c.has_error && vt.kind == TypeKind.Null {
                    fail(c, v.initializer, "cannot infer type from null")
                }
            }
            if c.has_error { return true }
            var sn = node_info(c, id)
            if span_bytes(c.tree, name) == "_" {
                sn.binding = ~0 as u32
                sn.type_info = vt
            } else {
                var slot = c.slot_count
                c.slot_count += 1
                var lv = LocalVar {
                    name: name,
                    slot: slot,
                    type_info: vt,
                    is_const: false,
                    const_idx: 0,
                    depth: c.scope_depth,
                }
                c.locals.push(&lv)
                sn.binding = slot
                sn.type_info = vt
            }
            falls = true
        }
        AstData.Const(idx) => {
            check_const_decl(c, idx)
            if c.has_error { return true }
            var decls = c.tree.consts.as_slice()
            var consts = c.sema.constants.data
            var lv = LocalVar {
                name: decls[idx].name,
                slot: idx,
                type_info: consts[idx].type_info,
                is_const: true,
                const_idx: idx,
                depth: c.scope_depth,
            }
            c.locals.push(&lv)
            falls = true
        }
        AstData.If(ifn) => {
            check_value(c, ifn.condition, simple_type(TypeKind.Bool))
            var then_falls = check_block(c, ifn.then_branch)
            if ifn.else_branch == NODE_NONE {
                falls = true
            } else {
                var else_falls = check_statement(c, ifn.else_branch)
                falls = then_falls || else_falls
            }
        }
        AstData.MatchType(mr) => {
            var children = c.tree.children.as_slice()
            var st = resolve_type(c, children[mr.first])
            var matched_arm: u32 = ~0 as u32
            var matched_body: u32 = NODE_NONE
            for var i: u32 = 1; i < mr.count && !c.has_error; i += 1 {
                var arm_id = children[mr.first + i]
                var ar = NodeRange { first: 0, count: 0 }
                match nodes[arm_id].data {
                    AstData.MatchArm(r) => ar = r
                    else => {}
                }
                if ar.count == 1 {
                    if i + 1 < mr.count {
                        fail(c, arm_id, "else arm must be the last arm in match")
                    }
                    if matched_arm == (~0 as u32) {
                        matched_arm = i
                        matched_body = children[ar.first + ar.count - 1]
                    }
                } else {
                    var arm_matches = false
                    for var p: u32 = 0; p < ar.count - 1 && !c.has_error; p += 1 {
                        var pat_id = children[ar.first + p]
                        var pt = resolve_type(c, pat_id)
                        if !c.has_error && same_type(c, st, pt) {
                            arm_matches = true
                        }
                    }
                    if arm_matches && matched_arm == (~0 as u32) {
                        matched_arm = i
                        matched_body = children[ar.first + ar.count - 1]
                    }
                }
            }
            if !c.has_error {
                if matched_arm == (~0 as u32) {
                    fail(c, id, "match type did not match any arm")
                } else {
                    node_info(c, id).binding = matched_arm
                    falls = check_statement(c, matched_body)
                }
            }
        }
        AstData.Match(mr) => {
            var children = c.tree.children.as_slice()
            var st = check_expr(c, children[mr.first], empty_type())
            var has_else = false
            var arm_falls = false
            var pattern_count: u32 = 0
            var seen_vals: Vec[u64]
            seen_vals.init(c.arena, 16)
            for var i: u32 = 1; i < mr.count && !c.has_error; i += 1 {
                var arm_id = children[mr.first + i]
                var ar = NodeRange { first: 0, count: 0 }
                match nodes[arm_id].data {
                    AstData.MatchArm(r) => ar = r
                    else => {}
                }
                var saved_locals = c.locals.len
                var entered_scope = false
                if ar.count == 1 {
                    if i + 1 < mr.count {
                        fail(c, arm_id, "else arm must be the last arm in match")
                    }
                    has_else = true
                } else if st.kind == TypeKind.TaggedUnion {
                    var su = &c.sema.unions.data[st.record]
                    var edecl = c.tree.enums.data[su.declaration]
                    c.scope_depth += 1
                    entered_scope = true
                    for var p: u32 = 0; p < ar.count - 1 && !c.has_error; p += 1 {
                        var pat_id = children[ar.first + p]
                        var mem_id = pat_id
                        var is_call_pat = false
                        var pcr = NodeRange { first: 0, count: 0 }
                        match nodes[pat_id].data {
                            AstData.Call(r) => {
                                is_call_pat = true
                                pcr = r
                                mem_id = children[r.first]
                            }
                            else => {}
                        }
                        var mlen: u32 = 0
                        var mem_ok = false
                        match nodes[mem_id].data {
                            AstData.Member(m) => {
                                mem_ok = true
                                mlen = m.name_length
                            }
                            else => {}
                        }
                        if !mem_ok {
                            fail(c, pat_id, "expected enum variant pattern")
                            break
                        }
                        var ei = find_enum_for_member(c, mem_id)
                        if ei != su.declaration {
                            fail(c, pat_id, "match pattern enum mismatch")
                            break
                        }
                        var mname = node_span(c.tree, mem_id, mlen)
                        var v_idx = ~0 as u32
                        for var ci: u32 = 0; ci < edecl.cases.count; ci += 1 {
                            var cid = children[edecl.cases.first + ci]
                            if same_span(c.tree, mname, node_ident_span(c.tree, cid)) {
                                v_idx = ci
                                break
                            }
                        }
                        if v_idx == (~0 as u32) {
                            fail(c, pat_id, "unknown enum variant")
                            break
                        }
                        var uv = &su.variants.data[v_idx]
                        if !is_call_pat {
                            if uv.fields.len > 0 {
                                fail(c, pat_id, "enum variant pattern requires payload bindings")
                                break
                            }
                        } else {
                            if uv.fields.len == 0 {
                                fail(c, pat_id, "unit enum variant does not take pattern arguments")
                                break
                            }
                            if (pcr.count - 1) != (uv.fields.len as u32) {
                                fail(c, pat_id, "wrong number of pattern bindings")
                                break
                            }
                            if ar.count > 2 {
                                fail(c, pat_id, "cannot bind variables in multi-pattern match arm")
                                break
                            }
                            for var bi: u32 = 0; bi < pcr.count - 1 && !c.has_error; bi += 1 {
                                var arg_id = children[pcr.first + 1 + bi]
                                var blen: u32 = 0
                                var is_id = false
                                match nodes[arg_id].data {
                                    AstData.Identifier(l) => {
                                        is_id = true
                                        blen = l
                                    }
                                    else => {}
                                }
                                if !is_id {
                                    fail(c, arg_id, "expected identifier or '_' in pattern")
                                    break
                                }
                                var bname = node_span(c.tree, arg_id, blen)
                                var bbytes = span_bytes(c.tree, bname)
                                if bbytes == "_" {
                                    node_info(c, arg_id).binding = ~0 as u32
                                } else {
                                    if find_local(c, bname, c.scope_depth) >= 0 {
                                        fail(c, arg_id, "duplicate binding name in match arm")
                                        break
                                    }
                                    var slot = c.slot_count
                                    c.slot_count += 1
                                    var ft = uv.fields.data[bi].type_info
                                    var bsn = node_info(c, arg_id)
                                    bsn.binding = slot
                                    bsn.type_info = ft
                                    var lv = LocalVar {
                                        name: bname,
                                        slot: slot,
                                        type_info: ft,
                                        is_const: false,
                                        const_idx: 0,
                                        depth: c.scope_depth,
                                    }
                                    c.locals.push(&lv)
                                }
                            }
                        }
                        if !c.has_error {
                            var svals = seen_vals.as_slice()
                            for var prev: i64 = 0; prev < len(svals); prev += 1 {
                                if svals[prev] == (v_idx as u64) {
                                    fail(c, pat_id, "duplicate match pattern")
                                    break
                                }
                            }
                            if !c.has_error {
                                seen_vals.push_value(v_idx as u64)
                                var mv_idx = c.sema.match_values.len as u32
                                c.sema.match_values.push_value(v_idx as u64)
                                var psn = node_info(c, pat_id)
                                psn.binding = mv_idx
                                psn.type_info = st
                            }
                        }
                        pattern_count += 1
                    }
                } else {
                    for var p: u32 = 0; p < ar.count - 1 && !c.has_error; p += 1 {
                        var pat_id = children[ar.first + p]
                        var pbits: u64 = 0
                        var pstr: u32 = 0
                        var pt = eval_const_expr(c, pat_id, st, &pbits, &pstr)
                        if !c.has_error {
                            if !same_type(c, pt, st) && !(!is_enum(pt) && !is_enum(st) && can_widen_num(pt.kind, st.kind)) {
                                fail(c, pat_id, "match pattern type mismatch")
                            } else {
                                var svals = seen_vals.as_slice()
                                for var prev: i64 = 0; prev < len(svals); prev += 1 {
                                    if svals[prev] == pbits {
                                        fail(c, pat_id, "duplicate match pattern")
                                        break
                                    }
                                }
                                if !c.has_error {
                                    seen_vals.push_value(pbits)
                                    var mv_idx = c.sema.match_values.len as u32
                                    c.sema.match_values.push_value(pbits)
                                    var sn = node_info(c, pat_id)
                                    sn.binding = mv_idx
                                    sn.type_info = st
                                }
                            }
                        }
                        pattern_count += 1
                    }
                }
                var body = children[ar.first + ar.count - 1]
                if !c.has_error && check_statement(c, body) {
                    arm_falls = true
                }
                if entered_scope {
                    c.scope_depth -= 1
                    c.locals.len = saved_locals
                }
            }
            if !c.has_error && !has_else {
                if st.kind == TypeKind.TaggedUnion {
                    var su = &c.sema.unions.data[st.record]
                    if pattern_count >= (su.variants.len as u32) {
                        has_else = true
                    } else {
                        fail(c, id, "match does not cover all enum cases")
                    }
                } else if is_enum(st) {
                    var enums = c.tree.enums.as_slice()
                    if pattern_count >= enums[st.record - 1].cases.count {
                        has_else = true
                    } else {
                        fail(c, id, "match does not cover all enum cases")
                    }
                } else if st.kind == TypeKind.Bool {
                    if pattern_count >= 2 {
                        has_else = true
                    } else {
                        fail(c, id, "bool match requires an else arm")
                    }
                } else if is_integer(st.kind) {
                    fail(c, id, "integer match requires an else arm")
                }
            }
            falls = !has_else || arm_falls
        }
        AstData.For(h) => {
            var saved_locals = c.locals.len
            c.scope_depth += 1
            if h.initializer != NODE_NONE {
                check_statement(c, h.initializer)
            }
            if h.condition != NODE_NONE {
                check_value(c, h.condition, simple_type(TypeKind.Bool))
            }
            if h.step != NODE_NONE {
                check_expr(c, h.step, empty_type())
            }
            if h.label.length > 0 && !c.has_error {
                var loops = c.loops.as_slice()
                for lp in loops {
                    if lp.label.length > 0 && same_span(c.tree, lp.label, h.label) {
                        fail_at(c, h.label.offset, "duplicate loop label")
                        break
                    }
                }
            }
            var le = LoopEntry { label: h.label, has_break: false }
            c.loops.push(&le)
            check_block(c, h.body)
            var popped: LoopEntry
            c.loops.pop(&popped)
            c.scope_depth -= 1
            c.locals.len = saved_locals
            falls = h.condition != NODE_NONE || popped.has_break
        }
        AstData.ForIn(h) => {
            var saved_locals = c.locals.len
            c.scope_depth += 1
            var item_t = empty_type()
            if h.range_end != NODE_NONE {
                var start_t = empty_type()
                if is_literal_expr(c.tree, h.iterable) && !is_literal_expr(c.tree, h.range_end) {
                    var end_t = check_expr(c, h.range_end, empty_type())
                    if !c.has_error && !is_integer(end_t.kind) {
                        fail(c, h.range_end, "range bounds must be integers")
                    }
                    if !c.has_error {
                        start_t = check_value(c, h.iterable, end_t)
                        item_t = end_t
                    }
                } else {
                    start_t = check_expr(c, h.iterable, empty_type())
                    if !c.has_error && !is_integer(start_t.kind) {
                        fail(c, h.iterable, "range bounds must be integers")
                    }
                    if !c.has_error {
                        check_value(c, h.range_end, start_t)
                    }
                    item_t = start_t
                }
            } else {
                var iter_t = check_expr(c, h.iterable, empty_type())
                if !c.has_error {
                    if iter_t.kind != TypeKind.Slice && iter_t.kind != TypeKind.Array {
                        fail(c, h.iterable, "for-in requires an array, slice, or range")
                    } else {
                        item_t = c.sema.elements.data[iter_t.element_type]
                    }
                }
            }
            if !c.has_error {
                if h.index_name.length > 0 {
                    var idx_slot = c.slot_count
                    c.slot_count += 1
                    if span_bytes(c.tree, h.index_name) != "_" {
                        var ilv = LocalVar {
                            name: h.index_name,
                            slot: idx_slot,
                            type_info: simple_type(TypeKind.I64),
                            is_const: false,
                            const_idx: 0,
                            depth: c.scope_depth,
                        }
                        c.locals.push(&ilv)
                    }
                }
                var item_slot = c.slot_count
                c.slot_count += 1
                if span_bytes(c.tree, h.item_name) != "_" {
                    var lv = LocalVar {
                        name: h.item_name,
                        slot: item_slot,
                        type_info: item_t,
                        is_const: false,
                        const_idx: 0,
                        depth: c.scope_depth,
                    }
                    c.locals.push(&lv)
                }
                node_info(c, id).binding = item_slot
                node_info(c, id).type_info = item_t
            }
            if h.label.length > 0 && !c.has_error {
                var loops = c.loops.as_slice()
                for lp in loops {
                    if lp.label.length > 0 && same_span(c.tree, lp.label, h.label) {
                        fail_at(c, h.label.offset, "duplicate loop label")
                        break
                    }
                }
            }
            var le = LoopEntry { label: h.label, has_break: false }
            c.loops.push(&le)
            check_block(c, h.body)
            var popped: LoopEntry
            c.loops.pop(&popped)
            c.scope_depth -= 1
            c.locals.len = saved_locals
            falls = true
        }
        else => {
            var et = check_expr(c, id, empty_type())
            var is_assign = false
            match node.data {
                AstData.Binary(bin) => {
                    if (bin.op as u8) >= (BinaryOp.Assign as u8) && (bin.op as u8) <= (BinaryOp.AssignShiftRight as u8) {
                        is_assign = true
                    }
                }
                else => {}
            }
            if !c.has_error && et.kind == TypeKind.Result && !is_assign {
                fail_at(c, nodes[id].pos, "unused error union result; handle it with '?' or 'or'")
            }
            falls = true
        }
    }
    node_info(c, id).falls_through = falls
    return falls
}

fun check_block(c: *Checker, id: u32): bool {
    var nodes = c.tree.nodes.as_slice()
    var br = NodeRange { first: 0, count: 0 }
    match nodes[id].data {
        AstData.Block(r) => br = r
        else => {}
    }
    var children = c.tree.children.as_slice()
    var saved_locals = c.locals.len
    c.scope_depth += 1
    var falls = true
    for var i: u32 = 0; i < br.count && !c.has_error; i += 1 {
        falls = check_statement(c, children[br.first + i])
    }
    c.scope_depth -= 1
    c.locals.len = saved_locals
    node_info(c, id).falls_through = falls
    return falls
}

pub fun check(arena: *mem.Arena, tree: *Ast, out: *Sema, err: *SemaError): bool {
    if out.nodes.init(arena, tree.nodes.len + 1) < 0 { return false }
    if out.functions.init(arena, tree.functions.len + 1) < 0 { return false }
    if out.records.init(arena, tree.structs.len + 1) < 0 { return false }
    if out.unions.init(arena, tree.enums.len + 1) < 0 { return false }
    if out.constants.init(arena, tree.consts.len + 1) < 0 { return false }
    if out.pointees.init(arena, 32) < 0 { return false }
    if out.elements.init(arena, 32) < 0 { return false }
    if out.func_types.init(arena, 16) < 0 { return false }
    if out.enum_values.init(arena, 32) < 0 { return false }
    if out.match_values.init(arena, 32) < 0 { return false }

    var empty_sn = SemaNode {
        type_info: empty_type(),
        binding: 0,
        builtin: SemaBuiltin.None,
        promotion: TypeKind.Invalid,
        method_call: 0,
        result_wrap: 0,
        box_any: false,
        is_fn_ref: false,
        is_indirect_call: false,
        is_boolean_literal: false,
        borrow_array: false,
        falls_through: false,
        is_enum_case: false,
        is_const: false,
    }
    for _ in 0..tree.nodes.len {
        out.nodes.push(&empty_sn)
    }

    var c: Checker
    c.arena = arena
    c.tree = tree
    c.sema = out
    c.err.note_offset = NODE_NONE
    c.err.note_message = ""
    c.has_error = false
    c.scope_depth = 0
    c.slot_count = 0
    c.current_fn_idx = ~0 as u32
    c.recursion_depth = 0
    c.module = 0
    c.owner_struct = ~0 as u32
    c.type_parameters = NodeRange { first: 0, count: 0 }
    c.instantiation_depth = 0
    c.locals.init(arena, 64)
    c.loops.init(arena, 8)

    for i in 0..tree.structs.len {
        var sr = SemaRecord {
            declaration: i as u32,
            size: 0,
            alignment: 1,
            state: 0,
            auto_eq: false,
            auto_hash: false,
            fields: Vec[SemaNode] { arena: arena },
            arguments: Vec[SemaType] { arena: arena },
        }
        sr.fields.init(arena, 8)
        out.records.push(&sr)
    }
    for i in 0..tree.enums.len {
        var su = SemaUnion {
            declaration: i as u32,
            size: 0,
            alignment: 4,
            state: 0,
            auto_eq: false,
            auto_hash: false,
            variants: Vec[SemaUnionVariant] { arena: arena },
            arguments: Vec[SemaType] { arena: arena },
        }
        su.variants.init(arena, 8)
        out.unions.push(&su)
    }
    for _ in 0..tree.consts.len {
        var sc = SemaConstant { type_info: empty_type(), bits: 0, str_node: NODE_NONE, state: 0 }
        out.constants.push(&sc)
    }

    // Resolve enums
    var enums = tree.enums.as_slice()
    var children = tree.children.as_slice()
    var nodes = tree.nodes.as_slice()
    for var i: i64 = 0; i < len(enums) && !c.has_error; i += 1 {
        var edecl = enums[i]
        c.module = edecl.module
        if edecl.has_payload {
            if edecl.type_parameters.count == 0 {
                resolve_union_layout(&c, i as u32)
            }
            continue
        }
        if edecl.type_parameters.count > 0 {
            fail_at(&c, edecl.name.offset, "plain enum without payload cannot have type parameters")
            break
        }
        for var ti: u32 = 0; ti < edecl.traits.count && !c.has_error; ti += 1 {
            var tn = children[edecl.traits.first + ti]
            var tidx = resolve_trait_ref(&c, tn)
            if !c.has_error && !is_eq_trait(&c, tidx) && !is_hash_trait(&c, tidx) {
                fail(&c, tn, "enum only supports Eq and Hash traits")
            }
        }
        var bt = resolve_enum_backing(&c, edecl)
        if !c.has_error && !is_integer(bt.kind) {
            fail(&c, edecl.backing, "enum backing type must be an integer")
            break
        }
        var next_val: u64 = 0
        for var m: u32 = 0; m < edecl.cases.count && !c.has_error; m += 1 {
            var cid = children[edecl.cases.first + m]
            var ec = AstEnumCase { name_length: 0, fields: NodeRange { first: 0, count: 0 }, value: NODE_NONE, has_payload: false }
            match nodes[cid].data {
                AstData.EnumCase(cdata) => ec = cdata
                else => {}
            }
            var val = next_val
            if ec.value != NODE_NONE {
                var dummy_str: u32 = 0
                eval_const_expr(&c, ec.value, bt, &val, &dummy_str)
            }
            var ev_idx = out.enum_values.len as u32
            out.enum_values.push_value(val)
            var sn = out.nodes.data
            sn[cid].binding = ev_idx
            next_val = val + 1
        }
    }

    // Resolve structs and consts
    var sdecls = tree.structs.as_slice()
    for var i: u64 = 0; i < tree.structs.len && !c.has_error; i += 1 {
        if sdecls[i].type_parameters.count == 0 {
            resolve_struct_layout(&c, i as u32)
        }
    }
    for var i: u64 = 0; i < tree.consts.len && !c.has_error; i += 1 {
        var consts = tree.consts.as_slice()
        if !consts[i].local {
            check_const_decl(&c, i as u32)
        }
    }

    // Register function signatures
    var fns = tree.functions.as_slice()
    for var i: i64 = 0; i < len(fns) && !c.has_error; i += 1 {
        var fdecl = fns[i]
        var sf = SemaFunction {
            result: empty_type(),
            slot_count: 0,
            declaration: i as u32,
            instantiated_at: NODE_NONE,
            param_types: Vec[SemaType] { arena: arena },
            arguments: Vec[SemaType] { arena: arena },
            nodes: Vec[SemaNode] { arena: arena },
        }
        sf.param_types.init(arena, 8)
        out.functions.push(&sf)
        if fdecl.type_parameters.count == 0 {
            register_fn_sig(&c, i as u32)
            if !c.has_error && fdecl.body == NODE_NONE {
                var rk = out.functions.data[i].result.kind
                if rk == TypeKind.Struct || rk == TypeKind.Array || rk == TypeKind.Slice {
                    fail_at(&c, fdecl.name.offset, "external results must be scalar")
                }
            }
        }
    }

    // Check function bodies (including generic specializations appended during checking)
    for var i: i64 = 0; i < (out.functions.len as i64) && !c.has_error; i += 1 {
        var sf_list = out.functions.data
        var decl_idx = sf_list[i].declaration
        var fdecl = fns[decl_idx]
        if fdecl.body == NODE_NONE || (fdecl.type_parameters.count > 0 && sf_list[i].arguments.len == 0) {
            continue
        }
        var saved = enter_type_scope(&c, fdecl.module, fdecl.type_parameters,
                                     (sf_list[i].arguments).as_slice(),
                                     c.instantiation_depth + 1)
        c.owner_struct = fdecl.owner_struct
        c.current_return = sf_list[i].result
        c.current_fn_idx = i as u32
        c.locals.len = 0
        c.loops.len = 0
        c.scope_depth = 1
        c.slot_count = 0

        var ptypes = (sf_list[i].param_types).as_slice()
        for var p: u32 = 0; p < fdecl.parameters.count; p += 1 {
            var pid = children[fdecl.parameters.first + p]
            var lv = LocalVar {
                name: node_ident_span(tree, pid),
                slot: c.slot_count,
                type_info: ptypes[p],
                is_const: false,
                const_idx: 0,
                depth: 1,
            }
            c.slot_count += 1
            c.locals.push(&lv)
        }
        var falls = check_block(&c, fdecl.body)
        var needs_return = c.current_return.kind != TypeKind.Void
        if c.current_return.kind == TypeKind.Result && c.sema.elements.data[c.current_return.element_type].kind == TypeKind.Void {
            needs_return = false
        }
        if !c.has_error && needs_return && falls {
            fail_at(&c, fdecl.name.offset, "function can finish without returning a value")
        }
        sf_list = out.functions.data
        if c.has_error && sf_list[i].instantiated_at != NODE_NONE {
            c.err.note_offset = nodes[sf_list[i].instantiated_at].pos
            c.err.note_message = "generic instantiated here"
        }
        sf_list[i].slot_count = c.slot_count
        leave_type_scope(&c, saved)
    }

    *err = c.err
    return !c.has_error
}
