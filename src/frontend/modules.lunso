import std.file
import std.fmt
import std.io
import std.map
import std.mem
import std.os
import std.path
import std.str
import std.vec
import frontend.ast.*
import frontend.lexer
import frontend.parser

pub struct ModuleFile {
    path: []u8
    start: u32
    length: u32
}

pub struct ModuleProgram {
    tree: Ast
    files: vec.Vec[ModuleFile]
    quiet: bool
    has_error: bool
    err_offset: u32
    err_message: []u8
}

enum LoadState : u8 {
    Unloaded,
    Loading,
    Loaded,
}

struct ModuleEntry {
    name: []u8
    file: []u8
    state: LoadState
    parent: u32
    declarations: NodeRange
    scope: AstModuleScope
}

struct Loader {
    arena: *mem.Arena
    program: *ModuleProgram
    source_buf: vec.Vec[u8]
    root: []u8
    std_root: []u8
    include_dirs: [][]u8
    overlays: *map.StrMap[[]u8]
    modules: vec.Vec[ModuleEntry]
    depth: u32
}

const NO_MODULE: u32 = ~0 as u32
const MAX_MODULE_DEPTH: u32 = 256

fun file_available(l: *Loader, p: []u8): bool {
    if (l.overlays as u64) != 0 && l.overlays.has(p) {
        return true
    }
    return file.exists(p)
}

pub fun find_file_at(files: []ModuleFile, offset: u32): i64 {
    for var i: i64 = 0; i < len(files); i += 1 {
        var f = files[i]
        if offset >= f.start && offset <= f.start + f.length {
            return i
        }
    }
    return -1
}

pub fun print_caret(src: []u8, file_start: u32, file_end: u32, offset: u32, line: u64, col: u64) {
    if offset < file_start || offset > file_end || (file_end as i64) > len(src) {
        return
    }
    var line_start = offset
    for line_start > file_start {
        var prev = src[(line_start - 1) as i64]
        if prev == '\n' || prev == '\r' {
            break
        }
        line_start -= 1
    }
    var line_end = offset
    for line_end < file_end {
        var ch = src[line_end as i64]
        if ch == '\n' || ch == '\r' {
            break
        }
        line_end += 1
    }
    var num_buf: [32]u8
    var num_len = fmt.u64_to_buf(line, &num_buf[0], 32)
    io.eprint("  ")
    io.write_bytes(2, num_buf[0..num_len])
    io.eprint(" | ")
    io.write_bytes(2, src[(line_start as i64)..(line_end as i64)])
    io.eprintln("")
    io.eprint("  ")
    for var k: i64 = 0; k < num_len; k += 1 {
        io.eprint(" ")
    }
    io.eprint(" | ")
    var p = line_start
    for p < offset && p < line_end {
        if src[p as i64] == '\t' {
            io.eprint("\t")
        } else {
            io.eprint(" ")
        }
        p += 1
    }
    if p == line_end && col > ((line_end - line_start) as u64) + 1 {
        // clamp at end of line
    }
    io.eprintln("^")
}

pub fun report(program: *ModuleProgram, offset: u32, message: []u8) {
    var files = program.files.as_slice()
    var src = program.tree.source
    for var i = len(files); i > 0; i -= 1 {
        var f = files[i - 1]
        if offset < f.start || offset - f.start > f.length {
            continue
        }
        var line: u64 = 1
        var col: u64 = 1
        for var p = f.start; p < offset; p += 1 {
            var b = src[p as i64]
            if b == '\r' || b == '\n' {
                if b == '\r' && p + 1 < offset && src[(p + 1) as i64] == '\n' {
                    p += 1
                }
                line += 1
                col = 1
            } else {
                col += 1
            }
        }
        io.eprint(f.path)
        io.eprint(":")
        fmt.print_u64(2, line)
        io.eprint(":")
        fmt.print_u64(2, col)
        io.eprint(": ")
        io.eprintln(message)
        print_caret(src, f.start, f.start + f.length, offset, line, col)
        return
    }
    io.eprintln(message)
}

fun err_at(l: *Loader, offset: u32, msg: []u8): bool {
    l.program.has_error = true
    l.program.err_offset = offset
    l.program.err_message = msg
    if !l.program.quiet {
        report(l.program, offset, msg)
    }
    return false
}

fun is_std_module(name: []u8): bool {
    if str.equals(name, "std") { return true }
    return len(name) >= 4 && name[0] == 's' && name[1] == 't' && name[2] == 'd' && name[3] == '/'
}

fun span_bytes(tree: *Ast, s: Span): []u8 {
    var start = s.offset as i64
    var end = (s.offset + s.length) as i64
    return tree.source[start..end]
}

fun item_name(tree: *Ast, id: u32): Span {
    var nodes = tree.nodes.as_slice()
    var pos = tree.nodes.as_slice()[id as i64].pos
    return Span { offset: pos, length: nodes[id as i64].a }
}

fun get_module(l: *Loader, name: []u8, offset: u32, out: *u32): bool {
    *out = NO_MODULE
    var in_std = len(l.std_root) > 0 && is_std_module(name)
    var mods = l.modules.as_slice()
    var start_idx: i64 = 0
    if in_std { start_idx = 1 }
    for var i = start_idx; i < len(mods); i += 1 {
        if str.equals(mods[i].name, name) {
            *out = i as u32
            return true
        }
    }
    var std_root_mod = in_std && len(name) == 3
    var file_path: []u8 = ""
    if !std_root_mod {
        if in_std {
            var sub = name[4..len(name)]
            file_path = path.join(l.arena, l.std_root, str.concat(l.arena, sub, ".lunso"))
            if !file_available(l, file_path) {
                file_path = ""
            }
        } else {
            file_path = str.concat3(l.arena, l.root, name, ".lunso")
            if !file_available(l, file_path) {
                file_path = ""
                var fname = str.concat(l.arena, name, ".lunso")
                for var k: i64 = 0; k < len(l.include_dirs); k += 1 {
                    var inc = l.include_dirs[k]
                    if len(inc) == 0 { continue }
                    var cand = path.join(l.arena, inc, fname)
                    if file_available(l, cand) {
                        file_path = cand
                        break
                    }
                }
            }
        }
    }
    if len(file_path) == 0 && !std_root_mod {
        return true
    }
    var entry = ModuleEntry {
        name: name,
        file: file_path,
        state: LoadState.Unloaded,
        parent: NO_MODULE,
        declarations: NodeRange { first: 0, count: 0 },
        scope: AstModuleScope { bindings: vec.Vec[AstBinding] { data: 0 as *AstBinding, len: 0, cap: 0, arena: l.arena } },
    }
    if entry.scope.bindings.init(l.arena, 16) < 0 {
        return err_at(l, offset, "could not allocate module scope")
    }
    var idx = l.modules.len as u32
    if l.modules.push(&entry) < 0 {
        return err_at(l, offset, "could not allocate module storage")
    }
    *out = idx
    return true
}

fun add_source(l: *Loader, path: []u8, source: []u8, offset: u32, out_base: *u32): bool {
    var base = l.source_buf.len as u32
    if l.source_buf.append_slice(source) < 0 {
        return err_at(l, offset, "could not allocate source storage")
    }
    if l.source_buf.push_value('\n') < 0 {
        return err_at(l, offset, "could not allocate source storage")
    }
    l.program.tree.source = l.source_buf.as_slice()
    var mf = ModuleFile { path: path, start: base, length: len(source) as u32 }
    if l.program.files.push(&mf) < 0 {
        return err_at(l, offset, "could not allocate file table")
    }
    *out_base = base
    return true
}

pub fun format_unexpected_byte(arena: *mem.Arena, b: u8): []u8 {
    var hex = "0123456789ABCDEF"
    var buf: *u8
    if arena.alloc(20, 1, &buf) < 0 {
        return "unexpected byte"
    }
    var prefix = "unexpected byte 0x"
    for var i: i64 = 0; i < 18; i += 1 {
        buf[i] = prefix[i]
    }
    buf[18] = hex[((b >> 4) & 15) as i64]
    buf[19] = hex[(b & 15) as i64]
    return buf[0..20]
}

fun parse_file(l: *Loader, mod_id: u32, source: []u8, offset: u32): bool {
    var mods = l.modules.as_slice()
    var base: u32 = 0
    if !add_source(l, mods[mod_id as i64].file, source, offset, &base) {
        return false
    }
    var slice = l.program.tree.source[(base as i64)..((base as i64) + len(source))]
    var perr: parser.ParseError
    var decls: NodeRange
    if !parser.parse_append(l.arena, &l.program.tree, slice, base, mod_id, &decls, &perr) {
        if perr.token.kind == lexer.TokenKind.Invalid {
            var byte = slice[perr.token.offset as i64]
            return err_at(l, base + (perr.token.offset as u32), format_unexpected_byte(l.arena, byte))
        }
        return err_at(l, base + (perr.token.offset as u32), perr.message)
    }
    l.modules.data[mod_id as i64].declarations = decls
    return true
}

fun declaration_info(tree: *Ast, id: u32, out_name: *Span, out_kind: *AstBindingKind, out_pub: *bool): bool {
    var nodes = tree.nodes.as_slice()
    var node = nodes[id as i64]
    if node.kind == AstKind.Function {
        var fns = tree.functions.as_slice()
        *out_name = fns[node.a as i64].name
        *out_pub = fns[node.a as i64].public
        *out_kind = AstBindingKind.Function
        return true
    }
    if node.kind == AstKind.Struct {
        var ss = tree.structs.as_slice()
        *out_name = ss[node.a as i64].name
        *out_pub = ss[node.a as i64].public
        *out_kind = AstBindingKind.Struct
        return true
    }
    if node.kind == AstKind.Enum {
        var es = tree.enums.as_slice()
        *out_name = es[node.a as i64].name
        *out_pub = es[node.a as i64].public
        *out_kind = AstBindingKind.Enum
        return true
    }
    if node.kind == AstKind.Const {
        var cs = tree.consts.as_slice()
        if !cs[node.a as i64].local {
            *out_name = cs[node.a as i64].name
            *out_pub = cs[node.a as i64].public
            *out_kind = AstBindingKind.Const
            return true
        }
    }
    return false
}

fun binding_named(mod: *ModuleEntry, name: []u8, out: *AstBinding): bool {
    var bs = mod.scope.bindings.as_slice()
    for var i: i64 = 0; i < len(bs); i += 1 {
        if str.equals(bs[i].name, name) {
            *out = bs[i]
            return true
        }
    }
    return false
}

fun bind_name(l: *Loader, owner: u32, name: []u8, kind: AstBindingKind, index: u32, offset: u32): bool {
    var mod = &l.modules.data[owner as i64]
    var prior: AstBinding
    if binding_named(mod, name, &prior) {
        if prior.kind == kind && prior.index == index {
            return true
        }
        report(l.program, offset, "import introduces a conflicting name")
        return err_at(l, prior.offset, "name was first imported here")
    }
    var tree = &l.program.tree
    var children = tree.children.as_slice()
    for var i: u32 = 0; i < mod.declarations.count; i += 1 {
        var decl = children[(mod.declarations.first + i) as i64]
        var existing: Span
        var dk: AstBindingKind
        var pub_flag = false
        if declaration_info(tree, decl, &existing, &dk, &pub_flag) && str.equals(span_bytes(tree, existing), name) {
            report(l.program, offset, "import conflicts with a local declaration")
            return err_at(l, existing.offset, "name was declared here")
        }
    }
    var b = AstBinding { name: name, index: index, offset: offset, kind: kind }
    if (l.modules.data[owner as i64].scope.bindings).push(&b) < 0 {
        return err_at(l, offset, "could not allocate module binding")
    }
    return true
}

fun module_path_str(l: *Loader, path: NodeRange): []u8 {
    var tree = &l.program.tree
    var children = tree.children.as_slice()
    var total: i64 = 0
    for var i: u32 = 0; i < path.count; i += 1 {
        if i > 0 { total += 1 }
        var part = item_name(tree, children[(path.first + i) as i64])
        total += part.length as i64
    }
    var buf: *u8
    if l.arena.alloc(total as u64, 1, &buf) < 0 {
        return ""
    }
    var pos: i64 = 0
    for var i: u32 = 0; i < path.count; i += 1 {
        if i > 0 { buf[pos] = '/'; pos += 1 }
        var s = span_bytes(tree, item_name(tree, children[(path.first + i) as i64]))
        for var j: i64 = 0; j < len(s); j += 1 {
            buf[pos] = s[j]
            pos += 1
        }
    }
    return buf[0..total]
}

fun child_module(l: *Loader, parent: u32, name: []u8, offset: u32, out: *u32): bool {
    var mods = l.modules.as_slice()
    var p = str.concat3(l.arena, mods[parent as i64].name, "/", name)
    return get_module(l, p, offset, out)
}

fun import_all(l: *Loader, owner: u32, target: u32, offset: u32): bool {
    var tree = &l.program.tree
    var children = tree.children.as_slice()
    var nodes = tree.nodes.as_slice()
    var decls = l.modules.data[target as i64].declarations
    for var i: u32 = 0; i < decls.count; i += 1 {
        var id = children[(decls.first + i) as i64]
        var name: Span
        var kind: AstBindingKind
        var is_pub = false
        if declaration_info(tree, id, &name, &kind, &is_pub) && is_pub {
            if !bind_name(l, owner, span_bytes(tree, name), kind, nodes[id as i64].a, offset) {
                return false
            }
        }
    }
    return true
}

fun import_selected(l: *Loader, owner: u32, target: u32, item: AstImport): bool {
    var tree = &l.program.tree
    var children = tree.children.as_slice()
    var nodes = tree.nodes.as_slice()
    var decls = l.modules.data[target as i64].declarations
    for var i: u32 = 0; i < item.items.count; i += 1 {
        var id = children[(item.items.first + i) as i64]
        var req = item_name(tree, id)
        var alias_id = nodes[id as i64].b
        var name_span = req
        if alias_id != NODE_NONE { name_span = item_name(tree, alias_id) }
        var req_bytes = span_bytes(tree, req)
        var name_bytes = span_bytes(tree, name_span)
        var found = false
        var is_priv = false
        for var j: u32 = 0; j < decls.count; j += 1 {
            var decl_id = children[(decls.first + j) as i64]
            var exported: Span
            var kind: AstBindingKind
            var is_pub = false
            if !declaration_info(tree, decl_id, &exported, &kind, &is_pub) {
                continue
            }
            if !str.equals(span_bytes(tree, exported), req_bytes) {
                continue
            }
            if is_pub {
                if !bind_name(l, owner, name_bytes, kind, nodes[decl_id as i64].a, req.offset) {
                    return false
                }
                found = true
            } else {
                is_priv = true
            }
        }
        if found { continue }
        if is_priv {
            return err_at(l, req.offset, "cannot import a private declaration")
        }
        var child: u32 = NO_MODULE
        if !child_module(l, target, req_bytes, req.offset, &child) {
            return false
        }
        if child == NO_MODULE {
            return err_at(l, req.offset, "name does not exist in imported module")
        }
        if !bind_name(l, owner, name_bytes, AstBindingKind.Module, child, req.offset) {
            return false
        }
    }
    return true
}

fun load_import(l: *Loader, owner: u32, id: u32): bool {
    var tree = &l.program.tree
    var nodes = tree.nodes.as_slice()
    var offset = nodes[id as i64].pos
    var imports = tree.imports.as_slice()
    var item = imports[nodes[id as i64].a as i64]
    var name = module_path_str(l, item.path)
    var target: u32 = NO_MODULE
    if !get_module(l, name, offset, &target) {
        return false
    }
    if target == NO_MODULE {
        io.eprint("  module ")
        io.eprintln(name)
        return err_at(l, offset, "module not found")
    }
    if !load_module(l, target, owner, offset) {
        return false
    }
    if item.kind == ImportKind.All {
        return import_all(l, owner, target, offset)
    }
    if item.kind == ImportKind.Selected {
        return import_selected(l, owner, target, item)
    }
    var children = tree.children.as_slice()
    var last = children[(item.path.first + item.path.count - 1) as i64]
    var alias_span = item.alias
    if alias_span.length == 0 {
        alias_span = item_name(tree, last)
    }
    return bind_name(l, owner, span_bytes(tree, alias_span), AstBindingKind.Module, target, offset)
}

fun add_qualified(l: *Loader, q: AstQualified): bool {
    if l.program.tree.qualified.push(&q) < 0 {
        var nodes = l.program.tree.nodes.as_slice()
        return err_at(l, nodes[q.node as i64].pos, "could not allocate qualified reference")
    }
    return true
}

fun qualify(l: *Loader, owner: u32, id: u32, parts: []Span, expected: AstBindingKind): bool {
    var optional = expected == AstBindingKind.Enum || expected == AstBindingKind.Const
    var tree = &l.program.tree
    var first_name = span_bytes(tree, parts[0])
    var binding: AstBinding
    if !binding_named(&l.modules.data[owner as i64], first_name, &binding) || binding.kind != AstBindingKind.Module {
        if expected != AstBindingKind.Struct {
            return true
        }
        return err_at(l, parts[0].offset, "unknown module name")
    }
    var target = binding.index
    for var i: i64 = 1; i + 1 < len(parts); i += 1 {
        var part_name = span_bytes(tree, parts[i])
        if !child_module(l, target, part_name, parts[i].offset, &target) {
            return false
        }
        if target == NO_MODULE {
            if optional { return true }
            return err_at(l, parts[i].offset, "unknown submodule")
        }
    }
    var requested = parts[len(parts) - 1]
    if !load_module(l, target, owner, requested.offset) {
        return false
    }
    var req_bytes = span_bytes(tree, requested)
    var decls = l.modules.data[target as i64].declarations
    var children = tree.children.as_slice()
    var nodes = tree.nodes.as_slice()
    for var i: u32 = 0; i < decls.count; i += 1 {
        var decl_id = children[(decls.first + i) as i64]
        var dname: Span
        var dkind: AstBindingKind
        var is_pub = false
        if !declaration_info(tree, decl_id, &dname, &dkind, &is_pub) {
            continue
        }
        if dkind != expected && !(expected == AstBindingKind.Struct && dkind == AstBindingKind.Enum) {
            continue
        }
        if !str.equals(span_bytes(tree, dname), req_bytes) {
            continue
        }
        var inacc = !is_pub && owner != target
        if inacc && !optional {
            return err_at(l, requested.offset, "cannot access a private declaration")
        }
        return add_qualified(l, AstQualified {
            node: id,
            index: nodes[decl_id as i64].a,
            kind: dkind,
            inaccessible: inacc,
        })
    }
    if optional { return true }
    if expected == AstBindingKind.Struct {
        return err_at(l, requested.offset, "unknown type in module")
    }
    return err_at(l, requested.offset, "unknown function in module")
}

fun member_path(tree: *Ast, id: u32, parts: *Span, cap: i64): i64 {
    var nodes = tree.nodes.as_slice()
    var start = cap
    var cur = id
    for nodes[cur as i64].kind == AstKind.Member && start > 1 {
        start -= 1
        parts[start] = Span { offset: nodes[cur as i64].pos, length: nodes[cur as i64].b }
        cur = nodes[cur as i64].a
    }
    if start == cap || nodes[cur as i64].kind != AstKind.Identifier {
        return cap
    }
    start -= 1
    parts[start] = item_name(tree, cur)
    return start
}

fun resolve_references(l: *Loader, owner: u32, first: u32, end: u32, member_prefixes: []bool): bool {
    var tree = &l.program.tree
    var nodes = tree.nodes.as_slice()
    var children = tree.children.as_slice()
    var parts: [64]Span
    for var id = first; id < end; id += 1 {
        var node = nodes[id as i64]
        if node.kind == AstKind.QualifiedType {
            if node.b > 64 {
                return err_at(l, node.pos, "qualified path is too deep")
            }
            for var i: u32 = 0; i < node.b; i += 1 {
                parts[i as i64] = item_name(tree, children[(node.a + i) as i64])
            }
            if !qualify(l, owner, id, parts[0..(node.b as i64)], AstBindingKind.Struct) {
                return false
            }
        } else if (node.kind == AstKind.Call || node.kind == AstKind.GenericType ||
                  node.kind == AstKind.StructLiteral ||
                  (node.kind == AstKind.Member && !member_prefixes[(id - first) as i64])) {
            var is_call = node.kind == AstKind.Call
            var is_type = node.kind == AstKind.GenericType || node.kind == AstKind.StructLiteral
            var base = id
            if is_call || is_type {
                base = children[node.a as i64]
            }
            if nodes[base as i64].kind == AstKind.GenericCallee {
                base = children[nodes[base as i64].a as i64]
            }
            var start = member_path(tree, base, &parts[0], 64)
            var count = 64 - start
            if is_call || is_type {
                var exp = AstBindingKind.Struct
                if is_call { exp = AstBindingKind.Function }
                if count >= 2 && !qualify(l, owner, id, parts[start..64], exp) {
                    return false
                }
            } else {
                var before = tree.qualified.len
                if count >= 3 && !qualify(l, owner, id, parts[start..63], AstBindingKind.Enum) {
                    return false
                }
                if tree.qualified.len == before && count >= 2 &&
                   !qualify(l, owner, id, parts[start..64], AstBindingKind.Const) {
                    return false
                }
            }
        }
    }
    return true
}

fun finish_module(l: *Loader, mod_id: u32, first: u32, end: u32): bool {
    var tree = &l.program.tree
    var children = tree.children.as_slice()
    var nodes = tree.nodes.as_slice()
    var decls = l.modules.data[mod_id as i64].declarations
    for var i: u32 = 0; i < decls.count; i += 1 {
        var id = children[(decls.first + i) as i64]
        if nodes[id as i64].kind == AstKind.Import {
            if !load_import(l, mod_id, id) {
                return false
            }
        }
    }
    if first >= end {
        return true
    }
    var prefixes: vec.Vec[bool]
    var count = (end - first) as u64
    if prefixes.init(l.arena, count) < 0 {
        return err_at(l, nodes[first as i64].pos, "could not allocate prefix table")
    }
    for var i: u64 = 0; i < count; i += 1 {
        prefixes.push_value(false)
    }
    for var id = first; id < end; id += 1 {
        var node = nodes[id as i64]
        var prefix = NODE_NONE
        if node.kind == AstKind.Member {
            prefix = node.a
        } else if node.kind == AstKind.Call || node.kind == AstKind.GenericType || node.kind == AstKind.GenericCallee || node.kind == AstKind.StructLiteral {
            prefix = children[node.a as i64]
        } else {
            continue
        }
        if nodes[prefix as i64].kind == AstKind.Member {
            prefixes.data[(prefix - first) as i64] = true
        }
    }
    return resolve_references(l, mod_id, first, end, prefixes.as_slice())
}

fun load_module(l: *Loader, mod_id: u32, owner: u32, offset: u32): bool {
    var st = l.modules.data[mod_id as i64].state
    if st == LoadState.Loaded { return true }
    if st == LoadState.Loading {
        return err_at(l, offset, "cyclic module import")
    }
    if l.depth == MAX_MODULE_DEPTH {
        return err_at(l, offset, "module import nesting limit exceeded")
    }
    var file_path = l.modules.data[mod_id as i64].file
    if len(file_path) == 0 {
        l.modules.data[mod_id as i64].state = LoadState.Loaded
        return true
    }
    var raw: []u8
    var from_overlay = (l.overlays as u64) != 0 && l.overlays.get(file_path, &raw)
    if !from_overlay && file.read_all(file_path, l.arena, &raw) < 0 {
        return err_at(l, offset, "could not read imported module")
    }
    l.depth += 1
    l.modules.data[mod_id as i64].state = LoadState.Loading
    l.modules.data[mod_id as i64].parent = owner
    var first = l.program.tree.nodes.len as u32
    var ok = parse_file(l, mod_id, raw, offset)
    if ok {
        var start_node = first
        if start_node == 0 { start_node = 1 }
        ok = finish_module(l, mod_id, start_node, l.program.tree.nodes.len as u32)
    }
    l.depth -= 1
    if ok {
        l.modules.data[mod_id as i64].state = LoadState.Loaded
    }
    return ok
}

fun sort_qualified(tree: *Ast) {
    var qs = tree.qualified.data
    var n = tree.qualified.len as i64
    for var i: i64 = 1; i < n; i += 1 {
        var key = qs[i]
        var j = i - 1
        for j >= 0 && qs[j].node > key.node {
            qs[j + 1] = qs[j]
            j -= 1
        }
        qs[j + 1] = key
    }
}

fun select_std_root(arena: *mem.Arena, override: []u8): []u8 {
    if len(override) > 0 {
        return override
    }
    var env_val: []u8
    if os.getenv("LUNSO_STD_DIR", arena, &env_val) == 0 && len(env_val) > 0 {
        return env_val
    }
    if file.exists("std/io.lunso") { return "std" }
    return ""
}

pub fun load_with_overlays(arena: *mem.Arena, entry_path: []u8, source: []u8, std_dir: []u8,
                              include_dirs: [][]u8, overlays: *map.StrMap[[]u8], out: *ModuleProgram): bool {
    var _overlay_layout: map.StrMap[[]u8]
    if !init(arena, source, &out.tree) {
        return false
    }
    if out.files.init(arena, 8) < 0 {
        return false
    }
    var l = Loader {
        arena: arena,
        program: out,
        source_buf: vec.Vec[u8] { data: 0 as *u8, len: 0, cap: 0, arena: arena },
        root: path.dir_prefix(entry_path),
        std_root: select_std_root(arena, std_dir),
        include_dirs: include_dirs,
        overlays: overlays,
        modules: vec.Vec[ModuleEntry] { data: 0 as *ModuleEntry, len: 0, cap: 0, arena: arena },
        depth: 1,
    }
    if l.source_buf.init(arena, (len(source) + 1024) as u64) < 0 {
        return false
    }
    if l.modules.init(arena, 8) < 0 {
        return false
    }
    var entry = ModuleEntry {
        name: "main",
        file: entry_path,
        state: LoadState.Loading,
        parent: NO_MODULE,
        declarations: NodeRange { first: 0, count: 0 },
        scope: AstModuleScope { bindings: vec.Vec[AstBinding] { data: 0 as *AstBinding, len: 0, cap: 0, arena: arena } },
    }
    if entry.scope.bindings.init(arena, 16) < 0 {
        return false
    }
    if l.modules.push(&entry) < 0 {
        return false
    }
    if !parse_file(&l, 0, source, 0) {
        return false
    }
    if !finish_module(&l, 0, 1, out.tree.nodes.len as u32) {
        return false
    }
    out.tree.declarations = l.modules.data[0].declarations
    sort_qualified(&out.tree)
    for var i: i64 = 0; i < l.modules.len as i64; i += 1 {
        if out.tree.modules.push(&l.modules.data[i].scope) < 0 {
            return false
        }
    }
    return true
}

pub fun load(arena: *mem.Arena, entry_path: []u8, source: []u8, std_dir: []u8, include_dirs: [][]u8, out: *ModuleProgram): bool {
    return load_with_overlays(arena, entry_path, source, std_dir, include_dirs, 0 as *map.StrMap[[]u8], out)
}
