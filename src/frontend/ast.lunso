import std.mem
import std.vec

pub const NODE_NONE: u32 = 0

pub enum AstKind : u8 {
    Invalid,
    Function,
    Struct,
    Enum,
    EnumCase,
    Const,
    Import,
    ImportItem,
    Field,
    Parameter,
    TypeName,
    QualifiedType,
    ArrayType,
    ConstType,
    PointerType,
    ResultType,
    FuncType,
    GenericType,
    Block,
    Return,
    If,
    Match,
    MatchArm,
    For,
    ForCStyle,
    ForIn,
    Break,
    Continue,
    Defer,
    Var,
    Identifier,
    Integer,
    Float,
    String,
    ArrayLiteral,
    StructLiteral,
    StructFieldInit,
    Call,
    GenericCallee,
    Index,
    Slice,
    SliceRange,
    Member,
    Cast,
    Try,
    OrElse,
    AddressOf,
    Dereference,
    Positive,
    Negate,
    LogicalNot,
    BitNot,
    Add,
    Subtract,
    Multiply,
    Divide,
    Remainder,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    LogicalAnd,
    LogicalOr,
    BitAnd,
    BitOr,
    BitXor,
    ShiftLeft,
    ShiftRight,
    Assign,
    AssignAdd,
    AssignSubtract,
    AssignMultiply,
    AssignDivide,
    AssignRemainder,
    AssignBitAnd,
    AssignBitOr,
    AssignBitXor,
    AssignShiftLeft,
    AssignShiftRight,
}

pub struct Span {
    offset: u32
    length: u32
}

pub struct NodeRange {
    first: u32
    count: u32
}

pub struct AstNode {
    kind: AstKind
    a: u32
    b: u32
    pos: u32
}

pub struct AstFunction {
    name: Span
    parameters: NodeRange
    type_parameters: NodeRange
    nodes: NodeRange
    return_type: u32
    body: u32
    module: u32
    owner_struct: u32
    public: bool
    is_variadic: bool
}

pub struct AstStruct {
    name: Span
    fields: NodeRange
    type_parameters: NodeRange
    module: u32
    public: bool
}

pub struct AstEnum {
    name: Span
    cases: NodeRange
    backing: u32
    module: u32
    public: bool
}

pub struct AstConst {
    name: Span
    type_node: u32
    value: u32
    module: u32
    public: bool
    local: bool
}

pub enum ImportKind : u8 {
    Module,
    All,
    Selected,
}

pub struct AstImport {
    path: NodeRange
    items: NodeRange
    alias: Span
    kind: ImportKind
}

pub struct AstIfBranches {
    then_branch: u32
    else_branch: u32
}

pub struct AstForHeader {
    initializer: u32
    condition: u32
    step: u32
    label: Span
}

pub struct AstForInHeader {
    index_name: Span
    item_name: Span
    iterable: u32
    range_end: u32
    label: Span
}

pub struct AstOrElse {
    expr: u32
    err_name: Span
    handler: u32
    is_block: bool
}

pub struct AstFuncType {
    params: NodeRange
    return_type: u32
}

pub struct AstVariable {
    name_length: u32
    type_node: u32
    initializer: u32
}

pub enum AstBindingKind : u8 {
    Function,
    Struct,
    Enum,
    Const,
    Module,
}

pub struct AstBinding {
    name: []u8
    index: u32
    offset: u32
    kind: AstBindingKind
}

pub struct AstModuleScope {
    bindings: vec.Vec[AstBinding]
}

pub struct AstQualified {
    node: u32
    index: u32
    kind: AstBindingKind
    inaccessible: bool
}

pub struct Ast {
    source: []u8
    nodes: vec.Vec[AstNode]
    children: vec.Vec[u32]
    functions: vec.Vec[AstFunction]
    structs: vec.Vec[AstStruct]
    enums: vec.Vec[AstEnum]
    consts: vec.Vec[AstConst]
    imports: vec.Vec[AstImport]
    if_branches: vec.Vec[AstIfBranches]
    for_headers: vec.Vec[AstForHeader]
    for_in_headers: vec.Vec[AstForInHeader]
    or_elses: vec.Vec[AstOrElse]
    func_types: vec.Vec[AstFuncType]
    variables: vec.Vec[AstVariable]
    modules: vec.Vec[AstModuleScope]
    qualified: vec.Vec[AstQualified]
    declarations: NodeRange
}

pub fun init(arena: *mem.Arena, source: []u8, out: *Ast): bool {
    out.source = source
    out.declarations = NodeRange { first: 0, count: 0 }
    if out.nodes.init(arena, 256) < 0 { return false }
    if out.children.init(arena, 256) < 0 { return false }
    if out.functions.init(arena, 32) < 0 { return false }
    if out.structs.init(arena, 16) < 0 { return false }
    if out.enums.init(arena, 16) < 0 { return false }
    if out.consts.init(arena, 16) < 0 { return false }
    if out.imports.init(arena, 16) < 0 { return false }
    if out.if_branches.init(arena, 32) < 0 { return false }
    if out.for_headers.init(arena, 16) < 0 { return false }
    if out.for_in_headers.init(arena, 16) < 0 { return false }
    if out.or_elses.init(arena, 16) < 0 { return false }
    if out.func_types.init(arena, 16) < 0 { return false }
    if out.variables.init(arena, 32) < 0 { return false }
    if out.modules.init(arena, 8) < 0 { return false }
    if out.qualified.init(arena, 16) < 0 { return false }
    var zero = AstNode { kind: AstKind.Invalid, a: 0, b: 0, pos: 0 }
    return out.nodes.push(&zero) >= 0
}

pub fun find_qualified(tree: *Ast, node: u32, out: *AstQualified): bool {
    var qs = tree.qualified.as_slice()
    var lo: i64 = 0
    var hi: i64 = len(qs)
    for lo < hi {
        var mid = lo + (hi - lo) / 2
        if qs[mid].node < node {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < len(qs) && qs[lo].node == node {
        *out = qs[lo]
        return true
    }
    return false
}

pub fun add_node(ast: *Ast, kind: AstKind, pos: u32, a: u32, b: u32): u32 {
    var id = ast.nodes.len as u32
    var node = AstNode { kind: kind, a: a, b: b, pos: pos }
    if ast.nodes.push(&node) < 0 {
        return NODE_NONE
    }
    return id
}

pub fun finish_children(ast: *Ast, pending: *vec.Vec[u32], mark: u64): NodeRange {
    var count = pending.len - mark
    if count == 0 {
        return NodeRange { first: 0, count: 0 }
    }
    var first = ast.children.len as u32
    var slice = pending.as_slice()
    if ast.children.append_slice(slice[(mark as i64)..len(slice)]) < 0 {
        pending.len = mark
        return NodeRange { first: 0, count: 0 }
    }
    pending.len = mark
    return NodeRange { first: first, count: count as u32 }
}

pub struct SourcePos {
    line: u64
    col: u64
}

pub fun offset_to_pos(src: []u8, offset: u32): SourcePos {
    var limit = offset as i64
    if limit > len(src) {
        limit = len(src)
    }
    var line: u64 = 1
    var col: u64 = 1
    for var i: i64 = 0; i < limit; i += 1 {
        var ch = src[i]
        if ch == '\n' {
            line += 1
            col = 1
        } else if ch != '\r' {
            col += 1
        }
    }
    return SourcePos { line: line, col: col }
}

pub fun pos_to_offset(src: []u8, line: u64, col: u64): u32 {
    var cur_line: u64 = 1
    var cur_col: u64 = 1
    var n = len(src)
    for var i: i64 = 0; i < n; i += 1 {
        if cur_line > line || (cur_line == line && cur_col >= col) {
            return i as u32
        }
        var ch = src[i]
        if ch == '\n' {
            if cur_line == line {
                return i as u32
            }
            cur_line += 1
            cur_col = 1
        } else if ch != '\r' {
            cur_col += 1
        }
    }
    return n as u32
}
