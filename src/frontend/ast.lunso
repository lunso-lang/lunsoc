}

pub struct AstOrElse {
    expr: u32
    err_name: Span
    handler: u32
    is_block: bool
}

pub struct AstFuncType {
    params: NodeRange
    return_type: u32
}

pub struct AstVariable {
    name_length: u32
    type_node: u32
