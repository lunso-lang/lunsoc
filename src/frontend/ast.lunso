import std.mem
import std.collections.Vec

pub const NODE_NONE: u32 = 0

pub struct Span {
    offset: u32
    length: u32
}

pub struct NodeRange {
    first: u32
    count: u32
}

pub enum UnaryOp : u8, Eq {
    Positive,
    Negate,
    LogicalNot,
    BitNot,
    AddressOf,
    Dereference,
    Try,
    Spread,
}

pub enum BinaryOp : u8, Eq {
    Add,
    Subtract,
    Multiply,
    Divide,
    Remainder,
    Equal,
    NotEqual,
    Less,
    LessEqual,
    Greater,
    GreaterEqual,
    LogicalAnd,
    LogicalOr,
    BitAnd,
    BitOr,
    BitXor,
    ShiftLeft,
    ShiftRight,
    Assign,
    AssignAdd,
    AssignSubtract,
    AssignMultiply,
    AssignDivide,
    AssignRemainder,
    AssignBitAnd,
    AssignBitOr,
    AssignBitXor,
    AssignShiftLeft,
    AssignShiftRight,
}

pub struct AstEnumCase {
