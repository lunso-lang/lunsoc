}

pub struct AstTypeParam {
    name_length: u32
    bounds: NodeRange
}

pub struct AstArrayType {
    elem: u32
    count: u32
}

pub struct AstPointerType {
    pointee: u32
    read_only: bool
}

pub struct AstIf {
    condition: u32
    then_branch: u32
    else_branch: u32
}

pub struct AstForHeader {
    initializer: u32
    condition: u32
    step: u32
    body: u32
    label: Span
}

pub struct AstForInHeader {
    index_name: Span
    item_name: Span
    iterable: u32
    range_end: u32
    body: u32
