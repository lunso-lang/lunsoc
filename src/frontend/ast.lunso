}

pub struct AstStructLiteral {
    type_node: u32
    fields: NodeRange
}

pub struct AstStructFieldInit {
    name_length: u32
    value: u32
}

pub struct AstIndex {
    base: u32
    idx: u32
}

pub struct AstSlice {
    base: u32
    range: u32
}

pub struct AstSliceRange {
    start: u32
    end: u32
}

pub struct AstMember {
    base: u32
    name_length: u32
}

pub struct AstCast {
    expr: u32
    target_type: u32
}

pub struct AstUnary {
    op: UnaryOp
    operand: u32
}

pub struct AstBinary {
    op: BinaryOp
    left: u32
    right: u32
}

pub enum AstData {
    Invalid,
    Function(u32),
    Struct(u32),
    Enum(u32),
    EnumCase(AstEnumCase),
    Trait(u32),
    Const(u32),
    Import(u32),
    ImportItem(AstImportItem),
    Field(AstNamedType),
    Parameter(AstNamedType),
    TypeParam(AstTypeParam),
    TypeName(u32),
    QualifiedType(NodeRange),
    ArrayType(AstArrayType),
    ConstType(u32),
    PointerType(AstPointerType),
    ResultType(u32),
    FuncType(AstFuncType),
    GenericType(NodeRange),
    Block(NodeRange),
    Return(u32),
    If(AstIf),
    Match(NodeRange),
    MatchType(NodeRange),
    MatchArm(NodeRange),
    For(AstForHeader),
    ForIn(AstForInHeader),
    Break(u32),
    Continue(u32),
    Defer(u32),
    Var(AstVariable),
    Identifier(u32),
    Integer(u32),
    Float(u32),
    String(u32),
    Null,
    ArrayLiteral(NodeRange),
    StructLiteral(AstStructLiteral),
    StructFieldInit(AstStructFieldInit),
    Call(NodeRange),
    GenericCallee(NodeRange),
    Index(AstIndex),
    Slice(AstSlice),
    SliceRange(AstSliceRange),
    Member(AstMember),
    Cast(AstCast),
    OrElse(AstOrElse),
    Unary(AstUnary),
    Binary(AstBinary),
}

pub struct AstNode {
    pos: u32
    data: AstData
}

pub struct AstFunction {
    name: Span
    parameters: NodeRange
    type_parameters: NodeRange
    nodes: NodeRange
    return_type: u32
    body: u32
    module: u32
    owner_struct: u32
    public: bool
    is_variadic: bool
}

pub struct AstStruct {
    name: Span
    fields: NodeRange
    type_parameters: NodeRange
    traits: NodeRange
    module: u32
    public: bool
}

pub struct AstEnum {
    name: Span
    cases: NodeRange
    type_parameters: NodeRange
    traits: NodeRange
    backing: u32
    module: u32
    public: bool
    has_payload: bool
}

pub struct AstTrait {
    name: Span
    methods: NodeRange
    module: u32
    public: bool
}

pub struct AstConst {
    name: Span
    type_node: u32
    value: u32
    module: u32
    public: bool
    local: bool
}

pub enum ImportKind : u8 {
    Module,
    All,
    Selected,
}

pub struct AstImport {
    path: NodeRange
    items: NodeRange
    alias: Span
    kind: ImportKind
}

pub enum AstBindingKind : u8 {
    Function,
    Struct,
    Enum,
    Trait,
    Const,
    Module,
}

pub struct AstBinding {
    name: []u8
    index: u32
    offset: u32
    kind: AstBindingKind
}

pub struct AstModuleScope {
    bindings: Vec[AstBinding]
}

pub struct AstQualified {
    node: u32
    index: u32
    kind: AstBindingKind
    inaccessible: bool
}

pub struct Ast {
    source: []u8
    nodes: Vec[AstNode]
    children: Vec[u32]
    functions: Vec[AstFunction]
    structs: Vec[AstStruct]
    enums: Vec[AstEnum]
    traits: Vec[AstTrait]
    consts: Vec[AstConst]
    imports: Vec[AstImport]
    modules: Vec[AstModuleScope]
    qualified: Vec[AstQualified]
    declarations: NodeRange
}

pub fun init(arena: *mem.Arena, source: []u8, out: *Ast): bool {
    out.source = source
    out.declarations = NodeRange { first: 0, count: 0 }
    if out.nodes.init(arena, 256) < 0 { return false }
    if out.children.init(arena, 256) < 0 { return false }
    if out.functions.init(arena, 32) < 0 { return false }
    if out.structs.init(arena, 16) < 0 { return false }
    if out.enums.init(arena, 16) < 0 { return false }
    if out.traits.init(arena, 16) < 0 { return false }
    if out.consts.init(arena, 16) < 0 { return false }
    if out.imports.init(arena, 16) < 0 { return false }
    if out.modules.init(arena, 8) < 0 { return false }
    if out.qualified.init(arena, 16) < 0 { return false }
    var zero = AstNode { pos: 0, data: AstData.Invalid }
    return out.nodes.push(&zero) >= 0
}

pub fun find_qualified(tree: *Ast, node: u32, out: *AstQualified): bool {
    var qs = tree.qualified.as_slice()
    var lo: i64 = 0
    var hi: i64 = len(qs)
    for lo < hi {
        var mid = lo + (hi - lo) / 2
        if qs[mid].node < node {
            lo = mid + 1
        } else {
            hi = mid
        }
    }
    if lo < len(qs) && qs[lo].node == node {
        *out = qs[lo]
        return true
    }
    return false
}

pub fun add_node(ast: *Ast, pos: u32, data: AstData): u32 {
    var id = ast.nodes.len as u32
    var node = AstNode { pos: pos, data: data }
    if ast.nodes.push(&node) < 0 {
        return NODE_NONE
    }
    return id
}

pub fun finish_children(ast: *Ast, pending: *Vec[u32], mark: u64): NodeRange {
    var count = pending.len - mark
    if count == 0 {
        return NodeRange { first: 0, count: 0 }
    }
    var first = ast.children.len as u32
    var slice = pending.as_slice()
    if ast.children.append_slice(slice[(mark as i64)..len(slice)]) < 0 {
        pending.len = mark
        return NodeRange { first: 0, count: 0 }
    }
    pending.len = mark
    return NodeRange { first: first, count: count as u32 }
}

pub struct SourcePos {
    line: u64
    col: u64
}

pub fun offset_to_pos(src: []u8, offset: u32): SourcePos {
    var limit = offset as i64
    if limit > len(src) {
        limit = len(src)
    }
    var line: u64 = 1
    var col: u64 = 1
    for ch in src[0..limit] {
        if ch == '\n' {
            line += 1
            col = 1
        } else if ch != '\r' {
            col += 1
        }
    }
    return SourcePos { line: line, col: col }
}

pub fun pos_to_offset(src: []u8, line: u64, col: u64): u32 {
    var cur_line: u64 = 1
    var cur_col: u64 = 1
    for i, ch in src {
        if cur_line > line || (cur_line == line && cur_col >= col) {
            return i as u32
        }
        if ch == '\n' {
            if cur_line == line {
                return i as u32
            }
            cur_line += 1
            cur_col = 1
        } else if ch != '\r' {
            cur_col += 1
        }
    }
    return len(src) as u32
}
