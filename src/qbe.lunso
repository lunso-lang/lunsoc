import std.fmt
import std.mem
import std.str
import std.vec
import frontend.ast { Span }
import ir { IrFunction, IrInstruction, IrModule, IrOp }
import frontend.sema { SemaType, TypeKind, element_size, is_signed, is_unsigned, parse_int_literal, scalar_size, storage_size }

struct QbeType {
    base: u8
    abi: []u8
    extend: []u8
}

fun qbe_type(k: TypeKind): QbeType {
    match k {
        TypeKind.Bool => return QbeType { base: 'w', abi: "ub", extend: "extub" }
        TypeKind.I8 => return QbeType { base: 'w', abi: "sb", extend: "extsb" }
        TypeKind.U8 => return QbeType { base: 'w', abi: "ub", extend: "extub" }
        TypeKind.I16 => return QbeType { base: 'w', abi: "sh", extend: "extsh" }
        TypeKind.U16 => return QbeType { base: 'w', abi: "uh", extend: "extuh" }
        TypeKind.I32, TypeKind.U32 => return QbeType { base: 'w', abi: "w", extend: "" }
        TypeKind.I64, TypeKind.U64 => return QbeType { base: 'l', abi: "l", extend: "" }
        TypeKind.F32 => return QbeType { base: 's', abi: "s", extend: "" }
        TypeKind.F64 => return QbeType { base: 'd', abi: "d", extend: "" }
        TypeKind.Struct, TypeKind.Pointer => return QbeType { base: 'l', abi: "l", extend: "" }
        TypeKind.Array, TypeKind.Slice => return QbeType { base: 'l', abi: "", extend: "" }
        else => return QbeType { base: 'l', abi: "", extend: "" }
    }
}

fun push_byte(out: *vec.Vec[u8], b: u8): bool {
    return vec.push_value.[u8](out, b) >= 0
}

fun push_str(out: *vec.Vec[u8], s: []u8): bool {
    for var i: i64 = 0; i < len(s); i += 1 {
        if vec.push_value.[u8](out, s[i]) < 0 {
            return false
        }
    }
    return true
}

fun push_u64(out: *vec.Vec[u8], v: u64): bool {
    var buf: [32]u8
    var n = fmt.u64_to_buf(v, &buf[0], 32)
    return push_str(out, buf[0..n])
}

fun push_u32(out: *vec.Vec[u8], v: u32): bool {
    return push_u64(out, v as u64)
}

fun span_bytes(source: []u8, s: Span): []u8 {
    var start = s.offset as i64
    var end = (s.offset + s.length) as i64
    return source[start..end]
}

fun entry_symbol(mod: *IrModule, f: IrFunction): bool {
    return !f.external && !f.specialization && f.module == 0 && str.equals(span_bytes(mod.source, f.name), "main")
}

fun write_symbol(out: *vec.Vec[u8], mod: *IrModule, index: u32) {
    var fns = vec.as_slice.[IrFunction](&mod.functions)
    var f = fns[index as i64]
    push_byte(out, '$')
    if f.specialization || (mod.module_count > 1 && !f.external && !entry_symbol(mod, f)) {
        push_str(out, ".lunso.fn.")
        push_u32(out, index)
        push_byte(out, '.')
    }
    push_str(out, span_bytes(mod.source, f.name))
}

fun write_integer_bits(out: *vec.Vec[u8], bits: u64) {
    var max_i64: u64 = 9223372036854775807
    if bits > max_i64 {
        push_byte(out, '-')
        push_u64(out, (0 as u64) - bits)
    } else {
        push_u64(out, bits)
    }
}

fun write_integer(out: *vec.Vec[u8], text: []u8, negative: bool) {
    var bits: u64 = 0
    parse_int_literal(text, &bits)
    if negative {
        bits = (0 as u64) - bits
    }
    write_integer_bits(out, bits)
}

fun write_number(out: *vec.Vec[u8], mod: *IrModule, inst: IrInstruction) {
    var qt = qbe_type(inst.type_info.kind)
    push_str(out, "\t%v")
    push_u32(out, inst.result)
    push_str(out, " =")
    push_byte(out, qt.base)
    push_str(out, " copy ")
    var start = inst.a as i64
    var end = (inst.a + inst.b) as i64
    var text = mod.source[start..end]
    if qt.base == 's' || qt.base == 'd' {
        push_byte(out, qt.base)
        push_byte(out, '_')
        push_str(out, text)
    } else {
        write_integer(out, text, inst.c != 0)
    }
    push_byte(out, '\n')
}

fun hex_digit(b: u8): i32 {
    if b >= '0' && b <= '9' { return (b - '0') as i32 }
    if b >= 'a' && b <= 'f' { return (b - 'a' + 10) as i32 }
    if b >= 'A' && b <= 'F' { return (b - 'A' + 10) as i32 }
    return -1
}

fun next_literal_byte(text: []u8, end: i64, cursor: *i64, out_byte: *u8): bool {
    var next = *cursor
    var val = text[next]
    next += 1
    if val == '\\' {
        if next >= end { return false }
        var esc = text[next]
        next += 1
        if esc == '0' {
            val = 0
        } else if esc == 'n' {
            val = '\n'
        } else if esc == 'r' {
            val = '\r'
        } else if esc == 't' {
            val = '\t'
        } else if esc == '\\' || esc == '"' || esc == '\'' {
            val = esc
        } else if esc == 'x' {
            if end - next < 2 { return false }
            var hi = hex_digit(text[next])
            var lo = hex_digit(text[next + 1])
            if hi < 0 || lo < 0 { return false }
            val = (hi * 16 + lo) as u8
            next += 2
        } else {
            return false
        }
    }
    *cursor = next
    *out_byte = val
    return true
}

fun write_data(out: *vec.Vec[u8], mod: *IrModule): bool {
    var insts = vec.as_slice.[IrInstruction](&mod.instructions)
    for var i: i64 = 0; i < len(insts); i += 1 {
        var inst = insts[i]
        if inst.op != IrOp.Bytes {
            continue
        }
        push_str(out, "data $.lunso.bytes.")
        push_u64(out, i as u64)
        push_str(out, " = align 1 {")
        if inst.type_info.length == 0 {
            push_str(out, " z 0")
        } else {
            push_str(out, " b")
            var literal = mod.source[(inst.a as i64)..((inst.a + inst.b) as i64)]
            var end = (inst.b - 1) as i64
            var cursor: i64 = 1
            for cursor < end {
                var byte: u8 = 0
                if !next_literal_byte(literal, end, &cursor, &byte) {
                    return false
                }
                push_byte(out, ' ')
                push_u64(out, byte as u64)
            }
        }
        push_str(out, " }\n")
    }
    return true
}

fun uses_sret(k: TypeKind): bool {
    return k == TypeKind.Struct || k == TypeKind.Array || k == TypeKind.Slice
}

fun memory_suffix(k: TypeKind): u8 {
    var sz = scalar_size(k)
    if sz == 1 { return 'b' }
    if sz == 2 { return 'h' }
    return qbe_type(k).base
}

fun write_load(out: *vec.Vec[u8], k: TypeKind, result: u32, name: []u8, address: u32) {
    if k == TypeKind.Slice {
        push_str(out, "\t%v")
        push_u32(out, result)
        push_str(out, " =l loadl %")
        push_str(out, name)
        push_u32(out, address)
        push_str(out, "\n\t%slen_addr")
        push_u32(out, result)
        push_str(out, " =l add %")
        push_str(out, name)
        push_u32(out, address)
        push_str(out, ", 8\n\t%len")
        push_u32(out, result)
        push_str(out, " =l loadl %slen_addr")
        push_u32(out, result)
        push_byte(out, '\n')
        return
    }
    var qt = qbe_type(k)
    push_str(out, "\t%v")
    push_u32(out, result)
    push_str(out, " =")
    push_byte(out, qt.base)
    push_str(out, " load")
    if len(qt.extend) > 0 {
        if is_signed(k) { push_byte(out, 's') } else { push_byte(out, 'u') }
    }
    push_byte(out, memory_suffix(k))
    push_str(out, " %")
    push_str(out, name)
    push_u32(out, address)
    push_byte(out, '\n')
}

fun write_store(out: *vec.Vec[u8], k: TypeKind, val_name: []u8, len_name: []u8, val: u32,
                addr_name: []u8, addr: u32, tmp_prefix: []u8, tmp_id: u32) {
    if k == TypeKind.Slice {
        push_str(out, "\tstorel %")
        push_str(out, val_name)
        push_u32(out, val)
        push_str(out, ", %")
        push_str(out, addr_name)
        push_u32(out, addr)
        push_str(out, "\n\t%s")
        push_str(out, tmp_prefix)
        push_u32(out, tmp_id)
        push_str(out, " =l add %")
        push_str(out, addr_name)
        push_u32(out, addr)
        push_str(out, ", 8\n\tstorel %")
        push_str(out, len_name)
        push_u32(out, val)
        push_str(out, ", %s")
        push_str(out, tmp_prefix)
        push_u32(out, tmp_id)
        push_byte(out, '\n')
        return
    }
    push_str(out, "\tstore")
    push_byte(out, memory_suffix(k))
    push_str(out, " %")
    push_str(out, val_name)
    push_u32(out, val)
    push_str(out, ", %")
    push_str(out, addr_name)
    push_u32(out, addr)
    push_byte(out, '\n')
}

fun write_call(out: *vec.Vec[u8], mod: *IrModule, inst: IrInstruction) {
    var fns = vec.as_slice.[IrFunction](&mod.functions)
    var params = vec.as_slice.[SemaType](&mod.parameters)
    var args = vec.as_slice.[u32](&mod.arguments)
    var callee = fns[inst.a as i64]
    var res_qt = qbe_type(callee.result.kind)
    var sret = uses_sret(callee.result.kind)
    push_byte(out, '\t')
    if inst.result != 0 && !sret {
        push_byte(out, '%')
        if len(res_qt.extend) > 0 { push_str(out, "raw") } else { push_byte(out, 'v') }
        push_u32(out, inst.result)
        push_str(out, " =")
        push_str(out, res_qt.abi)
        push_byte(out, ' ')
    }
    push_str(out, "call ")
    write_symbol(out, mod, inst.a)
    push_byte(out, '(')
    if sret {
        push_str(out, "l %")
        if callee.result.kind == TypeKind.Slice { push_str(out, "retbuf") } else { push_byte(out, 'v') }
        push_u32(out, inst.result)
    }
    for var i: u32 = 0; i < inst.c; i += 1 {
        if sret || i != 0 {
            push_str(out, ", ")
        }
        var pt = params[(callee.first_parameter + i) as i64]
        var arg = args[(inst.b + i) as i64]
        if pt.kind == TypeKind.Slice {
            push_str(out, "l %v")
            push_u32(out, arg)
            push_str(out, ", l %len")
            push_u32(out, arg)
        } else {
            push_str(out, qbe_type(pt.kind).abi)
            push_str(out, " %v")
            push_u32(out, arg)
        }
    }
    push_str(out, ")\n")
    if callee.result.kind == TypeKind.Slice {
        write_load(out, TypeKind.Slice, inst.result, "retbuf", inst.result)
    } else if !sret && len(res_qt.extend) > 0 {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =w ")
        push_str(out, res_qt.extend)
        push_str(out, " %raw")
        push_u32(out, inst.result)
        push_byte(out, '\n')
    }
}

fun write_length(out: *vec.Vec[u8], t: SemaType, val: u32) {
    if t.kind == TypeKind.Slice {
        push_str(out, "%len")
        push_u32(out, val)
    } else {
        push_u32(out, t.length)
    }
}

fun write_index_address(out: *vec.Vec[u8], inst: IrInstruction, size: u32) {
    if size != 1 {
        push_str(out, "\t%off")
        push_u32(out, inst.result)
        push_str(out, " =l mul %v")
        push_u32(out, inst.b)
        push_str(out, ", ")
        push_u32(out, size)
        push_byte(out, '\n')
    }
    push_str(out, "\t%v")
    push_u32(out, inst.result)
    push_str(out, " =l add %v")
    push_u32(out, inst.a)
    push_str(out, ", %")
    if size == 1 {
        push_byte(out, 'v')
        push_u32(out, inst.b)
    } else {
        push_str(out, "off")
        push_u32(out, inst.result)
    }
    push_byte(out, '\n')
}

fun write_access(out: *vec.Vec[u8], inst: IrInstruction) {
    var slice = inst.op == IrOp.Slice || inst.op == IrOp.PointerSlice
    var bound = inst.b
    if slice { bound = inst.c }
    var esz = element_size(inst.type_info)
    push_str(out, "\t%in")
    push_u32(out, inst.result)
    push_str(out, " =w ")
    if slice { push_str(out, "culel") } else { push_str(out, "cultl") }
    push_str(out, " %v")
    push_u32(out, bound)
    push_str(out, ", ")
    if inst.op == IrOp.PointerSlice {
        var denom: u64 = 1
        if esz > 0 { denom = esz as u64 }
        var max_i64: u64 = 9223372036854775807
        push_u64(out, max_i64 / denom)
    } else {
        write_length(out, inst.type_info, inst.a)
    }
    push_byte(out, '\n')
    if slice {
        push_str(out, "\t%order")
        push_u32(out, inst.result)
        push_str(out, " =w culel %v")
        push_u32(out, inst.b)
        push_str(out, ", %v")
        push_u32(out, inst.c)
        push_str(out, "\n\t%in")
        push_u32(out, inst.result)
        push_str(out, " =w and %in")
        push_u32(out, inst.result)
        push_str(out, ", %order")
        push_u32(out, inst.result)
        push_byte(out, '\n')
    }
    push_str(out, "\tjnz %in")
    push_u32(out, inst.result)
    push_str(out, ", @array_ok")
    push_u32(out, inst.result)
    push_str(out, ", @bounds_fail\n@array_ok")
    push_u32(out, inst.result)
    push_byte(out, '\n')
    write_index_address(out, inst, esz)
    if slice {
        push_str(out, "\t%len")
        push_u32(out, inst.result)
        push_str(out, " =l sub %v")
        push_u32(out, inst.c)
        push_str(out, ", %v")
        push_u32(out, inst.b)
        push_byte(out, '\n')
    }
}

fun write_copy_bytes(out: *vec.Vec[u8], dst_reg: []u8, dst_id: u32, has_dst_id: bool,
                     src_id: u32, has_src: bool, bytes: u32, at: u32) {
    if bytes == 0 {
        return
    }
    push_str(out, "\t%i")
    push_u32(out, at)
    push_str(out, " =l copy 0\n\tjmp @init")
    push_u32(out, at)
    push_str(out, "\n@init")
    push_u32(out, at)
    push_str(out, "\n\t%dst")
    push_u32(out, at)
    push_str(out, " =l add %")
    push_str(out, dst_reg)
    if has_dst_id { push_u32(out, dst_id) }
    push_str(out, ", %i")
    push_u32(out, at)
    push_byte(out, '\n')
    if has_src {
        push_str(out, "\t%src")
        push_u32(out, at)
        push_str(out, " =l add %v")
        push_u32(out, src_id)
        push_str(out, ", %i")
        push_u32(out, at)
        push_str(out, "\n\t%byte")
        push_u32(out, at)
        push_str(out, " =w loadub %src")
        push_u32(out, at)
        push_str(out, "\n\tstoreb %byte")
        push_u32(out, at)
        push_str(out, ", %dst")
        push_u32(out, at)
        push_byte(out, '\n')
    } else {
        push_str(out, "\tstoreb 0, %dst")
        push_u32(out, at)
        push_byte(out, '\n')
    }
    push_str(out, "\t%i")
    push_u32(out, at)
    push_str(out, " =l add %i")
    push_u32(out, at)
    push_str(out, ", 1\n\t%more")
    push_u32(out, at)
    push_str(out, " =w cultl %i")
    push_u32(out, at)
    push_str(out, ", ")
    push_u32(out, bytes)
    push_str(out, "\n\tjnz %more")
    push_u32(out, at)
    push_str(out, ", @init")
    push_u32(out, at)
    push_str(out, ", @init_end")
    push_u32(out, at)
    push_str(out, "\n@init_end")
    push_u32(out, at)
    push_byte(out, '\n')
}

fun write_comparison(out: *vec.Vec[u8], inst: IrInstruction) {
    var rel: []u8 = "eq"
    match inst.op {
        IrOp.Equal => rel = "eq"
        IrOp.NotEqual => rel = "ne"
        IrOp.Less => rel = "lt"
        IrOp.LessEqual => rel = "le"
        IrOp.Greater => rel = "gt"
        else => rel = "ge"
    }
    var sign: []u8 = ""
    if inst.op != IrOp.Equal && inst.op != IrOp.NotEqual {
        if is_signed(inst.type_info.kind) {
            sign = "s"
        } else if is_unsigned(inst.type_info.kind) {
            sign = "u"
        }
    }
    push_str(out, "\t%v")
    push_u32(out, inst.result)
    push_str(out, " =w c")
    push_str(out, sign)
    push_str(out, rel)
    push_byte(out, qbe_type(inst.type_info.kind).base)
    push_str(out, " %v")
    push_u32(out, inst.a)
    push_str(out, ", %v")
    push_u32(out, inst.b)
    push_byte(out, '\n')
}

fun op_name(inst: IrInstruction): []u8 {
    if inst.op == IrOp.Divide && is_unsigned(inst.type_info.kind) { return "udiv" }
    if inst.op == IrOp.Remainder && is_unsigned(inst.type_info.kind) { return "urem" }
    if inst.op == IrOp.ShiftRight && is_signed(inst.type_info.kind) { return "sar" }
    match inst.op {
        IrOp.Negate => return "neg"
        IrOp.LogicalNot => return "ceqw"
        IrOp.BitNot => return "xor"
        IrOp.Add => return "add"
        IrOp.Subtract => return "sub"
        IrOp.Multiply => return "mul"
        IrOp.Divide => return "div"
        IrOp.Remainder => return "rem"
        IrOp.BitAnd => return "and"
        IrOp.BitOr => return "or"
        IrOp.BitXor => return "xor"
        IrOp.ShiftLeft => return "shl"
        else => return "shr"
    }
}

fun write_operation(out: *vec.Vec[u8], inst: IrInstruction) {
    var qt = qbe_type(inst.type_info.kind)
    var rhs: []u8 = "v"
    var right = inst.b
    if len(qt.extend) > 0 && (inst.op == IrOp.ShiftLeft || inst.op == IrOp.ShiftRight) {
        var mask: u32 = 15
        if inst.type_info.kind == TypeKind.I8 || inst.type_info.kind == TypeKind.U8 {
            mask = 7
        }
        push_str(out, "\t%shift")
        push_u32(out, inst.result)
        push_str(out, " =w and %v")
        push_u32(out, inst.b)
        push_str(out, ", ")
        push_u32(out, mask)
        push_byte(out, '\n')
        rhs = "shift"
        right = inst.result
    }
    var norm = qt.extend
    if inst.op == IrOp.LogicalNot { norm = "" }
    push_str(out, "\t%")
    if len(norm) > 0 { push_str(out, "raw") } else { push_byte(out, 'v') }
    push_u32(out, inst.result)
    push_str(out, " =")
    push_byte(out, qt.base)
    push_byte(out, ' ')
    push_str(out, op_name(inst))
    push_str(out, " %v")
    push_u32(out, inst.a)
    if inst.op == IrOp.BitNot {
        push_str(out, ", -1")
    } else if inst.op == IrOp.LogicalNot {
        push_str(out, ", 0")
    } else if right != 0 {
        push_str(out, ", %")
        push_str(out, rhs)
        push_u32(out, right)
    }
    push_byte(out, '\n')
    if len(norm) > 0 {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =w ")
        push_str(out, norm)
        push_str(out, " %raw")
        push_u32(out, inst.result)
        push_byte(out, '\n')
    }
}

fun write_cast(out: *vec.Vec[u8], result: u32, value: u32, source: TypeKind, destination: TypeKind) {
    var target = qbe_type(destination)
    var src = qbe_type(source)
    if destination == TypeKind.Bool {
        if source == TypeKind.Bool {
            push_str(out, "\t%v")
            push_u32(out, result)
            push_str(out, " =w copy %v")
            push_u32(out, value)
            push_byte(out, '\n')
        } else if src.base == 's' || src.base == 'd' {
            push_str(out, "\t%v")
            push_u32(out, result)
            push_str(out, " =w cne")
            push_byte(out, src.base)
            push_str(out, " %v")
            push_u32(out, value)
            push_str(out, ", ")
            push_byte(out, src.base)
            push_str(out, "_0\n")
        } else {
            push_str(out, "\t%v")
            push_u32(out, result)
            push_str(out, " =w cne")
            push_byte(out, src.base)
            push_str(out, " %v")
            push_u32(out, value)
            push_str(out, ", 0\n")
        }
        return
    }
    if source == TypeKind.Bool && (target.base == 's' || target.base == 'd') {
        push_str(out, "\t%v")
        push_u32(out, result)
        push_str(out, " =")
        push_byte(out, target.base)
        push_str(out, " uwtof %v")
        push_u32(out, value)
        push_byte(out, '\n')
        return
    }
    if source == TypeKind.F32 && destination == TypeKind.F64 {
        push_str(out, "\t%v")
        push_u32(out, result)
        push_str(out, " =d exts %v")
        push_u32(out, value)
        push_byte(out, '\n')
        return
    }
    if source == TypeKind.F64 && destination == TypeKind.F32 {
        push_str(out, "\t%v")
        push_u32(out, result)
        push_str(out, " =s truncd %v")
        push_u32(out, value)
        push_byte(out, '\n')
        return
    }
    if (src.base == 's' || src.base == 'd') && (target.base == 'w' || target.base == 'l') {
        var conv: []u8 = "dtoui"
        if src.base == 's' {
            if is_signed(destination) { conv = "stosi" } else { conv = "stoui" }
        } else {
            if is_signed(destination) { conv = "dtosi" } else { conv = "dtoui" }
        }
        if len(target.extend) > 0 {
            push_str(out, "\t%raw")
            push_u32(out, result)
            push_str(out, " =w ")
            push_str(out, conv)
            push_str(out, " %v")
            push_u32(out, value)
            push_str(out, "\n\t%v")
            push_u32(out, result)
            push_str(out, " =w ")
            push_str(out, target.extend)
            push_str(out, " %raw")
            push_u32(out, result)
            push_byte(out, '\n')
        } else {
            push_str(out, "\t%v")
            push_u32(out, result)
            push_str(out, " =")
            push_byte(out, target.base)
            push_byte(out, ' ')
            push_str(out, conv)
            push_str(out, " %v")
            push_u32(out, value)
            push_byte(out, '\n')
        }
        return
    }
    if (src.base == 'w' || src.base == 'l') && (target.base == 's' || target.base == 'd') {
        var conv: []u8 = "ultof"
        if src.base == 'w' {
            if is_signed(source) { conv = "swtof" } else { conv = "uwtof" }
        } else {
            if is_signed(source) { conv = "sltof" } else { conv = "ultof" }
        }
        push_str(out, "\t%v")
        push_u32(out, result)
        push_str(out, " =")
        push_byte(out, target.base)
        push_byte(out, ' ')
        push_str(out, conv)
        push_str(out, " %v")
        push_u32(out, value)
        push_byte(out, '\n')
        return
    }
    var op = target.extend
    if len(op) == 0 { op = "copy" }
    if target.base == 'l' && src.base == 'w' {
        if is_signed(source) { op = "extsw" } else { op = "extuw" }
    }
    push_str(out, "\t%v")
    push_u32(out, result)
    push_str(out, " =")
    push_byte(out, target.base)
    push_byte(out, ' ')
    push_str(out, op)
    push_str(out, " %v")
    push_u32(out, value)
    push_byte(out, '\n')
}

fun write_instruction(out: *vec.Vec[u8], mod: *IrModule, index: u32,
                      addressed: []TypeKind, result: SemaType) {
    var insts = vec.as_slice.[IrInstruction](&mod.instructions)
    var inst = insts[index as i64]
    if inst.op == IrOp.Label {
        push_str(out, "@b")
        push_u32(out, inst.a)
        push_byte(out, '\n')
    } else if inst.op == IrOp.Number {
        write_number(out, mod, inst)
    } else if inst.op == IrOp.Bool || inst.op == IrOp.Immediate {
        var bits = ((inst.b as u64) << 32) | (inst.a as u64)
        var op: []u8 = "copy"
        if inst.type_info.kind == TypeKind.F32 || inst.type_info.kind == TypeKind.F64 {
            op = "cast"
        }
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =")
        push_byte(out, qbe_type(inst.type_info.kind).base)
        push_byte(out, ' ')
        push_str(out, op)
        push_byte(out, ' ')
        write_integer_bits(out, bits)
        push_byte(out, '\n')
        if inst.type_info.kind == TypeKind.Slice {
            push_str(out, "\t%len")
            push_u32(out, inst.result)
            push_str(out, " =l copy 0\n")
        }
    } else if inst.op == IrOp.Bytes {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =l copy $.lunso.bytes.")
        push_u32(out, index)
        push_byte(out, '\n')
    } else if inst.op == IrOp.Load {
        if len(addressed) > 0 && addressed[inst.a as i64] != TypeKind.Invalid {
            write_load(out, inst.type_info.kind, inst.result, "local", inst.a)
            return
        }
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =")
        push_byte(out, qbe_type(inst.type_info.kind).base)
        push_str(out, " copy %s")
        push_u32(out, inst.a)
        push_byte(out, '\n')
        if inst.type_info.kind == TypeKind.Slice {
            push_str(out, "\t%len")
            push_u32(out, inst.result)
            push_str(out, " =l copy %slen")
            push_u32(out, inst.a)
            push_byte(out, '\n')
        }
    } else if inst.op == IrOp.Store {
        if len(addressed) > 0 && addressed[inst.a as i64] != TypeKind.Invalid {
            write_store(out, inst.type_info.kind, "v", "len", inst.b, "local", inst.a, "store", index)
            return
        }
        push_str(out, "\t%s")
        push_u32(out, inst.a)
        push_str(out, " =")
        push_byte(out, qbe_type(inst.type_info.kind).base)
        push_str(out, " copy %v")
        push_u32(out, inst.b)
        push_byte(out, '\n')
        if inst.type_info.kind == TypeKind.Slice {
            push_str(out, "\t%slen")
            push_u32(out, inst.a)
            push_str(out, " =l copy %len")
            push_u32(out, inst.b)
            push_byte(out, '\n')
        }
    } else if inst.op == IrOp.StorageAlloc {
        // Emitted once in the entry block.
    } else if inst.op == IrOp.StorageInit {
        write_copy_bytes(out, "v", inst.a, true, inst.b, inst.b != 0, storage_size(inst.type_info), index)
    } else if inst.op == IrOp.WidenIndex {
        write_cast(out, inst.result, inst.a, inst.type_info.kind, TypeKind.U64)
    } else if inst.op == IrOp.Cast {
        write_cast(out, inst.result, inst.a, inst.b as TypeKind, inst.type_info.kind)
    } else if inst.op == IrOp.FloatExtend {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =d exts %v")
        push_u32(out, inst.a)
        push_byte(out, '\n')
    } else if inst.op == IrOp.ElementAddress || inst.op == IrOp.Slice || inst.op == IrOp.PointerSlice {
        write_access(out, inst)
    } else if inst.op == IrOp.PointerIndex {
        write_index_address(out, inst, storage_size(inst.type_info))
    } else if inst.op == IrOp.FieldAddress {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =l add %v")
        push_u32(out, inst.a)
        push_str(out, ", ")
        push_u32(out, inst.b)
        push_byte(out, '\n')
    } else if inst.op == IrOp.LocalAddress {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =l copy %local")
        push_u32(out, inst.a)
        push_byte(out, '\n')
    } else if inst.op == IrOp.ArrayView {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =l copy %v")
        push_u32(out, inst.a)
        push_str(out, "\n\t%len")
        push_u32(out, inst.result)
        push_str(out, " =l copy ")
        push_u32(out, inst.type_info.length)
        push_byte(out, '\n')
    } else if inst.op == IrOp.MemoryLoad {
        write_load(out, inst.type_info.kind, inst.result, "v", inst.a)
    } else if inst.op == IrOp.MemoryStore {
        write_store(out, inst.type_info.kind, "v", "len", inst.b, "v", inst.a, "mem", index)
    } else if inst.op == IrOp.Len {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =l copy ")
        write_length(out, inst.type_info, inst.a)
        push_byte(out, '\n')
    } else if inst.op == IrOp.Data {
        push_str(out, "\t%v")
        push_u32(out, inst.result)
        push_str(out, " =l copy %v")
        push_u32(out, inst.a)
        push_byte(out, '\n')
    } else if inst.op == IrOp.Call {
        write_call(out, mod, inst)
    } else if inst.op == IrOp.Jump {
        push_str(out, "\tjmp @b")
        push_u32(out, inst.a)
        push_byte(out, '\n')
    } else if inst.op == IrOp.Branch {
        push_str(out, "\tjnz %v")
        push_u32(out, inst.a)
        push_str(out, ", @b")
        push_u32(out, inst.b)
        push_str(out, ", @b")
        push_u32(out, inst.c)
        push_byte(out, '\n')
    } else if inst.op == IrOp.Return {
        if inst.a != 0 && result.kind == TypeKind.Slice {
            push_str(out, "\tstorel %v")
            push_u32(out, inst.a)
            push_str(out, ", %ret\n\t%ret_len")
            push_u32(out, index)
            push_str(out, " =l add %ret, 8\n\tstorel %len")
            push_u32(out, inst.a)
            push_str(out, ", %ret_len")
            push_u32(out, index)
            push_str(out, "\n\tret\n")
        } else if inst.a != 0 && (result.kind == TypeKind.Struct || result.kind == TypeKind.Array) {
            write_copy_bytes(out, "ret", 0, false, inst.a, true, storage_size(result), index)
            push_str(out, "\tret\n")
        } else {
            push_str(out, "\tret")
            if inst.a != 0 {
                push_str(out, " %v")
                push_u32(out, inst.a)
            }
            push_byte(out, '\n')
        }
    } else if inst.op >= IrOp.Equal && inst.op <= IrOp.GreaterEqual {
        write_comparison(out, inst)
    } else {
        write_operation(out, inst)
    }
}

fun collect_addressed_slots(arena: *mem.Arena, mod: *IrModule, f: IrFunction, out: *[]TypeKind): bool {
    var insts = vec.as_slice.[IrInstruction](&mod.instructions)
    var has_any = false
    for var i: u32 = 0; i < f.instruction_count; i += 1 {
        if insts[(f.first_instruction + i) as i64].op == IrOp.LocalAddress {
            has_any = true
            break
        }
    }
    if !has_any {
        return true
    }
    var slots: vec.Vec[TypeKind]
    if vec.init.[TypeKind](&slots, arena, f.slot_count as u64) < 0 {
        return false
    }
    for var s: u32 = 0; s < f.slot_count; s += 1 {
        if vec.push_value.[TypeKind](&slots, TypeKind.Invalid) < 0 {
            return false
        }
    }
    for var i: u32 = 0; i < f.instruction_count; i += 1 {
        var inst = insts[(f.first_instruction + i) as i64]
        if inst.op == IrOp.LocalAddress {
            slots.data[inst.a as i64] = inst.type_info.kind
        }
    }
    *out = vec.as_slice.[TypeKind](&slots)
    return true
}

fun write_function(arena: *mem.Arena, out: *vec.Vec[u8], mod: *IrModule, index: u32): bool {
    var fns = vec.as_slice.[IrFunction](&mod.functions)
    var f = fns[index as i64]
    var addressed: []TypeKind
    if !collect_addressed_slots(arena, mod, f, &addressed) {
        return false
    }
    if entry_symbol(mod, f) {
        push_str(out, "export function ")
    } else {
        push_str(out, "function ")
    }
    var sret = uses_sret(f.result.kind)
    if f.result.kind != TypeKind.Void && !sret {
        push_str(out, qbe_type(f.result.kind).abi)
        push_byte(out, ' ')
    }
    write_symbol(out, mod, index)
    push_byte(out, '(')
    if sret {
        push_str(out, "l %ret")
    }
    var params = vec.as_slice.[SemaType](&mod.parameters)
    for var i: u32 = 0; i < f.parameter_count; i += 1 {
        if sret || i != 0 {
            push_str(out, ", ")
        }
        var pt = params[(f.first_parameter + i) as i64]
        if pt.kind == TypeKind.Slice {
            push_str(out, "l %p")
            push_u32(out, i)
            push_str(out, ", l %plen")
            push_u32(out, i)
        } else {
            push_str(out, qbe_type(pt.kind).abi)
            push_str(out, " %p")
            push_u32(out, i)
        }
    }
    push_str(out, ") {\n")
    var insts = vec.as_slice.[IrInstruction](&mod.instructions)
    var has_bounds_check = false
    for var i: u32 = 0; i < f.instruction_count; i += 1 {
        var idx = f.first_instruction + i
        write_instruction(out, mod, idx, addressed, f.result)
        var op = insts[idx as i64].op
        if op == IrOp.ElementAddress || op == IrOp.Slice || op == IrOp.PointerSlice {
            has_bounds_check = true
        }
        if i == 0 {
            if len(addressed) > 0 {
                for var slot: u32 = 0; slot < f.slot_count; slot += 1 {
                    var ak = addressed[slot as i64]
                    if ak != TypeKind.Invalid {
                        var bytes = scalar_size(ak)
                        if ak == TypeKind.Slice {
                            bytes = 2 * scalar_size(TypeKind.Pointer)
                        }
                        push_str(out, "\t%local")
                        push_u32(out, slot)
                        push_str(out, " =l alloc8 ")
                        push_u32(out, bytes)
                        push_byte(out, '\n')
                    }
                }
            }
            for var p: u32 = 0; p < f.parameter_count; p += 1 {
                var pt = params[(f.first_parameter + p) as i64]
                var k = pt.kind
                if k == TypeKind.Struct {
                    var sz = storage_size(pt)
                    if sz == 0 {
                        push_str(out, "\t%pcopy")
                        push_u32(out, p)
                        push_str(out, " =l copy 0\n")
                    } else {
                        push_str(out, "\t%pcopy")
                        push_u32(out, p)
                        push_str(out, " =l alloc8 ")
                        push_u32(out, sz)
                        push_str(out, "\n\tblit %p")
                        push_u32(out, p)
                        push_str(out, ", %pcopy")
                        push_u32(out, p)
                        push_str(out, ", ")
                        push_u32(out, sz)
                        push_byte(out, '\n')
                    }
                    if len(addressed) > 0 && addressed[p as i64] != TypeKind.Invalid {
                        push_str(out, "\tstorel %pcopy")
                        push_u32(out, p)
                        push_str(out, ", %local")
                        push_u32(out, p)
                        push_byte(out, '\n')
                    } else {
                        push_str(out, "\t%s")
                        push_u32(out, p)
                        push_str(out, " =l copy %pcopy")
                        push_u32(out, p)
                        push_byte(out, '\n')
                    }
                    continue
                }
                if len(addressed) > 0 && addressed[p as i64] != TypeKind.Invalid {
                    write_store(out, k, "p", "plen", p, "local", p, "arg", p)
                    continue
                }
                var qt = qbe_type(k)
                push_str(out, "\t%s")
                push_u32(out, p)
                push_str(out, " =")
                push_byte(out, qt.base)
                push_byte(out, ' ')
                if len(qt.extend) > 0 { push_str(out, qt.extend) } else { push_str(out, "copy") }
                push_str(out, " %p")
                push_u32(out, p)
                push_byte(out, '\n')
                if k == TypeKind.Slice {
                    push_str(out, "\t%slen")
                    push_u32(out, p)
                    push_str(out, " =l copy %plen")
                    push_u32(out, p)
                    push_byte(out, '\n')
                }
            }
            for var j: u32 = 1; j < f.instruction_count; j += 1 {
                var inst = insts[(f.first_instruction + j) as i64]
                if inst.op == IrOp.StorageAlloc {
                    var sz = storage_size(inst.type_info)
                    push_str(out, "\t%v")
                    push_u32(out, inst.result)
                    push_str(out, " =l ")
                    if sz != 0 { push_str(out, "alloc8 ") } else { push_str(out, "copy ") }
                    push_u32(out, sz)
                    push_byte(out, '\n')
                } else if inst.op == IrOp.Call && uses_sret(inst.type_info.kind) {
                    if inst.type_info.kind == TypeKind.Slice {
                        push_str(out, "\t%retbuf")
                        push_u32(out, inst.result)
                        push_str(out, " =l alloc8 16\n")
                    } else {
                        var sz = storage_size(inst.type_info)
                        push_str(out, "\t%v")
                        push_u32(out, inst.result)
                        push_str(out, " =l ")
                        if sz != 0 { push_str(out, "alloc8 ") } else { push_str(out, "copy ") }
                        push_u32(out, sz)
                        push_byte(out, '\n')
                    }
                }
            }
        }
    }
    if has_bounds_check {
        push_str(out, "@bounds_fail\n\thlt\n")
    }
    push_str(out, "}\n")
    return true
}

pub fun write(arena: *mem.Arena, mod: *IrModule, out: *vec.Vec[u8]): bool {
    if vec.init.[u8](out, arena, 4096) < 0 {
        return false
    }
    if !write_data(out, mod) {
        return false
    }
    var fns = vec.as_slice.[IrFunction](&mod.functions)
    for var i: i64 = 0; i < len(fns); i += 1 {
        if !fns[i].template_only && !fns[i].external {
            if !write_function(arena, out, mod, i as u32) {
                return false
            }
        }
    }
    return true
}
