import std.file
import std.fmt
import std.fs
import std.io
import std.mem
import std.os
import std.path
import std.process
import std.str
import std.collections.Vec
import frontend.ast
import backend.ir
import frontend.lexer
import frontend.modules
import backend.native
import frontend.parser
import backend.qbe
import frontend.sema

fun print_lexeme(bytes: []const u8) {
    for i, b in bytes {
        if b == '\r' {
            io.print("\\r")
        } else if b == '\n' {
            io.print("\\n")
        } else if b == '\t' {
            io.print("\\t")
        } else if b == '\\' {
            io.print("\\\\")
        } else if b < ' ' || b == 127 {
            var hex: [16]u8
            var n = fmt.hex_to_buf(b as u64, &hex[0], 16)
            io.print("\\x")
            if n == 1 {
                io.print("0")
            }
            if n > 0 {
                io.print(hex[0..n])
            }
        } else {
            io.write_bytes(1, bytes[i..(i + 1)])
        }
    }
}

fun has_lexeme(kind: lexer.TokenKind): bool {
    match kind {
        lexer.TokenKind.Identifier, lexer.TokenKind.Integer, lexer.TokenKind.Float, lexer.TokenKind.String, lexer.TokenKind.Char, lexer.TokenKind.Comment => return true
        else => return false
    }
}

fun report_error(path: []const u8, source: []const u8, tok: lexer.Token, msg: []const u8): i32 {
    io.eprintfln("{}:{}:{}: {}", path, tok.line, tok.column, msg)
    modules.print_caret(source, 0, len(source) as u32, tok.offset as u32, tok.line, tok.column)
    return 1
}

fun dump_tokens(path: []u8, source: []u8, arena: *mem.Arena): i32 {
    var tokens: Vec[lexer.Token]
    if tokens.init(arena, 128) < 0 {
        io.eprintln("lunsoc: out of memory")
        return 1
    }

    var err_tok: lexer.Token
    if !lexer.tokenize_all(source, &tokens, &err_tok) {
        var msg = lexer.error_message(err_tok.kind)
        if err_tok.kind == lexer.TokenKind.Invalid && (err_tok.offset as i64) < len(source) {
            msg = modules.format_unexpected_byte(arena, source[err_tok.offset])
        }
        return report_error(path, source, err_tok, msg)
    }

    for tok in tokens.as_slice() {
        io.printf("{}:{} {}", tok.line, tok.column, lexer.token_name(tok.kind))
        if has_lexeme(tok.kind) {
            io.print(" ")
            var start = tok.offset as i64
            var end = (tok.offset + tok.length) as i64
            print_lexeme(source[start..end])
        }
        io.println("")
    }
    return 0
}

fun run_parse(path: []u8, source: []u8, arena: *mem.Arena): i32 {
    var tree: ast.Ast
    var err: parser.ParseError
    if !parser.parse(arena, source, &tree, &err) {
        var msg = err.message
        if err.token.kind == lexer.TokenKind.Invalid && (err.token.offset as i64) < len(source) {
            msg = modules.format_unexpected_byte(arena, source[err.token.offset])
        }
        return report_error(path, source, err.token, msg)
    }
    var nodes: u64 = 0
    if tree.nodes.len > 0 {
        nodes = tree.nodes.len - 1
    }
    io.printfln("Parsed {} function(s), {} AST node(s)", tree.functions.len, nodes)
    return 0
}

const VERSION: []u8 = "lunsoc 0.6.2"

enum Mode : u8 {
    Tokens,
    Parse,
    Check,
    EmitIr,
    EmitQbe,
    EmitAsm,
    EmitObj,
    Build,
    Run,
    New,
    Init,
}

fun print_usage(fd: i32, prog: []u8) {
    io.write_bytes(fd, "usage: ")
    io.write_bytes(fd, prog)
    io.write_bytes(fd, " [options] <source.lunso>\n       ")
    io.write_bytes(fd, prog)
    io.write_bytes(fd, " new <name> | init [name]\n       ")
    io.write_bytes(fd, prog)
    io.write_bytes(fd, " build|run|check [options] [source.lunso]\n       ")
    io.write_bytes(fd, prog)
    io.write_bytes(fd, " --build [options] <source.lunso> [-o <executable>] [--link <object>]...\n       ")
    io.write_bytes(fd, prog)
    io.write_bytes(fd, " --run [options] <source.lunso> [-- <args>...]\n")
}

fun print_help(prog: []u8) {
    print_usage(1, prog)
    io.println("")
    io.println("Commands:")
    io.println("  new <name>       Create a new Lunso project directory")
    io.println("  init [name]      Initialize a Lunso project in the current directory")
    io.println("  build            Build project (reads lunso.toml or src/main.lunso)")
    io.println("  run              Build and run project (or <source.lunso>)")
    io.println("  check            Typecheck project (or <source.lunso>)")
    io.println("")
    io.println("Modes:")
    io.println("  (default)        Dump lexer tokens")
    io.println("  --parse          Parse and report AST summary")
    io.println("  --check          Run module loading and semantic checks")
    io.println("  --emit-ir        Emit Lunso IR to stdout")
    io.println("  --emit-qbe       Emit QBE IL to stdout")
    io.println("  --emit-asm       Emit assembly (.s) file")
    io.println("  -c, --emit-obj   Compile to an object (.o) file")
    io.println("  --build          Compile and link a native executable")
    io.println("  --run            Compile to a temporary executable and run it")
    io.println("")
    io.println("Options:")
    io.println("  --std=<dir>      Override standard library directory")
    io.println("  --std <dir>      Override standard library directory")
    io.println("  -I <dir>         Add module search directory")
    io.println("  -o <file>        Output path (with --build, -c/--emit-obj, --emit-asm)")
    io.println("  --link <obj>     Link an additional object or archive (with --build/--run)")
    io.println("  -nostdlib        Link without standard C runtime/libraries")
    io.println("  -h, --help       Show this help message and exit")
    io.println("  -V, --version    Show compiler version and exit")
}

fun run_compile(path: []u8, source: []u8, std_dir: []u8, include_dirs: [][]u8, arena: *mem.Arena, mode: Mode,
                opts: *native.NativeOptions, run_args: [][]u8): i32 {
    var prog: modules.ModuleProgram
    if !modules.load(arena, path, source, std_dir, include_dirs, &prog) {
        return 1
    }
    var sem: sema.Sema
    var serr: sema.SemaError
    if !sema.check(arena, &prog.tree, &sem, &serr) {
        modules.report(&prog, serr.offset, serr.message)
        if serr.note_offset != 0 {
            modules.report(&prog, serr.note_offset, serr.note_message)
        }
        return 1
    }
    if mode == Mode.Check {
        io.printfln("Checked {} function(s)", prog.tree.functions.len)
        return 0
    }
    var mod: ir.IrModule
    if !ir.lower(arena, &prog.tree, &sem, &mod) {
        io.eprintln("lunsoc: could not lower to IR")
        return 1
    }
    if mode == Mode.EmitIr {
        ir.write(&mod)
        return 0
    }
    if mode == Mode.EmitQbe {
        var out_buf: Vec[u8]
        if !qbe.write(arena, &mod, &out_buf) {
            io.eprintln("lunsoc: could not emit QBE IL")
            return 1
        }
        io.write_bytes(1, out_buf.as_slice())
        return 0
    }
    if mode == Mode.Run {
        return native.run_exe(arena, &mod, path, opts, run_args)
    }
    if !native.build(arena, &mod, path, opts) {
        return 1
    }
    return 0
}

fun resolve_exe_dir(arena: *mem.Arena, prog_name: []u8): []u8 {
    if str.index_of(prog_name, '/') >= 0 {
        return path.dirname(prog_name)
    }
    var path_env: []u8
    if os.getenv("PATH", arena, &path_env) != 0 || len(path_env) == 0 {
        return ""
    }
    var n = len(path_env)
    var start: i64 = 0
    for var i: i64 = 0; i <= n; i += 1 {
        if i == n || path_env[i] == ':' {
            var dir = path_env[start..i]
            if len(dir) > 0 {
                var cand = path.join(arena, dir, prog_name)
                if file.exists(cand) {
                    return dir
                }
            }
            start = i + 1
        }
    }
    return ""
}

fun has_std_dir(arena: *mem.Arena, dir: []const u8): bool {
    if len(dir) == 0 { return false }
    return file.exists(path.join(arena, dir, "io.lunso"))
}

fun resolve_std_dir(arena: *mem.Arena, override: []u8, exe_dir: []u8): []u8 {
    if len(override) > 0 {
        return override
    }
    var env_val: []u8
    if os.getenv("LUNSO_STD_DIR", arena, &env_val) == 0 && len(env_val) > 0 {
        return env_val
    }
    if len(exe_dir) > 0 {
        var c1 = path.join(arena, exe_dir, "std")
        if has_std_dir(arena, c1) { return c1 }
        var c2 = path.join(arena, exe_dir, "../std")
        if has_std_dir(arena, c2) { return c2 }
    }
    if has_std_dir(arena, "std") {
        return "std"
    }
    var home: []u8
    if os.getenv("HOME", arena, &home) == 0 && len(home) > 0 {
        var c3 = path.join(arena, home, ".local/share/lunso/std")
        if has_std_dir(arena, c3) { return c3 }
    }
    if has_std_dir(arena, "/usr/local/share/lunso/std") {
        return "/usr/local/share/lunso/std"
    }
    if has_std_dir(arena, "/usr/local/lib/lunso/std") {
        return "/usr/local/lib/lunso/std"
    }
    return ""
}

fun resolve_std_obj(arena: *mem.Arena, exe_dir: []u8, std_dir: []u8): []u8 {
    var env_val: []u8
    if process.getenv("LUNSO_STD_OBJ", arena, &env_val) == 0 && len(env_val) > 0 {
        return env_val
    }
    if len(exe_dir) > 0 {
        var c1 = path.join(arena, exe_dir, "std-linux-x86_64.o")
        if fs.exists(c1) { return c1 }
        var c2 = path.join(arena, exe_dir, "../build/std-linux-x86_64.o")
        if fs.exists(c2) { return c2 }
    }
    if fs.exists("build/std-linux-x86_64.o") {
        return "build/std-linux-x86_64.o"
    }
    var home: []u8
    if os.getenv("HOME", arena, &home) == 0 && len(home) > 0 {
        var c3 = path.join(arena, home, ".local/share/lunso/std-linux-x86_64.o")
        if fs.exists(c3) { return c3 }
    }
    if fs.exists("/usr/local/lib/lunso/std-linux-x86_64.o") {
        return "/usr/local/lib/lunso/std-linux-x86_64.o"
    }
    if fs.exists("/usr/local/share/lunso/std-linux-x86_64.o") {
        return "/usr/local/share/lunso/std-linux-x86_64.o"
    }
    if len(std_dir) > 0 {
        var asm_src = path.join(arena, std_dir, "platform/linux_x86_64.s")
        if fs.exists(asm_src) {
            var cached: []u8 = "/tmp/lunsoc-std-linux-x86_64.o"
            if !fs.exists(cached) {
                var cc: []u8 = "cc"
                var cc_env: []u8
                if os.getenv("CC", arena, &cc_env) == 0 && len(cc_env) > 0 {
                    cc = cc_env
                }
                var cc_args: [5][]u8 = [cc, "-c", asm_src, "-o", cached]
                _ = os.run(cc, cc_args[0..5])
            }
            if fs.exists(cached) {
                return cached
            }
        }
    }
    return ""
}

fun default_output_name(arena: *mem.Arena, src_path: []const u8, mode: Mode): []u8 {
    var has_lunso = path.extension(src_path) == ".lunso"
    var stem = path.basename(src_path)
    if has_lunso {
        stem = path.stem(src_path)
    }
    var suffix: []const u8 = ""
    if mode == Mode.EmitAsm {
        suffix = ".s"
    } else if mode == Mode.EmitObj {
        suffix = ".o"
    } else if !has_lunso {
        suffix = ".out"
    }
    var out = str.concat(arena, stem, suffix)
    if len(out) == 0 {
        return "a.out"
    }
    return out
}

fun strip_quotes(s: []u8): []u8 {
    var t = str.trim(s)
    if len(t) >= 2 && ((t[0] == '"' && t[len(t) - 1] == '"') || (t[0] == '\'' && t[len(t) - 1] == '\'')) {
        return t[1..(len(t) - 1)]
    }
    return t
}

fun parse_manifest(arena: *mem.Arena, out_name: *[]u8, out_entry: *[]u8, out_inc: *[]u8): bool {
    var raw = fs.read_file("lunso.toml", arena) or { return false }
    *out_name = ""
    *out_entry = "src/main.lunso"
    *out_inc = ""
    var n = len(raw)
    var start: i64 = 0
    for var i: i64 = 0; i <= n; i += 1 {
        if i == n || raw[i] == '\n' {
            var line = str.trim(raw[start..i])
            start = i + 1
            if len(line) == 0 || line[0] == '#' || line[0] == '[' { continue }
            var eq = str.index_of(line, '=')
            if eq <= 0 { continue }
            var key = str.trim(line[0..eq])
            var val = strip_quotes(line[(eq + 1)..len(line)])
            if key == "name" { *out_name = val }
            else if key == "entry" { *out_entry = val }
            else if key == "include" { *out_inc = val }
        }
    }
    return true
}

fun run_scaffold(arena: *mem.Arena, is_new: bool, target: []u8): i32 {
    var root: []u8 = "."
    var proj_name: []u8 = "app"
    if is_new {
        if len(target) == 0 {
            io.eprintln("lunsoc: new requires a project name")
            return 1
        }
        root = target
        proj_name = path.basename(target)
        if fs.exists(root) {
            io.eprint("lunsoc: path already exists: ")
            io.eprintln(root)
            return 1
        }
    } else {
        if len(target) > 0 {
            proj_name = target
        }
        if fs.exists("lunso.toml") {
            io.eprintln("lunsoc: lunso.toml already exists")
            return 1
        }
    }

    var src_dir = path.join(arena, root, "src")
    fs.create_dir_all(src_dir) or err {
        io.eprint("lunsoc: failed to create directory: ")
        io.eprintln(err)
        return 1
    }

    var manifest_path = path.join(arena, root, "lunso.toml")
    var manifest_body = str.concat3(arena, "name = \"", proj_name, "\"\nversion = \"0.1.0\"\nentry = \"src/main.lunso\"\n")
    fs.write_file(manifest_path, manifest_body) or err {
        io.eprint("lunsoc: failed to write lunso.toml: ")
        io.eprintln(err)
        return 1
    }

    var main_path = path.join(arena, src_dir, "main.lunso")
    if !fs.exists(main_path) {
        var main_body: []u8 = "import std.io\n\nfun main(): i32 {\n    io.println(\"Hello, world!\")\n    return 0\n}\n"
        fs.write_file(main_path, main_body) or err {
            io.eprint("lunsoc: failed to write src/main.lunso: ")
            io.eprintln(err)
            return 1
        }
    }

    var gi_path = path.join(arena, root, ".gitignore")
    if !fs.exists(gi_path) {
        fs.write_file(gi_path, "build/\n") or {}
    }

    io.printfln("Created Lunso project '{}'", proj_name)
    return 0
}

pub fun run(arena: *mem.Arena, argv: [][]u8): i32 {
    var prog_name: []u8 = "lunsoc"
    if len(argv) > 0 {
        prog_name = argv[0]
    }

    var mode = Mode.Tokens
    var mode_count: i32 = 0
    var path: []u8 = ""
    var output: []u8 = ""
    var std_dir: []u8 = ""
    var nostdlib = false
    var stop_options = false
    var run_args_start: i64 = len(argv)
    var objects: Vec[[]u8]
    var include_dirs: Vec[[]u8]
    if objects.init(arena, 4) < 0 || include_dirs.init(arena, 4) < 0 {
        return 1
    }

    for var i: i64 = 1; i < len(argv); i += 1 {
        var arg = argv[i]
        if !stop_options && arg == "--" {
            stop_options = true
            if mode == Mode.Run && len(path) > 0 {
                run_args_start = i + 1
                break
            }
            continue
        }
        if !stop_options && (arg == "-h" || arg == "--help") {
            print_help(prog_name)
            return 0
        }
        if !stop_options && (arg == "-V" || arg == "--version") {
            io.println(VERSION)
            return 0
        }
        if i == 1 && !stop_options && mode_count == 0 {
            if arg == "new" {
                mode = Mode.New
                mode_count += 1
                continue
            } else if arg == "init" {
                mode = Mode.Init
                mode_count += 1
                continue
            } else if arg == "build" {
                mode = Mode.Build
                mode_count += 1
                continue
            } else if arg == "run" {
                mode = Mode.Run
                mode_count += 1
                continue
            } else if arg == "check" {
                mode = Mode.Check
                mode_count += 1
                continue
            }
        }
        if !stop_options && arg == "--parse" {
            mode = Mode.Parse
            mode_count += 1
        } else if !stop_options && arg == "--check" {
            mode = Mode.Check
            mode_count += 1
        } else if !stop_options && arg == "--emit-ir" {
            mode = Mode.EmitIr
            mode_count += 1
        } else if !stop_options && arg == "--emit-qbe" {
            mode = Mode.EmitQbe
            mode_count += 1
        } else if !stop_options && arg == "--emit-asm" {
            mode = Mode.EmitAsm
            mode_count += 1
        } else if !stop_options && (arg == "-c" || arg == "--emit-obj") {
            mode = Mode.EmitObj
            mode_count += 1
        } else if !stop_options && arg == "--build" {
            mode = Mode.Build
            mode_count += 1
        } else if !stop_options && arg == "--run" {
            mode = Mode.Run
            mode_count += 1
        } else if !stop_options && (arg == "-nostdlib" || arg == "--nostdlib") {
            nostdlib = true
        } else if !stop_options && arg == "--std" {
            if i + 1 >= len(argv) || len(std_dir) > 0 {
                io.eprintln("lunsoc: invalid --std option")
                    return 1
            }
            i += 1
            std_dir = argv[i]
        } else if !stop_options && arg == "-I" {
            if i + 1 >= len(argv) {
                io.eprintln("lunsoc: -I requires a directory")
                    return 1
            }
            i += 1
            include_dirs.push_value(argv[i])
        } else if !stop_options && len(arg) > 2 && arg[0..2] == "-I" {
            include_dirs.push_value(arg[2..len(arg)])
        } else if !stop_options && len(arg) > 6 && arg[0..6] == "--std=" {
            if len(std_dir) > 0 || len(arg) == 6 {
                io.eprintln("lunsoc: invalid --std option")
                    return 1
            }
            std_dir = arg[6..len(arg)]
        } else if !stop_options && arg == "-o" {
            if i + 1 >= len(argv) || len(output) > 0 {
                io.eprintln("lunsoc: invalid -o option")
                    return 1
            }
            i += 1
            output = argv[i]
        } else if !stop_options && arg == "--link" {
            if i + 1 >= len(argv) {
                io.eprintln("lunsoc: --link requires a path")
                    return 1
            }
            i += 1
            objects.push_value(argv[i])
        } else if !stop_options && len(arg) > 1 && arg[0] == '-' {
            io.eprint("unknown option: ")
            io.eprintln(arg)
            print_usage(2, prog_name)
            return 1
        } else if len(path) == 0 {
            path = arg
        } else {
            io.eprint("unexpected argument: ")
            io.eprintln(arg)
            print_usage(2, prog_name)
            return 1
        }
    }

    if mode_count > 1 {
        print_usage(2, prog_name)
        return 1
    }

    if mode == Mode.New {
        return run_scaffold(arena, true, path)
    }
    if mode == Mode.Init {
        return run_scaffold(arena, false, path)
    }

    if len(path) == 0 && (mode == Mode.Build || mode == Mode.Run || mode == Mode.Check) {
        var proj_name: []u8 = ""
        var proj_entry: []u8 = ""
        var proj_inc: []u8 = ""
        if parse_manifest(arena, &proj_name, &proj_entry, &proj_inc) {
            path = proj_entry
            if len(proj_inc) > 0 {
                include_dirs.push_value(proj_inc)
            } else if fs.is_dir("src") {
                include_dirs.push_value("src")
            }
            if mode == Mode.Build && len(output) == 0 && len(proj_name) > 0 {
                fs.create_dir_all("build") or {}
                output = path.join(arena, "build", proj_name)
            }
        } else if fs.exists("src/main.lunso") {
            path = "src/main.lunso"
            include_dirs.push_value("src")
        } else if fs.exists("main.lunso") {
            path = "main.lunso"
        }
    }

    if len(path) == 0 {
        print_usage(2, prog_name)
        return 1
    }

    var allows_output = mode == Mode.Build || mode == Mode.EmitObj || mode == Mode.EmitAsm
    var allows_link = mode == Mode.Build || mode == Mode.Run
    if (len(output) > 0 && !allows_output) || (!allows_link && (objects.len > 0 || nostdlib)) {
        io.eprintln("-o, --link, and -nostdlib require a compatible build/run mode")
        return 1
    }

    var source: []u8
    if file.read_all(path, arena, &source) < 0 {
        io.eprint(path)
        io.eprintln(": could not read source")
        return 1
    }

    var rc: i32 = 0
    if mode == Mode.Tokens {
        rc = dump_tokens(path, source, arena)
    } else if mode == Mode.Parse {
        rc = run_parse(path, source, arena)
    } else {
        var exe_dir = resolve_exe_dir(arena, prog_name)
        var resolved_std = resolve_std_dir(arena, std_dir, exe_dir)
        if allows_output && len(output) == 0 {
            output = default_output_name(arena, path, mode)
        }
        if allows_link && !nostdlib && objects.len == 0 {
            var std_obj = resolve_std_obj(arena, exe_dir, resolved_std)
            if len(std_obj) > 0 {
                objects.push_value(std_obj)
            }
        }
        var nkind = native.NativeKind.Exe
        if mode == Mode.EmitAsm { nkind = native.NativeKind.Asm }
        if mode == Mode.EmitObj { nkind = native.NativeKind.Obj }
        var opts = native.NativeOptions {
            kind: nkind,
            nostdlib: nostdlib,
            output: output,
            objects: objects.as_slice(),
        }
        var run_args = argv[run_args_start..len(argv)]
        rc = run_compile(path, source, resolved_std, include_dirs.as_slice(), arena, mode, &opts, run_args)
    }

    return rc
}
