import std.file
import std.mem

pub fun load(arena: *mem.Arena, out: *[][]u8): i64 {
    var raw: []u8
    var status = file.read_all("/proc/self/cmdline", arena, &raw)
    if status < 0 {
        return status
    }

    var raw_len = len(raw)
    var count: i64 = 0
    for var i: i64 = 0; i < raw_len; i += 1 {
        if raw[i] == '\0' {
            count += 1
        }
    }
    if raw_len > 0 && raw[raw_len - 1] != '\0' {
        count += 1
    }

    if count == 0 {
        var empty: *[]u8
        *out = empty[0..0]
        return 0
    }

    var items: *[]u8
    status = mem.alloc_many.[[]u8](arena, count as u64, &items)
    if status < 0 {
        return status
    }
    var idx: i64 = 0
    var start: i64 = 0
    for var i: i64 = 0; i < raw_len; i += 1 {
        if raw[i] == '\0' {
            items[idx] = raw[start..i]
            idx += 1
            start = i + 1
        }
    }
    if idx < count && start < raw_len {
        items[idx] = raw[start..raw_len]
    }

    *out = items[0..count]
    return count
}
