import std.file
import std.mem

pub fun load(arena: *mem.Arena): ![][]u8 {
    var raw: []u8
    if file.read_all("/proc/self/cmdline", arena, &raw) < 0 {
        return fail("could not read /proc/self/cmdline")
    }

    var raw_len = len(raw)
    var count: i64 = 0
    for ch in raw {
        if ch == '\0' {
            count += 1
        }
    }
    if raw_len > 0 && raw[raw_len - 1] != '\0' {
        count += 1
    }

    if count == 0 {
        var empty: *[]u8
        return empty[0..0]
    }

    var items: *[]u8
    if arena.alloc_many(count as u64, &items) < 0 {
        return fail("args out of memory")
    }
    var idx: i64 = 0
    var start: i64 = 0
    for i, ch in raw {
        if ch == '\0' {
            items[idx] = raw[start..i]
            idx += 1
            start = i + 1
        }
    }
    if idx < count && start < raw_len {
        items[idx] = raw[start..raw_len]
    }

    return items[0..count]
}
