import std.file
import std.mem
import std.str
import std.vec

pub struct DirEntry {
    name: []u8
    is_dir: bool
}

ext fun lunso_sys_fork(): i64
ext fun lunso_sys_execve(path: *const u8, argv: **u8, envp: **u8): i64
ext fun lunso_sys_exit(code: i32)
ext fun lunso_sys_wait4(pid: i64, status: *i32): i64
ext fun lunso_sys_access(path: *const u8, mode: i32): i64
ext fun lunso_sys_mkdir(path: *const u8): i64
ext fun lunso_sys_unlink(path: *const u8, flags: i32): i64
ext fun lunso_sys_open_dir(path: *const u8): i64
ext fun lunso_sys_getdents64(fd: i32, dirp: *u8, count: u64): i64
ext fun lunso_sys_file_close(fd: i32): i64

pub fun exit(code: i32) {
    lunso_sys_exit(code)
}

fun to_cstr(arena: *mem.Arena, s: []const u8, out: **u8): i64 {
    var n = len(s)
    var buf: *u8
    var status = mem.alloc(arena, (n as u64) + 1, 1, &buf)
    if status < 0 {
        return status
    }
    for var i: i64 = 0; i < n; i += 1 {
        if s[i] == '\0' {
            return -22
        }
        buf[i] = s[i]
    }
    buf[n] = '\0'
    *out = buf
    return 0
}

fun with_cstr(path: []const u8, buf: *u8, cap: i64): i64 {
    var n = len(path)
    if n >= cap {
        return -36
    }
    for var i: i64 = 0; i < n; i += 1 {
        if path[i] == '\0' {
            return -22
        }
        buf[i] = path[i]
    }
    buf[n] = '\0'
    return 0
}

pub fun mkdir(path: []const u8): i64 {
    var buf: [4096]u8
    var status = with_cstr(path, &buf[0], 4096)
    if status < 0 {
        return status
    }
    return lunso_sys_mkdir(data(buf))
}

pub fun remove(path: []const u8): i64 {
    var buf: [4096]u8
    var status = with_cstr(path, &buf[0], 4096)
    if status < 0 {
        return status
    }
    return lunso_sys_unlink(data(buf), 0)
}

pub fun rmdir(path: []const u8): i64 {
    var buf: [4096]u8
    var status = with_cstr(path, &buf[0], 4096)
    if status < 0 {
        return status
    }
    return lunso_sys_unlink(data(buf), 0x200)
}

fun find_env_in_raw(raw: []u8, name: []const u8, out: *[]u8): bool {
    var n = len(name)
    var raw_len = len(raw)
    var start: i64 = 0
    for var i: i64 = 0; i < raw_len; i += 1 {
        if raw[i] == '\0' {
            var entry = raw[start..i]
            if len(entry) > n && entry[n] == '=' && str.starts_with(entry, name) {
                *out = raw[(start + n + 1)..i]
                return true
            }
            start = i + 1
        }
    }
    return false
}

pub fun getenv(name: []const u8, arena: *mem.Arena, out: *[]u8): i64 {
    if len(name) == 0 {
        return -22
    }
    var raw: []u8
    var status = file.read_all("/proc/self/environ", arena, &raw)
    if status < 0 {
        return status
    }
    if find_env_in_raw(raw, name, out) {
        return 0
    }
    return -2
}

fun contains_slash(s: []const u8): bool {
    for var i: i64 = 0; i < len(s); i += 1 {
        if s[i] == '/' {
            return true
        }
    }
    return false
}

fun build_envp(arena: *mem.Arena, raw: []u8, has_env: bool, out: ***u8): i64 {
    var count: i64 = 0
    var raw_len = len(raw)
    if has_env {
        for var i: i64 = 0; i < raw_len; i += 1 {
            if raw[i] == '\0' {
                count += 1
            }
        }
    }
    var envp: **u8
    var status = mem.alloc_many.[*u8](arena, (count as u64) + 1, &envp)
    if status < 0 {
        return status
    }
    if has_env {
        var idx: i64 = 0
        var start: i64 = 0
        for var i: i64 = 0; i < raw_len; i += 1 {
            if raw[i] == '\0' {
                envp[idx] = &raw[start]
                idx += 1
                start = i + 1
            }
        }
    }
    var null_ptr: *u8
    envp[count] = null_ptr
    *out = envp
    return 0
}

fun resolve_program(arena: *mem.Arena, program: []const u8, raw: []u8, has_env: bool,
                    out: **u8): i64 {
    if contains_slash(program) {
        return to_cstr(arena, program, out)
    }
    var path_env: []u8
    if !has_env || !find_env_in_raw(raw, "PATH", &path_env) {
        return -2
    }
    var plen = len(program)
    var start: i64 = 0
    for var i: i64 = 0; i <= len(path_env); i += 1 {
        if i == len(path_env) || path_env[i] == ':' {
            var dlen = i - start
            var candidate: *u8
            var extra: i64 = 1
            if dlen == 0 {
                extra = 0
            }
            var status = mem.alloc(arena, ((dlen + extra + plen) as u64) + 1, 1, &candidate)
            if status < 0 {
                return status
            }
            for var j: i64 = 0; j < dlen; j += 1 {
                candidate[j] = path_env[start + j]
            }
            if extra == 1 {
                candidate[dlen] = '/'
            }
            for var j: i64 = 0; j < plen; j += 1 {
                candidate[dlen + extra + j] = program[j]
            }
            candidate[dlen + extra + plen] = '\0'
            if lunso_sys_access(candidate, 1) == 0 {
                *out = candidate
                return 0
            }
            start = i + 1
        }
    }
    return -2
}

pub fun run(program: []const u8, argv: [][]u8): i64 {
    if len(program) == 0 {
        return -22
    }
    var arena: mem.Arena
    var status = mem.init(&arena, 4096)
    if status < 0 {
        return status
    }
    defer mem.deinit(&arena)

    var raw_env: []u8
    var has_env = file.read_all("/proc/self/environ", &arena, &raw_env) >= 0

    var envp: **u8
    status = build_envp(&arena, raw_env, has_env, &envp)
    if status < 0 {
        return status
    }

    var prog_cstr: *u8
    status = resolve_program(&arena, program, raw_env, has_env, &prog_cstr)
    if status < 0 {
        return status
    }

    var argc = len(argv)
    var c_argv: **u8
    status = mem.alloc_many.[*u8](&arena, (argc as u64) + 1, &c_argv)
    if status < 0 {
        return status
    }
    for var i: i64 = 0; i < argc; i += 1 {
        var arg_ptr: *u8
        status = to_cstr(&arena, argv[i], &arg_ptr)
        if status < 0 {
            return status
        }
        c_argv[i] = arg_ptr
    }
    var null_ptr: *u8
    c_argv[argc] = null_ptr

    var pid = lunso_sys_fork()
    if pid < 0 {
        return pid
    }
    if pid == 0 {
        lunso_sys_execve(prog_cstr, c_argv, envp)
        lunso_sys_exit(127)
    }

    var wstatus: i32 = 0
    var waited = lunso_sys_wait4(pid, &wstatus)
    for waited == -4 {
        waited = lunso_sys_wait4(pid, &wstatus)
    }
    if waited < 0 {
        return waited
    }
    if (wstatus & 127) == 0 {
        return ((wstatus >> 8) & 255) as i64
    }
    return (128 + (wstatus & 127)) as i64
}

pub fun list_dir(path: []const u8, arena: *mem.Arena, out: *vec.Vec[DirEntry]): i64 {
    if (arena as u64) == 0 || (out as u64) == 0 {
        return -22
    }
    var cpath: [4096]u8
    var status = with_cstr(path, &cpath[0], 4096)
    if status < 0 {
        return status
    }
    var fd = lunso_sys_open_dir(data(cpath))
    for fd == -4 {
        fd = lunso_sys_open_dir(data(cpath))
    }
    if fd < 0 {
        return fd
    }
    defer lunso_sys_file_close(fd as i32)

    if vec.init.[DirEntry](out, arena, 16) < 0 {
        return -12
    }
    var buf: [4096]u8
    for {
        var nread = lunso_sys_getdents64(fd as i32, &buf[0], 4096)
        if nread == -4 {
            continue
        }
        if nread < 0 {
            return nread
        }
        if nread == 0 {
            break
        }
        var pos: i64 = 0
        for pos + 19 <= nread {
            var reclen = ((buf[pos + 16] as u64) | ((buf[pos + 17] as u64) << 8)) as i64
            if reclen < 19 || pos + reclen > nread {
                break
            }
            var dtype = buf[pos + 18]
            var name_start = pos + 19
            var name_end = name_start
            for name_end < pos + reclen && buf[name_end] != 0 {
                name_end += 1
            }
            var name_slice = buf[name_start..name_end]
            if !str.equals(name_slice, ".") && !str.equals(name_slice, "..") {
                var cloned = str.clone(arena, name_slice)
                if len(name_slice) > 0 && len(cloned) == 0 {
                    return -12
                }
                var entry = DirEntry {
                    name: cloned,
                    is_dir: dtype == 4,
                }
                if vec.push.[DirEntry](out, &entry) < 0 {
                    return -12
                }
            }
            pos += reclen
        }
    }
    return out.len as i64
}
