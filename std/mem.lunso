struct Block {
    next: *Block
    size: u64
    used: u64
}

pub struct Arena {
    head: *Block
    current: *Block
    block_size: u64

    pub fun init(self: *Arena, block_size: u64): i64 {
        if block_size == 0 || self.block_size != 0 {
            return -22
        }
        self.block_size = block_size
        return 0
    }

    pub fun alloc(self: *Arena, size: u64, align: u64, out: **u8): i64 {
        if self.block_size == 0 || size == 0 || align == 0 {
            return -22
        }
        var mask = align - 1
        if (align & mask) != 0 {
            return -22
        }

        var block = self.current
        var tail: *Block
        for (block as u64) != 0 {
            if alloc_from(block, size, mask, out) {
                self.current = block
                return 0
            }
            tail = block
            block = block.next
        }

        var header = size_of(*block)
        var overhead = header + mask
        var max: u64 = ~0
        if size > max - overhead {
            return -75
        }
        var capacity = size + overhead
        if capacity < self.block_size {
            capacity = self.block_size
        }

        var status = lunso_mem_map(capacity, &block)
        if status < 0 {
            return status
        }
        var end: *Block
        block.next = end
        block.size = capacity
        block.used = header
        // The new block includes room for the header, worst-case padding, and payload.
        alloc_from(block, size, mask, out)
        if (tail as u64) == 0 {
            self.head = block
        } else {
            tail.next = block
        }
        self.current = block
        return 0
    }

    pub fun reset(self: *Arena) {
        var block = self.head
        self.current = block
        for (block as u64) != 0 {
            block.used = size_of(*block)
            block = block.next
        }
    }

    pub fun deinit(self: *Arena): i64 {
        var block = self.head
        for (block as u64) != 0 {
            var next = block.next
            var status = lunso_mem_unmap(block, block.size)
            if status < 0 {
                self.current = block
                return status
            }
            self.head = next
            block = next
        }
        self.current = block
        self.block_size = 0
        return 0
    }
}

ext fun lunso_mem_map(size: u64, out: **Block): i64
ext fun lunso_mem_unmap(block: *Block, size: u64): i64

pub fun init(arena: *Arena, block_size: u64): i64 {
    return arena.init(block_size)
}

fun alloc_from(block: *Block, size: u64, mask: u64, out: **u8): bool {
    var used = (*block).used
    var remaining = (*block).size - used
    var address = (block as u64) + used
    var padding = (0 - address) & mask
    if padding > remaining || size > remaining - padding {
        return false
    }

    var offset = used + padding
    var bytes = block as *u8
    *out = &bytes[offset]
    (*block).used = offset + size
    return true
}

pub fun alloc(arena: *Arena, size: u64, align: u64, out: **u8): i64 {
    return arena.alloc(size, align, out)
}

pub fun reset(arena: *Arena) {
    arena.reset()
}

pub fun align_for(size: u64): u64 {
    if size <= 1 { return 1 }
    if size <= 2 { return 2 }
    if size <= 4 { return 4 }
    if size <= 8 { return 8 }
    return 16
}

pub fun alloc_many[T](arena: *Arena, count: u64, out: **T): i64 {
    if (out as u64) == 0 {
        return -22
    }
    if count == 0 {
        var empty: *T
        *out = empty
        return 0
    }
    var probe: T
    var elem_size = size_of(probe)
    if elem_size == 0 {
        elem_size = 1
    }
    var max: u64 = ~0
    if count > max / elem_size {
        return -75
    }
    var raw: *u8
    var status = alloc(arena, count * elem_size, align_for(elem_size), &raw)
    if status < 0 {
        return status
    }
    *out = raw as *T
    return 0
}

pub fun alloc_one[T](arena: *Arena, out: **T): i64 {
    return alloc_many(arena, 1, out)
}

pub fun deinit(arena: *Arena): i64 {
    return arena.deinit()
}
