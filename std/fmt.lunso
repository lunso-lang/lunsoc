import std.mem
import std.str
import std.vec

ext fun lunso_sys_write(fd: i32, buffer: *const u8, count: u64): i64

pub fun u64_to_buf(value: u64, buf: *u8, cap: i64): i64 {
    if cap <= 0 {
        return -22
    }
    var tmp: [32]u8
    var n: i64 = 0
    var v = value
    if v == 0 {
        tmp[0] = '0'
        n = 1
    } else {
        for v > 0 {
            tmp[n] = (('0' as u64) + (v % 10)) as u8
            n += 1
            v /= 10
        }
    }
    if n > cap {
        return -22
    }
    for var i: i64 = 0; i < n; i += 1 {
        buf[i] = tmp[n - 1 - i]
    }
    return n
}

pub fun i64_to_buf(value: i64, buf: *u8, cap: i64): i64 {
    if cap <= 0 {
        return -22
    }
    if value < 0 {
        buf[0] = '-'
        var mag = (0 as u64) - (value as u64)
        var n = u64_to_buf(mag, &buf[1], cap - 1)
        if n < 0 {
            return n
        }
        return n + 1
    }
    return u64_to_buf(value as u64, buf, cap)
}

pub fun hex_to_buf(value: u64, buf: *u8, cap: i64): i64 {
    if cap <= 0 {
        return -22
    }
    var digits = "0123456789abcdef"
    var tmp: [16]u8
    var n: i64 = 0
    var v = value
    if v == 0 {
        tmp[0] = '0'
        n = 1
    } else {
        for v > 0 {
            tmp[n] = digits[(v & 15) as i64]
            n += 1
            v >>= 4
        }
    }
    if n > cap {
        return -22
    }
    for var i: i64 = 0; i < n; i += 1 {
        buf[i] = tmp[n - 1 - i]
    }
    return n
}

pub fun format_u64(value: u64, arena: *mem.Arena): []u8 {
    var tmp: [32]u8
    var n = u64_to_buf(value, &tmp[0], 32)
    var ptr: *u8
    if n < 0 || mem.alloc(arena, n as u64, 1, &ptr) < 0 {
        var empty: *u8
        return empty[0..0]
    }
    for var i: i64 = 0; i < n; i += 1 {
        ptr[i] = tmp[i]
    }
    return ptr[0..n]
}

pub fun format_i64(value: i64, arena: *mem.Arena): []u8 {
    var tmp: [32]u8
    var n = i64_to_buf(value, &tmp[0], 32)
    var ptr: *u8
    if n < 0 || mem.alloc(arena, n as u64, 1, &ptr) < 0 {
        var empty: *u8
        return empty[0..0]
    }
    for var i: i64 = 0; i < n; i += 1 {
        ptr[i] = tmp[i]
    }
    return ptr[0..n]
}

pub fun print_u64(fd: i32, value: u64): i64 {
    var buf: [32]u8
    var n = u64_to_buf(value, &buf[0], 32)
    if n < 0 {
        return n
    }
    return lunso_sys_write(fd, &buf[0], n as u64)
}

pub fun print_i64(fd: i32, value: i64): i64 {
    var buf: [32]u8
    var n = i64_to_buf(value, &buf[0], 32)
    if n < 0 {
        return n
    }
    return lunso_sys_write(fd, &buf[0], n as u64)
}

pub fun parse_u64(text: []u8, out: *u64): bool {
    var trimmed = str.trim(text)
    if len(trimmed) > 0 && trimmed[0] == '+' {
        trimmed = trimmed[1..len(trimmed)]
    }
    return str.parse_u64(trimmed, out)
}

pub fun parse_i64(text: []u8, out: *i64): bool {
    return str.parse_i64(str.trim(text), out)
}

pub fun f64_to_buf(value: f64, decimals: i32, buf: *u8, cap: i64): i64 {
    if cap <= 0 {
        return -22
    }
    var pos: i64 = 0
    var v = value
    if v < 0.0 {
        buf[pos] = '-'
        pos += 1
        v = -v
    }
    var prec = decimals
    if prec < 0 { prec = 0 }
    if prec > 9 { prec = 9 }
    var scale: f64 = 1.0
    for var i: i32 = 0; i < prec; i += 1 {
        scale *= 10.0
    }
    var scaled = (v * scale + 0.5) as u64
    var divisor = scale as u64
    var int_part = scaled / divisor
    var frac_part = scaled % divisor

    var n = u64_to_buf(int_part, &buf[pos], cap - pos)
    if n < 0 { return n }
    pos += n
    if prec == 0 {
        return pos
    }
    if pos >= cap { return -22 }
    buf[pos] = '.'
    pos += 1
    if pos + (prec as i64) > cap { return -22 }
    var ftmp: [16]u8
    var fn_len = u64_to_buf(frac_part, &ftmp[0], 16)
    var zeros = (prec as i64) - fn_len
    for var z: i64 = 0; z < zeros; z += 1 {
        buf[pos] = '0'
        pos += 1
    }
    for var j: i64 = 0; j < fn_len; j += 1 {
        buf[pos] = ftmp[j]
        pos += 1
    }
    return pos
}

pub fun format_f64(value: f64, decimals: i32, arena: *mem.Arena): []u8 {
    var tmp: [64]u8
    var n = f64_to_buf(value, decimals, &tmp[0], 64)
    if n < 0 { return "" }
    return str.clone(arena, tmp[0..n])
}

pub struct Builder {
    buf: vec.Vec[u8]

    pub fun init(self: *Builder, arena: *mem.Arena): i64 {
        return self.buf.init(arena, 64)
    }

    pub fun str(self: *Builder, s: []const u8): *Builder {
        self.buf.append_slice(s)
        return self
    }

    pub fun ch(self: *Builder, c: u8): *Builder {
        self.buf.push_value(c)
        return self
    }

    pub fun nl(self: *Builder): *Builder {
        self.buf.push_value('\n')
        return self
    }

    pub fun bool_val(self: *Builder, v: bool): *Builder {
        if v {
            self.buf.append_slice("true")
        } else {
            self.buf.append_slice("false")
        }
        return self
    }

    pub fun i64_val(self: *Builder, v: i64): *Builder {
        var tmp: [32]u8
        var n = i64_to_buf(v, &tmp[0], 32)
        if n > 0 { self.buf.append_slice(tmp[0..n]) }
        return self
    }

    pub fun u64_val(self: *Builder, v: u64): *Builder {
        var tmp: [32]u8
        var n = u64_to_buf(v, &tmp[0], 32)
        if n > 0 { self.buf.append_slice(tmp[0..n]) }
        return self
    }

    pub fun hex(self: *Builder, v: u64): *Builder {
        var tmp: [16]u8
        var n = hex_to_buf(v, &tmp[0], 16)
        if n > 0 { self.buf.append_slice(tmp[0..n]) }
        return self
    }

    pub fun f64_val(self: *Builder, v: f64, decimals: i32): *Builder {
        var tmp: [64]u8
        var n = f64_to_buf(v, decimals, &tmp[0], 64)
        if n > 0 { self.buf.append_slice(tmp[0..n]) }
        return self
    }

    pub fun finish(self: *Builder): []u8 {
        return self.buf.as_slice()
    }
}

fun write_any(b: *Builder, a: any) {
    var k = a.tag & 255
    var ek = (a.tag >> 8) & 255
    if k == 2 {
        b.bool_val(*(a.ptr as *const bool))
    } else if k == 3 {
        b.i64_val((*(a.ptr as *const i8)) as i64)
    } else if k == 4 {
        b.i64_val((*(a.ptr as *const i16)) as i64)
    } else if k == 5 {
        b.i64_val((*(a.ptr as *const i32)) as i64)
    } else if k == 6 {
        b.i64_val(*(a.ptr as *const i64))
    } else if k == 7 {
        b.u64_val((*(a.ptr as *const u8)) as u64)
    } else if k == 8 {
        b.u64_val((*(a.ptr as *const u16)) as u64)
    } else if k == 9 {
        b.u64_val((*(a.ptr as *const u32)) as u64)
    } else if k == 10 {
        b.u64_val(*(a.ptr as *const u64))
    } else if k == 11 {
        b.f64_val((*(a.ptr as *const f32)) as f64, 4)
    } else if k == 12 {
        b.f64_val(*(a.ptr as *const f64), 4)
    } else if k == 15 && ek == 7 {
        b.str(*(a.ptr as *const []const u8))
    } else if k == 16 {
        b.str("0x").hex(*(a.ptr as *const u64))
    } else {
        b.str("<value>")
    }
}

pub fun format_args(arena: *mem.Arena, fmt_str: []const u8, args: []const any): []u8 {
    var b: Builder
    if b.init(arena) < 0 {
        return ""
    }
    var n = len(fmt_str)
    var arg_idx: i64 = 0
    var arg_count = len(args)
    var i: i64 = 0
    for i < n {
        var ch = fmt_str[i]
        if ch == '{' && i + 1 < n {
            if fmt_str[i + 1] == '}' {
                if arg_idx < arg_count {
                    write_any(&b, args[arg_idx])
                    arg_idx += 1
                } else {
                    b.str("{}")
                }
                i += 2
                continue
            }
            if fmt_str[i + 1] == '{' {
                b.ch('{')
                i += 2
                continue
            }
        } else if ch == '}' && i + 1 < n && fmt_str[i + 1] == '}' {
            b.ch('}')
            i += 2
            continue
        }
        b.ch(ch)
        i += 1
    }
    return b.finish()
}

pub fun format(arena: *mem.Arena, fmt_str: []const u8, args: ...any): []u8 {
    return format_args(arena, fmt_str, args)
}
