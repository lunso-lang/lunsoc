import std.time

ext fun lunso_sys_getrandom(buf: *u8, len: u64, flags: u32): i64

pub struct Rng {
    state: u64
}

pub fun fill_bytes(buf: []u8): !void {
    var count = len(buf) as u64
    if count == 0 {
        return
    }
    var offset: u64 = 0
    for offset < count {
        var n = lunso_sys_getrandom(&buf[offset], count - offset, 0)
        if n == -4 {
            continue
        }
        if n <= 0 {
            return fail("getrandom failed")
        }
        offset += n as u64
    }
}

pub fun u64_entropy(): !u64 {
    var raw: [8]u8
    fill_bytes(raw[0..8])?
    var val: u64 = 0
    for i, b in raw {
        val |= (b as u64) << ((i * 8) as u64)
    }
    return val
}

pub fun seed(rng: *Rng, value: u64) {
    if value == 0 {
        rng.state = 0x9e3779b97f4a7c15
    } else {
        rng.state = value
    }
}

pub fun init(rng: *Rng): !void {
    var ent = u64_entropy() or {
        seed(rng, time.monotonic_ns() as u64)
        return fail("entropy unavailable")
    }
    seed(rng, ent)
}

pub fun next_u64(rng: *Rng): u64 {
    var x = rng.state
    if x == 0 {
        x = 0x9e3779b97f4a7c15
    }
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    rng.state = x
    return x * 0x2545f4914f6cdd1d
}

pub fun range_i64(rng: *Rng, lo: i64, hi: i64): i64 {
    if hi <= lo {
        return lo
    }
    var span = ((hi - lo) as u64) + 1
    var offset = next_u64(rng) % span
    return lo + (offset as i64)
}

pub fun range_i32(rng: *Rng, lo: i32, hi: i32): i32 {
    return range_i64(rng, lo as i64, hi as i64) as i32
}
