import std.time

ext fun lunso_sys_getrandom(buf: *u8, len: u64, flags: u32): i64

pub struct Rng {
    state: u64
}

pub fun fill_bytes(buf: *u8, count: u64): i64 {
    if count == 0 {
        return 0
    }
    if (buf as u64) == 0 {
        return -22
    }
    var offset: u64 = 0
    for offset < count {
        var n = lunso_sys_getrandom(&buf[offset], count - offset, 0)
        if n == -4 {
            continue
        }
        if n < 0 {
            return n
        }
        if n == 0 {
            return -5
        }
        offset += n as u64
    }
    return 0
}

pub fun u64_entropy(out: *u64): i64 {
    if (out as u64) == 0 {
        return -22
    }
    var raw: [8]u8
    var status = fill_bytes(&raw[0], 8)
    if status < 0 {
        return status
    }
    var val: u64 = 0
    for var i: i64 = 0; i < 8; i += 1 {
        val |= (raw[i] as u64) << ((i * 8) as u64)
    }
    *out = val
    return 0
}

pub fun seed(rng: *Rng, value: u64) {
    if value == 0 {
        rng.state = 0x9e3779b97f4a7c15
    } else {
        rng.state = value
    }
}

pub fun init(rng: *Rng): i64 {
    var ent: u64 = 0
    var status = u64_entropy(&ent)
    if status < 0 {
        ent = time.monotonic_ns() as u64
        seed(rng, ent)
        return status
    }
    seed(rng, ent)
    return 0
}

pub fun next_u64(rng: *Rng): u64 {
    var x = rng.state
    if x == 0 {
        x = 0x9e3779b97f4a7c15
    }
    x ^= x >> 12
    x ^= x << 25
    x ^= x >> 27
    rng.state = x
    return x * 0x2545f4914f6cdd1d
}

pub fun range_i64(rng: *Rng, lo: i64, hi: i64): i64 {
    if hi <= lo {
        return lo
    }
    var span = ((hi - lo) as u64) + 1
    var offset = next_u64(rng) % span
    return lo + (offset as i64)
}

pub fun range_i32(rng: *Rng, lo: i32, hi: i32): i32 {
    return range_i64(rng, lo as i64, hi as i64) as i32
}
