import std.mem

pub struct Vec[T] {
    data: *T
    len: u64
    cap: u64
    arena: *mem.Arena

    pub fun init(self: *Self, arena: *mem.Arena, initial_cap: u64): i64 {
        if self == null || arena == null {
            return -22
        }
        var empty: *T
        self.data = empty
        self.len = 0
        self.cap = 0
        self.arena = arena
        if initial_cap == 0 {
            return 0
        }
        return self.reserve(initial_cap)
    }

    pub fun reserve(self: *Self, min_cap: u64): i64 {
        if self == null || self.arena == null {
            return -22
        }
        if min_cap <= self.cap {
            return 0
        }

        var probe: T
        var elem_size = size_of(probe)
        if elem_size == 0 {
            self.cap = min_cap
            return 0
        }

        var new_cap = self.cap
        if new_cap == 0 {
            new_cap = 8
        }
        var max: u64 = ~0
        for new_cap < min_cap {
            if new_cap > max / 2 {
                new_cap = min_cap
                break
            }
            new_cap = new_cap * 2
        }
        if new_cap > max / elem_size {
            return -75
        }

        var raw: *u8
        var status = self.arena.alloc(new_cap * elem_size, elem_align(elem_size), &raw)
        if status < 0 {
            return status
        }

        var new_data = raw as *T
        for var i: u64 = 0; i < self.len; i += 1 {
            new_data[i] = self.data[i]
        }
        self.data = new_data
        self.cap = new_cap
        return 0
    }

    pub fun alloc_slot(self: *Self, out: **T): i64 {
        if self == null || out == null {
            return -22
        }
        if self.len >= self.cap {
            var status = self.reserve(self.len + 1)
            if status < 0 {
                return status
            }
        }
        *out = &self.data[self.len]
        self.len += 1
        return 0
    }

    pub fun push(self: *Self, value: *const T): i64 {
        if self == null || value == null {
            return -22
        }
        if self.len >= self.cap {
            var status = self.reserve(self.len + 1)
            if status < 0 {
                return status
            }
        }
        self.data[self.len] = *value
        self.len += 1
        return 0
    }

    pub fun push_value(self: *Self, value: T): i64 {
        if self == null {
            return -22
        }
        if self.len >= self.cap {
            var status = self.reserve(self.len + 1)
            if status < 0 {
                return status
            }
        }
        self.data[self.len] = value
        self.len += 1
        return 0
    }

    pub fun append_slice(self: *Self, items: []const T): i64 {
        if self == null {
            return -22
        }
        var count = len(items) as u64
        if count == 0 {
            return 0
        }
        var max: u64 = ~0
        if self.len > max - count {
            return -75
        }
        var needed = self.len + count
        if needed > self.cap {
            var status = self.reserve(needed)
            if status < 0 {
                return status
            }
        }
        for var i: u64 = 0; i < count; i += 1 {
            self.data[self.len + i] = items[i as i64]
        }
        self.len = needed
        return 0
    }

    pub fun pop(self: *Self, out: *T): bool {
        if self == null || self.len == 0 {
            return false
        }
        self.len -= 1
        if out != null {
            *out = self.data[self.len]
        }
        return true
    }

    pub fun get(self: *const Self, index: u64, out: *T): bool {
        if self == null || out == null || index >= self.len {
            return false
        }
        *out = self.data[index]
        return true
    }

    pub fun get_ptr(self: *Self, index: u64, out: **T): bool {
        if self == null || out == null || index >= self.len {
            return false
        }
        *out = &self.data[index]
        return true
    }

    pub fun clear(self: *Self) {
        if self != null {
            self.len = 0
        }
    }

    pub fun as_slice(self: *Self): []T {
        if self == null || self.len == 0 {
            var empty: []T
            return empty
        }
        return self.data[0..self.len]
    }

    pub fun as_const_slice(self: *const Self): []const T {
        if self == null || self.len == 0 {
            var empty: []const T
            return empty
        }
        return self.data[0..self.len]
    }
}

fun elem_align(elem_size: u64): u64 {
    if elem_size <= 1 {
        return 1
    }
    if elem_size <= 2 {
        return 2
    }
    if elem_size <= 4 {
        return 4
    }
    if elem_size <= 8 {
        return 8
    }
    return 16
}

pub fun init[T](vec: *Vec[T], arena: *mem.Arena, initial_cap: u64): i64 {
    return vec.init(arena, initial_cap)
}

pub fun reserve[T](vec: *Vec[T], min_cap: u64): i64 {
    return vec.reserve(min_cap)
}

pub fun alloc_slot[T](vec: *Vec[T], out: **T): i64 {
    return vec.alloc_slot(out)
}

pub fun push[T](vec: *Vec[T], value: *const T): i64 {
    return vec.push(value)
}

pub fun push_value[T](vec: *Vec[T], value: T): i64 {
    return vec.push_value(value)
}

pub fun append_slice[T](vec: *Vec[T], items: []const T): i64 {
    return vec.append_slice(items)
}

pub fun pop[T](vec: *Vec[T], out: *T): bool {
    return vec.pop(out)
}

pub fun get[T](vec: *const Vec[T], index: u64, out: *T): bool {
    return vec.get(index, out)
}

pub fun get_ptr[T](vec: *Vec[T], index: u64, out: **T): bool {
    return vec.get_ptr(index, out)
}

pub fun clear[T](vec: *Vec[T]) {
    vec.clear()
}

pub fun as_slice[T](vec: *Vec[T]): []T {
    return vec.as_slice()
}

pub fun as_const_slice[T](vec: *const Vec[T]): []const T {
    return vec.as_const_slice()
}
