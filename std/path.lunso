import std.mem
import std.str

pub fun join(arena: *mem.Arena, dir: []u8, name: []u8): []u8 {
    if len(dir) == 0 { return name }
    if dir[len(dir) - 1] == '/' {
        return str.concat(arena, dir, name)
    }
    return str.concat3(arena, dir, "/", name)
}

pub fun dir_prefix(p: []u8): []u8 {
    var last: i64 = -1
    for var i: i64 = 0; i < len(p); i += 1 {
        if p[i] == '/' { last = i }
    }
    if last < 0 { return "" }
    return p[0..(last + 1)]
}

pub fun basename(p: []u8): []u8 {
    var base_start: i64 = 0
    for var i: i64 = 0; i < len(p); i += 1 {
        if p[i] == '/' { base_start = i + 1 }
    }
    return p[base_start..len(p)]
}
