import std.mem
import std.vec

pub fun equals(a: []const u8, b: []const u8): bool {
    if len(a) != len(b) {
        return false
    }
    for var i: i64 = 0; i < len(a); i += 1 {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

pub fun starts_with(s: []const u8, prefix: []const u8): bool {
    if len(s) < len(prefix) {
        return false
    }
    for var i: i64 = 0; i < len(prefix); i += 1 {
        if s[i] != prefix[i] {
            return false
        }
    }
    return true
}

pub fun ends_with(s: []const u8, suffix: []const u8): bool {
    if len(s) < len(suffix) {
        return false
    }
    var offset = len(s) - len(suffix)
    for var i: i64 = 0; i < len(suffix); i += 1 {
        if s[offset + i] != suffix[i] {
            return false
        }
    }
    return true
}

pub fun index_of(s: []const u8, needle: u8): i64 {
    for var i: i64 = 0; i < len(s); i += 1 {
        if s[i] == needle {
            return i
        }
    }
    return -1
}

pub fun last_index_of(s: []const u8, needle: u8): i64 {
    var i = len(s) - 1
    for i >= 0 {
        if s[i] == needle {
            return i
        }
        i -= 1
    }
    return -1
}

fun is_space(b: u8): bool {
    return b == ' ' || b == '\t' || b == '\r' || b == '\n'
}

pub fun trim_left(s: []u8): []u8 {
    var i: i64 = 0
    for i < len(s) && is_space(s[i]) {
        i += 1
    }
    return s[i..len(s)]
}

pub fun trim_right(s: []u8): []u8 {
    var end = len(s)
    for end > 0 && is_space(s[end - 1]) {
        end -= 1
    }
    return s[0..end]
}

pub fun trim(s: []u8): []u8 {
    return trim_right(trim_left(s))
}

pub fun strip_prefix(s: []u8, prefix: []u8): []u8 {
    if starts_with(s, prefix) {
        return s[len(prefix)..len(s)]
    }
    return s
}

pub fun strip_suffix(s: []u8, suffix: []u8): []u8 {
    if ends_with(s, suffix) {
        return s[0..(len(s) - len(suffix))]
    }
    return s
}

pub fun concat(arena: *mem.Arena, a: []const u8, b: []const u8): []u8 {
    var total = len(a) + len(b)
    if total == 0 { return "" }
    var buf: *u8
    if mem.alloc(arena, total as u64, 1, &buf) < 0 {
        return ""
    }
    for var i: i64 = 0; i < len(a); i += 1 { buf[i] = a[i] }
    for var i: i64 = 0; i < len(b); i += 1 { buf[len(a) + i] = b[i] }
    return buf[0..total]
}

pub fun concat3(arena: *mem.Arena, a: []const u8, b: []const u8, c: []const u8): []u8 {
    var total = len(a) + len(b) + len(c)
    if total == 0 { return "" }
    var buf: *u8
    if mem.alloc(arena, total as u64, 1, &buf) < 0 {
        return ""
    }
    var pos: i64 = 0
    for var i: i64 = 0; i < len(a); i += 1 { buf[pos] = a[i]; pos += 1 }
    for var i: i64 = 0; i < len(b); i += 1 { buf[pos] = b[i]; pos += 1 }
    for var i: i64 = 0; i < len(c); i += 1 { buf[pos] = c[i]; pos += 1 }
    return buf[0..total]
}

pub fun clone(arena: *mem.Arena, s: []const u8): []u8 {
    var n = len(s)
    if n == 0 { return "" }
    var buf: *u8
    if mem.alloc(arena, n as u64, 1, &buf) < 0 {
        return ""
    }
    for var i: i64 = 0; i < n; i += 1 {
        buf[i] = s[i]
    }
    return buf[0..n]
}

pub fun hash(s: []const u8): u64 {
    var h: u64 = 0xcbf29ce484222325
    for var i: i64 = 0; i < len(s); i += 1 {
        h ^= s[i] as u64
        h *= 0x100000001b3
    }
    return h
}

pub fun parse_u64(s: []const u8, out: *u64): bool {
    if len(s) == 0 {
        return false
    }
    var max_u64: u64 = 18446744073709551615
    var acc: u64 = 0
    for var i: i64 = 0; i < len(s); i += 1 {
        var ch = s[i]
        if ch < '0' || ch > '9' {
            return false
        }
        var digit = (ch - '0') as u64
        if acc > (max_u64 - digit) / 10 {
            return false
        }
        acc = acc * 10 + digit
    }
    *out = acc
    return true
}

pub fun parse_i64(s: []const u8, out: *i64): bool {
    if len(s) == 0 {
        return false
    }
    var negative = false
    var start: i64 = 0
    if s[0] == '-' {
        negative = true
        start = 1
    } else if s[0] == '+' {
        start = 1
    }
    if start >= len(s) {
        return false
    }

    var mag: u64 = 0
    if !parse_u64(s[start..len(s)], &mag) {
        return false
    }
    var limit: u64 = 9223372036854775807
    if negative {
        limit += 1
    }
    if mag > limit {
        return false
    }
    if negative {
        *out = (0 - mag) as i64
    } else {
        *out = mag as i64
    }
    return true
}

pub fun find(s: []const u8, needle: []const u8): i64 {
    var nlen = len(needle)
    if nlen == 0 {
        return 0
    }
    var slen = len(s)
    if nlen > slen {
        return -1
    }
    var limit = slen - nlen
    for var i: i64 = 0; i <= limit; i += 1 {
        var matched = true
        for var j: i64 = 0; j < nlen; j += 1 {
            if s[i + j] != needle[j] {
                matched = false
                break
            }
        }
        if matched {
            return i
        }
    }
    return -1
}

pub fun contains(s: []const u8, needle: []const u8): bool {
    return find(s, needle) >= 0
}

pub fun split_char(arena: *mem.Arena, s: []const u8, sep: u8, out: *vec.Vec[[]const u8]): i64 {
    if arena == null || out == null {
        return -22
    }
    if out.init(arena, 8) < 0 {
        return -12
    }
    var start: i64 = 0
    var slen = len(s)
    for var i: i64 = 0; i <= slen; i += 1 {
        if i == slen || s[i] == sep {
            if out.push_value(s[start..i]) < 0 {
                return -12
            }
            start = i + 1
        }
    }
    return out.len as i64
}

pub fun split(arena: *mem.Arena, s: []const u8, sep: []const u8, out: *vec.Vec[[]const u8]): i64 {
    if arena == null || out == null {
        return -22
    }
    if len(sep) == 1 {
        return split_char(arena, s, sep[0], out)
    }
    if out.init(arena, 8) < 0 {
        return -12
    }
    var slen = len(s)
    var seplen = len(sep)
    if seplen == 0 {
        for var i: i64 = 0; i < slen; i += 1 {
            if out.push_value(s[i..(i + 1)]) < 0 {
                return -12
            }
        }
        return out.len as i64
    }
    var pos: i64 = 0
    for pos <= slen {
        var idx = find(s[pos..slen], sep)
        if idx < 0 {
            if out.push_value(s[pos..slen]) < 0 {
                return -12
            }
            break
        }
        if out.push_value(s[pos..(pos + idx)]) < 0 {
            return -12
        }
        pos += idx + seplen
    }
    return out.len as i64
}

pub fun lines(arena: *mem.Arena, s: []const u8, out: *vec.Vec[[]const u8]): i64 {
    var count = split_char(arena, s, '\n', out)
    if count < 0 {
        return count
    }
    if out.len > 0 && len(s) > 0 && s[len(s) - 1] == '\n' {
        out.len -= 1
    }
    for var i: u64 = 0; i < out.len; i += 1 {
        var line = out.data[i]
        var n = len(line)
        if n > 0 && line[n - 1] == '\r' {
            out.data[i] = line[0..(n - 1)]
        }
    }
    return out.len as i64
}

pub fun join(arena: *mem.Arena, parts: []const []const u8, sep: []const u8): []u8 {
    var count = len(parts)
    if count == 0 {
        return ""
    }
    var total: u64 = 0
    var seplen = len(sep) as u64
    for p in parts {
        total += len(p) as u64
    }
    total += ((count - 1) as u64) * seplen
    if total == 0 {
        return ""
    }
    var buf: *u8
    if arena.alloc(total, 1, &buf) < 0 {
        return ""
    }
    var pos: i64 = 0
    for idx, p in parts {
        if idx > 0 {
            for ch in sep {
                buf[pos] = ch
                pos += 1
            }
        }
        for ch in p {
            buf[pos] = ch
            pos += 1
        }
    }
    return buf[0..(total as i64)]
}

pub fun replace(arena: *mem.Arena, s: []const u8, old: []const u8, new_s: []const u8): []u8 {
    var oldlen = len(old)
    if oldlen == 0 {
        return clone(arena, s)
    }
    var out: vec.Vec[u8]
    if out.init(arena, (len(s) as u64) + 16) < 0 {
        return ""
    }
    var pos: i64 = 0
    var slen = len(s)
    for pos <= slen {
        var idx = find(s[pos..slen], old)
        if idx < 0 {
            out.append_slice(s[pos..slen])
            break
        }
        out.append_slice(s[pos..(pos + idx)])
        out.append_slice(new_s)
        pos += idx + oldlen
    }
    return out.as_slice()
}

pub fun to_lower(arena: *mem.Arena, s: []const u8): []u8 {
    var n = len(s)
    if n == 0 { return "" }
    var buf: *u8
    if arena.alloc(n as u64, 1, &buf) < 0 {
        return ""
    }
    for i, ch in s {
        if ch >= 'A' && ch <= 'Z' {
            buf[i] = ch + ('a' - 'A')
        } else {
            buf[i] = ch
        }
    }
    return buf[0..n]
}

pub fun to_upper(arena: *mem.Arena, s: []const u8): []u8 {
    var n = len(s)
    if n == 0 { return "" }
    var buf: *u8
    if arena.alloc(n as u64, 1, &buf) < 0 {
        return ""
    }
    for i, ch in s {
        if ch >= 'a' && ch <= 'z' {
            buf[i] = ch - ('a' - 'A')
        } else {
            buf[i] = ch
        }
    }
    return buf[0..n]
}

pub fun repeat(arena: *mem.Arena, s: []const u8, count: u64): []u8 {
    var slen = len(s) as u64
    if slen == 0 || count == 0 {
        return ""
    }
    var total = slen * count
    var buf: *u8
    if arena.alloc(total, 1, &buf) < 0 {
        return ""
    }
    var pos: i64 = 0
    for var c: u64 = 0; c < count; c += 1 {
        for var i: i64 = 0; i < len(s); i += 1 {
            buf[pos] = s[i]
            pos += 1
        }
    }
    return buf[0..(total as i64)]
}
