pub fun equals(a: []u8, b: []u8): bool {
    if len(a) != len(b) {
        return false
    }
    for var i: i64 = 0; i < len(a); i += 1 {
        if a[i] != b[i] {
            return false
        }
    }
    return true
}

pub fun starts_with(s: []u8, prefix: []u8): bool {
    if len(s) < len(prefix) {
        return false
    }
    for var i: i64 = 0; i < len(prefix); i += 1 {
        if s[i] != prefix[i] {
            return false
        }
    }
    return true
}

pub fun ends_with(s: []u8, suffix: []u8): bool {
    if len(s) < len(suffix) {
        return false
    }
    var offset = len(s) - len(suffix)
    for var i: i64 = 0; i < len(suffix); i += 1 {
        if s[offset + i] != suffix[i] {
            return false
        }
    }
    return true
}

pub fun index_of(s: []u8, needle: u8): i64 {
    for var i: i64 = 0; i < len(s); i += 1 {
        if s[i] == needle {
            return i
        }
    }
    return -1
}

pub fun last_index_of(s: []u8, needle: u8): i64 {
    var i = len(s) - 1
    for i >= 0 {
        if s[i] == needle {
            return i
        }
        i -= 1
    }
    return -1
}

fun is_space(b: u8): bool {
    return b == ' ' || b == '\t' || b == '\r' || b == '\n'
}

pub fun trim_left(s: []u8): []u8 {
    var i: i64 = 0
    for i < len(s) && is_space(s[i]) {
        i += 1
    }
    return s[i..len(s)]
}

pub fun trim_right(s: []u8): []u8 {
    var end = len(s)
    for end > 0 && is_space(s[end - 1]) {
        end -= 1
    }
    return s[0..end]
}

pub fun trim(s: []u8): []u8 {
    return trim_right(trim_left(s))
}

pub fun parse_u64(s: []u8, out: *u64): bool {
    if len(s) == 0 {
        return false
    }
    var max_u64: u64 = 18446744073709551615
    var acc: u64 = 0
    for var i: i64 = 0; i < len(s); i += 1 {
        var ch = s[i]
        if ch < '0' || ch > '9' {
            return false
        }
        var digit = (ch - '0') as u64
        if acc > (max_u64 - digit) / 10 {
            return false
        }
        acc = acc * 10 + digit
    }
    *out = acc
    return true
}

pub fun parse_i64(s: []u8, out: *i64): bool {
    if len(s) == 0 {
        return false
    }
    var negative = false
    var start: i64 = 0
    if s[0] == '-' {
        negative = true
        start = 1
    } else if s[0] == '+' {
        start = 1
    }
    if start >= len(s) {
        return false
    }

    var mag: u64 = 0
    if !parse_u64(s[start..len(s)], &mag) {
        return false
    }
    var limit: u64 = 9223372036854775807
    if negative {
        limit += 1
    }
    if mag > limit {
        return false
    }
    if negative {
        *out = (0 - mag) as i64
    } else {
        *out = mag as i64
    }
    return true
}
