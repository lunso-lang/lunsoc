import std.str

fun parse_unsigned(s: []const u8, max_val: u64): !u64 {
    var n = len(s)
    if n == 0 {
        return fail("empty integer")
    }
    var i: i64 = 0
    if s[0] == '+' {
        i = 1
        if i >= n {
            return fail("invalid integer")
        }
    }
    var acc: u64 = 0
    for i < n {
        var ch = s[i]
        if ch < '0' || ch > '9' {
            return fail("invalid integer character")
        }
        var digit = (ch - '0') as u64
        if acc > (max_val - digit) / 10 {
            return fail("integer overflow")
        }
        acc = acc * 10 + digit
        i += 1
    }
    return acc
}

fun parse_signed(s: []const u8, min_val: i64, max_val: i64): !i64 {
    var n = len(s)
    if n == 0 {
        return fail("empty integer")
    }
    var neg = false
    var i: i64 = 0
    if s[0] == '-' {
        neg = true
        i = 1
    } else if s[0] == '+' {
        i = 1
    }
    if i >= n {
        return fail("invalid integer")
    }
    var limit: u64 = max_val as u64
    if neg {
        limit = ((-(min_val + 1)) as u64) + 1
    }
    var acc = parse_unsigned(s[i..n], limit)?
    if neg {
        if acc == limit && min_val == (-9223372036854775807 - 1) {
            return min_val
        }
        return -(acc as i64)
    }
    return acc as i64
}

fun parse_bool_val(s: []const u8): !bool {
    if str.equals(s, "true") {
        return true
    }
    if str.equals(s, "false") {
        return false
    }
    return fail("invalid bool")
}

fun parse_f64(s: []const u8): !f64 {
    var n = len(s)
    if n == 0 {
        return fail("empty float")
    }
    var i: i64 = 0
    var neg = false
    if s[i] == '-' {
        neg = true
        i += 1
    } else if s[i] == '+' {
        i += 1
    }
    var val: f64 = 0.0
    var digits = 0
    for i < n && s[i] >= '0' && s[i] <= '9' {
        val = val * 10.0 + ((s[i] - '0') as f64)
        digits += 1
        i += 1
    }
    if i < n && s[i] == '.' {
        i += 1
        var scale: f64 = 0.1
        for i < n && s[i] >= '0' && s[i] <= '9' {
            val += ((s[i] - '0') as f64) * scale
            scale *= 0.1
            digits += 1
            i += 1
        }
    }
    if digits == 0 {
        return fail("invalid float")
    }
    if i < n && (s[i] == 'e' || s[i] == 'E') {
        i += 1
        var exp_neg = false
        if i < n && s[i] == '-' {
            exp_neg = true
            i += 1
        } else if i < n && s[i] == '+' {
            i += 1
        }
        var exp_digits = 0
        var exp_val: i32 = 0
        for i < n && s[i] >= '0' && s[i] <= '9' {
            if exp_val < 10000 {
                exp_val = exp_val * 10 + ((s[i] - '0') as i32)
            }
            exp_digits += 1
            i += 1
        }
        if exp_digits == 0 {
            return fail("invalid float exponent")
        }
        for _ in 0..exp_val {
            if exp_neg {
                val *= 0.1
            } else {
                val *= 10.0
            }
        }
    }
    if i != n {
        return fail("invalid float trailing characters")
    }
    if neg {
        return -val
    }
    return val
}

pub fun parse[T](s: []const u8): !T {
    match type T {
        bool => return parse_bool_val(s)
        i8 => return parse_signed(s, -128, 127)? as i8
        i16 => return parse_signed(s, -32768, 32767)? as i16
        i32 => return parse_signed(s, -2147483648, 2147483647)? as i32
        i64 => return parse_signed(s, -9223372036854775807 - 1, 9223372036854775807)
        u8 => return parse_unsigned(s, 255)? as u8
        u16 => return parse_unsigned(s, 65535)? as u16
        u32 => return parse_unsigned(s, 4294967295)? as u32
        u64 => return parse_unsigned(s, 18446744073709551615)
        f64 => return parse_f64(s)
        f32 => return parse_f64(s)? as f32
        else => return fail("unsupported parse type")
    }
}
