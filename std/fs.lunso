import std.file
import std.mem
import std.os
import std.str
import std.collections { Vec }

ext fun lunso_sys_access(path: *const u8, mode: i32): i64
ext fun lunso_sys_open_dir(path: *const u8): i64
ext fun lunso_sys_file_close(fd: i32): i64
ext fun lunso_sys_rename(old_path: *const u8, new_path: *const u8): i64

fun copy_cstr(path: []const u8, buf: *u8, cap: i64): i64 {
    var n = len(path)
    if n >= cap {
        return -36
    }
    for i, ch in path {
        if ch == '\0' {
            return -22
        }
        buf[i] = ch
    }
    buf[n] = '\0'
    return 0
}

pub fun read_file(path: []const u8, arena: *mem.Arena): ![]u8 {
    var out: []u8
    if file.read_all(path, arena, &out) < 0 {
        return fail("read_file failed")
    }
    return out
}

pub fun write_file(path: []const u8, bytes: []const u8): !void {
    if file.write_all(path, bytes) < 0 {
        return fail("write_file failed")
    }
}

pub fun copy_file(src: []const u8, dst: []const u8): !i64 {
    var in_f: file.File
    if file.open_read(src, &in_f) < 0 {
        return fail("copy_file open source failed")
    }
    defer file.close(&in_f)

    var out_f: file.File
    if file.open_write(dst, &out_f) < 0 {
        return fail("copy_file open destination failed")
    }
    defer file.close(&out_f)

    var buf: [4096]u8
    var total: i64 = 0
    for {
        var n = file.read_into(&in_f, &buf[0], 4096)
        if n < 0 {
            return fail("copy_file read failed")
        }
        if n == 0 {
            break
        }
        var w = file.write_to(&out_f, buf[0..n])
        if w < 0 {
            return fail("copy_file write failed")
        }
        total += w
    }
    return total
}

pub fun exists(path: []const u8): bool {
    var buf: [4096]u8
    if copy_cstr(path, &buf[0], 4096) < 0 {
        return false
    }
    var r = lunso_sys_access(data(buf), 0)
    for r == -4 {
        r = lunso_sys_access(data(buf), 0)
    }
    return r == 0
}

pub fun is_dir(path: []const u8): bool {
    var buf: [4096]u8
    if copy_cstr(path, &buf[0], 4096) < 0 {
        return false
    }
    var fd = lunso_sys_open_dir(data(buf))
    for fd == -4 {
        fd = lunso_sys_open_dir(data(buf))
    }
    if fd < 0 {
        return false
    }
    lunso_sys_file_close(fd as i32)
    return true
}

pub fun is_file(path: []const u8): bool {
    return exists(path) && !is_dir(path)
}

pub fun create_dir(path: []const u8): !void {
    if os.mkdir(path) < 0 {
        return fail("create_dir failed")
    }
}

pub fun create_dir_all(path: []const u8): !void {
    var n = len(path)
    if n == 0 {
        return fail("create_dir_all empty path")
    }
    if n >= 4096 {
        return fail("create_dir_all path too long")
    }
    var buf: [4096]u8
    for var i: i64 = 0; i < n; i += 1 {
        if path[i] == '\0' {
            return fail("create_dir_all invalid path")
        }
        buf[i] = path[i]
    }
    for var i: i64 = 1; i < n; i += 1 {
        if buf[i] == '/' && i > 0 {
            var sub = buf[0..i]
            var st = os.mkdir(sub)
            if st < 0 && st != -17 {
                return fail("create_dir_all failed")
            }
        }
    }
    var st = os.mkdir(buf[0..n])
    if st < 0 {
        if st == -17 && is_dir(buf[0..n]) {
            return
        }
        return fail("create_dir_all failed")
    }
}

pub fun remove_file(path: []const u8): !void {
    if os.remove(path) < 0 {
        return fail("remove_file failed")
    }
}

pub fun remove_dir(path: []const u8): !void {
    if os.rmdir(path) < 0 {
        return fail("remove_dir failed")
    }
}

pub fun read_dir(path: []const u8, arena: *mem.Arena): !Vec[os.DirEntry] {
    var out: Vec[os.DirEntry]
    if os.list_dir(path, arena, &out) < 0 {
        return fail("read_dir failed")
    }
    return out
}

pub fun rename(old_path: []const u8, new_path: []const u8): !void {
    var obuf: [4096]u8
    var nbuf: [4096]u8
    if copy_cstr(old_path, &obuf[0], 4096) < 0 {
        return fail("rename invalid old_path")
    }
    if copy_cstr(new_path, &nbuf[0], 4096) < 0 {
        return fail("rename invalid new_path")
    }
    if lunso_sys_rename(data(obuf), data(nbuf)) < 0 {
        return fail("rename failed")
    }
}

pub fun remove_all(path: []const u8, arena: *mem.Arena): !void {
    if !exists(path) {
        return
    }
    if !is_dir(path) {
        remove_file(path)?
        return
    }
    var entries = read_dir(path, arena)?
    for item in entries.as_slice() {
        var child = str.concat3(arena, path, "/", item.name)
        if len(path) > 0 && path[len(path) - 1] == '/' {
            child = str.concat(arena, path, item.name)
        }
        if item.is_dir {
            remove_all(child, arena)?
        } else {
            remove_file(child)?
        }
    }
    remove_dir(path)?
}
