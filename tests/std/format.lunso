// expect-stdout: hi Alice, n=42, ok=true, pi=3.14\n
import std.fmt
import std.format
import std.mem
import std.str

fun main(): i32 {
    var arena: mem.Arena
    if arena.init(4096) < 0 {
        return 1
    }
    defer arena.deinit()

    var b: fmt.Builder
    b.init(&arena)
    b.str("x=").i64_val(-7).str(" ").f64_val(3.1415, 2)
    if !str.equals(b.finish(), "x=-7 3.14") {
        return 2
    }

    var name = "Alice"
    var n: i32 = 42
    var ok = true
    var out = format.format(&arena, "hi {}, n={}, ok={}, pi={}", name, n, ok, fmt.format_f64(3.1415, 2, &arena))
    if !str.equals(out, "hi Alice, n=42, ok=true, pi=3.14") {
        return 3
    }

    format.print("{}\n", out)
    return 0
}
