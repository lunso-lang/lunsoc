import std.rand
import std.time

fun main(): i32 {
    var t1 = time.now_monotonic() or {
        return 1
    }
    var rt = time.now_realtime() or {
        return 2
    }
    if rt.sec <= 0 {
        return 2
    }
    time.sleep_ms(5) or {
        return 3
    }
    var t2 = time.monotonic_ns()
    if t2 <= t1.sec * 1000000000 + t1.nsec {
        return 4
    }

    var buf: [16]u8
    rand.fill_bytes(buf[0..16]) or {
        return 5
    }
    var any_nonzero = false
    for b in buf {
        if b != 0 {
            any_nonzero = true
        }
    }
    if !any_nonzero {
        return 6
    }

    var rng: rand.Rng
    rand.init(&rng) or {
        return 7
    }
    for _ in 0..20 {
        var r = rand.range_i32(&rng, 1, 6)
        if r < 1 || r > 6 {
            return 8
        }
    }

    var a: rand.Rng
    var b: rand.Rng
    rand.seed(&a, 42)
    rand.seed(&b, 42)
    if rand.next_u64(&a) != rand.next_u64(&b) {
        return 9
    }
    return 0
}
