import std.rand
import std.time

fun main(): i32 {
    var t1: time.Instant
    if time.now_monotonic(&t1) < 0 {
        return 1
    }
    var rt: time.Instant
    if time.now_realtime(&rt) < 0 || rt.sec <= 0 {
        return 2
    }
    if time.sleep_ms(5) < 0 {
        return 3
    }
    var t2 = time.monotonic_ns()
    if t2 <= t1.sec * 1000000000 + t1.nsec {
        return 4
    }

    var buf: [16]u8
    if rand.fill_bytes(&buf[0], 16) < 0 {
        return 5
    }
    var any_nonzero = false
    for var i: i64 = 0; i < 16; i += 1 {
        if buf[i] != 0 {
            any_nonzero = true
        }
    }
    if !any_nonzero {
        return 6
    }

    var rng: rand.Rng
    if rand.init(&rng) < 0 {
        return 7
    }
    for var j: i32 = 0; j < 20; j += 1 {
        var r = rand.range_i32(&rng, 1, 6)
        if r < 1 || r > 6 {
            return 8
        }
    }

    var a: rand.Rng
    var b: rand.Rng
    rand.seed(&a, 42)
    rand.seed(&b, 42)
    if rand.next_u64(&a) != rand.next_u64(&b) {
        return 9
    }
    return 0
}
