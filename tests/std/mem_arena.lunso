import std.mem

fun main(): i32 {
    var arena: mem.Arena
    if mem.init(&arena, 64) != 0 {
        return 1
    }

    var p1: *u8
    if mem.alloc(&arena, 16, 8, &p1) != 0 {
        return 2
    }
    if ((p1 as u64) & 7) != 0 {
        return 3
    }
    p1[0] = 77

    // Force growth past initial 64-byte block.
    var p2: *u8
    if mem.alloc(&arena, 256, 16, &p2) != 0 {
        return 4
    }
    if ((p2 as u64) & 15) != 0 {
        return 5
    }
    if p1[0] != 77 {
        return 6
    }

    // Invalid alignment (not power of two) must fail and leave output untouched.
    var p3: *u8 = p1
    if mem.alloc(&arena, 8, 3, &p3) == 0 {
        return 7
    }
    if p3 != p1 {
        return 8
    }

    mem.reset(&arena)
    if mem.alloc(&arena, 32, 8, &p3) != 0 {
        return 9
    }

    var one: *i64
    if mem.alloc_one.[i64](&arena, &one) != 0 || ((one as u64) & 7) != 0 {
        return 11
    }
    *one = 123456

    var many: *i32
    if mem.alloc_many.[i32](&arena, 4, &many) != 0 || ((many as u64) & 3) != 0 {
        return 12
    }
    many[0] = 10
    many[3] = 40
    if *one != 123456 || many[0] + many[3] != 50 {
        return 13
    }

    if mem.deinit(&arena) != 0 {
        return 10
    }
    return 0
}
