import std.mem
import std.collections { Vec }

struct Token {
    kind: i32
    offset: u64
    size: u32
}

fun main(): i32 {
    var arena: mem.Arena
    if mem.init(&arena, 4096) < 0 {
        return 1
    }

    var nums: Vec[i32]
    if nums.init(&arena, 0) < 0 {
        mem.deinit(&arena)
        return 2
    }
    if len(nums.as_slice()) != 0 {
        mem.deinit(&arena)
        return 3
    }

    for var i: i32 = 0; i < 25; i += 1 {
        if nums.push_value(i * 3) < 0 {
            mem.deinit(&arena)
            return 4
        }
    }
    if nums.len != 25 || nums.cap < 25 {
        mem.deinit(&arena)
        return 5
    }

    var slice = nums.as_slice()
    if len(slice) != 25 || slice[0] != 0 || slice[24] != 72 {
        mem.deinit(&arena)
        return 6
    }

    var out: i32 = 0
    if !nums.get(10, &out) || out != 30 {
        mem.deinit(&arena)
        return 7
    }
    if nums.get(25, &out) {
        mem.deinit(&arena)
        return 8
    }

    if !nums.pop(&out) || out != 72 || nums.len != 24 {
        mem.deinit(&arena)
        return 9
    }

    nums.clear()
    if nums.len != 0 {
        mem.deinit(&arena)
        return 10
    }

    var extra: [3]i32 = [100, 200, 300]
    if nums.append_slice(extra[0..3]) < 0 || nums.len != 3 || nums.data[2] != 300 {
        mem.deinit(&arena)
        return 15
    }
    var buf: Vec[u8]
    if buf.init(&arena, 4) < 0 ||
       buf.append_slice("Content-Length: ") < 0 ||
       buf.append_slice("42") < 0 ||
       buf.len != 18 || buf.data[0] != 'C' || buf.data[17] != '2' {
        mem.deinit(&arena)
        return 16
    }

    var tokens: Vec[Token]
    if tokens.init(&arena, 2) < 0 {
        mem.deinit(&arena)
        return 11
    }
    for var j: u64 = 0; j < 10; j += 1 {
        if tokens.push_value(Token { kind: (j as i32) + 1, offset: j * 4, size: 2 }) < 0 {
            mem.deinit(&arena)
            return 12
        }
    }
    var tok: Token
    if !tokens.get(9, &tok) || tok.kind != 10 || tok.offset != 36 || tok.size != 2 {
        mem.deinit(&arena)
        return 13
    }

    if mem.deinit(&arena) < 0 {
        return 14
    }
    return 0
}
