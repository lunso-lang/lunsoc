// expect-stdout: num=-42\n
import std.fmt
import std.io
import std.mem
import std.str
import std.collections { Vec }

fun main(): i32 {
    if !str.equals("hello", "hello") || str.equals("hello", "world") {
        return 1
    }
    if !str.starts_with("lunso-boot", "lunso") || !str.ends_with("main.lunso", ".lunso") {
        return 2
    }
    if str.index_of("a/b/c", '/') != 1 || str.last_index_of("a/b/c", '/') != 3 {
        return 3
    }
    if str.index_of("abc", 'z') != -1 {
        return 4
    }
    if !str.equals(str.trim("  \t hello \n "), "hello") {
        return 5
    }

    var u: u64 = 0
    if !str.parse_u64("12345", &u) || u != 12345 || str.parse_u64("12x", &u) {
        return 6
    }
    var i: i64 = 0
    if !str.parse_i64("-9223372036854775808", &i) || i != (-9223372036854775807 - 1) {
        return 7
    }
    if str.parse_i64("9223372036854775808", &i) {
        return 8
    }

    var arena: mem.Arena
    if mem.init(&arena, 256) < 0 {
        return 9
    }

    if !str.equals(fmt.format_u64(0, &arena), "0") {
        mem.deinit(&arena)
        return 10
    }
    if !str.equals(fmt.format_i64(-9223372036854775807 - 1, &arena), "-9223372036854775808") {
        mem.deinit(&arena)
        return 11
    }

    if !str.equals(str.concat(&arena, "foo", "bar"), "foobar") ||
       !str.equals(str.concat3(&arena, "a", "/", "b"), "a/b") ||
       !str.equals(str.strip_prefix("pre_name", "pre_"), "name") ||
       !str.equals(str.strip_suffix("main.lunso", ".lunso"), "main") {
        mem.deinit(&arena)
        return 14
    }

    var orig = "cloned"
    var copy = str.clone(&arena, orig)
    if !str.equals(copy, orig) || data(copy) == data(orig) || !str.equals(str.clone(&arena, ""), "") {
        mem.deinit(&arena)
        return 15
    }
    if str.hash("") != 0xcbf29ce484222325 || str.hash("hello") != str.hash(str.clone(&arena, "hello")) || str.hash("hello") == str.hash("world") {
        mem.deinit(&arena)
        return 16
    }

    var hbuf: [16]u8
    var hn = fmt.hex_to_buf(0xdeadbeef, &hbuf[0], 16)
    if hn != 8 || !str.equals(hbuf[0..hn], "deadbeef") {
        mem.deinit(&arena)
        return 12
    }

    if str.find("hello world", "world") != 6 || !str.contains("hello world", "lo wo") || str.contains("hello", "xyz") {
        arena.deinit()
        return 17
    }

    var parts: Vec[[]const u8]
    if str.split(&arena, "a::b::c", "::", &parts) != 3 ||
       !str.equals(parts.data[0], "a") ||
       !str.equals(parts.data[1], "b") ||
       !str.equals(parts.data[2], "c") {
        arena.deinit()
        return 18
    }

    if !str.equals(str.join(&arena, parts.as_const_slice(), "-"), "a-b-c") {
        arena.deinit()
        return 19
    }

    var ls: Vec[[]const u8]
    if str.lines(&arena, "one\r\ntwo\nthree\n", &ls) != 3 ||
       !str.equals(ls.data[0], "one") ||
       !str.equals(ls.data[1], "two") ||
       !str.equals(ls.data[2], "three") {
        arena.deinit()
        return 20
    }

    if !str.equals(str.replace(&arena, "foo bar foo", "foo", "baz"), "baz bar baz") ||
       !str.equals(str.to_lower(&arena, "HeLLo 123"), "hello 123") ||
       !str.equals(str.to_upper(&arena, "HeLLo 123"), "HELLO 123") ||
       !str.equals(str.repeat(&arena, "ab", 3), "ababab") {
        arena.deinit()
        return 21
    }

    io.print("num=")
    fmt.print_i64(1, -42)
    io.print("\n")

    if mem.deinit(&arena) < 0 {
        return 13
    }
    return 0
}
