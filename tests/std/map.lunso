// expect-exit: 0
import std.fmt
import std.collections { StrMap }
import std.mem

fun main(): i32 {
    var arena: mem.Arena
    if mem.init(&arena, 4096) < 0 {
        return 1
    }
    defer mem.deinit(&arena)

    var m: StrMap[i64]
    if m.init(&arena, 0) < 0 {
        return 2
    }
    if m.has("missing") {
        return 3
    }

    // Insert enough keys to trigger multiple rehashes and verify key cloning.
    var key_buf: [32]u8
    for var i: i64 = 0; i < 40; i += 1 {
        var n = fmt.i64_to_buf(i, &key_buf[0], 32)
        if n <= 0 || m.set(key_buf[0..n], i * 10) < 0 {
            return 4
        }
    }
    if m.len != 40 {
        return 5
    }

    for var i: i64 = 0; i < 40; i += 1 {
        var n = fmt.i64_to_buf(i, &key_buf[0], 32)
        var v: i64 = 0
        if !m.get(key_buf[0..n], &v) || v != i * 10 {
            return 6
        }
    }

    // Update via set and via get_ptr.
    if m.set("7", 777) < 0 {
        return 7
    }
    var vp: *i64
    if !m.get_ptr("7", &vp) || *vp != 777 {
        return 8
    }
    *vp = 888
    var v7: i64 = 0
    if !m.get("7", &v7) || v7 != 888 {
        return 9
    }

    // Remove and re-insert (tombstone reuse).
    if !m.remove("7") || m.remove("7") || m.has("7") || m.len != 39 {
        return 10
    }
    if m.set("7", 999) < 0 || !m.get("7", &v7) || v7 != 999 || m.len != 40 {
        return 11
    }

    m.clear()
    if m.len != 0 || m.has("0") {
        return 12
    }

    return 0
}
