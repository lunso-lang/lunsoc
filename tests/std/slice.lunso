// expect-exit: 0
import std.slice
import std.str

struct Item {
    id: i32
    score: i32
}

fun cmp_i32_asc(a: i32, b: i32): i32 {
    if a < b { return -1 }
    if a > b { return 1 }
    return 0
}

fun cmp_i32_desc(a: i32, b: i32): i32 {
    return cmp_i32_asc(b, a)
}

fun cmp_item_score(a: Item, b: Item): i32 {
    if a.score < b.score { return -1 }
    if a.score > b.score { return 1 }
    return 0
}

fun is_even(x: i32): bool {
    return (x % 2) == 0
}

fun is_positive(x: i32): bool {
    return x > 0
}

fun is_gt_10(x: i32): bool {
    return x > 10
}

fun main(): i32 {
    var empty: [0]i32
    slice.sort(empty[0..0], cmp_i32_asc)
    slice.reverse(empty[0..0])
    if !slice.is_sorted(empty[0..0], cmp_i32_asc) {
        return 1
    }
    if slice.any_of(empty[0..0], is_even) || !slice.all_of(empty[0..0], is_even) {
        return 2
    }

    var nums: [8]i32 = [5, 1, 8, 3, 2, 7, 4, 6]
    var s = nums[0..8]
    if slice.is_sorted(s, cmp_i32_asc) {
        return 3
    }
    slice.sort(s, cmp_i32_asc)
    if !slice.is_sorted(s, cmp_i32_asc) {
        return 4
    }
    for var i: i64 = 0; i < 8; i += 1 {
        if s[i] != (i as i32) + 1 {
            return 5
        }
    }

    slice.reverse(s)
    if !slice.is_sorted(s, cmp_i32_desc) {
        return 6
    }

    // Large array (> 16) to exercise quicksort path
    var big: [24]i32 = [
        19, 3, 12, 7, 23, 0, 15, 8,
        1, 22, 11, 5, 18, 2, 14, 9,
        6, 21, 4, 17, 10, 20, 13, 16
    ]
    var bs = big[0..24]
    slice.sort(bs, cmp_i32_asc)
    if !slice.is_sorted(bs, cmp_i32_asc) {
        return 7
    }
    for var i: i64 = 0; i < 24; i += 1 {
        if bs[i] != (i as i32) {
            return 8
        }
    }

    if slice.find_by(s, is_even) != 0 {
        return 9
    }
    if slice.find_by(s, is_gt_10) != -1 {
        return 10
    }
    if !slice.any_of(s, is_even) || slice.any_of(s, is_gt_10) {
        return 11
    }
    if !slice.all_of(s, is_positive) || slice.all_of(s, is_even) {
        return 12
    }
    if slice.count_by(s, is_even) != 4 {
        return 13
    }
    if slice.index_of(s, 5) != 3 || slice.index_of(s, 99) != -1 {
        return 14
    }
    if !slice.contains(s, 1) || slice.contains(s, 99) {
        return 15
    }

    var items: [3]Item = [
        Item { id: 1, score: 30 },
        Item { id: 2, score: 10 },
        Item { id: 3, score: 20 }
    ]
    slice.sort(items[0..3], cmp_item_score)
    if items[0].id != 2 || items[1].id != 3 || items[2].id != 1 {
        return 16
    }

    var buf: [4]i32
    slice.fill(buf[0..4], 42)
    for x in buf[0..4] {
        if x != 42 {
            return 17
        }
    }

    var words: [3][]const u8 = ["alpha", "beta", "gamma"]
    if !str.equals(words[0], "alpha") || len(words) != 3 {
        return 18
    }

    return 0
}
