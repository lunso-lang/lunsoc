// expect-exit: 0
import std.collections { Vec, StrMap, Stack }
import std.mem { Arena }

fun stack_pop_fails(s: *Stack[i32]): bool {
    _ = s.pop() or { return true }
    return false
}

fun stack_peek_fails(s: *const Stack[i32]): bool {
    _ = s.peek() or { return true }
    return false
}

fun main(): i32 {
    var arena: Arena
    if arena.init(4096) < 0 {
        return 1
    }
    defer arena.deinit()

    var v: Vec[i32]
    if v.init(&arena, 4) < 0 {
        return 2
    }
    v.push_value(10)
    v.push_value(20)
    if v.len != 2 {
        return 3
    }

    var m: StrMap[i32]
    if m.init(&arena, 8) < 0 {
        return 4
    }
    m.set("one", 1)
    var val: i32 = 0
    if !m.get("one", &val) || val != 1 {
        return 5
    }

    var st: Stack[i32]
    st.init(&arena, 4) or { return 6 }
    if !st.is_empty() || st.len() != 0 { return 7 }
    if !stack_pop_fails(&st) || !stack_peek_fails(&st) { return 8 }

    st.push(10) or { return 9 }
    st.push(20) or { return 9 }
    st.push(30) or { return 9 }
    if st.is_empty() || st.len() != 3 { return 10 }
    if (st.peek() or -1) != 30 { return 11 }
    if (st.pop() or -1) != 30 { return 12 }
    if (st.pop() or -1) != 20 { return 13 }
    st.clear()
    if !st.is_empty() || !stack_pop_fails(&st) { return 14 }

    return 0
}
