// expect-exit: 0
import std.mem
import std.process
import std.str

fun main(): i32 {
    var arena: mem.Arena
    if arena.init(8192) < 0 {
        return 1
    }
    defer arena.deinit()

    if process.pid() <= 0 || process.ppid() <= 0 {
        return 2
    }

    var orig_cwd = process.cwd(&arena) or {
        return 3
    }
    if len(orig_cwd) == 0 {
        return 3
    }
    process.chdir("/tmp") or {
        return 4
    }
    var tmp_cwd = process.cwd(&arena) or {
        return 5
    }
    if !str.equals(tmp_cwd, "/tmp") {
        return 5
    }
    process.chdir(orig_cwd) or {
        return 6
    }

    var cmd: process.Command
    cmd.init(&arena, "echo") or {
        return 7
    }
    cmd.arg("hello") or {
        return 7
    }
    cmd.arg("lunso") or {
        return 7
    }

    var out = cmd.output() or {
        return 8
    }
    if !str.equals(str.trim(out), "hello lunso") {
        return 9
    }

    var bad_cmd: process.Command
    bad_cmd.init(&arena, "lunso_nonexistent_cmd_12345") or {
        return 10
    }
    bad_cmd.output() or {
        return 0
    }
    return 11
}
