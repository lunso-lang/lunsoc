// expect-exit: 15
// lunsoc-only
import std.mem
import std.collections { Vec }

fun main(): i32 {
    var a = 1
    var b = 2
    if a == 1 &&
       b == 2 {
        a = 10
    }
    var argv: [3][]u8 = ["-c", "-o", "out"]
    var arena: mem.Arena
    mem.init(&arena, 4096)
    var v: Vec[[]u8]
    v.init(&arena, 4)
    v.push_value("-o")
    var p: *[]u8
    if !v.get_ptr(0, &p) {
        return 1
    }
    *p = argv[2]
    var s = v.as_slice()
    var rc = a + (len(s[0]) as i32) + (len(argv[0]) as i32)
    mem.deinit(&arena)
    return rc
}
