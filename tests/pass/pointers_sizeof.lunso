// expect-exit: 50
struct Header {
    magic: u32
    flags: u16
    kind: u8
}

fun sum_bytes(view: []u8): i32 {
    var acc: i32 = 0
    for var i: i64 = 0; i < len(view); i += 1 {
        acc += view[i] as i32
    }
    return acc
}

fun main(): i32 {
    var buf: [4]u8
    var p: *u8 = &buf[0]
    p[0] = 10
    p[1] = 20
    p[2] = 30
    p[3] = 40

    var hdr: Header
    var sz = size_of(hdr)
    if sz < 7 {
        return 1
    }

    var slice = p[1..3]
    // 20 + 30 = 50
    return sum_bytes(slice)
}
