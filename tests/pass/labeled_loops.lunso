// expect-exit: 19
fun main(): i32 {
    var total: i32 = 0

    // i=0: j=0 -> total=1, j=1 -> continue outer (skips total+=100)
    // i=1: j=0 -> total=2, j=1 -> continue outer
    // i=2: j=0 -> break outer (total stays 2)
    outer: for var i: i32 = 0; i < 5; i += 1 {
        for var j: i32 = 0; j < 5; j += 1 {
            if i == 2 {
                break outer
            }
            if j == 1 {
                continue outer
            }
            total += 1
        }
        total += 100
    }

    // Infinite outer loop broken from inner loop -> adds 17 (total 19)
    var count: i32 = 0
    forever: for {
        for var k: i32 = 0; k < 10; k += 1 {
            count += 1
            if count == 3 {
                total += 17
                break forever
            }
        }
    }

    return total
}
