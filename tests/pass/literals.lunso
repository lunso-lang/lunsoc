// expect-exit: 42
enum Kind : u8 {
    Hex = 0x10,
    Bin = 0b101,
    Char = 'A',
}

fun main(): i32 {
    var h: u32 = 0x0f
    var H: u32 = 0X10
    var b: u32 = 0b1010
    var B: u32 = 0B0011

    if h != 15 || H != 16 || b != 10 || B != 3 {
        return 1
    }

    var c1: u8 = 'A'
    var c2: u8 = '\n'
    var c3: u8 = '\0'
    var c4: u8 = '\''
    var c5: u8 = '\\'
    var c6: u8 = '\x2a'

    if c1 != 65 || c2 != 10 || c3 != 0 || c4 != 39 || c5 != 92 || c6 != 42 {
        return 2
    }

    if (Kind.Hex as u8) != 16 || (Kind.Bin as u8) != 5 || (Kind.Char as u8) != 65 {
        return 3
    }

    return c6 as i32
}
