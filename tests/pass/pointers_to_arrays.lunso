struct Rows {
    next: *[2]Rows
    bytes: [2][4]u8
}

const TEXT = "xyz"

fun row_at(rows: *[4]u8, index: i64): *[4]u8 {
    return &rows[index]
}

fun main(): i32 {
    var rows: Rows
    var matrix: *[2][4]u8 = &rows.bytes
    var first = &(*matrix)[0]
    var second = row_at(first, 1)
    if (second as u64) - (first as u64) != 4 {
        return 1
    }

    *second = [10, 20, 30, 40]
    first[0] = first[1]
    first[1][3] = 99
    if rows.bytes[0][3] != 40 || rows.bytes[1][3] != 99 {
        return 2
    }

    var view: [][4]u8 = first[0..2]
    var borrowed: *const [4]u8 = data(view)
    if len(view) != 2 || borrowed[1][3] != 99 || size_of(*borrowed) != 4 {
        return 3
    }
    var text: *const [3]u8 = &"abc"
    var constant: *const [3]u8 = &TEXT
    if len(*text) != 3 || (*text)[1] != 'b' || constant[0][2] != 'z' {
        return 4
    }

    var empty: [2][0]u8
    var empty_row: *[0]u8 = &empty[0]
    if len(empty) != 2 || len(empty_row[0..2]) != 2 || len(empty_row[1]) != 0 {
        return 5
    }
    return 0
}
