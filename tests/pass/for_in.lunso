// lunsoc-only
struct Pair {
    a: i32
    b: i32
}

fun sum_slice(s: []const i32): i32 {
    var total: i32 = 0
    for x in s {
        total += x
    }
    return total
}

fun main(): i32 {
    var arr: [4]i32 = [10, 20, 30, 40]
    if sum_slice(arr[0..4]) != 100 {
        return 1
    }

    var weighted: i32 = 0
    for i, v in arr {
        weighted += (i as i32) * v
    }
    if weighted != 200 {
        return 2
    }

    var rsum: i64 = 0
    for i in 1..6 {
        if i == 3 {
            continue
        }
        rsum += i
    }
    if rsum != 12 {
        return 3
    }

    var pairs: [2]Pair = [Pair { a: 1, b: 2 }, Pair { a: 3, b: 4 }]
    var psum: i32 = 0
    outer: for p in pairs {
        psum += p.a + p.b
        if p.a == 3 {
            break outer
        }
    }
    if psum != 10 {
        return 4
    }

    return 0
}
