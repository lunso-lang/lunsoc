// lunsoc-only
// expect-exit: 0
import std.fmt
import std.mem
import std.str

fun sum(nums: ...i32): i32 {
    var total: i32 = 0
    for x in nums {
        total += x
    }
    return total
}

fun sum_with_bias(bias: i32, nums: ...i32): i32 {
    return bias + sum(...nums)
}

struct Acc {
    total: i32

    fun add_all(self: *Self, nums: ...i32) {
        self.total += sum(...nums)
    }
}

fun main(): i32 {
    var arr: [4]i32 = [1, 2, 3, 4]
    var sl: []i32 = arr[0..4]
    var csl: []const i32 = arr[1..3]

    if sum(...sl) != 10 { return 1 }
    if sum(...csl) != 5 { return 2 }
    if sum(...arr) != 10 { return 3 }
    if sum_with_bias(100, ...sl) != 110 { return 4 }

    var acc = Acc { total: 5 }
    acc.add_all(...csl)
    if acc.total != 10 { return 5 }

    var arena: mem.Arena
    if arena.init(4096) < 0 { return 6 }
    defer arena.deinit()

    var args: [2]any = [42, "ok"]
    var formatted = fmt.format(&arena, "{}={}", ...args)
    if !str.equals(formatted, "42=ok") { return 7 }

    return 0
}
