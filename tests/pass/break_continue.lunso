// expect-exit: 25
fun main(): i32 {
    var sum: i32 = 0

    // C-style loop: skip multiples of 2, stop at 7 -> 1 + 3 + 5 = 9
    for var i: i32 = 0; i < 10; i += 1 {
        if i == 7 {
            break
        }
        if i % 2 == 0 {
            continue
        }
        sum += i
    }

    // Infinite loop with break -> adds 10 (total 19)
    var count: i32 = 0
    for {
        count += 1
        if count == 4 {
            sum += 10
            break
        }
    }

    // Nested loops: inner break does not exit outer loop -> 3 * 2 = 6 (total 25)
    for var outer: i32 = 0; outer < 3; outer += 1 {
        for var inner: i32 = 0; inner < 5; inner += 1 {
            if inner == 2 {
                break
            }
            sum += 1
        }
    }

    return sum
}
