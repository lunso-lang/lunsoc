// expect-exit: 60
// Forward reference: Outer uses Inner declared below.
struct Outer {
    flag: u8
    inner: Inner
    tail: u8
}

struct Inner {
    x: i32
    y: i64
}

fun main(): i32 {
    var box = Outer {
        flag: 1,
        inner: Inner { x: 10, y: 20 },
        tail: 3,
    }
    box.inner.x += 5

    var grid = [
        Outer { flag: 1, inner: Inner { x: 2, y: 3 }, tail: 1 },
        Outer { flag: 0, inner: Inner { x: 4, y: 5 }, tail: 1 },
        Outer { flag: 1, inner: Inner { x: 6, y: 7 }, tail: 1 },
    ]

    var acc: i32 = (box.flag as i32) + box.inner.x + (box.inner.y as i32) + (box.tail as i32)
    // acc = 1 + 15 + 20 + 3 = 39
    for var i: i64 = 0; i < len(grid); i += 1 {
        if grid[i].flag == 0 {
            continue
        }
        for var j: i32 = 0; j < 3; j += 1 {
            if j == 1 {
                break
            }
            acc += grid[i].inner.x + (grid[i].inner.y as i32) + (grid[i].tail as i32)
        }
    }
    // i=0 adds 2+3+1=6; i=1 skipped; i=2 adds 6+7+1=14 -> 39 + 6 + 14 = 59... wait:
    // +1 to reach 60:
    return acc + 1
}
